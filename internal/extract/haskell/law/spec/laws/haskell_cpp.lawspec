unit assayxport.haskell.cpp
-- ref:DR-0035 ref:DR-0040 ref:DR-0046 (LawSpec is the law surface; owner direction 2026-11-13: every CPP branch is read)

import assayxport.contract as c (Package, Decl, CallEdge)
import assayxport.conditions.policy as wp (Env, Binding, Outcome, CExpr, BinOp, UnOp, Literal, refEval, pick, mix, emptyEnv, completed, buildCap, unreadText)

-- S1.j, next cycle 2 (docs/contributions/S1.j/next-cycle-2/design.md,
-- section 4), rewritten in next cycle 4 for review 7, B1
-- (next-cycle-4/design.md, section 3), and its rule C2 rewritten in next
-- cycle 6 for review 8, B1 (next-cycle-6/design.md, section 3): a term is a
-- choice where the preprocessor's walk first meets it, not where it first
-- stands in the source. Next cycle 7 (next-cycle-7/design.md, section 4;
-- review 9, B2 and S2): the walk keeps the file's own `#define` and
-- `#undef`, as the preprocessor does, and reads `#elifdef` and
-- `#elifndef`. The REFERENCE for reading a source
-- with CPP conditionals: a model of such a source, the text it stands for,
-- its builds, the copy an extractor must read for each build, the
-- condition of a line, and what one environment keeps. The extractor
-- never sees the model; it reads the text.
--
-- Nothing here is an implementation stub.
--
-- A TERM is one directive's condition as written (`#ifdef X` reads
-- `defined(X)`). Two directives with the same text are the same term: they
-- have one value in any build. A BUILD gives a value to every term it
-- reads, and a line stands in it when the preprocessor, walking the source
-- under those values, keeps it. So a build never takes the `#if X` arm of
-- one group and the `#else` of another `#if X`.
--
-- Next cycle 7: a directive that reads a name the FILE has defined or
-- undefined on the way (rule C8) is no term of the environment. Where the
-- file's definitions decide it, it is decided, with no choice and no
-- literal; where they do not, it is a term of its own that nothing
-- decides (`wp.fileDefinedTerm`).

-- ---------------------------------------------------------------------------
-- The first model (cycle 2): whole declarations, each arm with its own
-- names. A module is a list of sections. A section is a block of code, or
-- a group: `#if` arms, an optional `#else`. An arm's body is a list of
-- blocks and of nested groups; a nested group's arms hold one block each.
--
-- An arm's `form` picks its directive and its condition, on a name N made
-- from the arm's place:
--   first arm   0 `#if N`      1 `#ifdef N`       2 `#ifndef N`
--               3 `#if defined(N) && N >= 2`      4 `#  if N`
--   later arm   0, 4 `#elif N`   1 `#elif defined(N)`   2 `#elif !defined(N)`
--               3 `#elif defined(N) && N >= 2`

type Leaf is a record{
  forms :: List Integer
  hasElse :: Bool}
end type

type Inner is one of | InCode | InGroup of type Leaf end type

type Arm is a record{
  form :: Integer
  body :: List Inner}
end type

type Section is one of
  | Code
  | Group of type record{ arms :: List Arm , hasElse :: Bool , elseBody :: List Inner}
end type

-- One line of the source. `terms` are the literals of its path, outermost
-- first: for a group's arm the negations of its earlier arms, then its own
-- term. A directive that opens an arm stands in that arm. `reads` marks an
-- `#if` or `#elif` line: the preprocessor evaluates its own term, the last
-- of `terms`, when the literals before it hold. `name` is the name such a
-- line tests ("" for any other line). Next cycle 7: `sets` is what a
-- `#define` or `#undef` line does to the name `name`. Next cycle 8: `body`
-- is the text a `#define` gives the name (what follows the name, or the
-- argument list; "" where the row was made without one and `sets` says
-- the rest), and `fun` that the name has an argument list.
--
-- The literals of `terms` are the path as the directives are WRITTEN. They
-- give a first-model fact its condition (`conditionAt`), and a reading
-- line its own term. Which lines a build keeps is not read from them (a
-- name the file defines makes one text true in one place and false in
-- another): it is the walk's (`after`, `readingAt`).
type Sets is one of
  | SetsNothing
  | SetsInt of type Integer     -- `#define N <an integer literal>`
  | SetsOther                   -- `#define N`, `#define N(..) ..`, any other body
  | Unsets                      -- `#undef N`
end type

type Row is a record{
  text :: Text
  terms :: List Literal
  directive :: Bool
  reads :: Bool
  name :: Text
  sets :: Sets
  body :: Text
  fun :: Bool}
end type

function nameOf (group :: Integer) (arm :: Integer) -> Text is "C" ++ prelude.textOf group ++ "_" ++ prelude.textOf arm end function

function definedAnd (n :: Text) -> CExpr is
  Bin record{ op = BLand , left = IsDefined n , right = Bin record{ op = BGe , left = Name n , right = Lit 2}}
end function

-- Next cycle 7 (review 9, S2): a later arm's forms 5 `#elifdef N` and
-- 6 `#elifndef N` (C23; GCC 12 and later): the terms of `#ifdef` and
-- `#ifndef`. Next cycle 8 (rule C15): a later arm's form 2,
-- `#elif !defined(N)`, is the term `defined(N)`, negated: one condition
-- spelt two ways is one term (it was a term of its own, `!defined(N)`).
function termOf (first :: Bool) (form :: Integer) (n :: Text) -> Literal is
  if form = 5 then Literal record{ negated = false , text = "defined(" ++ n ++ ")" , expr = IsDefined n}
  else (if form = 6 then Literal record{ negated = true , text = "defined(" ++ n ++ ")" , expr = IsDefined n}
  else (if form = 1 then Literal record{ negated = false , text = "defined(" ++ n ++ ")" , expr = IsDefined n}
  else (if form = 2 then
    Literal record{ negated = true , text = "defined(" ++ n ++ ")" , expr = IsDefined n}
  else (if form = 3 then Literal record{ negated = false , text = "defined(" ++ n ++ ") && " ++ n ++ " >= 2" , expr = definedAnd n}
  else Literal record{ negated = false , text = n , expr = Name n} end if) end if) end if) end if) end if
end function

function directiveOf (first :: Bool) (form :: Integer) (n :: Text) -> Text is
  if first then
    (if form = 1 then "#ifdef " ++ n else (if form = 2 then "#ifndef " ++ n else (if form = 3 then "#if defined(" ++ n ++ ") && " ++ n ++ " >= 2"
     else (if form = 4 then "#  if " ++ n ++ "  " else "#if " ++ n end if) end if) end if) end if)
  else (if form = 5 then "#elifdef " ++ n else (if form = 6 then "#elifndef " ++ n
  else (if form = 2 then "#elif !defined(" ++ n ++ ")" else "#elif " ++ (termOf false form n).text end if) end if) end if) end if
end function

function negate (t :: Literal) -> Literal is t with negated = !t.negated end function

-- A line of code, or a directive that reads no term (`#else`, `#endif`).
function row (text :: Text) (terms :: List Literal) (directive :: Bool) -> Row is
  Row record{ text = text ++ "\n" , terms = terms , directive = directive , reads = false , name = "" , sets = SetsNothing , body = "" , fun = false}
end function

-- An `#if`, `#ifdef`, `#ifndef` or `#elif` line: `terms` end with its own.
function opener (text :: Text) (terms :: List Literal) (name :: Text) -> Row is
  Row record{ text = text ++ "\n" , terms = terms , directive = true , reads = true , name = name , sets = SetsNothing , body = "" , fun = false}
end function

-- A `#define` or `#undef` line of the name `name` (next cycle 7).
function definer (text :: Text) (terms :: List Literal) (name :: Text) (sets :: Sets) -> Row is
  Row record{ text = text ++ "\n" , terms = terms , directive = true , reads = false , name = name , sets = sets , body = "" , fun = false}
end function

-- A `#define` line with its body as text (next cycle 8): `fun`, the name
-- has an argument list.
function macro (text :: Text) (terms :: List Literal) (name :: Text) (sets :: Sets) (body :: Text) (fun :: Bool) -> Row is
  Row record{ text = text ++ "\n" , terms = terms , directive = true , reads = false , name = name , sets = sets , body = body , fun = fun}
end function

-- A block of code, by its number: four kinds of whole declarations, with
-- names no other block uses and calls no other block decides.
function blockRows (id :: Integer) (terms :: List Literal) -> List Row is
  let n = prelude.textOf id in let k = prelude.rem id 4 in
    (if k = 0 then [row ("v" ++ n ++ " = zz 1") terms false]
     else (if k = 1 then [row ("v" ++ n ++ " :: Int") terms false, row ("v" ++ n ++ " = 2") terms false]
     else (if k = 2 then [row ("data T" ++ n ++ " = K" ++ n ++ " Int") terms false]
     else [row ("-- | Doc " ++ n ++ ".") terms false, row ("v" ++ n ++ " x =") terms false, row "  map x" terms false] end if) end if) end if)
  end let end let
end function

-- A nested group: `forms` are its arms still to write, `k` the next arm's
-- number, `before` the negations of the arms already written.
function leafRows (group :: Integer) (terms :: List Literal) (forms :: List Integer) (k :: Integer) (before :: List Literal) (hasElse :: Bool) -> List Row is
  first matching case of forms :
    when Nil then
      (if hasElse then [row "#else" (terms ++ before) true] ++ blockRows (group * 10 + k) (terms ++ before) ++ [row "#endif" terms true]
       else [row "#endif" (terms ++ before) true] end if)
    when Cons f rest then
      (let own = termOf (k = 0) f (nameOf group k) in
        [opener (directiveOf (k = 0) f (nameOf group k)) (terms ++ before ++ [own]) (nameOf group k)]
          ++ blockRows (group * 10 + k) (terms ++ before ++ [own])
          ++ leafRows group terms rest (k + 1) (before ++ [negate own]) hasElse end let)
  end case
end function

function innerRows (base :: Integer) (terms :: List Literal) (items :: List Inner) (i :: Integer) -> List Row is
  first matching case of items :
    when Nil then []
    when Cons it rest then
      (first matching case of it :
        when InCode then blockRows (base * 10 + i) terms
        when InGroup leaf then leafRows (base * 10 + i) terms leaf.forms 0 [] leaf.hasElse
      end case) ++ innerRows base terms rest (i + 1)
  end case
end function

function armsRows (group :: Integer) (arms :: List Arm) (k :: Integer) (before :: List Literal) (hasElse :: Bool) (elseBody :: List Inner) -> List Row is
  first matching case of arms :
    when Nil then
      (if hasElse then [row "#else" before true] ++ innerRows (group * 10 + k) before elseBody 1 ++ [row "#endif" [] true]
       else [row "#endif" before true] end if)
    when Cons a rest then
      (let own = termOf (k = 0) a.form (nameOf group k) in
        [opener (directiveOf (k = 0) a.form (nameOf group k)) (before ++ [own]) (nameOf group k)]
          ++ innerRows (group * 10 + k) (before ++ [own]) a.body 1
          ++ armsRows group rest (k + 1) (before ++ [negate own]) hasElse elseBody end let)
  end case
end function

function sectionRows (ss :: List Section) (i :: Integer) -> List Row is
  first matching case of ss :
    when Nil then []
    when Cons s rest then
      (first matching case of s :
        when Code then blockRows (i * 4 + prelude.rem i 4) []
        when Group g then armsRows i g.arms 0 [] g.hasElse g.elseBody
      end case) ++ sectionRows rest (i + 1)
  end case
end function

-- The module's lines. Sections are numbered from 1, so no name repeats.
function rowsOf (ss :: List Section) -> List Row is
  [row "{-# LANGUAGE CPP #-}" [] false, row "module M where" [] false] ++ sectionRows ss 1
end function

-- ---------------------------------------------------------------------------
-- The texts.

function sourceOf (rs :: List Row) -> Text is
  first matching case of rs : when Nil then "" when Cons r rest then r.text ++ sourceOf rest end case
end function

-- The source as written.
function render (ss :: List Section) -> Text is sourceOf (rowsOf ss) end function

function blankIf (b :: Bool) (r :: Row) -> Text is if b then "\n" else r.text end if end function

-- Every arm at once, the directive lines blank. It parses, because every
-- block is a whole declaration with its own names; no build is this text.
function allArmsText (rs :: List Row) -> Text is
  first matching case of rs : when Nil then "" when Cons r rest then blankIf r.directive r ++ allArmsText rest end case
end function

function allArms (ss :: List Section) -> Text is allArmsText (rowsOf ss) end function

-- ---------------------------------------------------------------------------
-- Builds (rule C2 as next cycle 6 has it, with rule C8 of next cycle 7). A
-- build is the values of the terms it reads: 1 true, 0 false. The source
-- is walked from its first line as the preprocessor walks it, with the
-- preprocessor's own state: the stack of open groups, and the names the
-- file has defined or undefined so far. A directive is REACHED when the
-- group it stands in is being kept and, for an `#elif`, no earlier arm of
-- its group was taken. At a reached directive:
--   * if it reads no name the file has set, its text is a term of the
--     environment: a choice, true before false, when the term has no
--     value yet; the value it has, when an earlier directive of the same
--     text gave it one;
--   * if it reads a name the file has set and the file's definitions
--     decide it (rule C8), it is decided: no choice, no literal;
--   * if it reads a name the file has set and they do not decide it, it
--     is the term `wp.fileDefinedTerm` of its line: a choice that nothing
--     decides.
-- A directive that is not reached is no choice. Every way through is a
-- build, and the builds stand in that order.
--
-- Cycle 4 took the terms in the order they first stand in the source
-- (review 8, B1). Cycle 6 walked, but took a name the file defines for a
-- name of the environment: under `#if V` / `#define HAS 1` / `#endif` /
-- `#ifdef HAS` it asked the environment for HAS, which no environment
-- sets, and with every name given it dropped what the preprocessor keeps
-- (review 9, B2).

-- An open group: `live`, its current arm is being kept; `done`, an arm of
-- it has been taken, or the group stands in lines that are not kept.
type Frame is a record{
  live :: Bool
  done :: Bool}
end type

type Walk is a record{
  stack :: List Frame
  sets :: KeyVal Text Sets}
end type

function startWalk (u :: Unit) -> Walk is Walk record{ stack = [] , sets = prelude.keyValOf []} end function

function liveOf (stack :: List Frame) -> Bool is
  first matching case of stack : when Nil then true when Cons f rest then f.live end case
end function

-- The directive words, read off the line as the preprocessor reads them.
function isElif (r :: Row) -> Bool is r.reads && prelude.startsWith r.text "#elif" end function
function isIf (r :: Row) -> Bool is r.reads && !(prelude.startsWith r.text "#elif") end function
function isElse (r :: Row) -> Bool is r.directive && prelude.startsWith r.text "#else" end function
function isEndif (r :: Row) -> Bool is r.directive && prelude.startsWith r.text "#endif" end function

-- The preprocessor evaluates this line's condition.
function reachedIn (stack :: List Frame) (r :: Row) -> Bool is
  if isIf r then liveOf stack
  else (if isElif r then
    (first matching case of stack : when Nil then false when Cons f rest then liveOf rest && !f.done end case)
  else false end if) end if
end function

-- The stack after a line; `v` is the value of its condition where it was
-- reached (anything where it was not).
function stepped (stack :: List Frame) (r :: Row) (v :: Bool) -> List Frame is
  if isIf r then [Frame record{ live = liveOf stack && v , done = !(liveOf stack) || v}] ++ stack
  else (if isElif r then
    (first matching case of stack :
      when Nil then []
      when Cons f rest then [Frame record{ live = !f.done && v , done = f.done || v}] ++ rest
    end case)
  else (if isElse r then
    (first matching case of stack :
      when Nil then []
      when Cons f rest then [Frame record{ live = !f.done , done = true}] ++ rest
    end case)
  else (if isEndif r then prelude.drop 1 stack else stack end if) end if) end if) end if
end function

function after (w :: Walk) (r :: Row) (v :: Bool) -> Walk is
  Walk record{ stack = stepped w.stack r v ,
               sets = (if !(r.sets matches SetsNothing) && liveOf w.stack then prelude.put r.name r.sets w.sets else w.sets end if)}
end function

function ownLit (r :: Row) -> Maybe Literal is prelude.at (prelude.length r.terms - 1) r.terms end function

-- Rule C8: what the file's own definitions make of a directive.

-- Every name an expression reads, as a value, under `defined`, or as a
-- macro it calls. GHC's version macro is written in terms of the three
-- version names.
--
-- Next cycle 8 (review 10, N5). The five functions `namesOf`,
-- `valueNames`, `special`, `valued` and `litTrue` had, letter for letter,
-- the bodies an implementer gave `cxNamesOf` and the others, and the
-- generator made each pair one function: a law that held the walk against
-- this reference then held those five against themselves. They are
-- written here in another way on purpose (an accumulator; a list of
-- prefixes; `valueIn`), and the rule is in design.md, section 5: no
-- definition of the extraction may be a call of, or a copy of, a function
-- of this unit. What judges the walk since this cycle is `ran` below, the
-- preprocessor itself, which has none of the five.
function ghcNames (u :: Unit) -> List Text is
  ["MIN_VERSION_GLASGOW_HASKELL", "__GLASGOW_HASKELL__", "__GLASGOW_HASKELL_PATCHLEVEL1__", "__GLASGOW_HASKELL_PATCHLEVEL2__"]
end function

-- `whole`: every name; not `whole`: only those read as a value or called.
function namesInto (whole :: Bool) (acc :: List Text) (e :: CExpr) -> List Text is
  first matching case of e :
    when Lit n then acc
    when ULit n then acc
    when Name n then acc ++ [n]
    when IsDefined n then (if whole then acc ++ [n] else acc end if)
    when Un u then namesInto whole acc u.arg
    when Bin b then namesInto whole (namesInto whole acc b.left) b.right
    when Cond k then namesInto whole (namesInto whole (namesInto whole acc k.test) k.yes) k.no
    when MinVersion m then namesInto whole (namesInto whole (namesInto whole (acc ++ ["MIN_VERSION_" ++ m.pkg]) m.major1) m.major2) m.minor
    when MinGhc m then namesInto whole (namesInto whole (namesInto whole (namesInto whole (acc ++ ghcNames unitValue) m.major1) m.major2) m.patch1) m.patch2
  end case
end function

function namesOf (e :: CExpr) -> List Text is namesInto true [] e end function

-- The names read as a value or called: not those that stand only under
-- `defined`.
function valueNames (e :: CExpr) -> List Text is namesInto false [] e end function

function startsIt (n :: Text) (prefix :: Text) -> Bool is prelude.startsWith n prefix end function

-- A name the evaluator gives a meaning of its own (`wp.valueOf`,
-- `wp.definedOf`): Cabal's and GHC's version macros and names.
function special (n :: Text) -> Bool is prelude.any (startsIt n) ["MIN_VERSION_", "VERSION_", "__GLASGOW_HASKELL"] end function

function isSet (sets :: KeyVal Text Sets) (n :: Text) -> Bool is prelude.lookup n sets matches Present _ end function

-- The name keeps the file from deciding the directive: the file has not
-- set it (it is the environment's); or it is a special name; or the file
-- defined it with no integer body and it is read as a value.
function blocks (sets :: KeyVal Text Sets) (vals :: List Text) (n :: Text) -> Bool is
  first matching case of prelude.lookup n sets :
    when Absent then true
    when Present s then special n || ((s matches SetsOther) && (vals contains n))
  end case
end function

-- The file's definitions of the names, as an environment's.
function fileNames (sets :: KeyVal Text Sets) (ns :: List Text) (acc :: KeyVal Text Binding) -> KeyVal Text Binding is
  first matching case of ns :
    when Nil then acc
    when Cons n rest then
      fileNames sets rest
        (first matching case of prelude.lookup n sets :
          when Present (SetsInt v) then prelude.put n (wp.definedAs v) acc
          when Present Unsets then prelude.put n (wp.notDefined unitValue) acc
          when Present SetsOther then prelude.put n (wp.definedAs 1) acc
          otherwise acc
        end case)
  end case
end function

type Reading is one of | NotRead | ByFile of type Bool | ByTerm of type Literal end type

-- The term of a directive the file reaches and does not decide. Its
-- expression is one that cannot be evaluated.
function fileTerm (line :: Integer) (l :: Literal) -> Literal is
  Literal record{ negated = l.negated , text = wp.fileDefinedTerm line , expr = Bin record{ op = BDiv , left = Lit 1 , right = Lit 0}}
end function

-- Rule C8. A directive that reads no name the file has set is the term it
-- is written as. One that reads such a name is decided by the file when
-- every name it reads is set by the file, none of them blocks, and the
-- expression has a value under exactly those definitions (`ByFile`: the
-- directive holds or fails; `#ifndef` is already turned). Otherwise it is
-- the term of its line that nothing decides.
-- Next cycle 10 (review 12, B1; rule C18). The preprocessor's own names
-- (`ownNames`, below) are defined before the file's first line, with no
-- integer value the walk follows: for rule C8 each stands as if the file
-- had defined it with a body that is no integer, until the file itself
-- defines or undefines it. So `#ifdef __FILE__` is decided (it holds),
-- and a directive that reads one as a value, or beside a name the file
-- does not decide, is the term of its line that nothing decides, in the
-- words `wp.ownNameTerm`.
function setsOther (u :: Unit) -> Sets is SetsOther end function

function readsOwn (sets :: KeyVal Text Sets) (n :: Text) -> Bool is ((ownNames unitValue) contains n) && !(isSet sets n) end function

function ownSets (sets :: KeyVal Text Sets) (ns :: List Text) -> KeyVal Text Sets is
  first matching case of ns :
    when Nil then sets
    when Cons n rest then ownSets (if readsOwn sets n then prelude.put n (setsOther unitValue) sets else sets end if) rest
  end case
end function

function openTerm (sets :: KeyVal Text Sets) (line :: Integer) (l :: Literal) -> Literal is
  if prelude.any (readsOwn sets) (namesOf l.expr)
  then Literal record{ negated = l.negated , text = wp.ownNameTerm line , expr = Bin record{ op = BDiv , left = Lit 1 , right = Lit 0}}
  else fileTerm line l end if
end function

function decidedBy (sets :: KeyVal Text Sets) (l :: Literal) (line :: Integer) -> Reading is
  let ns = namesOf l.expr in let own = ownSets sets ns in
    (if !(prelude.any (isSet own) ns) then ByTerm l
     else (if prelude.any (blocks own (valueNames l.expr)) ns then ByTerm (openTerm sets line l)
     else
       (first matching case of refEval (completed ((emptyEnv unitValue) with names = fileNames own ns (prelude.keyValOf []))) l.expr :
         when Known v then ByFile ((v != 0) != l.negated)
         when Unknown o then ByTerm (openTerm sets line l)
         when Bad then ByTerm (openTerm sets line l)
       end case) end if) end if)
  end let end let
end function

-- What the walk meets at a line (its number from 1).
function readingAt (w :: Walk) (r :: Row) (line :: Integer) -> Reading is
  if !(reachedIn w.stack r) then NotRead
  else (first matching case of ownLit r : when Absent then NotRead when Present l then decidedBy w.sets l line end case) end if
end function

function valued (asg :: KeyVal Text Integer) (t :: Text) -> Bool is prelude.lookup t asg matches Present _ end function

-- The directive holds under the values: a term with no value counts 0.
function litTrue (asg :: KeyVal Text Integer) (l :: Literal) -> Bool is (valueIn asg l.text != 0) != l.negated end function

function truthAt (w :: Walk) (asg :: KeyVal Text Integer) (r :: Row) (line :: Integer) -> Bool is
  first matching case of readingAt w r line :
    when NotRead then false
    when ByFile v then v
    when ByTerm l then litTrue asg l
  end case
end function

function ownText (ls :: List Literal) -> Text is
  first matching case of prelude.at (prelude.length ls - 1) ls : when Present l then l.text when Absent then "" end case
end function

-- The number of builds, counted no further than `budget + 1`.
function countBuilds (rs :: List Row) (w :: Walk) (asg :: KeyVal Text Integer) (line :: Integer) (budget :: Integer) -> Integer is
  first matching case of rs :
    when Nil then 1
    when Cons r rest then
      (first matching case of readingAt w r line :
        when NotRead then countBuilds rest (after w r false) asg (line + 1) budget
        when ByFile v then countBuilds rest (after w r v) asg (line + 1) budget
        when ByTerm l then
          (if valued asg l.text then countBuilds rest (after w r (litTrue asg l)) asg (line + 1) budget
           else
             (let a = countBuilds rest (after w r (!l.negated)) (prelude.put l.text 1 asg) (line + 1) budget in
               (if a > budget then a
                else a + countBuilds rest (after w r l.negated) (prelude.put l.text 0 asg) (line + 1) (budget - a) end if) end let) end if)
      end case)
  end case
end function

function buildsFrom (rs :: List Row) (w :: Walk) (asg :: KeyVal Text Integer) (line :: Integer) -> List (KeyVal Text Integer) is
  first matching case of rs :
    when Nil then [asg]
    when Cons r rest then
      (first matching case of readingAt w r line :
        when NotRead then buildsFrom rest (after w r false) asg (line + 1)
        when ByFile v then buildsFrom rest (after w r v) asg (line + 1)
        when ByTerm l then
          (if valued asg l.text then buildsFrom rest (after w r (litTrue asg l)) asg (line + 1)
           else buildsFrom rest (after w r (!l.negated)) (prelude.put l.text 1 asg) (line + 1)
                  ++ buildsFrom rest (after w r l.negated) (prelude.put l.text 0 asg) (line + 1) end if)
      end case)
  end case
end function

-- The first build: every term it reads is true.
function firstBuild (rs :: List Row) (w :: Walk) (asg :: KeyVal Text Integer) (line :: Integer) -> KeyVal Text Integer is
  first matching case of rs :
    when Nil then asg
    when Cons r rest then
      (first matching case of readingAt w r line :
        when NotRead then firstBuild rest (after w r false) asg (line + 1)
        when ByFile v then firstBuild rest (after w r v) asg (line + 1)
        when ByTerm l then
          (if valued asg l.text then firstBuild rest (after w r (litTrue asg l)) asg (line + 1)
           else firstBuild rest (after w r (!l.negated)) (prelude.put l.text 1 asg) (line + 1) end if)
      end case)
  end case
end function

-- A build's copy: the source with every directive line, and every line
-- the walk does not keep under the build's values, made empty. No line
-- moves.
function copyFrom (rs :: List Row) (w :: Walk) (asg :: KeyVal Text Integer) (line :: Integer) -> Text is
  first matching case of rs :
    when Nil then ""
    when Cons r rest then blankIf (r.directive || !(liveOf w.stack)) r ++ copyFrom rest (after w r (truthAt w asg r line)) asg (line + 1)
  end case
end function

function copyOf (asg :: KeyVal Text Integer) (rs :: List Row) -> Text is copyFrom rs (startWalk unitValue) asg 1 end function

function copiesOf (rs :: List Row) (builds :: List (KeyVal Text Integer)) -> List Text is
  first matching case of builds : when Nil then [] when Cons b rest then [copyOf b rs] ++ copiesOf rs rest end case
end function

function hasGroup (rs :: List Row) -> Bool is
  first matching case of rs : when Nil then false when Cons r rest then r.reads || hasGroup rest end case
end function

function buildCount (rs :: List Row) -> Integer is countBuilds rs (startWalk unitValue) (prelude.keyValOf []) 1 (buildCap unitValue) end function

-- More builds than are read (`wp.buildCap`).
function overCapRows (rs :: List Row) -> Bool is buildCount rs > buildCap unitValue end function

-- The copies an extractor reads, in order: one per build. A source with
-- more builds than the cap is read in its first build alone. A source with
-- no conditional is its own single copy.
function copiesOfRows (rs :: List Row) -> List Text is
  if !(hasGroup rs) then [sourceOf rs]
  else (if overCapRows rs then [firstCopyOfRows rs]
  else copiesOf rs (buildsFrom rs (startWalk unitValue) (prelude.keyValOf []) 1) end if) end if
end function

-- The first build's copy.
function firstCopyOfRows (rs :: List Row) -> Text is copyOf (firstBuild rs (startWalk unitValue) (prelude.keyValOf []) 1) rs end function

function copies (ss :: List Section) -> List Text is copiesOfRows (rowsOf ss) end function

function overCap (ss :: List Section) -> Bool is overCapRows (rowsOf ss) end function

function firstCopy (ss :: List Section) -> Text is firstCopyOfRows (rowsOf ss) end function

-- ---------------------------------------------------------------------------
-- The builds with no rule of choice at all (next cycle 6; review 8, B1).
-- Rule C2 above says which terms are choices, and it was wrong twice in
-- what it took for a choice. This reference has no such notion. It takes
-- EVERY assignment of a value to every term of the source (2^k of them)
-- and, under each, walks the source as the preprocessor does: a directive
-- that is reached is evaluated, and nothing else is. What it evaluated, in
-- the order met, is the assignment's TRACE. Two assignments with one trace
-- keep the same lines; the builds are the distinct traces. They are put in
-- order by the values in the order met, true before false (two traces that
-- agree so far meet the same directive next, so no trace is the start of
-- another). Rule C2 must give exactly these copies, in this order: HCP-4,
-- and HSC-1 for the extractor. Only for sources of few terms: 2^k.
--
-- Next cycle 7: the terms are every reading line's own, and for a line
-- the file's definitions might reach and not decide, the term of that
-- line (`wp.fileDefinedTerm`). "Might" is read off the source with no
-- walk: the line reads a name some line of the source sets, and is not a
-- bare `N` or `defined(N)` that a definition always decides. A term no
-- walk meets doubles the assignments and adds no trace.

function withValue (t :: Text) (v :: Integer) (as :: List (KeyVal Text Integer)) -> List (KeyVal Text Integer) is
  first matching case of as : when Nil then [] when Cons a rest then [prelude.put t v a] ++ withValue t v rest end case
end function

-- Every assignment of the terms.
function assignments (ts :: List Text) -> List (KeyVal Text Integer) is
  first matching case of ts :
    when Nil then [prelude.keyValOf []]
    when Cons t rest then withValue t 1 (assignments rest) ++ withValue t 0 (assignments rest)
  end case
end function

function valueIn (full :: KeyVal Text Integer) (t :: Text) -> Integer is
  first matching case of prelude.lookup t full : when Present v then v when Absent then 0 end case
end function

-- The names some line of the source sets; `other`: only those a line
-- defines with no integer body.
function setNames (rs :: List Row) (onlyOther :: Bool) -> List Text is
  first matching case of rs :
    when Nil then []
    when Cons r rest then
      (if (if onlyOther then r.sets matches SetsOther else !(r.sets matches SetsNothing) end if) then [r.name] else [] end if) ++ setNames rest onlyOther
  end case
end function

function inNames (ns :: List Text) (n :: Text) -> Bool is ns contains n end function

function mayStayOpen (setBy :: List Text) (otherBy :: List Text) (l :: Literal) -> Bool is
  prelude.any (inNames setBy) (namesOf l.expr)
    && !(first matching case of l.expr :
           when Name n then !(special n) && !(otherBy contains n)
           when IsDefined n then !(special n)
           otherwise false
         end case)
end function

function addTerm (t :: Text) (seen :: List Text) -> List Text is
  if prelude.length t = 0 || (seen contains t) then seen else seen ++ [t] end if
end function

function termsFrom (rs :: List Row) (setBy :: List Text) (otherBy :: List Text) (line :: Integer) (seen :: List Text) -> List Text is
  first matching case of rs :
    when Nil then seen
    when Cons r rest then
      termsFrom rest setBy otherBy (line + 1)
        (first matching case of ownLit r :
          when Absent then seen
          when Present l then
            (if r.reads then addTerm (if mayStayOpen setBy otherBy l then wp.fileDefinedTerm line else "" end if) (addTerm l.text seen) else seen end if)
        end case)
  end case
end function

-- The terms, each once, in the order they first stand in the source. No
-- rule of the builds reads this order: it only names the terms.
function termsIn (rs :: List Row) (seen :: List Text) -> List Text is termsFrom rs (setNames rs false) (setNames rs true) 1 seen end function

-- What the preprocessor evaluates under a full assignment: the values of
-- the terms of the directives it reaches and the file does not decide, in
-- the order it first meets them.
function traceFrom (rs :: List Row) (w :: Walk) (full :: KeyVal Text Integer) (line :: Integer) (seen :: List Text) -> List Integer is
  first matching case of rs :
    when Nil then []
    when Cons r rest then
      (first matching case of readingAt w r line :
        when NotRead then traceFrom rest (after w r false) full (line + 1) seen
        when ByFile v then traceFrom rest (after w r v) full (line + 1) seen
        when ByTerm l then
          (if seen contains l.text then traceFrom rest (after w r (litTrue full l)) full (line + 1) seen
           else [valueIn full l.text] ++ traceFrom rest (after w r (litTrue full l)) full (line + 1) (seen ++ [l.text]) end if)
      end case)
  end case
end function

type Walked is a record{
  trace :: List Integer
  copy :: Text}
end type

-- `a` stands before `b`: where they first differ, `a` has the true value.
function traceBefore (a :: List Integer) (b :: List Integer) -> Bool is
  first matching case of a :
    when Nil then false
    when Cons x xs then
      (first matching case of b :
        when Nil then false
        when Cons y ys then (if x = y then traceBefore xs ys else x > y end if)
      end case)
  end case
end function

function insertWalked (w :: Walked) (ws :: List Walked) -> List Walked is
  first matching case of ws :
    when Nil then [w]
    when Cons h rest then
      (if h.trace = w.trace then ws else (if traceBefore w.trace h.trace then [w] ++ ws else [h] ++ insertWalked w rest end if) end if)
  end case
end function

function walkedAll (rs :: List Row) (fulls :: List (KeyVal Text Integer)) (acc :: List Walked) -> List Walked is
  first matching case of fulls :
    when Nil then acc
    when Cons f rest then
      walkedAll rs rest (insertWalked (Walked record{ trace = traceFrom rs (startWalk unitValue) f 1 [] , copy = copyOf f rs}) acc)
  end case
end function

function copiesOfWalked (ws :: List Walked) -> List Text is
  first matching case of ws : when Nil then [] when Cons w rest then [w.copy] ++ copiesOfWalked rest end case
end function

-- The copies of every build, in the builds' order, by every assignment.
function everyCopies (rs :: List Row) -> List Text is
  if !(hasGroup rs) then [sourceOf rs] else copiesOfWalked (walkedAll rs (assignments (termsIn rs [])) []) end if
end function

-- ---------------------------------------------------------------------------
-- Cycle 4's rule C2, kept only so that the harness can say how often a
-- drawn module is one it gets wrong (next cycle 7; review 9, N5). The
-- terms in the order they first stand; a term is a choice when, under the
-- values chosen so far, some directive that reads it has a path that
-- holds. It knows no walk and no definition.

function litHolds (asg :: KeyVal Text Integer) (l :: Literal) -> Bool is
  first matching case of prelude.lookup l.text asg :
    when Present v then (v != 0) != l.negated
    when Absent then false
  end case
end function

function allHold (asg :: KeyVal Text Integer) (ls :: List Literal) -> Bool is prelude.all (litHolds asg) ls end function

function oldReadAt (rs :: List Row) (asg :: KeyVal Text Integer) (t :: Text) -> Bool is
  first matching case of rs :
    when Nil then false
    when Cons r rest then (r.reads && ownText r.terms = t && allHold asg (prelude.take (prelude.length r.terms - 1) r.terms)) || oldReadAt rest asg t
  end case
end function

function oldBuilds (rs :: List Row) (ts :: List Text) (asg :: KeyVal Text Integer) -> List (KeyVal Text Integer) is
  first matching case of ts :
    when Nil then [asg]
    when Cons t rest then
      (if oldReadAt rs asg t then oldBuilds rs rest (prelude.put t 1 asg) ++ oldBuilds rs rest (prelude.put t 0 asg)
       else oldBuilds rs rest asg end if)
  end case
end function

function oldCopy (asg :: KeyVal Text Integer) (rs :: List Row) -> Text is
  first matching case of rs :
    when Nil then ""
    when Cons r rest then blankIf (r.directive || !(allHold asg r.terms)) r ++ oldCopy asg rest
  end case
end function

function oldCopiesOf (rs :: List Row) (builds :: List (KeyVal Text Integer)) -> List Text is
  first matching case of builds : when Nil then [] when Cons b rest then [oldCopy b rs] ++ oldCopiesOf rs rest end case
end function

function ownTexts (rs :: List Row) (seen :: List Text) -> List Text is
  first matching case of rs :
    when Nil then seen
    when Cons r rest then ownTexts rest (if r.reads then addTerm (ownText r.terms) seen else seen end if)
  end case
end function

function oldCopies (rs :: List Row) -> List Text is oldCopiesOf rs (oldBuilds rs (ownTexts rs []) (prelude.keyValOf [])) end function

-- ---------------------------------------------------------------------------
-- Conditions as text (rule C7; the writer is `wp.conditionText`).

-- A path's condition: one cube.
function conditionText (ts :: List Literal) -> Text is wp.conditionText [ts] end function

function conditionAt (rs :: List Row) (line :: Integer) -> Text is
  first matching case of prelude.at (line - 1) rs : when Present r then conditionText r.terms when Absent then "" end case
end function

function edgesAt (t :: Text) (es :: List CallEdge) -> List CallEdge is
  first matching case of es : when Nil then [] when Cons e rest then [e with condition = t] ++ edgesAt t rest end case
end function

function declsAt (rs :: List Row) (ds :: List Decl) -> List Decl is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      [d with condition = conditionAt rs d.location.line , calls = edgesAt (conditionAt rs d.location.line) d.calls] ++ declsAt rs rest
  end case
end function

function packagesAt (rs :: List Row) (ps :: List Package) -> List Package is
  first matching case of ps : when Nil then [] when Cons p rest then [p with symbols = declsAt rs p.symbols] ++ packagesAt rs rest end case
end function

-- The extraction of `allArms`, each symbol and each of its edges given the
-- condition of the line the symbol starts on. In the first model a fact's
-- builds are exactly those of its line's path, so this is its condition.
function conditioned (ss :: List Section) (ps :: List Package) -> List Package is packagesAt (rowsOf ss) ps end function

function unreadDecls (ds :: List Decl) -> List Decl is
  first matching case of ds :
    when Nil then []
    when Cons d rest then [d with condition = unreadText unitValue , calls = edgesAt (unreadText unitValue) d.calls] ++ unreadDecls rest
  end case
end function

-- What a source with more builds than the cap gives: the extraction of its
-- first build, every symbol and edge with the text that is never decided.
function unread (ps :: List Package) -> List Package is
  first matching case of ps : when Nil then [] when Cons p rest then [p with symbols = unreadDecls p.symbols] ++ unread rest end case
end function

-- ---------------------------------------------------------------------------
-- One environment's build.

function termHolds (env :: Env) (t :: Literal) -> Bool is
  first matching case of refEval env t.expr :
    when Known v then (v != 0) != t.negated
    when Unknown u then false
    when Bad then false
  end case
end function

-- The text by the written paths: a line stands when every literal of its
-- path holds under the environment. Right for a source with no `#define`
-- and no `#undef` (cycle 6's `buildText`); HCP-1 holds it equal to the
-- simulation below on the first and the second model.
function pathBuildText (env :: Env) (rs :: List Row) -> Text is
  first matching case of rs :
    when Nil then ""
    when Cons r rest then blankIf (r.directive || !(prelude.all (termHolds env) r.terms)) r ++ pathBuildText env rest
  end case
end function

-- Next cycle 7 (review 9, B2): the preprocessor itself, with its macro
-- table. It starts from the environment; a `#define` or `#undef` line it
-- keeps changes the table for the lines after it; a directive it reaches
-- is evaluated under the table as it then is. No term, no choice and no
-- rule about which directives the file decides is in it: this is what
-- rules C2 and C8 are held against (HCP-1, HSC-8, HSC-12, HSX-42).
-- (`#define N` with no integer body is `Defined 1` here: right for
-- `defined(N)`. Where such a name is read as a value the preprocessor
-- stops with an error, and the build has no text to compare. A name of
-- the kind `special` cannot be given to an environment this way, and no
-- source held against this function defines one. Next cycle 8 (review
-- 10, B2): this function blanks lines and does nothing else. It does not
-- replace a macro in a line of code, does not read a C comment on a line
-- of code, and gives a special name the evaluator's meaning. It is the
-- preprocessor only for the first three models, whose code lines name no
-- macro and open no comment; `ran`, below, is the preprocessor for the
-- rest, and HCP-8 holds the two equal on the third model.)
function tableAfter (env :: Env) (r :: Row) -> Env is
  first matching case of r.sets :
    when SetsNothing then env
    when SetsInt v then env with names = prelude.put r.name (wp.definedAs v) env.names
    when SetsOther then env with names = prelude.put r.name (wp.definedAs 1) env.names
    when Unsets then env with names = prelude.put r.name (wp.notDefined unitValue) env.names
  end case
end function

function ownHolds (env :: Env) (r :: Row) -> Bool is
  first matching case of ownLit r : when Present l then termHolds env l when Absent then false end case
end function

function simulated (env :: Env) (stack :: List Frame) (rs :: List Row) -> Text is
  first matching case of rs :
    when Nil then ""
    when Cons r rest then
      blankIf (r.directive || !(liveOf stack)) r
        ++ simulated (if liveOf stack then tableAfter env r else env end if) (stepped stack r (reachedIn stack r && ownHolds env r)) rest
  end case
end function

function buildText (env :: Env) (rs :: List Row) -> Text is simulated env [] rs end function

-- What the preprocessor leaves under a complete environment, line numbers
-- kept.
function buildOf (env :: Env) (ss :: List Section) -> Text is buildText env (rowsOf ss) end function

-- ---------------------------------------------------------------------------
-- Drawn values.

function leafOf (seed :: Integer) -> Leaf is
  Leaf record{ forms = (if pick seed 1 2 = 0 then [pick seed 2 5] else [pick seed 2 5, pick seed 3 5] end if) , hasElse = pick seed 4 2 = 0}
end function

function innersOf (seed :: Integer) (n :: Integer) -> List Inner is
  if n <= 0 then [] else [(if pick seed (10 + n) 3 = 0 then InGroup (leafOf (mix seed (20 + n))) else InCode end if)] ++ innersOf seed (n - 1) end if
end function

function armsOf (seed :: Integer) (n :: Integer) -> List Arm is
  if n <= 0 then [] else [Arm record{ form = pick seed (30 + n) 5 , body = innersOf (mix seed (40 + n)) (pick seed (50 + n) 3)}] ++ armsOf seed (n - 1) end if
end function

function sectionsOf (seed :: Integer) (n :: Integer) -> List Section is
  if n <= 0 then [] else
    [(if pick seed (60 + n) 4 = 0 then Code
      else Group record{ arms = armsOf (mix seed (70 + n)) (1 + pick seed (80 + n) 3) , hasElse = pick seed (90 + n) 2 = 0 ,
                         elseBody = innersOf (mix seed (100 + n)) (pick seed (110 + n) 3)} end if)] ++ sectionsOf seed (n - 1)
  end if
end function

-- A module of up to four sections.
function moduleOf (seed :: Integer) -> List Section is sectionsOf seed (pick seed 120 5) end function

function bindRows (seed :: Integer) (rs :: List Row) (k :: Integer) (acc :: KeyVal Text Binding) -> KeyVal Text Binding is
  first matching case of rs :
    when Nil then acc
    when Cons r rest then
      bindRows seed rest (k + 1)
        (if r.reads then
          (let c0 = pick seed (200 + k) 4 in
            (if c0 = 0 then acc else prelude.put r.name (wp.definedAs (c0 - 1)) acc end if) end let)
         else acc end if)
  end case
end function

function envOfRows (seed :: Integer) (rs :: List Row) -> Env is
  completed ((emptyEnv unitValue) with names = bindRows seed rs 0 (prelude.keyValOf []))
end function

-- A complete environment over the module's names: each is undefined, 0, 1
-- or 2.
function buildEnv (seed :: Integer) (ss :: List Section) -> Env is envOfRows seed (rowsOf ss) end function

-- ---------------------------------------------------------------------------
-- The second model (cycle 4; review 7, B1): a module whose facts depend on
-- one another across groups, as real sources do. Its conditions test three
-- names in four forms, so that two groups often share a term, or have
-- opposite ones (`#ifdef P` and `#ifndef P`).
--
--   {-# LANGUAGE CPP #-}
--   module M
--     ( d1
--   [#if ..]              the export of d2, in a group or not
--     , d2
--   [#endif]
--     , d3
--     ) where
--   two import pieces     `foo1` and `foo2`: from one module; from one of
--                         two, by a group; or from one, in a group with no
--                         `#else`
--   v0 x = x
--   three declarations    d1, d2, d3, each calling an imported name:
--     0  d = foo 1                        a plain value
--     1  d = foo 1 / #if / + v0 1 / #else / + foo' 2 / #endif
--                                         its tail in a group, with `#else`
--     2  d = foo 1 / #if / + v0 1 / #endif   its tail in a group
--     3  #if / d = foo 2 / #endif         whole, in a group
--     4  #if / d x = foo x / #if / + v0 x / #endif / #endif
--                                         whole in a group, its tail in a
--                                         nested one (the optional-
--                                         dependency idiom)
--     5  #if / d :: Int / #else / d :: Integer / #endif / d = foo 3
--                                         a signature in each arm
--     6  d x = / #if / foo x / #else / v0 x / #endif / + g x / where /
--        #if / g = foo1 / #else / g = foo2 / #endif
--                                         two groups in one declaration
--
-- Every build of such a module is a module that parses.

function poolName (i :: Integer) -> Text is
  first matching case of i : when 0 then "P" when 1 then "Q" otherwise "R" end case
end function

-- Forms 0, 1, 2 and 4 of `termOf`: the terms are `N` and `defined(N)`.
function poolForm (i :: Integer) -> Integer is
  first matching case of i : when 0 then 0 when 1 then 1 when 2 then 2 otherwise 4 end case
end function

-- A group with one written arm: its directive, the lines of the arm, and
-- the lines of its `#else` (none: no `#else` is written).
function oneGroup (outer :: List Literal) (form :: Integer) (n :: Text) (yes :: List Text) (hasElse :: Bool) (no :: List Text) -> List Row is
  let own = termOf true form n in
    [opener (directiveOf true form n) (outer ++ [own]) n] ++ codeRows yes (outer ++ [own])
      ++ (if hasElse then [row "#else" (outer ++ [negate own]) true] ++ codeRows no (outer ++ [negate own]) ++ [row "#endif" outer true]
          else [row "#endif" (outer ++ [negate own]) true] end if)
  end let
end function

function codeRows (lines :: List Text) (terms :: List Literal) -> List Row is
  first matching case of lines : when Nil then [] when Cons l rest then [row l terms false] ++ codeRows rest terms end case
end function

function tangleForm (seed :: Integer) (k :: Integer) -> Integer is poolForm (pick seed (500 + k) 4) end function
function tangleName (seed :: Integer) (k :: Integer) -> Text is poolName (pick seed (520 + k) 3) end function

function importRows (seed :: Integer) (i :: Integer) -> List Row is
  let n = prelude.textOf i in let kind = pick seed (540 + i) 3 in
    (if kind = 0 then codeRows ["import X" ++ n ++ " (foo" ++ n ++ ")"] []
     else oneGroup [] (tangleForm seed i) (tangleName seed i) ["import X" ++ n ++ " (foo" ++ n ++ ")"] (kind = 1) ["import Y" ++ n ++ " (foo" ++ n ++ ")"] end if)
  end let end let
end function

function fooOf (seed :: Integer) (k :: Integer) -> Text is if pick seed (560 + k) 2 = 0 then "foo1" else "foo2" end if end function

function declRows (seed :: Integer) (j :: Integer) -> List Row is
  let d = "d" ++ prelude.textOf j in let foo = fooOf seed j in let kind = pick seed (580 + j) 7 in
  let f1 = tangleForm seed (10 + j) in let n1 = tangleName seed (10 + j) in
  let f2 = tangleForm seed (20 + j) in let n2 = tangleName seed (20 + j) in
    (if kind = 0 then codeRows [d ++ " = " ++ foo ++ " 1"] []
     else (if kind = 1 then codeRows [d ++ " = " ++ foo ++ " 1"] [] ++ oneGroup [] f1 n1 ["  + v0 1"] true ["  + " ++ fooOf seed (30 + j) ++ " 2"]
     else (if kind = 2 then codeRows [d ++ " = " ++ foo ++ " 1"] [] ++ oneGroup [] f1 n1 ["  + v0 1"] false []
     else (if kind = 3 then oneGroup [] f1 n1 [d ++ " = " ++ foo ++ " 2"] false []
     else (if kind = 4 then
       (let own = termOf true f1 n1 in
         [opener (directiveOf true f1 n1) [own] n1] ++ codeRows [d ++ " x = " ++ foo ++ " x"] [own]
           ++ oneGroup [own] f2 n2 ["  + v0 x"] false [] ++ [row "#endif" [negate own] true] end let)
     else (if kind = 5 then oneGroup [] f1 n1 [d ++ " :: Int"] true [d ++ " :: Integer"] ++ codeRows [d ++ " = " ++ foo ++ " 3"] []
     else codeRows [d ++ " x ="] [] ++ oneGroup [] f1 n1 ["  " ++ foo ++ " x"] true ["  v0 x"] ++ codeRows ["  + g x", "  where"] []
            ++ oneGroup [] f2 n2 ["    g = foo1"] true ["    g = foo2"] end if) end if) end if) end if) end if) end if)
  end let end let end let end let end let end let end let
end function

function exportRows (seed :: Integer) -> List Row is
  codeRows ["module M", "  ( d1"] []
    ++ (if pick seed 600 2 = 0 then codeRows ["  , d2"] [] else oneGroup [] (tangleForm seed 0) (tangleName seed 0) ["  , d2"] false [] end if)
    ++ codeRows ["  , d3", "  ) where"] []
end function

-- A module of the second model, as its lines.
function tangle (seed :: Integer) -> List Row is
  codeRows ["{-# LANGUAGE CPP #-}"] [] ++ exportRows seed ++ importRows seed 1 ++ importRows seed 2 ++ codeRows ["v0 x = x"] []
    ++ declRows seed 1 ++ declRows seed 2 ++ declRows seed 3
end function

function poolBinding (seed :: Integer) (k :: Integer) (acc :: KeyVal Text Binding) -> KeyVal Text Binding is
  let c0 = pick seed (620 + k) 4 in (if c0 = 0 then acc else prelude.put (poolName k) (wp.definedAs (c0 - 1)) acc end if) end let
end function

-- A complete environment over the second model's three names: each is
-- undefined, 0, 1 or 2.
function tangleEnv (seed :: Integer) -> Env is
  completed ((emptyEnv unitValue) with names = poolBinding seed 0 (poolBinding seed 1 (poolBinding seed 2 (prelude.keyValOf []))))
end function

-- Every complete environment over the three names, by its number 0 to 63:
-- each name is undefined, 0, 1 or 2.
function poolState (n :: Text) (c0 :: Integer) (acc :: KeyVal Text Binding) -> KeyVal Text Binding is
  if c0 = 0 then acc else prelude.put n (wp.definedAs (c0 - 1)) acc end if
end function

function poolEnvAt (i :: Integer) -> Env is
  completed ((emptyEnv unitValue) with names =
    poolState "P" (prelude.rem i 4) (poolState "Q" (prelude.rem (prelude.quot i 4) 4) (poolState "R" (prelude.rem (prelude.quot i 16) 4) (prelude.keyValOf []))))
end function

-- ---------------------------------------------------------------------------
-- The third model (next cycle 6; review 8, B1): free nesting. The second
-- model is a list of shapes someone thought of, and review 8's shape was
-- not among them. This one draws the STRUCTURE: groups of one to three
-- written arms (`#if`, `#ifdef` or `#ifndef`, then `#elif N` or `#elif
-- defined(N)`), with or without `#else`, nested to three levels, every
-- condition over the same three names. So a term recurs anywhere: under a
-- guard that first stands after it, in a later arm of a group whose first
-- arm nests it, in an `#elif` of its own group (an arm in no build).
--
--   {-# LANGUAGE CPP #-}
--   module M where
--   the import of `foo1`      as the second model's: plain, chosen by a
--                             group, or in one arm only
--   import Z (bar)
--   v0 x = x
--   three sections, each one of
--     a tree of groups whose arms hold whole declarations
--                             `w<place> = foo1 <place>` or `.. = bar ..`
--     `t<i> :: Int`, `t<i> = foo1 <i>`, and a tree of groups whose arms
--     hold tails of it        `  + bar <place>`, `  + foo1 <place>` or
--                             `  + <place>`
--   z = bar 0
--
-- An arm holds its lines, or nothing, and then perhaps a nested group. At
-- most six terms (`N` and `defined(N)` of three names): at most 64 builds.
-- Every build is a module that parses.
--
-- Next cycle 7 (review 9, B2 and S2). Half the modules (`weaveNew`) are
-- cycle 6's, line for line. In the other half a later arm may be written
-- `#elifdef N` or `#elifndef N`, and one arm in three, and one section in
-- four before its first line, holds a definition of one of the three
-- names: `#define N 1`, `#define N 0`, `#define N 2` or `#undef N`. So a
-- directive on N after it, on the walks that keep the definition, is
-- decided by the file, and on the other walks by the environment; a
-- definition stands under any nesting, and under terms it later decides.
-- Every directive reads one name, so the file's definitions decide every
-- directive that reads a name they set: no term of `wp.fileDefinedTerm`
-- arises, and the terms are still at most six.

function weaveNew (seed :: Integer) -> Bool is pick seed 9700 2 = 1 end function

function setText (n :: Text) (k :: Integer) -> Text is
  if k = 0 then "#define " ++ n ++ " 1" else (if k = 1 then "#define " ++ n ++ " 0" else (if k = 2 then "#undef " ++ n else "#define " ++ n ++ " 2" end if) end if) end if
end function

function setKind (k :: Integer) -> Sets is
  if k = 0 then SetsInt 1 else (if k = 1 then SetsInt 0 else (if k = 2 then Unsets else SetsInt 2 end if) end if) end if
end function

-- The definition at a place (an arm, or a section's start), or none.
function weaveSets (seed :: Integer) (place :: Integer) (odds :: Integer) (path :: List Literal) -> List Row is
  if weaveNew seed && pick seed (10700 + place) odds = 0
  then [definer (setText (poolName (pick seed (11700 + place) 3)) (pick seed (12700 + place) 4)) path (poolName (pick seed (11700 + place) 3)) (setKind (pick seed (12700 + place) 4))]
  else [] end if
end function

function weaveName (seed :: Integer) (place :: Integer) -> Text is poolName (pick seed (700 + place) 3) end function

-- A first arm's form: 0 `#if N`, 1 `#ifdef N`, 2 `#ifndef N`. A later
-- arm's: 0 `#elif N`, 1 `#elif defined(N)`.
function weaveForm (seed :: Integer) (place :: Integer) (first :: Bool) -> Integer is
  if first then pick seed (1700 + place) 3
  else (if weaveNew seed then (let k = pick seed (1700 + place) 4 in (if k = 2 then 5 else (if k = 3 then 6 else k end if) end if) end let)
  else pick seed (1700 + place) 2 end if) end if
end function

function leafLines (seed :: Integer) (tail :: Bool) (place :: Integer) -> List Text is
  let n = prelude.textOf place in let k = pick seed (2700 + place) 3 in
    (if tail then [(if k = 0 then "  + bar " ++ n else (if k = 1 then "  + foo1 " ++ n else "  + " ++ n end if) end if)]
     else [(if k = 0 then "w" ++ n ++ " = bar " ++ n else "w" ++ n ++ " = foo1 " ++ n end if)] end if)
  end let end let
end function

-- The arms of one group still to write, and its end. `group` is the
-- group's place, `k` the next arm's number, `left` the arms still to
-- write, `outer` the path the group stands in, `before` the negations of
-- its arms already written. Every call takes one from `fuel`.
function weaveArms (seed :: Integer) (group :: Integer) (outer :: List Literal) (before :: List Literal) (k :: Integer) (left :: Integer)
                   (depth :: Integer) (tail :: Bool) (fuel :: Integer) -> List Row is
  if fuel <= 0 then [row "#endif" outer true]
  else (if left <= 0 then
    (if pick seed (3700 + group) 2 = 0
     then [row "#else" (outer ++ before) true] ++ codeRows (leafLines seed tail (group * 10 + 9)) (outer ++ before) ++ [row "#endif" outer true]
     else [row "#endif" outer true] end if)
  else
    (let place = group * 10 + k in let n = weaveName seed place in let form = weaveForm seed place (k = 0) in
     let own = termOf (k = 0) form n in let path = outer ++ before ++ [own] in
      [opener (directiveOf (k = 0) form n) path n]
        ++ weaveSets seed place 3 path
        ++ (if pick seed (4700 + place) 4 = 0 then [] else codeRows (leafLines seed tail place) path end if)
        ++ (if depth > 0 && pick seed (5700 + place) 2 = 0
            then weaveArms seed place path [] 0 (1 + pick seed (6700 + place) 2) (depth - 1) tail (fuel - 1) else [] end if)
        ++ weaveArms seed group outer (before ++ [negate own]) (k + 1) (left - 1) depth tail (fuel - 1)
     end let end let end let end let end let) end if) end if
end function

function weaveSection (seed :: Integer) (i :: Integer) -> List Row is
  let tail = pick seed (7700 + i) 2 = 0 in let n = prelude.textOf i in
    weaveSets seed (9000 + i) 4 []
      ++ (if tail then codeRows ["t" ++ n ++ " :: Int", "t" ++ n ++ " = foo1 " ++ n] [] else [] end if)
      ++ weaveArms seed i [] [] 0 (1 + pick seed (8700 + i) 3) 2 tail 16
  end let end let
end function

-- A module of the third model, as its lines.
function weave (seed :: Integer) -> List Row is
  codeRows ["{-# LANGUAGE CPP #-}", "module M where"] [] ++ importRows seed 1 ++ codeRows ["import Z (bar)", "v0 x = x"] []
    ++ weaveSection seed 1 ++ weaveSection seed 2 ++ weaveSection seed 3 ++ codeRows ["z = bar 0"] []
end function

-- ---------------------------------------------------------------------------
-- Review 8's three sources (B2, B3 and B5 of docs/contributions/S1.j/review-haskell-8.md), as rows.

-- `#if N`, a group on B inside it, `#endif`.
function under (n :: Text) (form :: Integer) (yes :: List Text) (hasElse :: Bool) (no :: List Text) -> List Row is
  let own = termOf true 0 n in
    [opener ("#if " ++ n) [own] n] ++ oneGroup [own] form "B" yes hasElse no ++ [row "#endif" [negate own] true]
  end let
end function

-- (c): `#if P` / `#if B` / a / `#endif` / `#elif Q` / q / `#elif B` / b / `#endif`.
function reproElif (u :: Unit) -> List Row is
  let p = termOf true 0 "P" in let q = termOf false 0 "Q" in let b = termOf false 0 "B" in
    codeRows ["{-# LANGUAGE CPP #-}", "module M where"] []
      ++ [opener "#if P" [p] "P"] ++ oneGroup [p] 0 "B" ["a = 1"] false []
      ++ [opener "#elif Q" [negate p, q] "Q"] ++ codeRows ["q = 0"] [negate p, q]
      ++ [opener "#elif B" [negate p, negate q, b] "B"] ++ codeRows ["b = 2"] [negate p, negate q, b]
      ++ [row "#endif" [negate p, negate q, negate b] true] ++ codeRows ["c = 3"] []
  end let end let end let
end function

-- (b): `#ifdef B` under `#if P`, and again under `#if Q`.
function reproLost (u :: Unit) -> List Row is
  codeRows ["{-# LANGUAGE CPP #-}", "module M where"] [] ++ under "P" 1 ["a = 1"] false [] ++ under "Q" 1 ["b = 2"] false [] ++ codeRows ["c = 3"] []
end function

-- (a): the second `#ifdef B` holds the tail of `f`.
function reproTail (u :: Unit) -> List Row is
  codeRows ["{-# LANGUAGE CPP #-}", "module M where", "import Z (bar)"] [] ++ under "P" 1 ["x = 1"] false []
    ++ codeRows ["f :: Int", "f = 1"] [] ++ under "Q" 1 ["  + bar 2"] true ["  + 3"]
end function

-- ---------------------------------------------------------------------------
-- Next cycle 7 (review 9, B2 and S2): sources with a `#define`, an
-- `#undef`, `#elifdef` and `#elifndef`, as rows. The texts are
-- next-cycle-7/repros/*.hs.

-- One written arm on a term given whole: its directive, its lines, `#endif`.
function oneArm (own :: Literal) (directive :: Text) (name :: Text) (yes :: List Text) -> List Row is
  [opener directive [own] name] ++ codeRows yes [own] ++ [row "#endif" [negate own] true]
end function

function baseAtLeast48 (u :: Unit) -> Literal is
  Literal record{ negated = false , text = "MIN_VERSION_base(4,8,0)" , expr = MinVersion record{ pkg = "base" , major1 = Lit 4 , major2 = Lit 8 , minor = Lit 0}}
end function

-- Review 9, B2 (`define.hs`): `#define HAS_VOID 1` under a version test,
-- then `#ifdef HAS_VOID`.
function reproDefine (u :: Unit) -> List Row is
  let mv = baseAtLeast48 unitValue in
    codeRows ["{-# LANGUAGE CPP #-}", "module M where"] []
      ++ [opener "#if MIN_VERSION_base(4,8,0)" [mv] "MIN_VERSION_base", definer "#define HAS_VOID 1" [mv] "HAS_VOID" (SetsInt 1), row "#endif" [negate mv] true]
      ++ oneGroup [] 1 "HAS_VOID" ["import Data.Void (absurd)", "f = absurd"] false []
      ++ codeRows ["g :: Int", "g = 1"] []
  end let
end function

-- The include-guard idiom (`guard.hs`): a default for a name the build
-- may give.
function reproGuard (u :: Unit) -> List Row is
  let nd = termOf true 2 "LIMIT" in
    codeRows ["{-# LANGUAGE CPP #-}", "module M where"] []
      ++ [opener "#ifndef LIMIT" [nd] "LIMIT", definer "#define LIMIT 1" [nd] "LIMIT" (SetsInt 1), row "#endif" [negate nd] true]
      ++ oneGroup [] 0 "LIMIT" ["a = 1"] true ["b = 2"]
      ++ oneGroup [] 1 "LIMIT" ["c = 3"] false []
  end let
end function

function sixteenAndDefined (u :: Unit) -> Literal is
  Literal record{ negated = false , text = "N == 16 && defined(N)" ,
                  expr = Bin record{ op = BLand , left = Bin record{ op = BEq , left = Name "N" , right = Lit 16} , right = IsDefined "N"}}
end function

-- `defs.hs`: a definition with no body, an `#undef` under `#else`, a
-- hexadecimal body with a comment, an `#undef` of a name the file defined.
function reproDefs (u :: Unit) -> List Row is
  let a = termOf true 0 "A" in
    codeRows ["{-# LANGUAGE CPP #-}", "module M where"] []
      ++ [opener "#if A" [a] "A", definer "#define HAS_X" [a] "HAS_X" SetsOther, row "#else" [negate a] true,
          definer "#undef HAS_Y" [negate a] "HAS_Y" Unsets, row "#endif" [] true]
      ++ oneGroup [] 1 "HAS_X" ["a = 1"] false []
      ++ oneGroup [] 2 "HAS_Y" ["b = 2"] false []
      ++ oneGroup [] 1 "HAS_Y" ["c = 3"] false []
      ++ [definer "#define N 0x10 /* sixteen */" [] "N" (SetsInt 16)]
      ++ oneArm (sixteenAndDefined unitValue) "#if N == 16 && defined(N)" "N" ["d = 4"]
      ++ [definer "#undef N" [] "N" Unsets]
      ++ oneGroup [] 0 "N" ["e = 5"] true ["f = 6"]
  end let
end function

function hasAndFoo (u :: Unit) -> Literal is
  Literal record{ negated = false , text = "HAS && FOO" , expr = Bin record{ op = BLand , left = Name "HAS" , right = Name "FOO"}}
end function

-- `undecided.hs`: three directives the file reaches and does not decide: a
-- name of the file beside a name of the environment; a name defined with
-- no body, read as a value; a version macro the file defines itself where
-- the build has none.
function reproUndecided (u :: Unit) -> List Row is
  let nd = termOf true 2 "MIN_VERSION_base" in
    codeRows ["{-# LANGUAGE CPP #-}", "module M where"] []
      ++ [definer "#define HAS 1" [] "HAS" (SetsInt 1)]
      ++ oneArm (hasAndFoo unitValue) "#if HAS && FOO" "HAS" ["a = 1"]
      ++ [definer "#define EMPTY" [] "EMPTY" SetsOther]
      ++ oneGroup [] 0 "EMPTY" ["b = 2"] false []
      ++ [opener "#ifndef MIN_VERSION_base" [nd] "MIN_VERSION_base",
          definer "#define MIN_VERSION_base(x,y,z) 1" [nd] "MIN_VERSION_base" SetsOther, row "#endif" [negate nd] true]
      ++ oneArm (baseAtLeast48 unitValue) "#if MIN_VERSION_base(4,8,0)" "MIN_VERSION_base" ["c = 3"]
      ++ codeRows ["d = 4"] []
  end let
end function

-- Review 9, S2 (`elifdef.hs`).
function reproElifdef (u :: Unit) -> List Row is
  let a = termOf true 0 "A" in let b = termOf false 5 "B" in let d = termOf false 6 "C" in
    codeRows ["{-# LANGUAGE CPP #-}", "module M where"] []
      ++ [opener "#if A" [a] "A"] ++ codeRows ["f = 1"] [a]
      ++ [opener (directiveOf false 5 "B") [negate a, b] "B"] ++ codeRows ["g = 2"] [negate a, b]
      ++ [opener (directiveOf false 6 "C") [negate a, negate b, d] "C"] ++ codeRows ["h = 3"] [negate a, negate b, d]
      ++ [row "#else" [negate a, negate b, negate d] true] ++ codeRows ["k = 4"] [negate a, negate b, negate d] ++ [row "#endif" [] true]
  end let end let end let
end function

function reproDefineCopies (u :: Unit) -> List Text is
  ["{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\nimport Data.Void (absurd)\nf = absurd\n\ng :: Int\ng = 1\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\nimport Data.Void (absurd)\nf = absurd\n\ng :: Int\ng = 1\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\n\ng :: Int\ng = 1\n"]
end function

function reproGuardCopies (u :: Unit) -> List Text is
  ["{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\na = 1\n\n\n\n\nc = 3\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\nb = 2\n\n\nc = 3\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\na = 1\n\n\n\n\nc = 3\n\n"]
end function

function reproDefsCopies (u :: Unit) -> List Text is
  ["{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\na = 1\n\n\n\n\n\nc = 3\n\n\n\nd = 4\n\n\n\n\n\nf = 6\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\na = 1\n\n\nb = 2\n\n\n\n\n\n\nd = 4\n\n\n\n\n\nf = 6\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\na = 1\n\n\nb = 2\n\n\n\n\n\n\nd = 4\n\n\n\n\n\nf = 6\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\n\n\n\nb = 2\n\n\n\n\n\n\nd = 4\n\n\n\n\n\nf = 6\n\n"]
end function

function reproElifdefCopies (u :: Unit) -> List Text is
  ["{-# LANGUAGE CPP #-}\nmodule M where\n\nf = 1\n\n\n\n\n\n\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\ng = 2\n\n\n\n\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\n\nk = 4\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\nh = 3\n\n\n\n"]
end function

-- An environment from lines such as `A=1`, `undef B`, `package base=4.18.0`
-- is the callers'; here, the few the laws below need.
function withName (n :: Text) (v :: Integer) (env :: Env) -> Env is env with names = prelude.put n (wp.definedAs v) env.names end function

function noNames (u :: Unit) -> Env is completed (emptyEnv unitValue) end function

function base418 (u :: Unit) -> Env is completed ((emptyEnv unitValue) with versions = prelude.put "base" [4, 18, 0] (prelude.keyValOf [])) end function

-- ---------------------------------------------------------------------------
-- What the harness says of a drawn module (next cycle 7; review 9, N5),
-- so that a change to `pick` or to a model cannot empty a law quietly.

function pathTexts (rs :: List Row) (t :: Text) -> List Text is
  first matching case of rs :
    when Nil then []
    when Cons r rest then
      (if r.reads && ownText r.terms = t then [conditionText (prelude.take (prelude.length r.terms - 1) r.terms)] else [] end if) ++ pathTexts rest t
  end case
end function

function severalIn (ts :: List Text) -> Bool is
  first matching case of ts : when Nil then false when Cons t rest then prelude.any (differsFrom t) rest end case
end function

function differsFrom (a :: Text) (b :: Text) -> Bool is a != b end function

function twoPathsOf (rs :: List Row) (t :: Text) -> Bool is severalIn (pathTexts rs t) end function

-- Some term is read by two directives that stand on different paths: the
-- shape of review 7's and review 8's blockers.
function readOnTwoPaths (rs :: List Row) -> Bool is prelude.any (twoPathsOf rs) (ownTexts rs []) end function

-- Cycle 4's rule gives other copies than the walk's.
function oldRuleDiffers (rs :: List Row) -> Bool is oldCopies rs != copiesOfRows rs end function

-- On some walk a directive is decided by a definition of the file.
function fileDecides (rs :: List Row) (w :: Walk) (asg :: KeyVal Text Integer) (line :: Integer) -> Bool is
  first matching case of rs :
    when Nil then false
    when Cons r rest then
      (first matching case of readingAt w r line :
        when NotRead then fileDecides rest (after w r false) asg (line + 1)
        when ByFile v then true
        when ByTerm l then
          (if valued asg l.text then fileDecides rest (after w r (litTrue asg l)) asg (line + 1)
           else fileDecides rest (after w r (!l.negated)) (prelude.put l.text 1 asg) (line + 1)
                  || fileDecides rest (after w r l.negated) (prelude.put l.text 0 asg) (line + 1) end if)
      end case)
  end case
end function

function fileDecidesSome (rs :: List Row) -> Bool is fileDecides rs (startWalk unitValue) (prelude.keyValOf []) 1 end function

function hasElifdef (rs :: List Row) -> Bool is
  first matching case of rs : when Nil then false when Cons r rest then prelude.startsWith r.text "#elifdef" || prelude.startsWith r.text "#elifndef" || hasElifdef rest end case
end function

function severalBuilds (rs :: List Row) -> Bool is buildCount rs >= 8 end function

-- ---------------------------------------------------------------------------
-- Next cycle 8 (next-cycle-8/design.md, sections 4 to 6; review 10: B1,
-- B2, N1, N5): THE PREPROCESSOR ITSELF, as `cpp -traditional` reads a
-- Haskell source, for the sources of the fourth model below.
--
-- `buildText` above keeps or blanks whole lines. This one also does what
-- the preprocessor does INSIDE a line of code:
--   * it lexes the line: a `'` or a `"` opens a quote that ends at the
--     same character (a backslash takes the next character with it) or
--     with the line; outside a quote `/*` opens a C comment, which may
--     run over lines and hides every directive inside it; the comment's
--     text is removed, and what follows its `*/` stands on the line that
--     opened it;
--   * it keeps a real macro table: a name the environment gives, Cabal's
--     MIN_VERSION_p of a given package, and whatever the file's own
--     `#define` and `#undef` lines made of a name, special or not;
--   * in a line it keeps, outside comments and quotes, it replaces an
--     identifier the table has as an object-like macro by the macro's
--     body, and reads the body again in the same way.
-- It has no term, no choice, no notion of a special name and no rule
-- about what the file decides. It gives one of three answers:
--   bad = 0   the text the preprocessor leaves;
--   bad = 1   outside what is modelled here: a function-like macro is
--             called in a line of code (the preprocessor expands it; this
--             model does not);
--   bad = 2   the preprocessor stops with an error (a directive it cannot
--             evaluate, a macro that expands to itself, a comment never
--             closed).
-- Beside the text it says whether ax MUST decide this build (`free`):
-- the rules C8 and C10 to C12 name what ax decides, and outside that ax
-- may leave facts undecided, never wrong. This is the one place where the
-- reference states ax's own boundary; it is read off the preprocessor's
-- walk under one environment, not off a walk with choices.
-- The texts were compared with GCC 15.2 `cpp -undef -traditional
-- -nostdinc` (next-cycle-8/tools/lacecpp.py; design.md, section 10).
--
-- Next cycle 9 (next-cycle-9/design.md; review 11: B1, S3, N1, N3). Rule
-- D1: exact where the preprocessor's rule is simple, and where it is not,
-- the build is outside the model (`bad` 1) and ax must mark it. So:
--   * the lines are joined first, as the preprocessor joins them (rule
--     C17): a line of code that ends in a backslash (blanks after it
--     apart) takes the next line, whatever that line is; the joined text
--     stands on the first line and the line joined to it is empty;
--   * a source with no directive line and no pragma that turns the
--     preprocessor on is not preprocessed: its text is the source (C1);
--   * `bad` is 1 where the text of a kept line, AFTER its macros are
--     replaced, holds outside quotes: the name of a macro with an
--     argument list followed by `(`, or ending the line when the line is
--     not the source's last (the preprocessor then looks for the `(` on
--     the lines that follow, and takes a directive there for text); or
--     one of the preprocessor's own names (`__LINE__` and the others).
--     And where a macro is replaced whose body ends inside a quote. Review
--     11's B1: the call was looked for in the text before replacement,
--     and only on the name's own line, so `#define A F` / `A(1)` and
--     `F` / `(1)` were "a text ax must decide", with the call unexpanded.
-- Each of these was measured with GCC 15.2 first
-- (next-cycle-9/tools/gcc-rows.txt); the drawn modules are compared by
-- next-cycle-9/tools/lacecpp.py.

type Macro is one of
  | Obj of type record{ body :: Text , num :: Maybe Integer}   -- object-like
  | Fun of type Text                                            -- with an argument list: its body
  | Ver of type List Integer                                    -- Cabal's MIN_VERSION_p of a given package
  | Gone                                                        -- undefined by the file
end type

function macroOf (r :: Row) -> Macro is
  first matching case of r.sets :
    when Unsets then Gone
    when SetsInt v then Obj record{ body = (if prelude.length r.body = 0 then prelude.textOf v else r.body end if) , num = Present v}
    otherwise (if r.fun then Fun r.body else Obj record{ body = r.body , num = Absent} end if)
  end case
end function

-- What the table holds for a name: the file's last word on it, else the
-- environment's.
function macroAt (file :: KeyVal Text Macro) (env :: Env) (n :: Text) -> Maybe Macro is
  first matching case of prelude.lookup n file :
    when Present m then Present m
    when Absent then
      (first matching case of prelude.lookup n env.names :
        when Present (Defined v) then Present (Obj record{ body = prelude.textOf v , num = Present v})
        otherwise
          (if prelude.startsWith n "MIN_VERSION_" then
            (first matching case of prelude.lookup (prelude.drop 12 n) env.versions :
              when Present v then Present (Ver v)
              when Absent then Absent
            end case)
           else Absent end if)
      end case)
  end case
end function

function isIdentText (t :: Text) -> Bool is t matches regex "[A-Za-z_][A-Za-z0-9_]*" end function

-- An identifier in a directive's expression: its macro's value; another
-- name's, when the body is that name; 0 when it is no object-like macro.
function nameValue (file :: KeyVal Text Macro) (env :: Env) (n :: Text) (fuel :: Integer) -> Outcome is
  if fuel <= 0 then Bad
  else
    (first matching case of macroAt file env n :
      when Present (Obj o) then
        (first matching case of o.num :
          when Present v then Known (wp.wrap v)
          when Absent then (if isIdentText o.body then nameValue file env o.body (fuel - 1) else Bad end if)
        end case)
      otherwise Known 0
    end case)
  end if
end function

-- The name's macro has no body (followed through bodies that are a
-- name): read as a value it leaves nothing in the expression.
function emptyName (file :: KeyVal Text Macro) (env :: Env) (fuel :: Integer) (n :: Text) -> Bool is
  if fuel <= 0 then false
  else
    (first matching case of macroAt file env n :
      when Present (Obj o) then
        (first matching case of o.num :
          when Present v then false
          when Absent then (if prelude.length o.body = 0 then true else (if isIdentText o.body then emptyName file env (fuel - 1) o.body else false end if) end if)
        end case)
      otherwise false
    end case)
  end if
end function

function emptyOperand (file :: KeyVal Text Macro) (env :: Env) (e :: CExpr) -> Bool is
  first matching case of e : when Name n then emptyName file env 4 n otherwise false end case
end function

function additive (op :: BinOp) -> Bool is op = BAdd || op = BSub end function

-- An operand that leaves nothing where one must stand: an error
-- (`#if` with no expression; an operator with no operand), wherever it
-- stands. Not where it is the left side of `+` or `-`: the operator is
-- then a sign (`#define Q` / `#if Q + P > 1` is `#if + P > 1`; measured).
function leavesNothing (file :: KeyVal Text Macro) (env :: Env) (e :: CExpr) -> Bool is
  first matching case of e :
    when Lit n then false
    when ULit n then false
    when Name n then emptyName file env 4 n
    when IsDefined n then false
    when Un u then leavesNothing file env u.arg
    when Bin b then (if additive b.op && emptyOperand file env b.left then leavesNothing file env b.right else leavesNothing file env b.left || leavesNothing file env b.right end if)
    when Cond k then leavesNothing file env k.test || leavesNothing file env k.yes || leavesNothing file env k.no
    when MinVersion m then leavesNothing file env m.major1 || leavesNothing file env m.major2 || leavesNothing file env m.minor
    when MinGhc m then true
  end case
end function

function tableEval (file :: KeyVal Text Macro) (env :: Env) (e :: CExpr) -> Outcome is
  first matching case of e :
    when Lit n then Known (wp.wrap n)
    when ULit n then Known (wp.wrap n)
    when Name n then nameValue file env n 4
    when IsDefined n then
      (first matching case of macroAt file env n : when Absent then Known 0 when Present Gone then Known 0 otherwise Known 1 end case)
    when Un u then wp.unary u.op (tableEval file env u.arg)
    when Bin b then
      (if additive b.op && emptyOperand file env b.left then wp.unary (if b.op = BAdd then UPlus else UMinus end if) (tableEval file env b.right)
       else wp.binaryAs (wp.unsignedOf b.left) (wp.unsignedOf b.right) b.op (tableEval file env b.left) (tableEval file env b.right) end if)
    when Cond k then wp.conditional (tableEval file env k.test) (tableEval file env k.yes) (tableEval file env k.no)
    when MinVersion m then
      (first matching case of macroAt file env ("MIN_VERSION_" ++ m.pkg) :
        when Present (Ver v) then wp.minVersion v (tableEval file env m.major1) (tableEval file env m.major2) (tableEval file env m.minor)
        when Present (Fun b) then (if b = "1" then Known 1 else (if b = "0" then Known 0 else Bad end if) end if)
        otherwise Bad
      end case)
    when MinGhc m then Bad
  end case
end function

-- One directive's value under the table: Known, or Bad (an error).
-- Next cycle 10 (O157): a name's value is pasted as text, so a minus
-- sign that begins on a name with a negative value is `--`, an error
-- wherever it stands (`wp.negLead` says the same of the names given).
function negLeadAt (file :: KeyVal Text Macro) (env :: Env) (e :: CExpr) -> Bool is
  first matching case of e :
    when Name n then (first matching case of nameValue file env n 4 : when Known v then v < 0 otherwise false end case)
    when Bin b then negLeadAt file env b.left
    when Cond k then negLeadAt file env k.test
    otherwise false
  end case
end function

function pastesMinus (file :: KeyVal Text Macro) (env :: Env) (e :: CExpr) -> Bool is
  first matching case of e :
    when Un u then (u.op = UMinus && negLeadAt file env u.arg) || pastesMinus file env u.arg
    when Bin b then (b.op = BSub && negLeadAt file env b.right) || pastesMinus file env b.left || pastesMinus file env b.right
    when Cond k then pastesMinus file env k.test || pastesMinus file env k.yes || pastesMinus file env k.no
    when MinVersion m then pastesMinus file env m.major1 || pastesMinus file env m.major2 || pastesMinus file env m.minor
    otherwise false
  end case
end function

function directiveValue (file :: KeyVal Text Macro) (env :: Env) (l :: Literal) -> Outcome is
  if leavesNothing file env l.expr || pastesMinus file env l.expr then Bad else tableEval file env l.expr end if
end function

-- ax's boundary at a directive (rule C8c, read under the table): the
-- file's definitions decide it, or it reads no name the file has set.
function inFile (file :: KeyVal Text Macro) (n :: Text) -> Bool is prelude.lookup n file matches Present _ end function

function noValue (file :: KeyVal Text Macro) (n :: Text) -> Bool is
  first matching case of prelude.lookup n file :
    when Present (Obj o) then o.num matches Absent
    when Present (Fun b) then true
    otherwise false
  end case
end function

function keepsOpen (file :: KeyVal Text Macro) (vals :: List Text) (n :: Text) -> Bool is
  !(inFile file n) || special n || ((vals contains n) && noValue file n)
end function

function axDecides (file :: KeyVal Text Macro) (l :: Literal) -> Bool is
  !(prelude.any (inFile file) (namesOf l.expr)) || !(prelude.any (keepsOpen file (valueNames l.expr)) (namesOf l.expr))
end function

-- A line of code, lexed.
type Lex is a record{
  file :: KeyVal Text Macro
  env :: Env
  live :: Bool}
end type

type Scanned is a record{
  out :: Text
  open :: Bool
  bad :: Integer
  free :: Bool}
end type

function worse (a :: Integer) (b :: Integer) -> Integer is if a > b then a else b end if end function

function charAt (t :: Text) (i :: Integer) -> Text is prelude.take 1 (prelude.drop i t) end function

function isIdStart (ch :: Text) -> Bool is ch matches regex "[A-Za-z_]" end function

function isIdChar (ch :: Text) -> Bool is ch matches regex "[A-Za-z0-9_]" end function

-- The index after the first `*/` at or after i; -1 when there is none.
function findClose (t :: Text) (i :: Integer) (n :: Integer) (fuel :: Integer) -> Integer is
  if fuel <= 0 || i + 1 >= n then 0 - 1
  else (if prelude.take 2 (prelude.drop i t) = "*/" then i + 2 else findClose t (i + 1) n (fuel - 1) end if) end if
end function

function idEnd (t :: Text) (i :: Integer) (n :: Integer) (fuel :: Integer) -> Integer is
  if fuel <= 0 || i >= n then i else (if isIdChar (charAt t i) then idEnd t (i + 1) n (fuel - 1) else i end if) end if
end function

-- Next cycle 10 (review 12, B2 and N1). The preprocessor's blanks inside
-- a line are the blank, the tab, the form feed and the vertical tab
-- (GCC 15.2, every byte tried: next-cycle-10/tools/gcc-rows.txt); between
-- a macro's name and its `(` a carriage return is one too.
function isBlank (ch :: Text) -> Bool is ch = " " || ch = "\t" || ch = "\f" || ch = "\v" end function

function blanksEnd (t :: Text) (i :: Integer) (n :: Integer) (fuel :: Integer) -> Integer is
  if fuel <= 0 || i >= n then i else (if isBlank (charAt t i) || charAt t i = "\r" then blanksEnd t (i + 1) n (fuel - 1) else i end if) end if
end function

function prefixed (p :: Text) (s :: Scanned) -> Scanned is s with out = p ++ s.out end function

function joined (a :: Scanned) (b :: Scanned) -> Scanned is
  Scanned record{ out = a.out ++ b.out , open = b.open , bad = worse a.bad b.bad , free = a.free && b.free}
end function

function noted (k :: Integer) (free :: Bool) (s :: Scanned) -> Scanned is s with bad = worse k s.bad , free = s.free && free end function

-- The quote a text ends inside when it is lexed alone; "" for none.
function quoteAtEnd (t :: Text) (i :: Integer) (n :: Integer) (quote :: Text) (fuel :: Integer) -> Text is
  if fuel <= 0 || i >= n then quote
  else
    (let ch = charAt t i in
      (if prelude.length quote > 0 then
         (if ch = "\\" then quoteAtEnd t (i + 2) n quote (fuel - 1)
          else quoteAtEnd t (i + 1) n (if ch = quote then "" else quote end if) (fuel - 1) end if)
       else quoteAtEnd t (i + 1) n (if ch = "'" || ch = "\"" then ch else "" end if) (fuel - 1) end if)
    end let)
  end if
end function

function endsInQuote (body :: Text) -> Bool is
  prelude.length (quoteAtEnd body 0 (prelude.length body) "" (prelude.length body + 1)) > 0
end function

-- The text from index i, lexed as the preprocessor lexes a line: `quote`
-- is the quote that is open ("" for none); `active` the macros being
-- expanded (one that names itself is an error). Where the line is not
-- kept (`live` false) nothing is replaced, and quotes and comments are
-- read all the same. A macro with an argument list is left as written
-- here: whether the line calls it is read off the replaced text
-- (`callAt`, below). A macro whose body ends inside a quote is outside
-- the model: the quote would run on into the rest of the line.
function scanAt (x :: Lex) (t :: Text) (i :: Integer) (n :: Integer) (quote :: Text) (active :: List Text) (fuel :: Integer) -> Scanned is
  if fuel <= 0 || i >= n then Scanned record{ out = "" , open = false , bad = 0 , free = true}
  else
    (let ch = charAt t i in
      (if prelude.length quote > 0 then
         (if ch = "\\" then prefixed (prelude.take 2 (prelude.drop i t)) (scanAt x t (i + 2) n quote active (fuel - 1))
          else prefixed ch (scanAt x t (i + 1) n (if ch = quote then "" else quote end if) active (fuel - 1)) end if)
       else (if prelude.take 2 (prelude.drop i t) = "/*" then
         (let e = findClose t (i + 2) n (n + 1) in
           (if e < 0 then Scanned record{ out = "" , open = true , bad = 0 , free = true}
            else scanAt x t e n "" active (fuel - 1) end if) end let)
       else (if ch = "'" || ch = "\"" then prefixed ch (scanAt x t (i + 1) n ch active (fuel - 1))
       else (if isIdStart ch then
         (let j = idEnd t i n (n + 1) in let id = prelude.take (j - i) (prelude.drop i t) in
          let rest = scanAt x t j n "" active (fuel - 1) in
           (first matching case of (if x.live then macroAt x.file x.env id else Absent end if) :
             when Present (Obj o) then
               (if active contains id then noted 2 true (prefixed id rest)
                else (if endsInQuote o.body then noted 1 true (prefixed id rest)
                else joined (noted 0 (inFile x.file id && !((ownNames unitValue) contains id)) (scanAt x o.body 0 (prelude.length o.body) "" (active ++ [id]) (fuel - 1))) rest end if) end if)
             when Present (Ver v) then noted 0 false (prefixed id rest)
             otherwise prefixed id rest
           end case) end let end let end let)
       else prefixed ch (scanAt x t (i + 1) n "" active (fuel - 1)) end if) end if) end if) end if)
    end let)
  end if
end function

-- Next cycle 9 (review 11, B1 and N1; rule C12 (a) and (e)). The
-- preprocessor's own names, as GCC 15.2 has them under `-undef
-- -traditional -nostdinc` (measured: `__STDC__`, `__GNUC__` and the
-- system's names are not defined there). Next cycle 10 (review 12, B1):
-- the list was ten names, found by trying the ones the manual names. It
-- is 25: every identifier in the compiler's own strings was put to
-- `#ifdef` (next-cycle-10/tools/ownnames.sh), which adds six constants
-- (`__STDC_HOSTED__` is 1 in a line of code) and the nine `__has_`
-- operators.
function ownNames (u :: Unit) -> List Text is
  ["__LINE__", "__FILE__", "__DATE__", "__TIME__", "__TIMESTAMP__", "__COUNTER__", "__INCLUDE_LEVEL__", "__BASE_FILE__", "__FILE_NAME__", "__STDC_VERSION__",
   "__STDC_HOSTED__", "__STDC_UTF_16__", "__STDC_UTF_32__", "__STDC_EMBED_EMPTY__", "__STDC_EMBED_FOUND__", "__STDC_EMBED_NOT_FOUND__",
   "__has_attribute", "__has_builtin", "__has_c_attribute", "__has_cpp_attribute", "__has_embed", "__has_extension", "__has_feature", "__has_include",
   "__has_include_next"]
end function

-- The six that are strings: read as a value in a directive they are an
-- error, in a branch that is not evaluated too (measured).
function ownStrings (u :: Unit) -> List Text is ["__FILE__", "__DATE__", "__TIME__", "__TIMESTAMP__", "__BASE_FILE__", "__FILE_NAME__"] end function

-- Next cycle 10 (review 12, B1; rule C18): the own names in a DIRECTIVE.
-- Cycle 9 looked for them in lines of code only, and read them in a
-- directive as names of the environment: `#ifdef __FILE__` failed under a
-- complete environment, where the preprocessor keeps the group.
-- A name is the preprocessor's own at a line while the file has not
-- defined or undefined it and the names given do not hold it (GCC lets
-- `#undef`, `#define`, `-D` and `-U` take it over, each with a warning;
-- measured).
function ownHere (file :: KeyVal Text Macro) (env :: Env) (n :: Text) -> Bool is
  ((ownNames unitValue) contains n) && !(inFile file n) && !(prelude.lookup n env.names matches Present _)
end function

function ownString (file :: KeyVal Text Macro) (env :: Env) (n :: Text) -> Bool is ownHere file env n && ((ownStrings unitValue) contains n) end function

-- One this model has no value for: neither `__LINE__` nor a string.
function ownLoose (file :: KeyVal Text Macro) (env :: Env) (n :: Text) -> Bool is
  ownHere file env n && n != "__LINE__" && !((ownStrings unitValue) contains n)
end function

function ownGiven (env :: Env) (n :: Text) -> Bool is ((ownNames unitValue) contains n) && (prelude.lookup n env.names matches Present _) end function

-- `__LINE__` is the number of the directive's line (no model draws a
-- `#line`, which moves it); every other own name is a macro with a body
-- that is no number.
function ownMacro (n :: Text) (line :: Integer) (valued :: Bool) -> Macro is
  if valued && n = "__LINE__" then Obj record{ body = prelude.textOf line , num = Present line} else Obj record{ body = "\"\"" , num = Absent} end if
end function

-- The table a directive is read under: the file's, and each own name
-- that is still the preprocessor's.
function withOwn (file :: KeyVal Text Macro) (env :: Env) (line :: Integer) (valued :: Bool) (ns :: List Text) -> KeyVal Text Macro is
  first matching case of ns :
    when Nil then file
    when Cons n rest then withOwn (if ownHere file env n then prelude.put n (ownMacro n line valued) file else file end if) env line valued rest
  end case
end function

function directiveRead (file :: KeyVal Text Macro) (env :: Env) (line :: Integer) (l :: Literal) -> Outcome is
  if prelude.any (ownString file env) (valueNames l.expr) then Bad
  else directiveValue (withOwn file env line true (ownNames unitValue)) env l end if
end function

-- 2 an error; 3 the directive reads, as a value, an own name this model
-- has no value for (`__COUNTER__` counts its uses, the constants are the
-- compiler's, the `__has_` operators are calls): nothing is asked of the
-- build, and no model draws it.
function directiveBad (file :: KeyVal Text Macro) (env :: Env) (l :: Literal) (v :: Outcome) -> Integer is
  if prelude.any (ownString file env) (valueNames l.expr) then 2
  else (if prelude.any (ownLoose file env) (valueNames l.expr) then 3 else (if v matches Bad then 2 else 0 end if) end if) end if
end function

-- ax's boundary at a directive, with rule C18: an own name stands as a
-- name the file defined with no integer body; and where the names given
-- hold one, nothing is asked.
function directiveFree (file :: KeyVal Text Macro) (env :: Env) (l :: Literal) -> Bool is
  axDecides (withOwn file env 0 false (ownNames unitValue)) l && !(prelude.any (ownGiven env) (namesOf l.expr))
end function

function takesArguments (x :: Lex) (id :: Text) -> Bool is
  first matching case of macroAt x.file x.env id :
    when Present (Fun b) then true
    when Present (Ver v) then true
    otherwise false
  end case
end function

-- Does the text of a kept line, with its macros replaced and its
-- comments gone, hold outside quotes a name the model does not follow:
-- a macro with an argument list before a `(` (blanks apart), or as the
-- last thing of the line when `more` lines follow; or one of the
-- preprocessor's own names?
function callAt (x :: Lex) (more :: Bool) (t :: Text) (i :: Integer) (n :: Integer) (quote :: Text) (fuel :: Integer) -> Bool is
  if fuel <= 0 || i >= n then false
  else
    (let ch = charAt t i in
      (if prelude.length quote > 0 then
         (if ch = "\\" then callAt x more t (i + 2) n quote (fuel - 1)
          else callAt x more t (i + 1) n (if ch = quote then "" else quote end if) (fuel - 1) end if)
       else (if ch = "'" || ch = "\"" then callAt x more t (i + 1) n ch (fuel - 1)
       else (if isIdStart ch then
         (let j = idEnd t i n (n + 1) in let id = prelude.take (j - i) (prelude.drop i t) in let b = blanksEnd t j n (n + 1) in
           (if (ownNames unitValue) contains id then true
            else (if takesArguments x id && (charAt t b = "(" || (b >= n && more)) then true
            else callAt x more t j n "" (fuel - 1) end if) end if)
          end let end let end let)
       else callAt x more t (i + 1) n "" (fuel - 1) end if) end if) end if)
    end let)
  end if
end function

-- 1 where the kept line's text is outside the model, 0 where it is not.
function outside (x :: Lex) (more :: Bool) (out :: Text) -> Integer is
  if x.live && callAt x more out 0 (prelude.length out) "" (scanFuel out) then 1 else 0 end if
end function

-- Next cycle 10 (review 12, S1). What a kept line of code holds, for the
-- floors: read off the same table and the same replaced text as
-- `callAt`, so a floor counts what the preprocessor does and not what
-- the source's text looks like. `atEnd` false: a name with an argument
-- list before `(`, blanks apart. `atEnd` true: such a name as the last
-- thing of the line.
function callShape (x :: Lex) (atEnd :: Bool) (t :: Text) (i :: Integer) (n :: Integer) (quote :: Text) (fuel :: Integer) -> Bool is
  if fuel <= 0 || i >= n then false
  else
    (let ch = charAt t i in
      (if prelude.length quote > 0 then
         (if ch = "\\" then callShape x atEnd t (i + 2) n quote (fuel - 1)
          else callShape x atEnd t (i + 1) n (if ch = quote then "" else quote end if) (fuel - 1) end if)
       else (if ch = "'" || ch = "\"" then callShape x atEnd t (i + 1) n ch (fuel - 1)
       else (if isIdStart ch then
         (let j = idEnd t i n (n + 1) in let id = prelude.take (j - i) (prelude.drop i t) in let b = blanksEnd t j n (n + 1) in
           (if takesArguments x id && (if atEnd then b >= n else charAt t b = "(" end if) then true
            else callShape x atEnd t j n "" (fuel - 1) end if)
          end let end let end let)
       else callShape x atEnd t (i + 1) n "" (fuel - 1) end if) end if) end if)
    end let)
  end if
end function

-- The line as written names an object-like macro whose body is the name
-- of another object-like macro: a chain of aliases.
function chainAt (x :: Lex) (t :: Text) (i :: Integer) (n :: Integer) (fuel :: Integer) -> Bool is
  if fuel <= 0 || i >= n then false
  else (if isIdStart (charAt t i) then
    (let j = idEnd t i n (n + 1) in
      (first matching case of macroAt x.file x.env (prelude.take (j - i) (prelude.drop i t)) :
        when Present (Obj o) then
          (if isIdentText o.body && (first matching case of macroAt x.file x.env o.body : when Present (Obj p) then true otherwise false end case) then true
           else chainAt x t j n (fuel - 1) end if)
        otherwise chainAt x t j n (fuel - 1)
      end case) end let)
  else chainAt x t (i + 1) n (fuel - 1) end if) end if
end function

-- The next line begins, blanks apart, with `(`.
function nextOpens (rest :: List Row) -> Bool is
  first matching case of rest :
    when Nil then false
    when Cons r more then !r.directive && (let t = bare r.text in charAt t (blanksEnd t 0 (prelude.length t) (prelude.length t + 1)) = "(" end let)
  end case
end function

-- Next cycle 9 (review 11, S3; rule C17): a line that ends in a
-- backslash, blanks after it apart. Next cycle 10 (review 12, B2): the
-- blanks are the preprocessor's four, not two: a form feed or a vertical
-- tab after the backslash is skipped like a blank, measured.
function trimmedEnd (t :: Text) (fuel :: Integer) -> Text is
  if fuel <= 0 || prelude.length t = 0 then t
  else (if isBlank (charAt t (prelude.length t - 1)) then trimmedEnd (prelude.take (prelude.length t - 1) t) (fuel - 1) else t end if) end if
end function

function spliced (t :: Text) -> Bool is prelude.endsWith (trimmedEnd (bare t) (prelude.length t)) "\\" end function

function unspliced (t :: Text) -> Text is
  let s = trimmedEnd (bare t) (prelude.length t) in prelude.take (prelude.length s - 1) s end let
end function

function blankAfterFirst (rs :: List Row) (terms :: List Literal) -> List Row is
  first matching case of rs : when Nil then [] when Cons r rest then [r] ++ [row "" terms false] ++ rest end case
end function

-- The lines as the preprocessor first joins them: a line of code that
-- ends in a backslash takes the next line (a directive too: it is then
-- text), and an empty line stands where that line was. The last line
-- only loses its backslash. (A directive's own continuation is rule C1's,
-- and no model draws one.)
function splicedRows (rs :: List Row) (fuel :: Integer) -> List Row is
  if fuel <= 0 then rs
  else
    (first matching case of rs :
      when Nil then []
      when Cons r rest then
        (if r.directive || !(spliced r.text) then [r] ++ splicedRows rest (fuel - 1)
         else
           (first matching case of rest :
             when Nil then [r with text = unspliced r.text ++ "\n"]
             when Cons r2 rest2 then blankAfterFirst (splicedRows ([r with text = unspliced r.text ++ r2.text] ++ rest2) (fuel - 1)) r2.terms
           end case) end if)
    end case)
  end if
end function

-- Next cycle 9 (review 11, N3; rule C1): the pragma that turns the
-- preprocessor on. `{-# LANGUAGE ... #-}` (the word in any case) that
-- lists CPP, or `{-# OPTIONS_GHC ... #-}` or `{-# OPTIONS ... #-}` that
-- holds `-cpp` or `-XCPP`; the pragma may run over lines, and its words
-- are parted by blanks, line ends and commas.
function wordsOf (t :: Text) (i :: Integer) (n :: Integer) (cur :: Text) (fuel :: Integer) -> List Text is
  if fuel <= 0 || i >= n then (if prelude.length cur > 0 then [cur] else [] end if)
  else
    (let ch = charAt t i in
      (if ch = " " || ch = "\t" || ch = "\n" || ch = "\r" || ch = "," then
         (if prelude.length cur > 0 then [cur] else [] end if) ++ wordsOf t (i + 1) n "" (fuel - 1)
       else wordsOf t (i + 1) n (cur ++ ch) (fuel - 1) end if)
    end let)
  end if
end function

function pragmaTurnsOn (body :: Text) -> Bool is
  first matching case of wordsOf body 0 (prelude.length body) "" (prelude.length body + 1) :
    when Nil then false
    when Cons w rest then
      (let k = prelude.caseFold w in
        (k = "language" && (rest contains "CPP")) || ((k = "options_ghc" || k = "options") && ((rest contains "-cpp") || (rest contains "-XCPP")))
      end let)
  end case
end function

-- The index of the first `what` at or after i; -1 when there is none.
function findText (t :: Text) (what :: Text) (i :: Integer) (n :: Integer) (fuel :: Integer) -> Integer is
  if fuel <= 0 || i + prelude.length what > n then 0 - 1
  else (if prelude.take (prelude.length what) (prelude.drop i t) = what then i else findText t what (i + 1) n (fuel - 1) end if) end if
end function

-- Next cycle 10 (review 12, B3; rule C1). GHC reads the pragma in the
-- file's HEADER only: "A file-header pragma must precede the `module`
-- keyword in the file. There can be as many file-header pragmas as you
-- please, and they can be preceded or followed by comments" (GHC User's
-- Guide, "Pragmas"; the file-header pragmas are LANGUAGE, OPTIONS_GHC
-- and INCLUDE). Cycle 9 looked for `{-#` anywhere in the text: inside a
-- `--` comment, inside a string, after `module`.
-- The header is read as GHC's lexer reads it (compiler/GHC/Parser/
-- Lexer.x, the state `option_prags`; GHC.Parser.Header.getOptions stops
-- at the first token that is neither a comment nor one of these
-- pragmas). From the start of the text:
--   * white space is skipped (blank, tab, line end, carriage return,
--     form feed, vertical tab);
--   * `{- ... -}` is a comment, nested as Haskell nests it;
--   * two or more dashes begin a comment to the line's end, unless a
--     symbol character follows them (`-->`, `--|` are operators: the
--     header ends);
--   * `{-# WORD ... #-}`, the word in any case: LANGUAGE lists
--     extensions (blanks, line ends and commas part them), OPTIONS_GHC
--     and OPTIONS hold flags; OPTIONS_HADDOCK and INCLUDE
--     are passed over to their `#-}`; a word GHC gives a token of its
--     own (`tokenPragmas`: INLINE, RULES and the rest) ends the header;
--     any other word makes the whole a comment;
--   * a line that begins `#!` (or blank, `#!`) is skipped;
--   * anything else ends the header.
-- The preprocessor is on when the LAST of `CPP`, `-cpp`, `-XCPP`,
-- `NoCPP` and `-XNoCPP` the header holds turns it on (GHC applies them
-- in order).
-- Where this reading cannot be sure it is GHC's, it stops and says so
-- (`unsureAt`): a character outside ASCII where a token may begin or
-- right after a comment's dashes (GHC asks Unicode whether it is a
-- space or a symbol), a LANGUAGE pragma that holds anything but names,
-- commas and blanks (a comment inside it; GHC rejects the rest), an
-- OPTIONS pragma with a quote or a bracket (GHC reads its words as
-- Haskell strings, or as a list), a `#` at a line's start that is not
-- `#!`; and, since next cycle 11 (review 13, B2), a LINE or a COLUMN
-- pragma (GHC's lexer ends LINE at `#-}` or at `-}`, and reads both as
-- positions or as tokens by a setting this reading does not know), and
-- a comment that holds a line beginning with `#` on which a `{-` or a
-- `-}` stands (inside a comment GHC's lexer reads a line that begins
-- with `#` by its rules for line pragmas and `#!`, which can take the
-- rest of the line, braces and all: `hashLineIn`).
-- If the text from there on names `CPP` or `-cpp` the answer is 2:
-- the source is outside the model and ax must mark it; if not, nothing
-- after that point can change the answer, and it stands.
function isWs (ch :: Text) -> Bool is ch = " " || ch = "\t" || ch = "\n" || ch = "\r" || ch = "\f" || ch = "\v" end function

function isPlain (ch :: Text) -> Bool is isWs ch || ch matches regex "[ -~]" end function

function wsEnd (t :: Text) (i :: Integer) (n :: Integer) (fuel :: Integer) -> Integer is
  if fuel <= 0 || i >= n then i else (if isWs (charAt t i) then wsEnd t (i + 1) n (fuel - 1) else i end if) end if
end function

function dashEnd (t :: Text) (i :: Integer) (n :: Integer) (fuel :: Integer) -> Integer is
  if fuel <= 0 || i >= n then i else (if charAt t i = "-" then dashEnd t (i + 1) n (fuel - 1) else i end if) end if
end function

function lineEndAt (t :: Text) (i :: Integer) (n :: Integer) -> Integer is
  let e = findText t "\n" i n (n + 1) in (if e < 0 then n else e end if) end let
end function

-- The index after the `-}` that closes the comment whose `{-` is at or
-- after i (`depth` comments are open); -1 when it is never closed.
function commentEnd (t :: Text) (i :: Integer) (n :: Integer) (depth :: Integer) (fuel :: Integer) -> Integer is
  if fuel <= 0 || i >= n then 0 - 1
  else (if prelude.take 2 (prelude.drop i t) = "{-" then commentEnd t (i + 2) n (depth + 1) (fuel - 1)
  else (if prelude.take 2 (prelude.drop i t) = "-}" then (if depth <= 1 then i + 2 else commentEnd t (i + 2) n (depth - 1) (fuel - 1) end if)
  else commentEnd t (i + 1) n depth (fuel - 1) end if) end if) end if
end function

function lineStart (t :: Text) (i :: Integer) -> Bool is if i <= 0 then true else charAt t (i - 1) = "\n" end if end function

function spaceStart (t :: Text) (i :: Integer) -> Bool is
  if i <= 0 then false else charAt t (i - 1) = " " && lineStart t (i - 1) end if
end function

-- The pragmas GHC reads in the header, and passes over when they are
-- not about extensions or flags.
function headerPragmas (u :: Unit) -> List Text is ["language", "options_ghc", "options", "options_haddock", "include"] end function

-- The pragmas that are tokens of their own to GHC's lexer (Lexer.x,
-- `oneWordPrags`, with the two spellings `clean_pragma` folds): one of
-- them ends the header.
function tokenPragmas (u :: Unit) -> List Text is
  ["rules", "inline", "inlinable", "inlineable", "notinline", "noinline", "opaque", "specialize", "specialise", "source", "warning", "deprecated", "scc",
   "unpack", "nounpack", "ann", "minimal", "overlaps", "overlappable", "overlapping", "incoherent", "ctype", "complete"]
end function

function switched (flags :: Bool) (on :: Integer) (ws :: List Text) -> Integer is
  first matching case of ws :
    when Nil then on
    when Cons w rest then
      switched flags
        (if (!flags && w = "CPP") || (flags && (w = "-cpp" || w = "-XCPP")) then 1
         else (if (!flags && w = "NoCPP") || (flags && w = "-XNoCPP") then 0 else on end if) end if) rest
  end case
end function

function unsureAt (t :: Text) (i :: Integer) (on :: Integer) -> Integer is
  if ((prelude.drop i t) contains "CPP") || ((prelude.drop i t) contains "-cpp") then 2 else on end if
end function

-- One step of the header's reading at index i: either the index to go
-- on from (and what is known so far), or the answer.
type Step is a record{
  next :: Integer
  on :: Integer
  stop :: Bool}
end type

function goOn (next :: Integer) (on :: Integer) -> Step is Step record{ next = next , on = on , stop = false} end function

function stopAt (on :: Integer) -> Step is Step record{ next = 0 , on = on , stop = true} end function

-- Next cycle 11: between i and e, a line that begins with `#` and holds
-- `{-` or `-}`.
function hashLineIn (t :: Text) (i :: Integer) (e :: Integer) (n :: Integer) (fuel :: Integer) -> Bool is
  let j = findText t "\n#" i e (e + 1) in
    (if fuel <= 0 || j < 0 then false
     else
       (let seg = prelude.take (lineEndAt t (j + 1) n - j - 1) (prelude.drop (j + 1) t) in
         (seg contains "-}") || (seg contains "{-") || hashLineIn t (j + 1) e n (fuel - 1) end let) end if)
  end let
end function

function afterComment (t :: Text) (i :: Integer) (n :: Integer) (on :: Integer) -> Step is
  let e = commentEnd t i n 0 (n + 1) in
    (if hashLineIn t i (if e < 0 then n else e end if) n (n + 1) then stopAt (unsureAt t i on)
     else (if e < 0 then stopAt on else goOn e on end if) end if)
  end let
end function

-- A `{-#` at i.
function pragmaStep (t :: Text) (i :: Integer) (n :: Integer) (on :: Integer) -> Step is
  let w0 = wsEnd t (i + 3) n (n + 1) in let w1 = idEnd t w0 n (n + 1) in
  let word = prelude.caseFold (prelude.take (w1 - w0) (prelude.drop w0 t)) in
    (if w1 < n && !(isPlain (charAt t w1)) then stopAt (unsureAt t i on)
     else (if word = "line" || word = "column" then stopAt (unsureAt t i on)
     else (if (headerPragmas unitValue) contains word then
       (let b = findText t "#-}" w1 n (n + 1) in
         (if b < 0 then stopAt on
          else
            (let body = prelude.take (b - w1) (prelude.drop w1 t) in
              (if word = "language" then
                 (if body matches regex "[A-Za-z0-9_, \\t\\n\\r]*"
                  then goOn (b + 3) (switched false on (wordsOf body 0 (prelude.length body) "" (prelude.length body + 1)))
                  else stopAt (unsureAt t i on) end if)
               else (if word = "options_ghc" || word = "options" then
                 (if (body contains "\"") || (body contains "[") || (body contains "\f") || (body contains "\v") then stopAt (unsureAt t i on)
                  else goOn (b + 3) (switched true on (wordsOf body 0 (prelude.length body) "" (prelude.length body + 1))) end if)
               else goOn (b + 3) on end if) end if)
            end let) end if)
       end let)
     else (if (tokenPragmas unitValue) contains word then stopAt on else afterComment t i n on end if) end if) end if) end if)
  end let end let end let
end function

-- Two or more dashes at i.
function dashStep (t :: Text) (i :: Integer) (n :: Integer) (on :: Integer) -> Step is
  let dd = dashEnd t i n (n + 1) in
    (if dd >= n || charAt t dd = "\n" then goOn dd on
     else (if !(isPlain (charAt t dd)) then stopAt (unsureAt t dd on)
     else (if (charAt t dd) matches regex "[!#$%&*+./<=>?@\\\\^|~:]" then stopAt on
     else goOn (lineEndAt t dd n) on end if) end if) end if)
  end let
end function

function hashStep (t :: Text) (i :: Integer) (n :: Integer) (on :: Integer) -> Step is
  if (lineStart t i || spaceStart t i) && charAt t (i + 1) = "!" then goOn (lineEndAt t i n) on
  else (if lineStart t i then stopAt (unsureAt t i on) else stopAt on end if) end if
end function

function headerStep (t :: Text) (i :: Integer) (n :: Integer) (on :: Integer) -> Step is
  let ch = charAt t i in
    (if isWs ch then goOn (i + 1) on
     else (if !(isPlain ch) then stopAt (unsureAt t i on)
     else (if ch = "#" then hashStep t i n on
     else (if prelude.take 3 (prelude.drop i t) = "{-#" then pragmaStep t i n on
     else (if prelude.take 2 (prelude.drop i t) = "{-" then afterComment t i n on
     else (if prelude.take 2 (prelude.drop i t) = "--" then dashStep t i n on
     else stopAt on end if) end if) end if) end if) end if) end if)
  end let
end function

-- 0 the header leaves the preprocessor off; 1 it turns it on; 2 the
-- header is not read to its end and CPP is named after that point.
function headerFrom (t :: Text) (i :: Integer) (n :: Integer) (on :: Integer) (fuel :: Integer) -> Integer is
  if fuel <= 0 || i >= n then on
  else (let s = headerStep t i n on in (if s.stop then s.on else headerFrom t s.next n s.on (fuel - 1) end if) end let) end if
end function

function headerState (source :: Text) -> Integer is headerFrom source 0 (prelude.length source) 0 (prelude.length source + 1) end function

-- The header turns the preprocessor on, for sure.
function cppPragma (source :: Text) -> Bool is headerState source = 1 end function

-- Next cycle 11 (review 13, B3; rule C19). A carriage return that no
-- line feed follows is a line end to the preprocessor (GCC 15.2,
-- measured: `x = 1 -- note`, CR, `#if 0` opens a group; `#define CK`,
-- CR, `helper` gives CK no body; a backslash before it joins; and the
-- text that comes out has a line more). This model's rows are lines by
-- line feeds, as ax's are. So a source that holds such a carriage
-- return is OUTSIDE THE MODEL (`bad` 1: ax must leave every fact of it
-- undecided, `wp.crTerm`) wherever the preprocessor may read it and
-- may read it otherwise than these rows do: where the source is
-- preprocessed as it stands (h is 1 or 2), or a `#` stands anywhere
-- after the first such carriage return (a directive line the rows do
-- not show, or a pragma of the header). Where neither holds, no line
-- of the source is a directive under either reading and no pragma
-- stands after that point: the source is its own copy.
-- `loneCrAt`: the index of the first carriage return at or after i that
-- no line feed follows; -1 for none.
function loneCrAt (t :: Text) (i :: Integer) (n :: Integer) (fuel :: Integer) -> Integer is
  let j = findText t "\r" i n (n + 1) in
    (if fuel <= 0 || j < 0 then 0 - 1
     else (if charAt t (j + 1) = "\n" then loneCrAt t (j + 2) n (fuel - 1) else j end if) end if)
  end let
end function

function lfBefore (t :: Text) (i :: Integer) (j :: Integer) (fuel :: Integer) -> Integer is
  let k = findText t "\n" i j (j + 1) in (if fuel <= 0 || k < 0 then 0 else 1 + lfBefore t (k + 1) j (fuel - 1) end if) end let
end function

-- The line of the first lone carriage return, lines counted by line
-- feeds from 1; 0 when the source has none.
function crLine (source :: Text) -> Integer is
  let n = prelude.length source in let j = loneCrAt source 0 n (n + 1) in
    (if j < 0 then 0 else 1 + lfBefore source 0 j (n + 1) end if)
  end let end let
end function

-- h: what the source is as it stands (0 not preprocessed, 1
-- preprocessed, 2 the header is in doubt).
function crMarked (h :: Integer) (source :: Text) -> Bool is
  let n = prelude.length source in let j = loneCrAt source 0 n (n + 1) in
    j >= 0 && (h != 0 || ((prelude.drop j source) contains "#"))
  end let end let
end function

function isDirectiveRow (r :: Row) -> Bool is r.directive end function

-- What the preprocessor makes of a source.
type Run is a record{
  text :: Text
  bad :: Integer
  free :: Bool}
end type

-- Next cycle 10 (review 12, S1): the same, with what its kept lines of
-- code were seen to hold (`shaped`): a call the preprocessor makes
-- through a replaced name (`viaAlias`), the same with a chain of aliases
-- on the line (`viaChain`), and a macro's name at a line's end with the
-- `(` opening the next line (`nextLine`). `bad` 3: a directive reads, as
-- a value, an own name the model has no value for.
type Trace is a record{
  text :: Text
  bad :: Integer
  free :: Bool
  viaAlias :: Bool
  viaChain :: Bool
  nextLine :: Bool}
end type

-- Its state between two lines: the open groups, the file's part of the
-- table, and a C comment that is open: the line that opened it, as far
-- as it was read (`held`), whether that line is kept, and how many lines
-- the comment has taken since.
type Pre is a record{
  stack :: List Frame
  file :: KeyVal Text Macro
  open :: Bool
  held :: Text
  heldLive :: Bool
  skipped :: Integer
  total :: Integer}
end type

function bare (t :: Text) -> Text is if prelude.endsWith t "\n" then prelude.take (prelude.length t - 1) t else t end if end function

function blankLines (n :: Integer) -> Text is if n <= 0 then "" else "\n" ++ blankLines (n - 1) end if end function

function emitted (t :: Text) (r :: Trace) -> Trace is r with text = t ++ r.text end function

function withScan (s :: Scanned) (r :: Trace) -> Trace is r with bad = worse s.bad r.bad , free = s.free && r.free end function

function withDirective (bad :: Integer) (free :: Bool) (r :: Trace) -> Trace is r with bad = worse bad r.bad , free = free && r.free end function

function shaped (x :: Lex) (raw :: Text) (out :: Text) (rest :: List Row) (r :: Trace) -> Trace is
  if !x.live then r
  else
    (let through = callShape x false out 0 (prelude.length out) "" (scanFuel out) && !(callShape x false raw 0 (prelude.length raw) "" (scanFuel raw)) in
      r with viaAlias = r.viaAlias || through ,
             viaChain = r.viaChain || (through && chainAt x raw 0 (prelude.length raw) (scanFuel raw)) ,
             nextLine = r.nextLine || (callShape x true out 0 (prelude.length out) "" (scanFuel out) && nextOpens rest)
    end let)
  end if
end function

function holdsUnder (v :: Outcome) (l :: Literal) -> Bool is
  first matching case of v : when Known k then (k != 0) != l.negated otherwise false end case
end function

function scanFuel (t :: Text) -> Integer is 6 * prelude.length t + 64 end function

function ranFrom (env :: Env) (s :: Pre) (rs :: List Row) -> Trace is
  first matching case of rs :
    when Nil then Trace record{ text = "" , bad = (if s.open then 2 else 0 end if) , free = true , viaAlias = false , viaChain = false , nextLine = false}
    when Cons r rest then
      (let t = bare r.text in let n = prelude.length t in
        (if s.open then
           (let e = findClose t 0 n (n + 1) in
             (if e < 0 then ranFrom env (s with skipped = s.skipped + 1) rest
              else
                (let x = Lex record{ file = s.file , env = env , live = s.heldLive} in
                 let sc = scanAt x t e n "" [] (scanFuel t) in
                  (if sc.open then withScan sc (ranFrom env (s with held = s.held ++ sc.out , skipped = s.skipped + 1) rest)
                   else withDirective (outside x (prelude.length rest > 0) (s.held ++ sc.out)) true
                          (withScan sc (emitted ((if s.heldLive then s.held ++ sc.out else "" end if) ++ blankLines (s.skipped + 2))
                                                (ranFrom env (s with open = false , held = "" , skipped = 0) rest))) end if)
                end let end let) end if)
           end let)
         else (if r.directive then
           (first matching case of (if reachedIn s.stack r then ownLit r else Absent end if) :
             when Present l then
               (let v = directiveRead s.file env (s.total - prelude.length rest) l in
                 withDirective (directiveBad s.file env l v) (directiveFree s.file env l)
                   (emitted "\n" (ranFrom env (s with stack = stepped s.stack r (holdsUnder v l)) rest)) end let)
             when Absent then
               emitted "\n" (ranFrom env (s with stack = stepped s.stack r false ,
                                                 file = (if liveOf s.stack && !(r.sets matches SetsNothing) then prelude.put r.name (macroOf r) s.file else s.file end if)) rest)
           end case)
         else
           (let x = Lex record{ file = s.file , env = env , live = liveOf s.stack} in
            let sc = scanAt x t 0 n "" [] (scanFuel t) in
             (if sc.open then withScan sc (ranFrom env (s with open = true , held = sc.out , heldLive = liveOf s.stack , skipped = 0) rest)
              else withDirective (outside x (prelude.length rest > 0) sc.out) true
                     (shaped x t sc.out rest (withScan sc (emitted ((if liveOf s.stack then sc.out else "" end if) ++ "\n") (ranFrom env s rest)))) end if)
           end let end let) end if) end if)
      end let end let)
  end case
end function

-- The preprocessor on a source, under a complete environment. A source
-- that is not preprocessed (rule C1: no directive line once its lines
-- are joined, and no pragma) is its own text, backslashes and all.
-- Next cycle 10 (review 12, B3): the pragma counts in the file's header
-- only (`headerState`); where the header is not read to its end and CPP
-- is named after that point, the source is outside the model.
-- Next cycle 11 (review 13, B3): and where a lone carriage return makes
-- the preprocessor's lines other than these rows (`crMarked`).
function ranAll (env :: Env) (rs :: List Row) -> Trace is
  let js = splicedRows rs (2 * prelude.length rs + 2) in
  let h = (if prelude.any isDirectiveRow js then 1 else headerState (sourceOf rs) end if) in
  let cr = crMarked h (sourceOf rs) in
    (if h = 0 && !cr then Trace record{ text = sourceOf rs , bad = 0 , free = true , viaAlias = false , viaChain = false , nextLine = false}
     else withDirective (if h = 2 || cr then 1 else 0 end if) true
            (ranFrom env (Pre record{ stack = [] , file = prelude.keyValOf [] , open = false , held = "" , heldLive = false , skipped = 0 , total = prelude.length js}) js) end if)
  end let end let end let
end function

function ran (env :: Env) (rs :: List Row) -> Run is
  let r = ranAll env rs in Run record{ text = r.text , bad = r.bad , free = r.free} end let
end function

-- ---------------------------------------------------------------------------
-- The fourth model (next cycle 8; review 10, B1, B2, N1, N5): a module of
-- the third model, laced with what the first three never draw.
--   * A directive is rewritten, two in seven: to a test of Cabal's macro
--     of a package `zz` (`#ifdef MIN_VERSION_zz`, `#ifndef`,
--     `#if MIN_VERSION_zz(1,2,0)`, and their `#elif` forms), or to a
--     compound over its own name and another (`N && M`, `N || M`,
--     `defined(N) && !defined(M)`, `N + M > 1`, `!N`).
--   * Before a line of code, one time in five, a definition stands: of
--     the macro CALL (a name, another name, no body, an argument list
--     in three forms, `#undef`); of a pool name (no body; another pool name; 1; 0;
--     `#undef`); of MIN_VERSION_zz itself (an argument list and the body
--     1; `#undef`); or, before a declaration, a C comment opened in a
--     line of code that hides a `#define`, or a whole `#ifdef` group.
--   * A line of code gains a use, eight times in thirteen: `CALL k`,
--     `CALL(k)`, a pool name that a directive of the module names,
--     `CALL` inside a string, `CALL` after an open quote, a C comment.
-- Next cycle 9 (review 11: B1, S3, N1): the shapes the review found
-- undrawn. A definition may be `#define ALIAS CALL`, an object-like
-- macro whose body is CALL, whatever CALL is then, and `#undef ALIAS`;
-- before a declaration may stand a line of code that ends in a backslash
-- with a `#define` after it (the preprocessor joins them: the `#define`
-- is text), a string gap over two lines with CALL after it, or a
-- declaration that ends in CALL with `(k)` on the next line. A use may
-- be `ALIAS k`, `ALIAS(k)`, `id CALL` (the name ends the line) or
-- `-- see CALL`. `#define N M` now takes for M a name the directives
-- name (rule C12 (c) then holds whatever M's value: a name no directive
-- names is rule C16's, which needs the names given and is held by rows).
-- So a special name is defined and tested; a name with no value, or with
-- another name's, is read as a value and under `defined`; a directive
-- mixes a name of the file with one of the environment; a macro is used
-- in code as a name, as a call, under any nesting; and a comment hides a
-- directive. The environments are the 64 over the three names, each with
-- the package `zz` given at 1.2.0, given at 1.1.0, or said absent.

function otherName (n :: Text) (k :: Integer) -> Text is
  if n = "P" then (if k = 0 then "Q" else "R" end if) else (if n = "Q" then (if k = 0 then "P" else "R" end if) else (if k = 0 then "P" else "Q" end if) end if) end if
end function

-- 0 `defined(MIN_VERSION_zz)`; 1 its negation; 2 `MIN_VERSION_zz(1,2,0)`.
function zzLit (kind :: Integer) -> Literal is
  if kind = 2 then Literal record{ negated = false , text = "MIN_VERSION_zz(1,2,0)" , expr = MinVersion record{ pkg = "zz" , major1 = Lit 1 , major2 = Lit 2 , minor = Lit 0}}
  else Literal record{ negated = (kind = 1) , text = "defined(MIN_VERSION_zz)" , expr = IsDefined "MIN_VERSION_zz"} end if
end function

function compoundLit (kind :: Integer) (n :: Text) (m :: Text) -> Literal is
  first matching case of kind :
    when 0 then Literal record{ negated = false , text = n ++ " && " ++ m , expr = Bin record{ op = BLand , left = Name n , right = Name m}}
    when 1 then Literal record{ negated = false , text = n ++ " || " ++ m , expr = Bin record{ op = BLor , left = Name n , right = Name m}}
    when 2 then Literal record{ negated = false , text = "defined(" ++ n ++ ") && !defined(" ++ m ++ ")" ,
                                expr = Bin record{ op = BLand , left = IsDefined n , right = Un record{ op = UNot , arg = IsDefined m}}}
    when 3 then Literal record{ negated = false , text = n ++ " + " ++ m ++ " > 1" ,
                                expr = Bin record{ op = BGt , left = Bin record{ op = BAdd , left = Name n , right = Name m} , right = Lit 1}}
    otherwise Literal record{ negated = true , text = n , expr = Name n}
  end case
end function

function ifWord (first :: Bool) -> Text is if first then "#if " else "#elif " end if end function

-- Next cycle 10 (review 12, B1): a directive on one of the
-- preprocessor's own names. 0 `#ifdef __FILE__`; 1 `#ifndef __DATE__`;
-- 2 `#if __LINE__ > c`; 3 `#if defined(__TIME__) && N`, N the
-- directive's own name. The first two the file decides (rule C18); the
-- other two nothing decides, and the preprocessor's answer is the line
-- number's and N's.
function ownLitOf (kind :: Integer) (n :: Text) (c0 :: Integer) -> Literal is
  first matching case of kind :
    when 0 then Literal record{ negated = false , text = "defined(__FILE__)" , expr = IsDefined "__FILE__"}
    when 1 then Literal record{ negated = true , text = "defined(__DATE__)" , expr = IsDefined "__DATE__"}
    when 2 then Literal record{ negated = false , text = "__LINE__ > " ++ prelude.textOf c0 , expr = Bin record{ op = BGt , left = Name "__LINE__" , right = Lit c0}}
    otherwise Literal record{ negated = false , text = "defined(__TIME__) && " ++ n , expr = Bin record{ op = BLand , left = IsDefined "__TIME__" , right = Name n}}
  end case
end function

function ownDirective (first :: Bool) (kind :: Integer) (n :: Text) (c0 :: Integer) -> Text is
  if kind = 0 then (if first then "#ifdef __FILE__" else "#elifdef __FILE__" end if)
  else (if kind = 1 then (if first then "#ifndef __DATE__" else "#elifndef __DATE__" end if)
  else ifWord first ++ (ownLitOf kind n c0).text end if) end if
end function

function ownNameOf (kind :: Integer) (n :: Text) -> Text is
  if kind = 0 then "__FILE__" else (if kind = 1 then "__DATE__" else (if kind = 2 then "__LINE__" else n end if) end if) end if
end function

function laceOpener (seed :: Integer) (k :: Integer) (r :: Row) -> Row is
  if !r.reads then r
  else
    (let how = pick seed (34000 + k) 7 in let first = isIf r in let outer = prelude.take (prelude.length r.terms - 1) r.terms in
      (if how = 0 then
         (let z = pick seed (35000 + k) 3 in
           opener ((if z = 2 then ifWord first ++ "MIN_VERSION_zz(1,2,0)"
                    else (if first then (if z = 0 then "#ifdef " else "#ifndef " end if) else (if z = 0 then "#elifdef " else "#elifndef " end if) end if) ++ "MIN_VERSION_zz" end if))
                  (outer ++ [zzLit z]) "MIN_VERSION_zz" end let)
       else (if how = 1 then
         (let kind = pick seed (36000 + k) 5 in let m = otherName r.name (pick seed (37000 + k) 2) in
           opener (ifWord first ++ (if kind = 4 then "!" ++ r.name else (compoundLit kind r.name m).text end if)) (outer ++ [compoundLit kind r.name m]) r.name end let end let)
       else (if how = 2 then
         (let kind = pick seed (42000 + k) 4 in let c0 = pick seed (43000 + k) 61 in
           opener (ownDirective first kind r.name c0) (outer ++ [ownLitOf kind r.name c0]) (ownNameOf kind r.name) end let end let)
       else r end if) end if) end if)
    end let end let end let)
  end if
end function

function laceOpeners (seed :: Integer) (rs :: List Row) (k :: Integer) -> List Row is
  first matching case of rs : when Nil then [] when Cons r rest then [laceOpener seed k r] ++ laceOpeners seed rest (k + 1) end case
end function

function isPoolName (n :: Text) -> Bool is n = "P" || n = "Q" || n = "R" end function

-- The pool names the directives name, each once.
function poolNamesOf (rs :: List Row) (acc :: List Text) -> List Text is
  first matching case of rs :
    when Nil then acc
    when Cons r rest then
      poolNamesOf rest (if (r.reads || !(r.sets matches SetsNothing)) && isPoolName r.name && !(acc contains r.name) then acc ++ [r.name] else acc end if)
  end case
end function

function nameAt (names :: List Text) (i :: Integer) -> Text is
  first matching case of prelude.at (if prelude.length names > 0 then prelude.rem i (prelude.length names) else 0 end if) names :
    when Present n then n
    when Absent then "P"
  end case
end function

-- The definition before a line of code, or none. `decl`: a declaration
-- may stand here.
function otherIn (names :: List Text) (n :: Text) -> Text is
  first matching case of names :
    when Nil then ""
    when Cons m rest then (if m = n then otherIn rest n else m end if)
  end case
end function

-- Next cycle 10 (review 12, S1 and B2). The rows of the shapes that are
-- drawn whole, so that the call they are drawn for is made in every
-- build that keeps them: CALL with one argument, an alias of it, an
-- alias of the alias. And what stands between a line's last backslash
-- and its end: nothing, a form feed, a vertical tab, a blank and a tab.
function callBar (u :: Unit) (path :: List Literal) -> Row is macro "#define CALL(x) bar x" path "CALL" SetsOther "bar x" true end function
function callFoo (u :: Unit) (path :: List Literal) -> Row is macro "#define CALL(x) foo1 x" path "CALL" SetsOther "foo1 x" true end function
function aliasRow (u :: Unit) (path :: List Literal) -> Row is macro "#define ALIAS CALL" path "ALIAS" SetsOther "CALL" false end function
function alias2Row (u :: Unit) (path :: List Literal) -> Row is macro "#define ALIAS2 ALIAS" path "ALIAS2" SetsOther "ALIAS" false end function

function spliceTail (k :: Integer) -> Text is
  if k = 1 then "\f" else (if k = 2 then "\v" else (if k = 3 then " \t" else "" end if) end if) end if
end function

function laceDefs (seed :: Integer) (names :: List Text) (k :: Integer) (path :: List Literal) (decl :: Bool) -> List Row is
  if pick seed (33000 + k) 5 != 0 then []
  else
    (let n = nameAt names (pick seed (38000 + k) 3) in let kt = prelude.textOf k in
      (first matching case of pick seed (32000 + k) 29 :
        when 0 then [macro "#define CALL foo1" path "CALL" SetsOther "foo1" false]
        when 1 then [macro "#define CALL bar" path "CALL" SetsOther "bar" false]
        when 2 then [macro "#define CALL" path "CALL" SetsOther "" false]
        when 3 then [macro "#define CALL(x) bar x" path "CALL" SetsOther "bar x" true]
        when 4 then [definer "#undef CALL" path "CALL" Unsets]
        when 5 then [macro ("#define " ++ n) path n SetsOther "" false]
        when 6 then
          (if prelude.length (otherIn names n) = 0 then []
           else [macro ("#define " ++ n ++ " " ++ otherIn names n) path n SetsOther (otherIn names n) false] end if)
        when 7 then [macro "#define MIN_VERSION_zz(a,b,c) 1" path "MIN_VERSION_zz" SetsOther "1" true]
        when 8 then [definer "#undef MIN_VERSION_zz" path "MIN_VERSION_zz" Unsets]
        when 9 then [definer ("#define " ++ n ++ " 1") path n (SetsInt 1)]
        when 10 then [definer ("#undef " ++ n) path n Unsets]
        when 11 then [definer ("#define " ++ n ++ " 0") path n (SetsInt 0)]
        when 14 then [macro "#define CALL(x) foo1 x" path "CALL" SetsOther "foo1 x" true]
        when 15 then [macro "#define CALL(x, y) x" path "CALL" SetsOther "x" true]
        when 12 then
          (if decl then [row ("c" ++ kt ++ " = 0 {- /* -}") path false, definer ("#define " ++ n ++ " 1") path n (SetsInt 1), row "{- */ -}" path false] else [] end if)
        when 13 then
          (if decl then [row ("c" ++ kt ++ " = 0 /*") path false, opener ("#ifdef " ++ n) (path ++ [termOf true 1 n]) n, row ("h" ++ kt ++ " = 1") path false,
                         row "#endif" path true, row "*/" path false] else [] end if)
        when 16 then [macro "#define ALIAS CALL" path "ALIAS" SetsOther "CALL" false]
        when 17 then [macro "#define ALIAS2 ALIAS" path "ALIAS2" SetsOther "ALIAS" false]
        when 18 then
          (if decl then [row ("c" ++ kt ++ " = 0 -- \\" ++ spliceTail (pick seed (41000 + k) 4)) path false, definer ("#define " ++ n ++ " 1") path n (SetsInt 1)] else [] end if)
        when 19 then
          (if decl then [row ("s" ++ kt ++ " = \"a\\") path false, row "  \\b\" ++ show CALL" path false] else [] end if)
        when 20 then
          (if decl then [callBar unitValue path, row ("e" ++ kt ++ " = 1 + CALL") path false, row ("  (" ++ kt ++ ")") path false] else [] end if)
        when 21 then [definer "#undef ALIAS" path "ALIAS" Unsets]
        when 22 then
          (if decl then [callFoo unitValue path, aliasRow unitValue path, row ("qa" ++ kt ++ " = ALIAS(" ++ kt ++ ")") path false] else [] end if)
        when 23 then
          (if decl then [callBar unitValue path, aliasRow unitValue path, alias2Row unitValue path, row ("qb" ++ kt ++ " = ALIAS2 (" ++ kt ++ ")") path false] else [] end if)
        when 24 then
          (if decl then [callFoo unitValue path, row ("e" ++ kt ++ " = 2 + CALL") path false, row ("  (" ++ kt ++ ")") path false] else [] end if)
        when 25 then
          (if decl then [callBar unitValue path, aliasRow unitValue path, row ("qa" ++ kt ++ " = 1 + ALIAS (" ++ kt ++ ")") path false] else [] end if)
        when 26 then
          (if decl then [callFoo unitValue path, aliasRow unitValue path, alias2Row unitValue path, row ("qb" ++ kt ++ " = 1 + ALIAS2(" ++ kt ++ ")") path false] else [] end if)
        when 27 then [definer "#undef ALIAS2" path "ALIAS2" Unsets]
        otherwise [macro "#define CALL(x) bar x" path "CALL" SetsOther "bar x" true]
      end case)
    end let end let)
  end if
end function

function usePlace (t :: Text) -> Bool is prelude.startsWith t "w" || prelude.startsWith t "  + " || prelude.startsWith t "z = " end function

function declPlace (t :: Text) -> Bool is prelude.startsWith t "w" || prelude.startsWith t "z = " || prelude.startsWith t "t" end function

function laceUse (seed :: Integer) (names :: List Text) (k :: Integer) (r :: Row) -> Row is
  if !(usePlace r.text) then r
  else
    (let how = pick seed (31000 + k) 19 in
      (if how > 13 || (how = 4 && prelude.length names = 0) then r
       else r with text = bare r.text
              ++ (first matching case of how :
                   when 0 then " + CALL " ++ prelude.textOf k
                   when 1 then " + CALL " ++ prelude.textOf k
                   when 2 then " + CALL(" ++ prelude.textOf k ++ ")"
                   when 3 then " + CALL (" ++ prelude.textOf k ++ ")"
                   when 4 then " + " ++ nameAt names (pick seed (39000 + k) 3)
                   when 5 then " + \"CALL\""
                   when 6 then " + v0' CALL"
                   when 8 then " + ALIAS " ++ prelude.textOf k
                   when 9 then " + ALIAS(" ++ prelude.textOf k ++ ")"
                   when 10 then " + id CALL"
                   when 11 then " -- see CALL"
                   when 12 then " + ALIAS2(" ++ prelude.textOf k ++ ")"
                   when 13 then " + ALIAS2 " ++ prelude.textOf k
                   otherwise " /* c */"
                 end case) ++ "\n" end if)
    end let)
  end if
end function

function laced (seed :: Integer) (names :: List Text) (rs :: List Row) (k :: Integer) -> List Row is
  first matching case of rs :
    when Nil then []
    when Cons r rest then
      (if r.directive then [r] else laceDefs seed names k r.terms (declPlace r.text) ++ [laceUse seed names k r] end if) ++ laced seed names rest (k + 1)
  end case
end function

-- A module of the fourth model, as its lines.
function lace (seed :: Integer) -> List Row is
  let a = laceOpeners seed (weave seed) 0 in laced seed (poolNamesOf a []) a 0 end let
end function

-- (The moduli of the draws above are 5, 7, 19 and 29 on purpose; they
-- were 5, 7, 13 and 17 before cycle 9 added its shapes, and 5, 7, 17 and
-- 23 before cycle 10 added the chain, the shapes drawn whole and the
-- directive on an own name. `pick`
-- reads the low bits of a linear congruence, and two draws by powers of
-- two at places a fixed distance apart are one draw: with 4 and 16, no
-- module had a special name defined or a call of a macro, in 300 cases.)

-- The package `zz` of an environment: 0 given at 1.2.0, 1 given at 1.1.0,
-- 2 said absent. A drawn one is given three times in four.
function zzOf (se :: Integer) -> Integer is
  let p = pick se 1 4 in (if p = 3 then 2 else (if p = 2 then 1 else 0 end if) end if) end let
end function

function laceEnvAt (i :: Integer) (z :: Integer) -> Env is
  let e = poolEnvAt i in
    (if z = 0 then e with versions = prelude.put "zz" [1, 2, 0] e.versions
     else (if z = 1 then e with versions = prelude.put "zz" [1, 1, 0] e.versions
     else e with names = prelude.put "MIN_VERSION_zz" (wp.notDefined unitValue) e.names end if) end if)
  end let
end function

-- What the harness says of a module of the fourth model: how many of the
-- 64 environments (with the package state z) end as `kind` says: 0 a
-- text ax must decide, 1 a text ax may leave undecided, 2 outside the
-- model, 3 an error.
function kindOf (r :: Run) -> Integer is
  if r.bad >= 2 then 3 else (if r.bad = 1 then 2 else (if r.free then 0 else 1 end if) end if) end if
end function

function laceCount (rs :: List Row) (z :: Integer) (kind :: Integer) (n :: Integer) -> Integer is
  if n <= 0 then 0 else (if kindOf (ran (laceEnvAt (n - 1) z) rs) = kind then 1 else 0 end if) + laceCount rs z kind (n - 1) end if
end function

-- Next cycle 9 (review 11, S2). HSC-15 holds eight of the 64 environments
-- a case, not all of them: the eight at a stride of 21 from a drawn
-- start (21 is 1 + 4 + 16: each of the three names changes state at
-- every step). The start is drawn by a modulus that is no power of two,
-- since `zzOf` reads the same seed by 4.
function laceStart (se :: Integer) -> Integer is prelude.rem (pick se 2 67) 64 end function

function laceEnvIdx (from :: Integer) (k :: Integer) -> Integer is prelude.rem (from + 21 * k) 64 end function

function laceCountAt (rs :: List Row) (z :: Integer) (kind :: Integer) (from :: Integer) (n :: Integer) -> Integer is
  if n <= 0 then 0
  else (if kindOf (ran (laceEnvAt (laceEnvIdx from (n - 1)) z) rs) = kind then 1 else 0 end if) + laceCountAt rs z kind from (n - 1) end if
end function

function laceNamesMacro (rs :: List Row) -> Bool is (sourceOf rs) contains "CALL" end function

-- Next cycle 10 (review 12, S1): what the preprocessor DOES under one of
-- the `n` environments at a stride from `from`. `which`: 0 it calls a
-- macro through an alias; 1 through a chain of aliases; 2 with the `(`
-- on the line after the macro's name. Cycle 9's floors asked whether
-- the source's text held the shape, and GCC made the call in 2 of 200
-- drawn modules, and in none with the `(` on the next line.
function shapeOf (r :: Trace) (which :: Integer) -> Bool is
  if which = 0 then r.viaAlias else (if which = 1 then r.viaChain else r.nextLine end if) end if
end function

function laceShapeAt (rs :: List Row) (z :: Integer) (which :: Integer) (from :: Integer) (n :: Integer) -> Bool is
  if n <= 0 then false
  else shapeOf (ranAll (laceEnvAt (laceEnvIdx from (n - 1)) z) rs) which || laceShapeAt rs z which from (n - 1) end if
end function

-- A directive on an own name; a join over a form feed or a vertical tab.
function laceOwnDirective (rs :: List Row) -> Bool is
  ((sourceOf rs) contains "def __FILE__\n") || ((sourceOf rs) contains "def __DATE__\n") || ((sourceOf rs) contains "if __LINE__ > ") || ((sourceOf rs) contains "if defined(__TIME__)")
end function

function laceJoinsWide (rs :: List Row) -> Bool is ((sourceOf rs) contains "\\\f\n") || ((sourceOf rs) contains "\\\v\n") end function

function laceAliases (rs :: List Row) -> Bool is ((sourceOf rs) contains "#define ALIAS CALL") && (((sourceOf rs) contains " + ALIAS") || ((sourceOf rs) contains " = ALIAS")) end function

function laceEndsInName (rs :: List Row) -> Bool is
  ((sourceOf rs) contains " + id CALL\n") || ((sourceOf rs) contains " -- see CALL\n") || ((sourceOf rs) contains " + CALL\n")
end function

function laceSplices (rs :: List Row) -> Bool is ((sourceOf rs) contains "\\\n") || ((sourceOf rs) contains "\\ \t\n") || laceJoinsWide rs end function

function laceHides (rs :: List Row) -> Bool is ((sourceOf rs) contains "{- /* -}") || ((sourceOf rs) contains " = 0 /*") end function

function laceDefinesSpecial (rs :: List Row) -> Bool is ((sourceOf rs) contains "#define MIN_VERSION_zz") || ((sourceOf rs) contains "#undef MIN_VERSION_zz") end function

-- ---------------------------------------------------------------------------
-- Next cycle 8 (rule C14): an environment that gives SOME of the three
-- names. `mask` says which: bit 0 P, bit 1 Q, bit 2 R. What it gives, it
-- gives as `poolEnvAt i` has it (a name that environment leaves undefined
-- is said undefined). It is not complete.
function givenState (n :: Text) (c0 :: Integer) (given :: Bool) (acc :: KeyVal Text Binding) -> KeyVal Text Binding is
  if !given then acc else (if c0 = 0 then prelude.put n (wp.notDefined unitValue) acc else prelude.put n (wp.definedAs (c0 - 1)) acc end if) end if
end function

function poolGivenAt (i :: Integer) (mask :: Integer) -> Env is
  (emptyEnv unitValue) with names =
    givenState "P" (prelude.rem i 4) (prelude.rem mask 2 = 1)
      (givenState "Q" (prelude.rem (prelude.quot i 4) 4) (prelude.rem (prelude.quot mask 2) 2 = 1)
        (givenState "R" (prelude.rem (prelude.quot i 16) 4) (prelude.rem (prelude.quot mask 4) 2 = 1) (prelude.keyValOf [])))
end function

-- ---------------------------------------------------------------------------
-- Next cycle 8: review 10's sources, as rows. The texts are
-- next-cycle-8/repros/*.hs.

-- B1 (`special.hs`): the fallback of transformers-compat, then a test of
-- the macro.
function reproSpecial (u :: Unit) -> List Row is
  let nd = termOf true 2 "MIN_VERSION_base" in
    codeRows ["{-# LANGUAGE CPP #-}", "module M where"] []
      ++ [opener "#ifndef MIN_VERSION_base" [nd] "MIN_VERSION_base",
          macro "#define MIN_VERSION_base(a,b,c) 1" [nd] "MIN_VERSION_base" SetsOther "1" true, row "#endif" [negate nd] true]
      ++ oneGroup [] 1 "MIN_VERSION_base" ["f = 1"] false []
      ++ codeRows ["g = 2"] []
  end let
end function

function ghcAtLeast800 (u :: Unit) -> Literal is
  Literal record{ negated = false , text = "__GLASGOW_HASKELL__ >= 800" , expr = Bin record{ op = BGe , left = Name "__GLASGOW_HASKELL__" , right = Lit 800}}
end function

-- B1 (`special2.hs`): GHC's version name, and a version macro's name with
-- a plain value, defined by the file and read.
function reproSpecial2 (u :: Unit) -> List Row is
  codeRows ["module M where"] []
    ++ [definer "#define __GLASGOW_HASKELL__ 900" [] "__GLASGOW_HASKELL__" (SetsInt 900)]
    ++ oneArm (ghcAtLeast800 unitValue) "#if __GLASGOW_HASKELL__ >= 800" "__GLASGOW_HASKELL__" ["a = 1"]
    ++ [definer "#define MIN_VERSION_base 1" [] "MIN_VERSION_base" (SetsInt 1)]
    ++ oneGroup [] 0 "MIN_VERSION_base" ["b = 2"] false []
end function

-- B2 (`expand.hs`): object-like macros in code.
function reproExpand (u :: Unit) -> List Row is
  codeRows ["module M where"] []
    ++ [macro "#define CHECK helper" [] "CHECK" SetsOther "helper" false, definer "#define LIMIT 3" [] "LIMIT" (SetsInt 3),
        macro "#define NOTHING" [] "NOTHING" SetsOther "" false, macro "#define TWICE CHECK (CHECK LIMIT)" [] "TWICE" SetsOther "CHECK (CHECK LIMIT)" false]
    ++ codeRows ["helper :: Int -> Int", "helper x = x", "f = CHECK 1", "g = CHECK' 1 + x' CHECK", "h = \"CHECK\" ++ show (M.CHECK LIMIT)",
                 "k = NOTHING helper NOTHING 2", "m = TWICE"] []
    ++ [definer "#undef CHECK" [] "CHECK" Unsets] ++ codeRows ["n = CHECK"] []
end function

function reproExpandText (u :: Unit) -> Text is
  "module M where\n\n\n\n\nhelper :: Int -> Int\nhelper x = x\nf = helper 1\ng = helper' 1 + x' helper\nh = \"CHECK\" ++ show (M.helper 3)\nk =  helper  2\nm = helper (helper 3)\n\nn = CHECK\n"
end function

-- B2 (`funlike.hs`): a macro with an argument list, called in one arm.
function reproFunlike (u :: Unit) -> List Row is
  codeRows ["module M where"] []
    ++ [macro "#define WRAP(ty) ty" [] "WRAP" SetsOther "ty" true, macro "#define CHECK helper" [] "CHECK" SetsOther "helper" false]
    ++ codeRows ["helper :: Int -> Int", "helper x = x"] []
    ++ oneGroup [] 0 "A" ["f = CHECK 1"] true ["g :: WRAP(Int)", "g = CHECK 2"]
    ++ codeRows ["h = WRAP"] []
end function

-- N1 (`codecomment.hs`): a C comment opened in a line of code hides a
-- `#define`.
function reproCodeComment (u :: Unit) -> List Row is
  codeRows ["{-# LANGUAGE CPP #-}", "module M where", "foo = 1 {- /* -}"] []
    ++ [definer "#define A 1" [] "A" (SetsInt 1)] ++ codeRows ["{- */ -}"] []
    ++ oneGroup [] 1 "A" ["f = 1"] false [] ++ codeRows ["g = 0"] []
end function

-- N1 (`m4.hs`): the comment hides a whole group.
function reproHidden (u :: Unit) -> List Row is
  codeRows ["{-# LANGUAGE CPP #-}", "module M where", "f = 1 -- /*"] [] ++ oneGroup [] 0 "A" ["g = 2"] false [] ++ codeRows ["h = 3 -- */"] []
end function

-- `envname.hs`: names of the directives, read in code.
function reproEnvName (u :: Unit) -> List Row is
  let nd = termOf true 2 "LIMIT" in
    codeRows ["module M where"] []
      ++ [opener "#ifndef LIMIT" [nd] "LIMIT", definer "#define LIMIT 1" [nd] "LIMIT" (SetsInt 1), row "#endif" [negate nd] true]
      ++ codeRows ["f = LIMIT"] [] ++ oneGroup [] 1 "FAST" ["g = 1"] false [] ++ codeRows ["h = FAST", "k = OTHER"] []
  end let
end function

-- ---------------------------------------------------------------------------
-- Next cycle 9: review 11's sources, as rows. The texts are
-- next-cycle-9/repros/*.hs; GCC's text of each is in
-- next-cycle-9/tools/gcc-rows.txt.

function funF (u :: Unit) -> Row is macro "#define F(x) helper x" [] "F" SetsOther "helper x" true end function

function underF (defs :: List Row) (code :: List Text) -> List Row is
  codeRows ["module M where"] [] ++ [funF unitValue] ++ defs ++ codeRows code []
end function

function aliasA (u :: Unit) -> Row is macro "#define A F" [] "A" SetsOther "F" false end function

-- B1 (`alias.hs`): an object-like macro whose body is a macro with an
-- argument list, then `(`.
function reproAlias (u :: Unit) -> List Row is underF [aliasA unitValue] ["f = A(1)", "g = A (2)"] end function

-- The same alias with no `(` after it, and not at a line's end: no call.
function reproAliasPlain (u :: Unit) -> List Row is underF [aliasA unitValue] ["f = A + 1", "g = 2"] end function

-- B1 (`callnext.hs`): the `(` on the next line.
function reproCallNext (u :: Unit) -> List Row is underF [] ["f = F", "  (1)"] end function

-- N1 (`nameend.hs`): the name ends a line, in a Haskell comment.
function reproNameEnd (u :: Unit) -> List Row is underF [] ["f = 1 -- see F", "g = 2", "h = 3"] end function

-- The name mid-line with no `(`, and as the source's last word: no call.
function reproNameMid (u :: Unit) -> List Row is underF [] ["f = F x", "g = F"] end function

-- S3 (`gap.hs`): a string gap, then a macro.
function reproGap (u :: Unit) -> List Row is
  codeRows ["module M where"] [] ++ [macro "#define CHECK helper" [] "CHECK" SetsOther "helper" false]
    ++ codeRows ["s = \"abc\\", "    \\def\" ++ CHECK 1", "t = 2"] []
end function

-- S3 (`splice.hs`): a Haskell comment that ends in a backslash takes the
-- `#define`, the `#if` and the `#endif` after it. (Every row is written
-- as code: once the lines are joined the source has no directive line,
-- and it is the pragma that makes it a preprocessed source.)
function reproSplice (u :: Unit) -> List Row is
  codeRows ["{-# LANGUAGE CPP #-}", "module M where", "-- see C:\\", "#define CHECK helper", "f = CHECK 1", "x = 1 -- \\", "#if 0", "y = 2 -- \\", "#endif"] []
end function

-- N3 (`nodir.hs`): the pragma and no directive line; and the same lines
-- without the pragma.
function reproNoDirective (pragma :: Bool) -> List Row is
  codeRows ((if pragma then ["{-# LANGUAGE CPP #-}"] else ["{-# LANGUAGE BangPatterns #-}"] end if) ++ ["module M where", "f = g /* see below */ 1", "g = id"]) []
end function

-- N2 (`envbody.hs`): a name of the environment in a macro's body.
function reproEnvBody (u :: Unit) -> List Row is
  codeRows ["module M where"] [] ++ [macro "#define X Y" [] "X" SetsOther "Y" false] ++ codeRows ["f = X 1", "g = 2"] []
end function

-- The preprocessor's own name, and a body that ends inside a quote.
function reproOwnName (u :: Unit) -> List Row is underF [] ["f = __LINE__", "g = 2"] end function

function reproQuoteBody (u :: Unit) -> List Row is
  codeRows ["module M where"] [] ++ [macro "#define Q '" [] "Q" SetsOther "'" false] ++ codeRows ["f = Q x", "g = 2"] []
end function

-- ---------------------------------------------------------------------------
-- Next cycle 10: review 12's sources, as rows. The texts are
-- next-cycle-10/repros/*.hs; GCC's text of each is in
-- next-cycle-10/tools/gcc-rows.txt.

function notDefinedLit (n :: Text) -> CExpr is Un record{ op = UNot , arg = IsDefined n} end function

function lineIs (op :: BinOp) (v :: Integer) -> CExpr is Bin record{ op = op , left = Name "__LINE__" , right = Lit v} end function

function plainLit (text :: Text) (e :: CExpr) -> Literal is Literal record{ negated = false , text = text , expr = e} end function

-- B1 (`owndefined.hs`): directives that only ask whether an own name is
-- defined. The file decides them all.
function reproOwnDefined (u :: Unit) -> List Row is
  codeRows ["module M where"] [] ++ oneGroup [] 1 "__FILE__" ["withFile = 1"] true ["noFile = 1"]
    ++ oneArm (plainLit "!defined(__TIME__) || !defined(__STDC_HOSTED__)" (Bin record{ op = BLor , left = notDefinedLit "__TIME__" , right = notDefinedLit "__STDC_HOSTED__"}))
              "#if !defined(__TIME__) || !defined(__STDC_HOSTED__)" "__TIME__" ["none = 1"]
    ++ oneGroup [] 2 "__has_include" ["noInc = 1"] false [] ++ codeRows ["g = 2"] []
end function

-- B1 (`ownvalue.hs`): `__LINE__` read as a value, at lines 2, 7 and 10.
function reproOwnValue (u :: Unit) -> List Row is
  codeRows ["module M where"] [] ++ oneArm (plainLit "__LINE__ > 5" (lineIs BGt 5)) "#if __LINE__ > 5" "__LINE__" ["early = 1"]
    ++ codeRows ["a = 0", "b = 0"] [] ++ oneArm (plainLit "__LINE__ == 7" (lineIs BEq 7)) "#if __LINE__ == 7" "__LINE__" ["late = 1"]
    ++ oneArm (plainLit "defined(__COUNTER__) && __LINE__ >= 10" (Bin record{ op = BLand , left = IsDefined "__COUNTER__" , right = lineIs BGe 10}))
              "#if defined(__COUNTER__) && __LINE__ >= 10" "__COUNTER__" ["both = 1"]
    ++ codeRows ["g = 2"] []
end function

-- B1 (`owntaken.hs`): the file undefines one own name and defines
-- another: from there on they are the file's.
function reproOwnTaken (u :: Unit) -> List Row is
  codeRows ["module M where"] [] ++ [definer "#undef __FILE__" [] "__FILE__" Unsets] ++ oneGroup [] 1 "__FILE__" ["a = 1"] false []
    ++ [definer "#define __LINE__ 7" [] "__LINE__" (SetsInt 7)] ++ oneArm (plainLit "__LINE__ == 7" (lineIs BEq 7)) "#if __LINE__ == 7" "__LINE__" ["b = 2"]
    ++ codeRows ["c = __LINE__"] []
end function

-- B1 (`ownerror.hs`, `ownloose.hs`, `ownline7.hs`, `ownmixed.hs`).
function reproOwnError (u :: Unit) -> List Row is
  codeRows ["module M where"] []
    ++ oneArm (plainLit "0 && __FILE__" (Bin record{ op = BLand , left = Lit 0 , right = Name "__FILE__"})) "#if 0 && __FILE__" "__FILE__" ["a = 1"] ++ codeRows ["g = 2"] []
end function

function reproOwnLoose (u :: Unit) -> List Row is
  codeRows ["module M where"] []
    ++ oneArm (plainLit "__COUNTER__ == 0" (Bin record{ op = BEq , left = Name "__COUNTER__" , right = Lit 0})) "#if __COUNTER__ == 0" "__COUNTER__" ["a = 1"] ++ codeRows ["g = 2"] []
end function

function reproOwnLine7 (u :: Unit) -> List Row is
  codeRows ["module M where"] [] ++ oneArm (plainLit "__LINE__ == 7" (lineIs BEq 7)) "#if __LINE__ == 7" "__LINE__" ["b = 2"]
end function

function reproOwnMixed (u :: Unit) -> List Row is
  codeRows ["module M where"] []
    ++ oneArm (plainLit "defined(__FILE__) && FOO" (Bin record{ op = BLand , left = IsDefined "__FILE__" , right = Name "FOO"})) "#if defined(__FILE__) && FOO" "FOO" ["a = 1"]
    ++ codeRows ["g = 2"] []
end function

-- B2 (`joinwide.hs`): a form feed, a vertical tab, and a blank and a tab
-- between a line's last backslash and its end. (The lines the joins
-- take are written as code: they are text once joined.)
function reproJoinWide (u :: Unit) -> List Row is
  codeRows ["module M where"] [] ++ [macro "#define CHECK helper" [] "CHECK" SetsOther "helper" false]
    ++ codeRows ["x = 1 -- see C:\\\f", "#define CHECK other", "f = CHECK 1", "y = 2 -- \\\v", "#if 0", "hidden = 1", "-- \\\v", "#endif", "z = 3 \\ \t", "  + 4"] []
end function

-- N1 (`hashblank.hs`): a vertical tab or a form feed after the `#`,
-- after the directive's word and after its name; and a form feed BEFORE
-- the `#`, which is no directive (it stands in a Haskell block comment,
-- so that the text is Haskell either way).
function reproHashBlank (u :: Unit) -> List Row is
  let dk = termOf true 1 "DK" in
    codeRows ["module M where"] [] ++ [definer "#define CK 1" [] "CK" (SetsInt 1), definer "#\vundef CK" [] "CK" Unsets] ++ codeRows ["f = CK"] []
      ++ [definer "# \f define\fDK\v2" [] "DK" (SetsInt 2)] ++ codeRows ["g = DK"] []
      ++ [opener "#ifdef\fDK\v" [dk] "DK"] ++ codeRows ["h = 1"] [dk] ++ [row "#endif\f" [negate dk] true] ++ codeRows ["{-", "\f#define EK 1", "-}", "k = EK"] []
  end let
end function

-- S1 (`chain.hs`, review 11's p20): an alias of an alias, called. And a
-- form feed between the macro's name and its `(` (`callff.hs`).
function reproChain (u :: Unit) -> List Row is underF [aliasA unitValue, macro "#define B A" [] "B" SetsOther "A" false] ["f = B(1)"] end function

function reproCallFf (u :: Unit) -> List Row is underF [] ["f = F\f(1)", "g = 2"] end function

function reproHostedCode (u :: Unit) -> List Row is underF [] ["f = __STDC_HOSTED__", "g = 2"] end function

-- O157 (`minus.hs`): a minus sign before a name.
function reproMinus (u :: Unit) -> List Row is
  codeRows ["module M where"] []
    ++ oneArm (plainLit "-N == 3" (Bin record{ op = BEq , left = Un record{ op = UMinus , arg = Name "N"} , right = Lit 3})) "#if -N == 3" "N" ["a = 1"] ++ codeRows ["g = 4"] []
end function

-- B3: a header's pieces, drawn (HSC-24 holds the extraction's reading of
-- the header against `headerState` on them). No piece holds a C
-- comment, a quote that is not closed, a backslash or a macro's name:
-- preprocessed or not, each stands as it is written.
-- Next cycle 11 (review 13, B1, B2, B3): eleven pieces more. Review 13
-- found the extraction's reading and this one apart on `{-}` (the `-`
-- belongs to the opener, and the `}` is text), and no piece held it.
-- 18 to 23 are the shapes of nesting where an opener and a closer
-- share a character or stand alone: `{-} -}` and `{-}-}` (a whole
-- comment), `{- a {-} -}` (a comment left open: it takes the pieces
-- after it, up to their first closer), `-}` alone (an operator: the
-- header ends), `{--}`, `{-{-}-}-}`. 24 and 25 are a LINE pragma that
-- ends in `-}` and a COLUMN pragma (in doubt). 26 and 27 are comments
-- with a line that begins with `#`: with a closer on that line (in
-- doubt), and without one (a comment). 28 ends in a carriage return
-- with no line feed, unless the next piece begins with one (rule C19).
function headerPiece (k :: Integer) -> Text is
  first matching case of k :
    when 0 then "{-# LANGUAGE CPP #-}\n"
    when 1 then "{-# LANGUAGE NoCPP #-}\n"
    when 2 then "-- see {-# LANGUAGE CPP #-}\n"
    when 3 then "{- a {- b -} {-# LANGUAGE CPP #-} -}\n"
    when 4 then "module M where\n"
    when 5 then "x = \"{-# LANGUAGE CPP #-}\"\n"
    when 6 then "{-# OPTIONS_GHC -Wall -cpp #-}\n"
    when 7 then "{-# INLINE f #-}\n"
    when 8 then "{-# FOO bar #-}\n"
    when 9 then "--| doc\n"
    when 10 then "\n  \t\n"
    when 11 then "{-# language Strict,\n  CPP #-}"
    when 12 then "--été\n"
    when 13 then "{-# OPTIONS_GHC \"-cpp\" #-}\n"
    when 14 then "{-# OPTIONS_HADDOCK hide #-} {-# LINE 3 \"f\" #-}\n"
    when 15 then "--- rule\n"
    when 16 then "{-# OPTIONS -XNoCPP #-}\n"
    when 17 then "{-# LANGUAGE Strict {- CPP -} #-}\n"
    when 18 then "{-} -}\n"
    when 19 then "{- a {-} -}\n"
    when 20 then "{-}-}\n"
    when 21 then "-}\n"
    when 22 then "{--}\n"
    when 23 then "{-{-}-}-}\n"
    when 24 then "{-# LINE 1 \"M.hs\" -}\n"
    when 25 then "{-# COLUMN 1 #-}\n"
    when 26 then "{- a\n#! b -}\n"
    when 27 then "{-\n# title\n-}\n"
    when 28 then "-- c\r"
    otherwise "import Z\n"
  end case
end function

function headerOf (seed :: Integer) (k :: Integer) (n :: Integer) -> Text is
  if n <= 0 then "" else headerPiece (pick seed (51000 + k) 30) ++ headerOf seed (k + 1) (n - 1) end if
end function

function headerText (seed :: Integer) -> Text is headerOf seed 0 (1 + pick seed 50999 5) end function

-- ---------------------------------------------------------------------------
-- The reference agrees with itself.

function newlines (t :: Text) (i :: Integer) -> Integer is
  if i <= 0 then 0 else (if prelude.take 1 (prelude.drop (i - 1) t) = "\n" then 1 else 0 end if) + newlines t (i - 1) end if
end function

function sameLength (n :: Integer) (t :: Text) -> Bool is newlines t (prelude.length t) = n end function

function inList (xs :: List Text) (t :: Text) -> Bool is xs contains t end function

-- What each of the pool's 64 environments keeps is among the copies.
function poolBuildsIn (rs :: List Row) (copies :: List Text) (n :: Integer) -> Bool is
  if n <= 0 then true else inList copies (buildText (poolEnvAt (n - 1)) rs) && poolBuildsIn rs copies (n - 1) end if
end function

law "|every copy has the source's line count, and an environment's build is one of the copies| is
  id: "HCP-1"
  description :
    "No copy moves a line. For a source within the cap, what any complete
    environment keeps is the copy of one of the builds: the builds are
    every build. Beyond the cap there is one copy, the first build's.
    Next cycle 6: also for the third model (free nesting), and there and
    in the second model for every one of the 64 environments over the
    three names, not for one drawn. Next cycle 7: what an environment
    keeps is the preprocessor's own walk with its macro table
    (`buildText`), so in the third model also where the file defines or
    undefines a name; and on the first and second model, which define
    nothing, that walk keeps exactly the lines whose written path holds
    (`pathBuildText`, cycle 6's reading)."
  end description
  definition :
    for all (seed :: Integer) (se :: Integer) =>
      (let m = moduleOf seed in
        prelude.all (sameLength (prelude.length (rowsOf m))) (copies m)
          && (if overCap m then copies m = [firstCopy m] else inList (copies m) (buildOf (buildEnv se m) m) end if)
          && pathBuildText (buildEnv se m) (rowsOf m) = buildOf (buildEnv se m) m end let)
        && (let t = tangle seed in
          prelude.all (sameLength (prelude.length t)) (copiesOfRows t) && !(overCapRows t) && inList (copiesOfRows t) (buildText (tangleEnv se) t)
            && poolBuildsIn t (copiesOfRows t) 64 && pathBuildText (tangleEnv se) t = buildText (tangleEnv se) t end let)
        && (let w = weave seed in
          prelude.all (sameLength (prelude.length w)) (copiesOfRows w) && !(overCapRows w) && poolBuildsIn w (copiesOfRows w) 64 end let)
    end for all
  end definition
end law

law "|a path's condition is written as the rules say| is
  id: "HCP-2"
  definition :
    conditionText [] = ""
    && conditionText [termOf true 0 "A"] = "A"
    && conditionText [termOf true 3 "A"] = "(defined(A) && A >= 2)"
    && conditionText [termOf true 2 "A"] = "!(defined(A))"
    && conditionText [negate (termOf true 2 "A")] = "defined(A)"
    && conditionText [negate (termOf true 0 "A"), termOf false 2 "B"] = "!(A) && !(defined(B))"
    && directiveOf false 2 "B" = "#elif !defined(B)"
    && conditionText [termOf true 1 "A", negate (termOf true 3 "B"), termOf false 3 "C"] = "defined(A) && !(defined(B) && B >= 2) && (defined(C) && C >= 2)"
  end definition
end law

function ifdefP (yes :: Text) -> List Row is oneGroup [] 1 "P" [yes] false [] end function

law "|two groups with one condition are one choice; opposite conditions are the same choice turned| is
  id: "HCP-3"
  description :
    "Review 7, B1 (b). Three `#ifdef P` groups give two builds, not eight:
    no build has the first group's lines without the others'. `#ifndef P`
    after `#ifdef P` gives two builds as well, each with one group's lines.
    Two different names give four, in the order of the first term's value,
    true first. A term inside a group that fails is no choice. Nine
    independent groups are more builds than are read."
  end description
  definition :
    copiesOfRows (ifdefP "a = 1" ++ ifdefP "b = 2" ++ ifdefP "c = 3") = ["\na = 1\n\n\nb = 2\n\n\nc = 3\n\n", "\n\n\n\n\n\n\n\n\n"]
    && copiesOfRows (ifdefP "a = 1" ++ oneGroup [] 2 "P" ["b = 2"] false []) = ["\na = 1\n\n\n\n\n", "\n\n\n\nb = 2\n\n"]
    && copiesOfRows (ifdefP "a = 1" ++ oneGroup [] 0 "P" ["b = 2"] true ["c = 3"])
         = ["\na = 1\n\n\nb = 2\n\n\n\n", "\na = 1\n\n\n\n\nc = 3\n\n", "\n\n\n\nb = 2\n\n\n\n", "\n\n\n\n\n\nc = 3\n\n"]
    && copiesOfRows (oneGroup [] 0 "P" ["a = 1"] false [] ++ oneGroup [] 0 "Q" ["b = 2"] false [])
         = ["\na = 1\n\n\nb = 2\n\n", "\na = 1\n\n\n\n\n", "\n\n\n\nb = 2\n\n", "\n\n\n\n\n\n"]
    && buildCount (tangleNest unitValue) = 3
    && buildCount (wideRows 8) = 256 && !(overCapRows (wideRows 8))
    && overCapRows (wideRows 9) && prelude.length (copiesOfRows (wideRows 9)) = 1
  end definition
end law

law "|the builds are exactly what the preprocessor keeps under every assignment of the terms| is
  id: "HCP-4"
  description :
    "Review 8, B1: the law that does not share rule C2's rule. For any
    module of the second and of the third model, and for a module of the
    first with at most eight terms: the copies rule C2 gives (a choice
    where the walk meets a term with no value) are, one for one and in
    order, the copies got with no rule of choice: every assignment of the
    terms, each walked as the preprocessor walks, the distinct outcomes
    kept. So no build is missing (the defect of cycle 4's rule), none is
    invented, and none stands twice. HCP-1 holds only that an
    environment's build is among the copies, for the environments it
    tries; this is an equality, over every assignment. Next cycle 7
    (review 9, B2 and S2): half the modules of the third model hold
    `#define` and `#undef` lines of the three names, under any nesting,
    and `#elifdef` and `#elifndef` arms; a directive the file's
    definitions decide is no term on that walk, and the two routes must
    still give the same copies."
  end description
  definition :
    for all (seed :: Integer) =>
      copiesOfRows (tangle seed) = everyCopies (tangle seed)
        && copiesOfRows (weave seed) = everyCopies (weave seed)
        && (let m = rowsOf (moduleOf seed) in prelude.length (termsIn m []) > 8 || copiesOfRows m = everyCopies m end let)
    end for all
  end definition
end law

law "|review 8's three sources: a term whose later directive is guarded by a term written after it| is
  id: "HCP-5"
  description :
    "Review 8, B1, repros (c), (b) and (a), to the letter. In each, B is
    first read inside `#if P`, and again where P does not matter: under
    `#if Q`, or in a later arm of P's own group. With P false the second
    directive is still reached, so B is a choice there: the builds are
    five, seven and seven. Cycle 4's rule gave four, six and six: with P
    false it never asked for B, and `b = 2` (or the tail `+ bar 2`) was
    in no copy. The copies are listed as next-cycle-6/tools/cppbuilds.py
    printed them, and are those of every assignment."
  end description
  definition :
    sourceOf (reproElif unitValue) = "{-# LANGUAGE CPP #-}\nmodule M where\n#if P\n#if B\na = 1\n#endif\n#elif Q\nq = 0\n#elif B\nb = 2\n#endif\nc = 3\n"
    && copiesOfRows (reproElif unitValue) = reproElifCopies unitValue
    && everyCopies (reproElif unitValue) = reproElifCopies unitValue
    && sourceOf (reproLost unitValue) = "{-# LANGUAGE CPP #-}\nmodule M where\n#if P\n#ifdef B\na = 1\n#endif\n#endif\n#if Q\n#ifdef B\nb = 2\n#endif\n#endif\nc = 3\n"
    && copiesOfRows (reproLost unitValue) = reproLostCopies unitValue
    && everyCopies (reproLost unitValue) = reproLostCopies unitValue
    && sourceOf (reproTail unitValue)
         = "{-# LANGUAGE CPP #-}\nmodule M where\nimport Z (bar)\n#if P\n#ifdef B\nx = 1\n#endif\n#endif\nf :: Int\nf = 1\n#if Q\n#ifdef B\n  + bar 2\n#else\n  + 3\n#endif\n#endif\n"
    && copiesOfRows (reproTail unitValue) = reproTailCopies unitValue
    && everyCopies (reproTail unitValue) = reproTailCopies unitValue
    && buildCount (reproElif unitValue) = 5 && buildCount (reproLost unitValue) = 7 && buildCount (reproTail unitValue) = 7
    && inList (copiesOfRows (reproLost unitValue)) "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\n\nb = 2\n\n\nc = 3\n"
  end definition
end law

law "|review 9: a name the file defines or undefines is the file's, not the environment's| is
  id: "HCP-6"
  description :
    "Review 9, B2, and rule C8, to the letter. (1) `#define HAS_VOID 1`
    under `#if MIN_VERSION_base(4,8,0)`, then `#ifdef HAS_VOID`: three
    builds. With the version test true the file defines the name and the
    group is kept, with no question; with it false the name is the
    environment's, defined or not. Cycle 6 had four builds, asked the
    environment for HAS_VOID in each, and with base 4.18 given and every
    other name undefined dropped `f`, which the preprocessor keeps: the
    first copy is what it keeps. (2) The guard `#ifndef LIMIT` /
    `#define LIMIT 1`: where the build gives no LIMIT it is 1, and the
    `#if LIMIT` and `#ifdef LIMIT` after it are decided. (3) A definition
    with no body is defined; an `#undef` undefines, also a name the
    environment gives; an integer body is the name's value, a comment
    after it apart; a name the file undefined after defining it is
    undefined. (4) Three directives the file reaches and does not
    decide: each is a choice of its own, sixteen builds with the
    version macro's own two. In every source the copies are those of
    every assignment of the terms, and what one environment keeps is
    the preprocessor's own walk with its macro table (`buildText`), which
    has no rule of choice in it. The copies were printed by
    next-cycle-7/tools/cpp7.py, which shares no code with this
    reference, and each environment's text there was compared with the
    real cpp's."
  end description
  definition :
    sourceOf (reproDefine unitValue) = "{-# LANGUAGE CPP #-}\nmodule M where\n#if MIN_VERSION_base(4,8,0)\n#define HAS_VOID 1\n#endif\n#ifdef HAS_VOID\nimport Data.Void (absurd)\nf = absurd\n#endif\ng :: Int\ng = 1\n"
    && copiesOfRows (reproDefine unitValue) = reproDefineCopies unitValue
    && everyCopies (reproDefine unitValue) = reproDefineCopies unitValue
    && buildCount (reproDefine unitValue) = 3
    && inList (prelude.take 1 (reproDefineCopies unitValue)) (buildText (base418 unitValue) (reproDefine unitValue))
    && sourceOf (reproGuard unitValue) = "{-# LANGUAGE CPP #-}\nmodule M where\n#ifndef LIMIT\n#define LIMIT 1\n#endif\n#if LIMIT\na = 1\n#else\nb = 2\n#endif\n#ifdef LIMIT\nc = 3\n#endif\n"
    && copiesOfRows (reproGuard unitValue) = reproGuardCopies unitValue
    && everyCopies (reproGuard unitValue) = reproGuardCopies unitValue
    && inList (prelude.take 1 (reproGuardCopies unitValue)) (buildText (noNames unitValue) (reproGuard unitValue))
    && inList (prelude.take 1 (prelude.drop 1 (reproGuardCopies unitValue))) (buildText (withName "LIMIT" 0 (noNames unitValue)) (reproGuard unitValue))
    && inList (prelude.take 1 (reproGuardCopies unitValue)) (buildText (withName "LIMIT" 2 (noNames unitValue)) (reproGuard unitValue))
    && sourceOf (reproDefs unitValue) = "{-# LANGUAGE CPP #-}\nmodule M where\n#if A\n#define HAS_X\n#else\n#undef HAS_Y\n#endif\n#ifdef HAS_X\na = 1\n#endif\n#ifndef HAS_Y\nb = 2\n#endif\n#ifdef HAS_Y\nc = 3\n#endif\n#define N 0x10 /* sixteen */\n#if N == 16 && defined(N)\nd = 4\n#endif\n#undef N\n#if N\ne = 5\n#else\nf = 6\n#endif\n"
    && copiesOfRows (reproDefs unitValue) = reproDefsCopies unitValue
    && everyCopies (reproDefs unitValue) = reproDefsCopies unitValue
    && inList (prelude.take 1 (prelude.drop 1 (reproDefsCopies unitValue))) (buildText (withName "A" 1 (noNames unitValue)) (reproDefs unitValue))
    && inList (prelude.take 1 (reproDefsCopies unitValue)) (buildText (withName "HAS_Y" 1 (withName "A" 1 (noNames unitValue))) (reproDefs unitValue))
    && inList (prelude.take 1 (prelude.drop 3 (reproDefsCopies unitValue))) (buildText (withName "HAS_Y" 1 (noNames unitValue)) (reproDefs unitValue))
    && inList (prelude.take 1 (prelude.drop 2 (reproDefsCopies unitValue))) (buildText (withName "N" 5 (withName "HAS_X" 1 (noNames unitValue))) (reproDefs unitValue))
    && sourceOf (reproUndecided unitValue) = "{-# LANGUAGE CPP #-}\nmodule M where\n#define HAS 1\n#if HAS && FOO\na = 1\n#endif\n#define EMPTY\n#if EMPTY\nb = 2\n#endif\n#ifndef MIN_VERSION_base\n#define MIN_VERSION_base(x,y,z) 1\n#endif\n#if MIN_VERSION_base(4,8,0)\nc = 3\n#endif\nd = 4\n"
    && buildCount (reproUndecided unitValue) = 16
    && copiesOfRows (reproUndecided unitValue) = everyCopies (reproUndecided unitValue)
    && termsIn (reproUndecided unitValue) []
         = ["HAS && FOO", wp.fileDefinedTerm 4, "EMPTY", wp.fileDefinedTerm 8, "defined(MIN_VERSION_base)", wp.fileDefinedTerm 11,
            "MIN_VERSION_base(4,8,0)", wp.fileDefinedTerm 14]
  end definition
end law

law "|#elifdef and #elifndef are #elif defined and #elif not defined| is
  id: "HCP-7"
  description :
    "Review 9, S2. `#elifdef N` and `#elifndef N` (C23; GCC 12 and later
    read them in every mode) are later arms whose term is `defined(N)`,
    the second negated: the one term `#ifdef N` and `#ifndef N` have.
    Cycle 6 did not know the words, took the lines for directives that
    do nothing, and merged their arms into the arm before: with A=0 and
    B defined it kept `k`, where the preprocessor keeps `g`. Four
    builds, in the order of the terms' values, true first: `f`; `g`;
    then C defined, which fails `#elifndef C` and leaves the `#else`
    (`k`); then `h`."
  end description
  definition :
    sourceOf (reproElifdef unitValue) = "{-# LANGUAGE CPP #-}\nmodule M where\n#if A\nf = 1\n#elifdef B\ng = 2\n#elifndef C\nh = 3\n#else\nk = 4\n#endif\n"
    && copiesOfRows (reproElifdef unitValue) = reproElifdefCopies unitValue
    && everyCopies (reproElifdef unitValue) = reproElifdefCopies unitValue
    && inList (prelude.take 1 (prelude.drop 1 (reproElifdefCopies unitValue))) (buildText (withName "B" 1 (withName "A" 0 (noNames unitValue))) (reproElifdef unitValue))
    && inList (prelude.take 1 (prelude.drop 3 (reproElifdefCopies unitValue))) (buildText (withName "A" 0 (noNames unitValue)) (reproElifdef unitValue))
    && inList (prelude.take 1 (prelude.drop 2 (reproElifdefCopies unitValue))) (buildText (withName "C" 0 (noNames unitValue)) (reproElifdef unitValue))
    && conditionText [negate (termOf true 0 "A"), negate (termOf false 5 "B"), termOf false 6 "C"] = "!(A) && !(defined(B)) && !(defined(C))"
  end definition
end law

-- ---------------------------------------------------------------------------
-- Next cycle 8: the preprocessor on text (`ran`).

-- For each of the n first environments, `ran` gives the text `buildText`
-- gives, with no error, and a build ax must decide.
function ranAgrees (rs :: List Row) (n :: Integer) -> Bool is
  if n <= 0 then true
  else ran (poolEnvAt (n - 1)) rs = Run record{ text = buildText (poolEnvAt (n - 1)) rs , bad = 0 , free = true} && ranAgrees rs (n - 1) end if
end function

function ranKeepsLines (rs :: List Row) (z :: Integer) (n :: Integer) -> Bool is
  if n <= 0 then true else sameLength (prelude.length rs) (ran (laceEnvAt (n - 1) z) rs).text && ranKeepsLines rs z (n - 1) end if
end function

law "|the preprocessor on text keeps what the line-keeping preprocessor keeps, where no line of code names a macro| is
  id: "HCP-8"
  description :
    "Next cycle 8 (review 10, B2 and N5). `ran` is the preprocessor as
    it reads a line of code too: quotes, C comments, a macro table, the
    file's object-like macros replaced. On a module of the second and
    of the third model, whose lines of code name no macro and open no
    comment, it must give, for every one of the 64 environments, the
    text `buildText` gives, with no error, as a build ax must decide: so
    the laws that hold ax against `buildText` (HSC-8, HSC-12, HSX-42)
    and the law that holds it against `ran` (HSC-15) are about one
    preprocessor. And on a module of the fourth model, whatever it
    answers, no line moves: the text has the source's line count, also
    where a C comment runs over lines (what follows the comment stands
    on the line that opened it, and the lines it took are empty)."
  end description
  definition :
    for all (seed :: Integer) (se :: Integer) =>
      ranAgrees (tangle seed) 64 && ranAgrees (weave seed) 64 && ranKeepsLines (lace seed) (zzOf se) 64
    end for all
  end definition
end law

function saidAbsent (p :: Text) (env :: Env) -> Env is env with names = prelude.put ("MIN_VERSION_" ++ p) (wp.notDefined unitValue) env.names end function

function reproSpecialCopies (u :: Unit) -> List Text is
  ["{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\nf = 1\n\ng = 2\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\nf = 1\n\ng = 2\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\ng = 2\n"]
end function

function reproSpecial2Copies (u :: Unit) -> List Text is
  ["module M where\n\n\na = 1\n\n\n\nb = 2\n\n",
   "module M where\n\n\na = 1\n\n\n\n\n\n",
   "module M where\n\n\n\n\n\n\nb = 2\n\n",
   "module M where\n\n\n\n\n\n\n\n\n"]
end function

law "|review 10: the preprocessor's text for a special name the file defines, a macro in code, and a comment that hides a directive| is
  id: "HCP-9"
  description :
    "Review 10, B1, B2 and N1, to the letter; every text here was
    compared with GCC's (next-cycle-8/tools/cpp8.py cmp). (B1) The
    fallback `#ifndef MIN_VERSION_base` / `#define MIN_VERSION_base(a,b,c)
    1`, then `#ifdef MIN_VERSION_base`: the preprocessor keeps `f` in
    every environment, with the package given, said absent, or not
    said. Rule C8c does not let the file decide a directive on a
    special name: three copies, the last two on the term that nothing
    decides. Where the file defined the macro, the build is one ax need
    not decide (`free` is false), and it must not decide it wrongly:
    the walk that forgets the rule takes `defined(MIN_VERSION_base)`
    for 'the package is said absent' and drops `f`. The same for
    `#define __GLASGOW_HASKELL__ 900` read by `#if __GLASGOW_HASKELL__
    >= 800`, and for `#define MIN_VERSION_base 1` read by `#if
    MIN_VERSION_base`: the preprocessor keeps both arms, ax leaves each
    undecided. (B2) Object-like macros in code: a name, a number, no
    body, a body that names other macros; replaced after a quote that
    closed, not inside a string, not after a quote left open (`x'`),
    under a qualifier, and not after `#undef`. The file's definition
    stands whatever the environment says of the name. A macro with an
    argument list, called: outside the model (`bad` 1) in the build
    that keeps the call, and a text in the build that does not; its
    name alone is no call. (N1) A C comment opened in a line of code
    hides the `#define` inside it: `#ifdef A` is then the
    environment's, and what follows the comment stands on the line
    that opened it. A comment in a Haskell line comment hides a whole
    group. (C12) A directive's name read in code: the file's
    definition is replaced; the environment's own value is replaced by
    the preprocessor and is not known to ax (`free` false)."
  end description
  definition :
    sourceOf (reproSpecial unitValue) = "{-# LANGUAGE CPP #-}\nmodule M where\n#ifndef MIN_VERSION_base\n#define MIN_VERSION_base(a,b,c) 1\n#endif\n#ifdef MIN_VERSION_base\nf = 1\n#endif\ng = 2\n"
    && copiesOfRows (reproSpecial unitValue) = reproSpecialCopies unitValue
    && everyCopies (reproSpecial unitValue) = reproSpecialCopies unitValue
    && ran (noNames unitValue) (reproSpecial unitValue) = Run record{ text = "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\nf = 1\n\ng = 2\n" , bad = 0 , free = false}
    && ran (saidAbsent "base" (noNames unitValue)) (reproSpecial unitValue) = ran (noNames unitValue) (reproSpecial unitValue)
    && ran (base418 unitValue) (reproSpecial unitValue) = Run record{ text = "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\nf = 1\n\ng = 2\n" , bad = 0 , free = true}
    && sourceOf (reproSpecial2 unitValue) = "module M where\n#define __GLASGOW_HASKELL__ 900\n#if __GLASGOW_HASKELL__ >= 800\na = 1\n#endif\n#define MIN_VERSION_base 1\n#if MIN_VERSION_base\nb = 2\n#endif\n"
    && copiesOfRows (reproSpecial2 unitValue) = reproSpecial2Copies unitValue
    && everyCopies (reproSpecial2 unitValue) = reproSpecial2Copies unitValue
    && ran (noNames unitValue) (reproSpecial2 unitValue) = Run record{ text = "module M where\n\n\na = 1\n\n\n\nb = 2\n\n" , bad = 0 , free = false}
    && sourceOf (reproExpand unitValue) = "module M where\n#define CHECK helper\n#define LIMIT 3\n#define NOTHING\n#define TWICE CHECK (CHECK LIMIT)\nhelper :: Int -> Int\nhelper x = x\nf = CHECK 1\ng = CHECK' 1 + x' CHECK\nh = \"CHECK\" ++ show (M.CHECK LIMIT)\nk = NOTHING helper NOTHING 2\nm = TWICE\n#undef CHECK\nn = CHECK\n"
    && ran (noNames unitValue) (reproExpand unitValue) = Run record{ text = reproExpandText unitValue , bad = 0 , free = true}
    && ran (withName "LIMIT" 9 (withName "CHECK" 5 (noNames unitValue))) (reproExpand unitValue) = Run record{ text = reproExpandText unitValue , bad = 0 , free = true}
    && sourceOf (reproFunlike unitValue) = "module M where\n#define WRAP(ty) ty\n#define CHECK helper\nhelper :: Int -> Int\nhelper x = x\n#if A\nf = CHECK 1\n#else\ng :: WRAP(Int)\ng = CHECK 2\n#endif\nh = WRAP\n"
    && ran (withName "A" 1 (noNames unitValue)) (reproFunlike unitValue)
         = Run record{ text = "module M where\n\n\nhelper :: Int -> Int\nhelper x = x\n\nf = helper 1\n\n\n\n\nh = WRAP\n" , bad = 0 , free = true}
    && (ran (noNames unitValue) (reproFunlike unitValue)).bad = 1
    && sourceOf (reproCodeComment unitValue) = "{-# LANGUAGE CPP #-}\nmodule M where\nfoo = 1 {- /* -}\n#define A 1\n{- */ -}\n#ifdef A\nf = 1\n#endif\ng = 0\n"
    && ran (noNames unitValue) (reproCodeComment unitValue) = Run record{ text = "{-# LANGUAGE CPP #-}\nmodule M where\nfoo = 1 {-  -}\n\n\n\n\n\ng = 0\n" , bad = 0 , free = true}
    && ran (withName "A" 1 (noNames unitValue)) (reproCodeComment unitValue)
         = Run record{ text = "{-# LANGUAGE CPP #-}\nmodule M where\nfoo = 1 {-  -}\n\n\n\nf = 1\n\ng = 0\n" , bad = 0 , free = true}
    && sourceOf (reproHidden unitValue) = "{-# LANGUAGE CPP #-}\nmodule M where\nf = 1 -- /*\n#if A\ng = 2\n#endif\nh = 3 -- */\n"
    && ran (noNames unitValue) (reproHidden unitValue) = Run record{ text = "{-# LANGUAGE CPP #-}\nmodule M where\nf = 1 -- \n\n\n\n\n" , bad = 0 , free = true}
    && ran (withName "A" 1 (noNames unitValue)) (reproHidden unitValue) = ran (noNames unitValue) (reproHidden unitValue)
    && sourceOf (reproEnvName unitValue) = "module M where\n#ifndef LIMIT\n#define LIMIT 1\n#endif\nf = LIMIT\n#ifdef FAST\ng = 1\n#endif\nh = FAST\nk = OTHER\n"
    && ran (noNames unitValue) (reproEnvName unitValue) = Run record{ text = "module M where\n\n\n\nf = 1\n\n\n\nh = FAST\nk = OTHER\n" , bad = 0 , free = true}
    && ran (withName "LIMIT" 5 (noNames unitValue)) (reproEnvName unitValue) = Run record{ text = "module M where\n\n\n\nf = 5\n\n\n\nh = FAST\nk = OTHER\n" , bad = 0 , free = false}
    && ran (withName "FAST" 1 (noNames unitValue)) (reproEnvName unitValue) = Run record{ text = "module M where\n\n\n\nf = 1\n\ng = 1\n\nh = 1\nk = OTHER\n" , bad = 0 , free = false}
  end definition
end law

function textRun (t :: Text) -> Run is Run record{ text = t , bad = 0 , free = true} end function

law "|review 11: a call the preprocessor finds after replacement or on a later line is outside the model; lines joined by a backslash; a module with the pragma and no directive| is
  id: "HCP-10"
  description :
    "Review 11, B1, S3, N1, N2 and N3, to the letter. Every text here is
    GCC's (15.2, `cpp -undef -traditional -nostdinc`;
    next-cycle-9/tools/gcc-rows.txt), and where GCC expands a call the
    answer is 'outside the model' (`bad` 1), never a text. (B1) An
    object-like macro whose body names a macro with an argument list,
    with `(` after it in the code: the preprocessor calls it; cycle 8's
    reference read the call off the text before replacement and
    answered with the unexpanded text as one ax must decide. The same
    alias with no `(` and not at its line's end is no call, and the
    text has the macro's name. The macro's name with its `(` on the
    next line: a call. (N1) The name as the last thing of a line that
    is not the source's last, in a Haskell comment too: the
    preprocessor looks on for the `(`, moves a line and takes a
    directive there for text; outside the model. The name before
    anything else on its line, or as the source's last word, is no
    call. (S3) A line of code that ends in a backslash takes the next
    line, before anything else is read: a string gap's two lines are
    one, the macro after it is replaced, and an empty line follows; a
    Haskell comment that ends in a backslash takes the `#define`, the
    `#if` and the `#endif` after it, and none of them is a directive.
    (N3) A source with the pragma `LANGUAGE CPP` and no directive line
    is preprocessed: its C comment is removed. With another pragma and
    no directive line it is its own text. The pragma is read in any
    case of the word, among other extensions, over lines, and as
    `OPTIONS_GHC -cpp`. (N2) A name of the environment in a macro's
    body is replaced by the preprocessor: a text ax need not decide
    (`free` false), and must not decide wrongly. One of the
    preprocessor's own names in code, and a macro whose body ends
    inside a quote: outside the model."
  end description
  definition :
    sourceOf (reproAlias unitValue) = "module M where\n#define F(x) helper x\n#define A F\nf = A(1)\ng = A (2)\n"
    && (ran (noNames unitValue) (reproAlias unitValue)).bad = 1
    && ran (noNames unitValue) (reproAliasPlain unitValue) = textRun "module M where\n\n\nf = F + 1\ng = 2\n"
    && sourceOf (reproCallNext unitValue) = "module M where\n#define F(x) helper x\nf = F\n  (1)\n"
    && (ran (noNames unitValue) (reproCallNext unitValue)).bad = 1
    && sourceOf (reproNameEnd unitValue) = "module M where\n#define F(x) helper x\nf = 1 -- see F\ng = 2\nh = 3\n"
    && (ran (noNames unitValue) (reproNameEnd unitValue)).bad = 1
    && ran (noNames unitValue) (reproNameMid unitValue) = textRun "module M where\n\nf = F x\ng = F\n"
    && sourceOf (reproGap unitValue) = "module M where\n#define CHECK helper\ns = \"abc\\\n    \\def\" ++ CHECK 1\nt = 2\n"
    && ran (noNames unitValue) (reproGap unitValue) = textRun "module M where\n\ns = \"abc    \\def\" ++ helper 1\n\nt = 2\n"
    && sourceOf (reproSplice unitValue) = "{-# LANGUAGE CPP #-}\nmodule M where\n-- see C:\\\n#define CHECK helper\nf = CHECK 1\nx = 1 -- \\\n#if 0\ny = 2 -- \\\n#endif\n"
    && ran (noNames unitValue) (reproSplice unitValue) = textRun "{-# LANGUAGE CPP #-}\nmodule M where\n-- see C:#define CHECK helper\n\nf = CHECK 1\nx = 1 -- #if 0\n\ny = 2 -- #endif\n\n"
    && sourceOf (reproNoDirective true) = "{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* see below */ 1\ng = id\n"
    && ran (noNames unitValue) (reproNoDirective true) = textRun "{-# LANGUAGE CPP #-}\nmodule M where\nf = g  1\ng = id\n"
    && ran (noNames unitValue) (reproNoDirective false) = textRun (sourceOf (reproNoDirective false))
    && cppPragma "{-# language ScopedTypeVariables, CPP #-}\nmodule M where\n"
    && cppPragma "{-# LANGUAGE\n    BangPatterns\n  , CPP\n  #-}\n"
    && cppPragma "{-# OPTIONS_GHC -Wall -cpp #-}\n"
    && cppPragma "{-# LANGUAGE Safe #-}\n{-# LANGUAGE CPP #-}\n"
    && !(cppPragma "{-# LANGUAGE CPPish #-}\n-- CPP\n")
    && !(cppPragma "{-# OPTIONS_GHC -Wno-cpp-undef #-}\nmodule M where\n")
    && sourceOf (reproEnvBody unitValue) = "module M where\n#define X Y\nf = X 1\ng = 2\n"
    && ran (noNames unitValue) (reproEnvBody unitValue) = textRun "module M where\n\nf = Y 1\ng = 2\n"
    && ran (withName "Y" 4 (noNames unitValue)) (reproEnvBody unitValue) = Run record{ text = "module M where\n\nf = 4 1\ng = 2\n" , bad = 0 , free = false}
    && (ran (noNames unitValue) (reproOwnName unitValue)).bad = 1
    && (ran (noNames unitValue) (reproQuoteBody unitValue)).bad = 1
  end definition
end law

function ranIs (r :: Run) (text :: Text) (bad :: Integer) (free :: Bool) -> Bool is r = Run record{ text = text , bad = bad , free = free} end function

law "|review 12: the preprocessor's own names in a directive, joins and directives over a form feed or a vertical tab, the pragma in the file's header, a minus sign pasted onto a negative value| is
  id: "HCP-11"
  description :
    "Review 12, B1, B2, B3, S1 and N1, and O157, to the letter. Every
    text here is GCC's (15.2, `cpp -undef -traditional -nostdinc`;
    next-cycle-10/tools/gcc-rows.txt); the header rows are GHC's rule,
    read from its lexer and its user's guide, since no GHC ran. (B1)
    The preprocessor defines 25 names of its own. A directive that
    asks whether one is defined holds, with nothing given: cycle 9's
    reference read them as names of the environment and dropped
    `withFile`. Such a directive is one ax must decide (`free`).
    `__LINE__` as a value is the directive's line; ax need not decide
    it. A string name as a value is an error, also in a branch that
    is not evaluated. Another own name as a value is `bad` 3: the
    model has no value for it and nothing is asked. A name the file
    undefines or defines is the file's from there on; one the names
    given hold is theirs. (B2) A backslash ends a line also with a
    form feed, a vertical tab, or blanks and tabs after it: cycle 9
    joined over blanks and tabs only, kept the second `#define` and
    lost `hidden`. (N1) The same four characters may stand after the
    `#`, after the directive's word and after a name; before the `#`
    they make the line code. Between a macro's name and its `(` too.
    (S1) An alias of an alias, called: outside the model, and seen as
    a call through a chain. (B3) The pragma turns the preprocessor on
    only in the header: not in a `--` comment, in a block comment, in
    a string, after `module` or after any other token; after `--|`,
    which is an operator, not at all; `NoCPP` after `CPP` turns it
    off; a pragma that is a token of its own (INLINE) ends the header
    and one GHC does not know is a comment; a `#!` line is passed
    over. Where the header cannot be read as GHC reads it and CPP is
    named after that point the answer is 2. (O157) `-N` with N given
    as -3 is an error; with N given as 3 it has a value."
  end description
  definition :
    sourceOf (reproOwnDefined unitValue)
      = "module M where\n#ifdef __FILE__\nwithFile = 1\n#else\nnoFile = 1\n#endif\n#if !defined(__TIME__) || !defined(__STDC_HOSTED__)\nnone = 1\n#endif\n#ifndef __has_include\nnoInc = 1\n#endif\ng = 2\n"
    && ran (noNames unitValue) (reproOwnDefined unitValue) = textRun "module M where\n\nwithFile = 1\n\n\n\n\n\n\n\n\n\ng = 2\n"
    && sourceOf (reproOwnValue unitValue)
         = "module M where\n#if __LINE__ > 5\nearly = 1\n#endif\na = 0\nb = 0\n#if __LINE__ == 7\nlate = 1\n#endif\n#if defined(__COUNTER__) && __LINE__ >= 10\nboth = 1\n#endif\ng = 2\n"
    && ranIs (ran (noNames unitValue) (reproOwnValue unitValue)) "module M where\n\n\n\na = 0\nb = 0\n\nlate = 1\n\n\nboth = 1\n\ng = 2\n" 0 false
    && sourceOf (reproOwnTaken unitValue) = "module M where\n#undef __FILE__\n#ifdef __FILE__\na = 1\n#endif\n#define __LINE__ 7\n#if __LINE__ == 7\nb = 2\n#endif\nc = __LINE__\n"
    && ranIs (ran (noNames unitValue) (reproOwnTaken unitValue)) "module M where\n\n\n\n\n\n\nb = 2\n\nc = 7\n" 0 false
    && sourceOf (reproOwnError unitValue) = "module M where\n#if 0 && __FILE__\na = 1\n#endif\ng = 2\n"
    && (ran (noNames unitValue) (reproOwnError unitValue)).bad = 2
    && (ran (noNames unitValue) (reproOwnLoose unitValue)).bad = 3
    && ranIs (ran (noNames unitValue) (reproOwnLine7 unitValue)) "module M where\n\n\n\n" 0 false
    && ranIs (ran (withName "__LINE__" 7 (noNames unitValue)) (reproOwnLine7 unitValue)) "module M where\n\nb = 2\n\n" 0 false
    && ranIs (ran (noNames unitValue) (reproOwnMixed unitValue)) "module M where\n\n\n\ng = 2\n" 0 false
    && ranIs (ran (withName "FOO" 1 (noNames unitValue)) (reproOwnMixed unitValue)) "module M where\n\na = 1\n\ng = 2\n" 0 false
    && copiesOfRows (reproOwnDefined unitValue) = ["module M where\n\nwithFile = 1\n\n\n\n\n\n\n\n\n\ng = 2\n"]
    && prelude.length (copiesOfRows (reproOwnValue unitValue)) = 8
    && copiesOfRows (reproOwnTaken unitValue) = ["module M where\n\n\n\n\n\n\nb = 2\n\nc = __LINE__\n"]
    && sourceOf (reproJoinWide unitValue)
         = "module M where\n#define CHECK helper\nx = 1 -- see C:\\\f\n#define CHECK other\nf = CHECK 1\ny = 2 -- \\\v\n#if 0\nhidden = 1\n-- \\\v\n#endif\nz = 3 \\ \t\n  + 4\n"
    && ran (noNames unitValue) (reproJoinWide unitValue)
         = textRun "module M where\n\nx = 1 -- see C:#define helper other\n\nf = helper 1\ny = 2 -- #if 0\n\nhidden = 1\n-- #endif\n\nz = 3   + 4\n\n"
    && sourceOf (reproHashBlank unitValue)
         = "module M where\n#define CK 1\n#\vundef CK\nf = CK\n# \f define\fDK\v2\ng = DK\n#ifdef\fDK\v\nh = 1\n#endif\f\n{-\n\f#define EK 1\n-}\nk = EK\n"
    && ran (noNames unitValue) (reproHashBlank unitValue) = textRun "module M where\n\n\nf = CK\n\ng = 2\n\nh = 1\n\n{-\n\f#define EK 1\n-}\nk = EK\n"
    && (ran (noNames unitValue) (reproCallFf unitValue)).bad = 1
    && (ran (noNames unitValue) (reproHostedCode unitValue)).bad = 1
    && (ran (noNames unitValue) (reproChain unitValue)).bad = 1
    && (ranAll (noNames unitValue) (reproChain unitValue)).viaChain && (ranAll (noNames unitValue) (reproChain unitValue)).viaAlias
    && (ranAll (noNames unitValue) (reproAlias unitValue)).viaAlias && !((ranAll (noNames unitValue) (reproAlias unitValue)).viaChain)
    && (ranAll (noNames unitValue) (reproCallNext unitValue)).nextLine && !((ranAll (noNames unitValue) (reproCallNext unitValue)).viaAlias)
    && !((ranAll (noNames unitValue) (reproNameEnd unitValue)).nextLine) && !((ranAll (noNames unitValue) (reproAliasPlain unitValue)).viaAlias)
    && (ran (withName "N" (0 - 3) (noNames unitValue)) (reproMinus unitValue)).bad = 2
    && ran (withName "N" 3 (noNames unitValue)) (reproMinus unitValue) = textRun "module M where\n\n\n\ng = 4\n"
    && headerState "{-# LANGUAGE CPP #-}\nmodule M where\n" = 1
    && headerState "-- enable with {-# LANGUAGE CPP #-}\nmodule M where\nf = g /* see */ 1\nx = 1 -- \\\ny = 2\n" = 0
    && headerState "module M where\nheader = \"{-# LANGUAGE CPP #-}\\n\"\nf = map \\\n  x -> g x\n" = 0
    && headerState "module M where\n{-# LANGUAGE CPP #-}\nf = g /* see */ 1\n" = 0
    && headerState "import X\n{-# LANGUAGE CPP #-}\n" = 0
    && headerState "{- a {- nested -} {-# LANGUAGE CPP #-} -}\nmodule M where\n" = 0
    && headerState "-- c\n{- d -}\n\n{-# OPTIONS_GHC -Wall #-}\n{-# LANGUAGE Safe #-}\n{-#LANGUAGE CPP#-}\nmodule M where\n" = 1
    && headerState "{-# LANGUAGE CPP #-}\n{-# LANGUAGE NoCPP #-}\nf = g /* c */ 1\n" = 0
    && headerState "{-# LANGUAGE NoCPP, CPP #-}\n" = 1
    && headerState "{-# OPTIONS_GHC -cpp -XNoCPP #-}\n" = 0
    && headerState "{-# OPTIONS -XCPP #-}\n" = 1
    && headerState "{-# INLINE f #-}\n{-# LANGUAGE CPP #-}\nf = g /* c */ 1\n" = 0
    && headerState "{-# FOO bar #-}\n{-# OPTIONS_HADDOCK hide #-}\n{-# INCLUDE \"f.h\" #-}\n{-# LANGUAGE CPP #-}\n" = 1
    && headerState "--| not a comment\n{-# LANGUAGE CPP #-}\n" = 0
    && headerState "---- a comment\n--\n{-# LANGUAGE CPP #-}\n" = 1
    && headerState "#!/usr/bin/env stack\n-- stack script\n{-# LANGUAGE CPP #-}\nmain = g /* c */ 1\n" = 1
    && headerState "{-# LANGUAGE CPP" = 0
    && headerState "--été\n{-# LANGUAGE CPP #-}\nf = g /* c */ 1\n" = 2
    && headerState "--été\nmodule M where\n" = 0
    && headerState "{-# LANGUAGE CPP #-}\n--été\nmodule M where\n" = 1
    && headerState "{-# LANGUAGE Strict {- CPP -} #-}\nmodule M where\n" = 2
    && headerState "{-# OPTIONS_GHC \"-cpp\" #-}\n" = 2
    && (ran (noNames unitValue) (codeRows ["--été", "{-# LANGUAGE CPP #-}", "f = g /* c */ 1"] [])).bad = 1
    && ran (noNames unitValue) (codeRows ["-- enable with {-# LANGUAGE CPP #-}", "module M where", "f = g /* see */ 1"] [])
         = textRun "-- enable with {-# LANGUAGE CPP #-}\nmodule M where\nf = g /* see */ 1\n"
  end definition
end law

law "|review 13: the shapes of a nested comment, a LINE pragma, a line that begins with # in a comment, and a carriage return alone| is
  id: "HCP-12"
  description :
    "Review 13, B1, B2 and B3 (next cycle 11). (B1) In a nested
    comment an opening brace and a dash open a level and are read
    together, and so are a dash and a closing brace: after an opener
    the dash is spent, and the brace that follows it is text. The
    extraction closed the comment there and read review 13's first
    source without the preprocessor and its second with it; this
    reference had GHC's reading, and no law asked. The rows are that
    question: an opener right before a closing brace, alone, twice,
    inside a comment, and beside the shapes that do close. (B2) A
    LINE pragma may end without its hash to GHC's lexer, and whether
    LINE and COLUMN are positions or tokens is a setting this
    reading does not know: either is a doubt, and the answer is 2
    where CPP is named from there on; where it is not, the answer so
    far stands. Cycle 10 passed both over to the next hash-closer,
    and so took a NoCPP after it for part of it. (Found while
    reading GHC's lexer for B1.) Inside a comment a line that begins
    with a hash is read by the lexer's rules for line pragmas, which
    can take the rest of the line: where such a line holds an opener
    or a closer the comment's end is in doubt. A hash line without
    them, and a hash that does not begin a line, are a comment's
    text. (B3, rule C19) A carriage return that no line feed follows
    is a line end to GCC 15.2
    (next-cycle-11/tools/measure.txt). A source that holds one is
    outside the model where it is preprocessed as it stands or a
    hash stands after the first of them; elsewhere it is its own
    copy. A carriage return before a line feed, and the first of two
    before a line feed, are told apart. GHC was not run: the header's
    rows are GHC's lexer as read, and next-cycle-11/tools/hdr.py is
    a third writing of the rule that gave every expected value here."
  end description
  definition :
    headerState "{-} -}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 1
    && headerState "{- a {-} -}\n{-# LANGUAGE CPP #-}\n-}\nmodule M where\nf = g /* c */ 1\n" = 0
    && headerState "{-}-}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 1
    && headerState "{--}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 1
    && headerState "{-{-}-}-}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 1
    && headerState "{-{-}-}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 0
    && headerState "{---}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 1
    && headerState "{-}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 0
    && headerState "-}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 0
    && headerState "{-#}\n{-# LANGUAGE CPP #-}\n-}\nmodule M where\nf = g /* c */ 1\n" = 0
    && headerState "{-#-}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 1
    && headerState "{-# LANGUAGE CPP #-}\n{-# LINE 1 \"M.hs\" -}\n{-# LANGUAGE NoCPP #-}\nmodule M where\nf = g /* c */ 1\n" = 2
    && headerState "{-# LINE 1 \"M.hs\" -}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 2
    && headerState "{-# LANGUAGE CPP #-}\n{-# LINE 1 \"M.hs\" #-}\nmodule M where\nf = g /* c */ 1\n" = 1
    && headerState "{-# LINE 1 \"M.hs\" #-}\nmodule M where\nf = g /* c */ 1\n" = 0
    && headerState "{-# LINE 1 \"M.hs\" #-}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 2
    && headerState "{-# COLUMN 1 #-}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 2
    && headerState "{-# LANGUAGE CPP #-}\n{-# column 1 #-}\n{-# OPTIONS_GHC -XNoCPP #-}\nmodule M where\nf = g /* c */ 1\n" = 2
    && headerState "{-\n#! a -}\n{-# LANGUAGE CPP #-}\n-}\nmodule M where\nf = g /* c */ 1\n" = 2
    && headerState "{-\n#1 \"x\" {- b\n-}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 2
    && headerState "{-\n# title\n-}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 1
    && headerState "{-# LANGUAGE CPP #-}\n{-\n#! a -}\nmodule M where\nf = g /* c */ 1\n" = 1
    && headerState "{-# FOO\n#! a -}\n{-# LANGUAGE CPP #-}\n-}\nmodule M where\nf = g /* c */ 1\n" = 2
    && headerState "{- a #! -}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 1
    && headerState (headerPiece 18 ++ "{-# LANGUAGE CPP #-}\nf = g /* c */ 1\n") = 1
    && headerState (headerPiece 19 ++ "{-# LANGUAGE CPP #-}\nf = g /* c */ 1\n") = 0
    && headerState (headerPiece 20 ++ "{-# LANGUAGE CPP #-}\nf = g /* c */ 1\n") = 1
    && headerState (headerPiece 21 ++ "{-# LANGUAGE CPP #-}\nf = g /* c */ 1\n") = 0
    && headerState (headerPiece 22 ++ "{-# LANGUAGE CPP #-}\nf = g /* c */ 1\n") = 1
    && headerState (headerPiece 23 ++ "{-# LANGUAGE CPP #-}\nf = g /* c */ 1\n") = 1
    && headerState (headerPiece 24 ++ "{-# LANGUAGE CPP #-}\nf = g /* c */ 1\n") = 2
    && headerState (headerPiece 25 ++ "{-# LANGUAGE CPP #-}\nf = g /* c */ 1\n") = 2
    && headerState (headerPiece 26 ++ "{-# LANGUAGE CPP #-}\nf = g /* c */ 1\n") = 2
    && headerState (headerPiece 27 ++ "{-# LANGUAGE CPP #-}\nf = g /* c */ 1\n") = 1
    && headerState (headerPiece 28 ++ "{-# LANGUAGE CPP #-}\nf = g /* c */ 1\n") = 0
    && crLine "{-# LANGUAGE CPP #-}\nmodule M where\nx = 1 -- note\r#if 0\nhidden = 1\n#endif\nk = 1\n" = 3 && crMarked 0 "{-# LANGUAGE CPP #-}\nmodule M where\nx = 1 -- note\r#if 0\nhidden = 1\n#endif\nk = 1\n"
    && crLine "{-# LANGUAGE CPP #-}\nmodule M where\n#define CK\rhelper\nf = CK 1\n" = 3 && !(crMarked 0 "{-# LANGUAGE CPP #-}\nmodule M where\n#define CK\rhelper\nf = CK 1\n")
    && crLine "module M where\nx = 1 -- a\ry = 2\nf = g /* c */ 1\n" = 2 && !(crMarked 0 "module M where\nx = 1 -- a\ry = 2\nf = g /* c */ 1\n")
    && crLine "module M where\nx = 1 -- a\r#if 0\nf = g /* c */ 1\n" = 2 && crMarked 0 "module M where\nx = 1 -- a\r#if 0\nf = g /* c */ 1\n"
    && crLine "-- c\r{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n" = 1 && crMarked 0 "-- c\r{-# LANGUAGE CPP #-}\nmodule M where\nf = g /* c */ 1\n"
    && crLine "{-# LANGUAGE CPP #-}\nmodule M where\nx = 1\ry = 2\nf = g /* c */ 1\n" = 3 && !(crMarked 0 "{-# LANGUAGE CPP #-}\nmodule M where\nx = 1\ry = 2\nf = g /* c */ 1\n")
    && crLine "{-# LANGUAGE CPP #-}\r\nmodule M where\r\nf = g /* c */ 1\r\n" = 0 && !(crMarked 0 "{-# LANGUAGE CPP #-}\r\nmodule M where\r\nf = g /* c */ 1\r\n")
    && crLine "module M where\r\nx = 1\r\r\ny = 2\r\n" = 2 && !(crMarked 0 "module M where\r\nx = 1\r\r\ny = 2\r\n")
    && crLine "module M where\nx = I# 1\ry = 2\n" = 2 && !(crMarked 0 "module M where\nx = I# 1\ry = 2\n")
    && crLine "module M where\nx = 1\ry = I# 2\n" = 2 && crMarked 0 "module M where\nx = 1\ry = I# 2\n"
    && crLine "x = 1\r" = 1 && !(crMarked 0 "x = 1\r")
    && crLine "\r\n\r#\n" = 2 && crMarked 0 "\r\n\r#\n"
    && crMarked 1 "module M where\nx = 1 -- a\ry = 2\n" && crMarked 2 "x = 1\r" && !(crMarked 1 "module M where\r\nx = 1\r\n")
    && (ran (noNames unitValue) (codeRows ["{-# LANGUAGE CPP #-}", "module M where", "x = 1\ry = 2", "f = g /* c */ 1"] [])).bad = 1
    && (ran (noNames unitValue) (codeRows ["module M where", "x = 1 -- a\r#if 0", "f = g /* c */ 1"] [])).bad = 1
    && (ran (noNames unitValue) (codeRows ["-- c\r{-# LANGUAGE CPP #-}", "module M where", "f = g /* c */ 1"] [])).bad = 1
    && ran (noNames unitValue) (codeRows ["module M where", "x = 1 -- a\ry = 2", "f = g /* c */ 1"] [])
         = textRun "module M where\nx = 1 -- a\ry = 2\nf = g /* c */ 1\n"
    && ran (noNames unitValue) (codeRows ["{-# LANGUAGE CPP #-}\r", "module M where\r", "f = g /* c */ 1\r"] [])
         = textRun "{-# LANGUAGE CPP #-}\r\nmodule M where\r\nf = g  1\r\n"
    && ran (noNames unitValue) (codeRows ["{-} -}", "{-# LANGUAGE CPP #-}", "module M where", "f = g /* c */ 1"] [])
         = textRun "{-} -}\n{-# LANGUAGE CPP #-}\nmodule M where\nf = g  1\n"
    && ran (noNames unitValue) (codeRows ["{- a {-} -}", "{-# LANGUAGE CPP #-}", "-}", "module M where", "f = g /* c */ 1"] [])
         = textRun "{- a {-} -}\n{-# LANGUAGE CPP #-}\n-}\nmodule M where\nf = g /* c */ 1\n"
    && (ran (noNames unitValue) (codeRows ["{-# LINE 1 \"M.hs\" -}", "{-# LANGUAGE CPP #-}", "module M where", "f = g /* c */ 1"] [])).bad = 1
  end definition
end law

function reproElifCopies (u :: Unit) -> List Text is
  ["{-# LANGUAGE CPP #-}\nmodule M where\n\n\na = 1\n\n\n\n\n\n\nc = 3\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\n\n\n\nc = 3\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\nq = 0\n\n\n\nc = 3\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\n\nb = 2\n\nc = 3\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\n\n\n\nc = 3\n"]
end function

function reproLostCopies (u :: Unit) -> List Text is
  ["{-# LANGUAGE CPP #-}\nmodule M where\n\n\na = 1\n\n\n\n\nb = 2\n\n\nc = 3\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\na = 1\n\n\n\n\n\n\n\nc = 3\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\n\n\n\n\nc = 3\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\n\n\n\n\nc = 3\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\n\nb = 2\n\n\nc = 3\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\n\n\n\n\nc = 3\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\n\n\n\n\n\n\n\n\n\n\nc = 3\n"]
end function

function reproTailCopies (u :: Unit) -> List Text is
  ["{-# LANGUAGE CPP #-}\nmodule M where\nimport Z (bar)\n\n\nx = 1\n\n\nf :: Int\nf = 1\n\n\n  + bar 2\n\n\n\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\nimport Z (bar)\n\n\nx = 1\n\n\nf :: Int\nf = 1\n\n\n\n\n\n\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\nimport Z (bar)\n\n\n\n\n\nf :: Int\nf = 1\n\n\n\n\n  + 3\n\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\nimport Z (bar)\n\n\n\n\n\nf :: Int\nf = 1\n\n\n\n\n\n\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\nimport Z (bar)\n\n\n\n\n\nf :: Int\nf = 1\n\n\n  + bar 2\n\n\n\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\nimport Z (bar)\n\n\n\n\n\nf :: Int\nf = 1\n\n\n\n\n  + 3\n\n\n",
   "{-# LANGUAGE CPP #-}\nmodule M where\nimport Z (bar)\n\n\n\n\n\nf :: Int\nf = 1\n\n\n\n\n\n\n\n"]
end function

-- `#ifdef P` with `#if Q` inside it: Q is read only where P is defined.
function tangleNest (u :: Unit) -> List Row is
  let own = termOf true 1 "P" in
    [opener "#ifdef P" [own] "P"] ++ oneGroup [own] 0 "Q" ["a = 1"] false [] ++ [row "#endif" [negate own] true]
  end let
end function

-- A module of n groups on n names, a declaration in each.
function wideRows (n :: Integer) -> List Row is
  if n <= 0 then codeRows ["module W where"] []
  else wideRows (n - 1) ++ oneGroup [] 0 ("W" ++ prelude.textOf n) ["w" ++ prelude.textOf n ++ " = " ++ prelude.textOf n] false [] end if
end function

-- ---------------------------------------------------------------------------
-- Next cycle 7 (review 9, N5): floors on what the drawn modules hold. The
-- laws above are equalities over models; a change to `pick`, `mix` or a
-- model that stopped drawing the shapes the equalities are for would
-- leave every one of them green and empty. Each floor is half, or less,
-- of the share measured over the law's own cases (design.md, section 9).
harness assayxport.haskell.cpp.testing for assayxport.haskell.cpp is
tags cpp
parallel
order random
timeout 5 min

for law "|every copy has the source's line count, and an environment's build is one of the copies|
classify (weaveNew seed) as "third model: with definitions and #elifdef"
classify (readOnTwoPaths (tangle seed)) as "second model: a term read on two paths"
classify (severalBuilds (tangle seed)) as "second model: eight builds or more"
cover 60% "third model: a term read on two paths" when readOnTwoPaths (weave seed)
cover 15% "third model: the file decides a directive" when fileDecidesSome (weave seed)
end for law

for law "|the builds are exactly what the preprocessor keeps under every assignment of the terms|
classify (weaveNew seed) as "third model: with definitions and #elifdef"
cover 60% "third model: a term read on two paths" when readOnTwoPaths (weave seed)
cover 40% "third model: cycle 4's rule gives other copies" when oldRuleDiffers (weave seed)
cover 15% "third model: the file decides a directive" when fileDecidesSome (weave seed)
cover 15% "third model: an #elifdef or #elifndef" when hasElifdef (weave seed)
cover 40% "third model: eight builds or more" when severalBuilds (weave seed)
end for law

for law "|the preprocessor on text keeps what the line-keeping preprocessor keeps, where no line of code names a macro|
classify (weaveNew seed) as "third model: with definitions and #elifdef"
classify (laceCount (lace seed) (zzOf se) 3 64 > 0) as "fourth model: some environment is an error"
cover 30% "fourth model: a macro's name in a line of code" when laceNamesMacro (lace seed)
cover 5% "fourth model: a comment hides a directive" when laceHides (lace seed)
cover 9% "fourth model: the file defines or undefines a special name" when laceDefinesSpecial (lace seed)
cover 7% "fourth model: some environment's build is one ax must decide" when laceCount (lace seed) (zzOf se) 0 64 > 0
cover 13% "fourth model: some environment's build is one ax may leave undecided" when laceCount (lace seed) (zzOf se) 1 64 > 0
cover 15% "fourth model: some environment's build is outside the model" when laceCount (lace seed) (zzOf se) 2 64 > 0
classify (laceAliases (lace seed)) as "fourth model: an alias of the macro is defined and used"
classify (laceShapeAt (lace seed) (zzOf se) 0 (laceStart se) 8) as "fourth model, eight environments: the preprocessor calls through an alias"
classify (laceShapeAt (lace seed) (zzOf se) 1 (laceStart se) 8) as "fourth model, eight environments: the preprocessor calls through a chain of aliases"
classify (laceShapeAt (lace seed) (zzOf se) 2 (laceStart se) 8) as "fourth model, eight environments: the preprocessor calls with the ( on the next line"
classify (laceOwnDirective (lace seed)) as "fourth model: a directive on one of the preprocessor's own names"
classify (laceJoinsWide (lace seed)) as "fourth model: a join over a form feed or a vertical tab"
classify (laceEndsInName (lace seed)) as "fourth model: the macro's name ends a line"
classify (laceSplices (lace seed)) as "fourth model: a line ends in a backslash"
classify (laceCountAt (lace seed) (zzOf se) 0 (laceStart se) 8 > 0) as "fourth model, eight environments: one ax must decide"
classify (laceCountAt (lace seed) (zzOf se) 1 (laceStart se) 8 > 0) as "fourth model, eight environments: one ax may leave undecided"
classify (laceCountAt (lace seed) (zzOf se) 2 (laceStart se) 8 > 0) as "fourth model, eight environments: one outside the model"
classify (laceCountAt (lace seed) (zzOf se) 3 (laceStart se) 8 > 0) as "fourth model, eight environments: an error"
end for law

end harness

end unit
