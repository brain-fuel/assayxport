function fixtureCppCopies (u :: Unit) -> List Text is
  ["{-# LANGUAGE CPP #-}\nmodule Cpp\n  ( f\n  , g\n\n  , k\n\n  ) where\n\n\nimport Data.Foo (foo)\n\n\n\n\nimport qualified Q.New as Q\n\n\n\n\nv0 x = x\n\nf x = foo x\n\ng = Q.run 1\n\nk = v0 1\n\nh = v0\n\n  1\n\n\n\ndata T = T1\n\n  | T2\n\n\n\n\n\n\n\np :: Int\n\n\n\np = 1\n\nq = v0 2\n\n" ,
