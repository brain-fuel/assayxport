function fixtureSixImpSource (u :: Unit) -> Text is
  "{-# LANGUAGE ExplicitNamespaces, TypeOperators #-}\nmodule SixImp where\nimport Prelude hiding (filter)\nimport qualified Prelude as P\nimport qualified Data.Text as T\nimport qualified Data.Text.Internal as T (Text (..))\nimport qualified Data.ByteString as B\nimport qualified Data.ByteString.Internal as B (ByteString (BS))\nimport qualified Data.Set.Internal as SI (Set (..))\nimport qualified Data.Map as MH hiding (Map (..))\nimport GHC.TypeLits (type (+), type (<=))\nimport Data.Type.Equality (type (==))\nimport Other (type (<+>), (<->), type (:+:), (:*:), (:%:) ((:%:)), type (:^:) ((:^:), (<^>)), data (:$:))\nq1 = T.Text 1 2 3\nq2 = T.pack 1\nq3 = B.BS 1 2\nq4 = B.pack 1\nq5 = SI.Bin 1\nq6 = SI.size 1\nq7 = MH.insert 1\nt1 x = x + 1\nt2 x = x <= 1\nt3 x = x == 1\nt4 x = x <+> 1\nt5 x = x <-> 1\nt6 x = x :+: 1\nt7 x = x :*: 1\nt8 x = x :%: 1\nt9 x = x :^: 1\nt10 x = x <^> 1\nt11 x = x :$: 1\ne1 = Prelude.map 1\ne2 x = x Prelude.+ 1\ne3 = P.map 1\ne4 = Prelude.filter 1\ne5 = P.filter 1\ne6 = P.zzq 1\ne7 = filter 1\n"
end function

