unit assayxport.haskell.policy
-- ref:DR-0035 ref:DR-0040 ref:DR-0046 (LawSpec is the law surface and writes our software; the Haskell extractor matches the calibrated Python contract)

import assayxport.contract as c (distinct, spaces, indented, at, noBinary, edge, edgeIf, merged, Package, Decl, DocText, EntryPoint, Detail, Binary, CallEdge, Complexity, Signature, Param, Location, Invocation, SourceFile, SymbolKind, Visibility, VisibilityIdiom, DocFormat, CallKind, ComplexityMethod)

-- S1.j: the POLICY of ax's Haskell extractor, written before the extractor
-- (spec.md, "What the extractor reports", and its amendment: laws before
-- implementation). The shape is the calibrated Python policy's: a model of
-- source trees, `render` (the .hs files), `expected` (the packages ax must
-- report), and one small law per rule. Conformance (unit
-- assayxport.haskell) holds the native extractor to `expected`.
--
-- Settled here where the spec is silent (stated in the PR text):
--   * An edge is an application (`f x`); a bare reference is not a call.
--   * A value binding's location runs from its signature (or its equation,
--     if unsigned) to its equation's last line; a constructor's and a
--     field's start at their own name.
--   * Only the first module may be `Main` or headerless, so the model never
--     makes two packages with one id (discovery Q4 is the maker's).
-- Counts are plain Int8, folded by the definitions: a refined field
-- anywhere in a unit's schema disables `any` (LawSpec issue 2).

-- ---------------------------------------------------------------------------
-- The model.

type ModKind is one of | Named | Dotted | MainHeader | Headerless end type
type DocStyle is one of | DocOne | DocTwo | DocNoSpace | DocBlock | DocBlockTight | DocGap | DocGapComment | DocAfterComment end type
type ImportModel is one of | ImpExplicit | ImpQualifiedAs | ImpQualified | ImpOpen | ImpHidePrelude | ImpPreludeOnly | ImpHidingTight | ImpQualifiedPost | ImpHidingLines | ImpPreludeEmpty | ImpPreludeQualified | ImpSharedAlias | ImpQualifiedHiding end type

-- A callee in a value's body. Its rendering is fixed; its resolution
-- depends on the module (imports, the Prelude) and on the value's params.
type Callee is one of
  | HTop of type Int8
  | HTopOp of type Int8
  | HField of type Int8
  | HSelfQual of type Int8
  | HLocal of type Int8
  | HExplicit
  | HQualAs
  | HQualFull
  | HOpenName
  | HPrelude of type Int8
  | HUnknown
  | HUnknownAlias
  | HLambdaApply
  | HCurried
  | HShared
  | HInsert
  | HPostQualified
  | HQualHidingKept
  | HQualHidingHidden
end type

-- A binding that shadows the module's first value name inside a scope
-- (spec amendment 2026-11-07: full local scope analysis).
-- Where a value's calls sit in its body. Each form but SiteList puts the
-- call list under an operator in a position the grammar leaves without a
-- field name (a `do` statement, a guard, a `case` scrutinee, a
-- comprehension filter); only operators wrap it, so the edges are the same.
type CallSite is one of | SiteList | SiteDo | SiteGuard | SiteCase | SiteFilter | SiteSig end type

type ScopeForm is one of | NoScope | InWhere | InLet | InLambda | InCase | InDo | InDoLet | InPattern | InPatGuard | InGenerator | InPatLet | InWherePat | InFieldPat | InFieldPun | InGuardLet | InQualLet | InAltWhere | InRec end type

type SigKind is one of | SigNone | SigValue | SigFunc | SigConstrained | SigForall end type

-- A top-level value binding: a function or a constant (decided by its
-- params and signature), or an operator.
type ValueModel is a record{
  operator :: Bool
  params :: Int8
  sig :: SigKind
  doc :: Maybe DocStyle
  shadow :: Bool
  clauses :: Bool
  sigAfter :: Bool
  infixDef :: Bool
  scope :: ScopeForm
  site :: CallSite
  docAfter :: Bool
  calls :: List Callee}
end type

type DataModel is a record{
  isNewtype :: Bool
  asRecord :: Bool
  cons :: Int8
  fields :: Int8
  doc :: Maybe DocStyle
  after :: Bool
  void :: Bool
  pairFields :: Bool
  afterBelow :: Bool
  sharedCon :: Bool
  fmtDoc :: Bool
  blockAfter :: Bool
  infixCons :: Bool
  infixHead :: Bool}
end type

type ClassModel is a record{
  super :: Int8
  methods :: Int8
  valueMethod :: Bool
  pairMethods :: Bool
  methodDoc :: Bool
  opMethod :: Bool
  doc :: Maybe DocStyle}
end type

type InstModel is a record{
  own :: Bool
  target :: Int8
  spaced :: Bool
  wrapped :: Bool
  method :: Bool
  doc :: Bool}
end type

type HsDecl is one of
  | DValue of type ValueModel
  | DData of type DataModel
  | DSyn
  | DClass of type ClassModel
  | DInst of type InstModel
end type

type ExportPick is one of
  | EValue of type Int8
  | ETypeAll of type Int8
  | ETypeOnly of type Int8
  | EClassAll of type Int8
  | EClassOnly of type Int8
  | ETypeSome of type Int8
  | EField of type Int8
  | EMethod of type Int8
  | EMain
  | ESelf
  | EReexport
  | EClassOp of type Int8
  | EOpMethod of type Int8
  | EConOp of type Int8
  | EQualSelf of type Int8
end type

type HsModule is a record{
  kind :: ModKind
  doc :: Bool
  blockDoc :: Bool
  docGap :: Bool
  exports :: Maybe (List ExportPick)
  noPrelude :: Bool
  rebindable :: Bool
  imports :: List ImportModel
  decls :: List HsDecl
  mainDef :: Bool}
end type

type HsTree is a record{
  modules :: List HsModule
  noise :: Bool
  exotic :: Bool}
end type

-- ---------------------------------------------------------------------------
-- Small helpers.

function fold (n :: Int8) (k :: Integer) -> Integer is
  if k <= 0 then 0 else (if n < 0 then 0 - prelude.rem n k else prelude.rem n k end if) end if
end function

function textOf (n :: Integer) -> Text is prelude.textOf n end function

function nthText (i :: Integer) (ts :: List Text) -> Text is
  first matching case of prelude.at i ts : when Absent then "" when Present t then t end case
end function

function pickText (n :: Int8) (ts :: List Text) -> Maybe Text is
  if prelude.length ts = 0 then Absent else prelude.at (fold n (prelude.length ts)) ts end if
end function

function hasImport (i :: ImportModel) (imps :: List ImportModel) -> Bool is imps contains i end function

function joinLines (ts :: List Text) -> Text is prelude.join "\n" ts end function

-- ---------------------------------------------------------------------------
-- Module identity. Only the first module may be Main or headerless.

function effKind (i :: Integer) (k :: ModKind) -> ModKind is
  if i = 0 then k else (first matching case of k : when Dotted then Dotted when Named then Named when MainHeader then Named when Headerless then Named end case) end if
end function

function moduleId (i :: Integer) (k :: ModKind) -> Text is
  first matching case of effKind i k :
    when Named then "M" ++ textOf i
    when Dotted then "Lib.M" ++ textOf i
    when MainHeader then "Main"
    when Headerless then "Main"
  end case
end function

function moduleName (i :: Integer) (k :: ModKind) -> Text is
  first matching case of effKind i k :
    when Dotted then "M" ++ textOf i
    when Named then "M" ++ textOf i
    when MainHeader then "Main"
    when Headerless then "Main"
  end case
end function

function moduleFile (i :: Integer) (k :: ModKind) -> Text is
  first matching case of effKind i k :
    when Named then "M" ++ textOf i ++ ".hs"
    when Dotted then "Lib/M" ++ textOf i ++ ".hs"
    when MainHeader then "Main.hs"
    when Headerless then "app.hs"
  end case
end function

function hasHeader (i :: Integer) (k :: ModKind) -> Bool is effKind i k != Headerless end function

function isMainModule (i :: Integer) (k :: ModKind) -> Bool is
  first matching case of effKind i k : when MainHeader then true when Headerless then true when Named then false when Dotted then false end case
end function

-- ---------------------------------------------------------------------------
-- Names of a module's declarations, by ordinal within their family.

function valueName (v :: ValueModel) (valueIx :: Integer) (opIx :: Integer) -> Text is
  if v.operator then "(<" ++ pluses (opIx + 1) ++ ">)" else "v" ++ textOf valueIx end if
end function

function opBare (opIx :: Integer) -> Text is "<" ++ pluses (opIx + 1) ++ ">" end function

function pluses (n :: Integer) -> Text is if n <= 0 then "" else "+" ++ pluses (n - 1) end if end function

function typeName (k :: Integer) -> Text is "T" ++ textOf k end function
function synName (k :: Integer) -> Text is "S" ++ textOf k end function
function className (k :: Integer) -> Text is "C" ++ textOf k end function
function conName (k :: Integer) (j :: Integer) -> Text is "K" ++ textOf k ++ "_" ++ textOf j end function
function fieldName (k :: Integer) (j :: Integer) -> Text is "fld" ++ textOf k ++ "_" ++ textOf j end function
function methodName (k :: Integer) (j :: Integer) -> Text is "mth" ++ textOf k ++ "_" ++ textOf j end function
-- An operator method (review 4, S1), and the infix constructors of a
-- positional type (S2): symbolic and backticked.
-- An infix constructor is located where its text starts: its left operand,
-- column 5 in `  | Int :*: Int`. The grammar starts the node on the space
-- before it (column 4); that is not the position (scope-design.md, section C).
function opName (k :: Integer) -> Text is "<!" ++ pluses (k + 1) ++ ">" end function
function infixConName (k :: Integer) -> Text is ":*" ++ pluses (k + 1) ++ ":" end function
function tickConName (k :: Integer) -> Text is "B" ++ textOf k ++ "_i" end function
function infixOn (x :: DataModel) -> Bool is x.infixCons && !x.isNewtype && !(isVoid x) && !(isRecord x) && !(fmtDoc x) end function

-- The plain (non-operator) value names, in order.
function plainValues (ds :: List HsDecl) (n :: Integer) -> List Text is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (first matching case of d :
        when DValue v then (if v.operator then plainValues rest n else ["v" ++ textOf n] ++ plainValues rest (n + 1) end if)
        when DData x then plainValues rest n
        when DSyn then plainValues rest n
        when DClass x then plainValues rest n
        when DInst x then plainValues rest n
      end case)
  end case
end function

function dataNames (ds :: List HsDecl) (n :: Integer) -> List Text is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (first matching case of d :
        when DData x then [typeName n] ++ dataNames rest (n + 1)
        when DValue x then dataNames rest n
        when DSyn then dataNames rest n
        when DClass x then dataNames rest n
        when DInst x then dataNames rest n
      end case)
  end case
end function

function classNames (ds :: List HsDecl) (n :: Integer) -> List Text is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (first matching case of d :
        when DClass x then [className n] ++ classNames rest (n + 1)
        when DValue x then classNames rest n
        when DSyn then classNames rest n
        when DData x then classNames rest n
        when DInst x then classNames rest n
      end case)
  end case
end function

-- Data shape, normalized: a newtype has one constructor; a record has one
-- constructor with at least one field; a positional constructor's fields
-- are its arguments.
function isVoid (x :: DataModel) -> Bool is x.void && !x.isNewtype end function
function consOf (x :: DataModel) -> Integer is if isVoid x then 0 else (if x.isNewtype || isRecord x then (if sharedCon x then 2 else 1 end if) else 1 + fold x.cons 3 end if) end if end function
function fieldsOf (x :: DataModel) -> Integer is if x.isNewtype then 1 else fold x.fields 3 end if end function
function isRecord (x :: DataModel) -> Bool is !(isVoid x) && x.asRecord && (x.isNewtype || fold x.fields 3 > 0) end function
-- A second record constructor repeating the first field (one selector,
-- one field symbol; review 2, S4). Not for a newtype (one constructor).
function sharedCon (x :: DataModel) -> Bool is x.sharedCon && !x.isNewtype && isRecord x end function
-- The second constructor's line up to its own new field: it repeats field 0
-- (one selector) and adds a field of its own, as AST-style types do.
function sharedLead (k :: Integer) -> Text is "  | " ++ conName k 1 ++ " { " ++ fieldName k 0 ++ " :: Int, " end function
-- The formatter (ormolu/fourmolu) Haddock layout: `-- |` on the line of the
-- `=` or `{`, documenting the first constructor or field below it (review 2,
-- S1). Only on the plain layouts, so line arithmetic stays exact.
function fmtDoc (x :: DataModel) -> Bool is
  x.fmtDoc && !x.isNewtype && !(isVoid x) && !x.after && !x.pairFields && !x.afterBelow && !(sharedCon x)
end function
function beforeDoc (u :: Unit) -> DocText is DocText record{ raw = "Before." , format = Haddock} end function
function withFirstDoc (ds :: List Decl) (doc :: DocText) -> List Decl is
  first matching case of ds : when Nil then [] when Cons d rest then [d with doc = doc] ++ rest end case
end function
function methodsOf (x :: ClassModel) -> Integer is fold x.methods 3 end function
function paramsOf (v :: ValueModel) -> Integer is if v.operator then 2 else fold v.params 3 end if end function

-- Constructors (text, id) of every data type, then fields, then methods.
type TopName is a record{
  text :: Text
  id :: Text}
end type

function conRange (k :: Integer) (j :: Integer) (n :: Integer) (owner :: Text) -> List TopName is
  if j >= n then [] else [TopName record{ text = conName k j , id = owner ++ "." ++ conName k j}] ++ conRange k (j + 1) n owner end if
end function

function fieldRange (k :: Integer) (j :: Integer) (n :: Integer) (owner :: Text) -> List TopName is
  if j >= n then [] else [TopName record{ text = fieldName k j , id = owner ++ "." ++ fieldName k j}] ++ fieldRange k (j + 1) n owner end if
end function

function methodRange (k :: Integer) (j :: Integer) (n :: Integer) (owner :: Text) -> List TopName is
  if j >= n then [] else [TopName record{ text = methodName k j , id = owner ++ "." ++ methodName k j}] ++ methodRange k (j + 1) n owner end if
end function

function conTops (ds :: List HsDecl) (n :: Integer) -> List TopName is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (first matching case of d :
        when DData x then conRange n 0 (consOf x) (typeName n) ++ conTops rest (n + 1)
        when DValue x then conTops rest n
        when DSyn then conTops rest n
        when DClass x then conTops rest n
        when DInst x then conTops rest n
      end case)
  end case
end function

function methodTops (ds :: List HsDecl) (n :: Integer) -> List TopName is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (first matching case of d :
        when DClass x then methodRange n 0 (methodsOf x) (className n) ++ methodTops rest (n + 1)
        when DValue x then methodTops rest n
        when DSyn then methodTops rest n
        when DData x then methodTops rest n
        when DInst x then methodTops rest n
      end case)
  end case
end function

-- The module's operator values, as applied in prefix form `(<+>) a b`
-- (review 5: a prefix-applied top-level operator is internal).
function opValues (ds :: List HsDecl) (oi :: Integer) -> List Text is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (first matching case of d :
        when DValue v then (if v.operator then [opBare oi] ++ opValues rest (oi + 1) else opValues rest oi end if)
        when DData x then opValues rest oi
        when DSyn then opValues rest oi
        when DClass x then opValues rest oi
        when DInst x then opValues rest oi
      end case)
  end case
end function

function valueTops (ts :: List Text) -> List TopName is
  first matching case of ts :
    when Nil then []
    when Cons t rest then [TopName record{ text = t , id = t}] ++ valueTops rest
  end case
end function

-- What an internal callee can name: plain values, constructors, methods.
-- An operator value is called in prefix form, `(<+>) a b` (opValues).
function topNames (ds :: List HsDecl) -> List TopName is
  valueTops (plainValues ds 0) ++ conTops ds 0 ++ methodTops ds 0
end function

-- ---------------------------------------------------------------------------
-- Visibility. No export list: everything is exported. With one, a name is
-- exported if listed; `T(..)` and `C(..)` export the constructors, fields
-- and methods too. An instance is always exported.

function pickName (n :: Int8) (ts :: List Text) -> List Text is
  first matching case of pickText n ts : when Absent then [] when Present t then [t] end case
end function

function dataChildren (ds :: List HsDecl) (n :: Integer) (want :: Text) -> List Text is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (first matching case of d :
        when DData x then
          (if typeName n = want then idsOf (conRange n 0 (consOf x) want) ++ (if infixOn x then [want ++ "." ++ infixConName n, want ++ "." ++ tickConName n] else [] end if) ++ (if isRecord x then idsOf (fieldRange n 0 (fieldsOf x) want) else [] end if) ++ (if sharedCon x then [want ++ "." ++ fieldName n (fieldsOf x)] else [] end if) else [] end if)
            ++ dataChildren rest (n + 1) want
        when DValue x then dataChildren rest n want
        when DSyn then dataChildren rest n want
        when DClass x then dataChildren rest n want
        when DInst x then dataChildren rest n want
      end case)
  end case
end function

function classChildren (ds :: List HsDecl) (n :: Integer) (want :: Text) -> List Text is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (first matching case of d :
        when DClass x then (if className n = want then idsOf (methodRange n 0 (methodsOf x) want) ++ (if x.opMethod then [want ++ "." ++ opName n] else [] end if) else [] end if) ++ classChildren rest (n + 1) want
        when DValue x then classChildren rest n want
        when DSyn then classChildren rest n want
        when DData x then classChildren rest n want
        when DInst x then classChildren rest n want
      end case)
  end case
end function

function idsOf (ns :: List TopName) -> List Text is
  first matching case of ns : when Nil then [] when Cons t rest then [t.id] ++ idsOf rest end case
end function

function valueAndOpNames (ds :: List HsDecl) (vi :: Integer) (oi :: Integer) -> List Text is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (first matching case of d :
        when DValue v then (if v.operator then [opBare oi] ++ valueAndOpNames rest vi (oi + 1) else ["v" ++ textOf vi] ++ valueAndOpNames rest (vi + 1) oi end if)
        when DData x then valueAndOpNames rest vi oi
        when DSyn then valueAndOpNames rest vi oi
        when DClass x then valueAndOpNames rest vi oi
        when DInst x then valueAndOpNames rest vi oi
      end case)
  end case
end function

-- The ids an export list makes visible.
function exportedIds (ds :: List HsDecl) (ps :: List ExportPick) -> List Text is
  first matching case of ps :
    when Nil then []
    when Cons p rest then
      (first matching case of p :
        when EValue n then pickName n (valueAndOpNames ds 0 0)
        when ETypeOnly n then pickName n (dataNames ds 0)
        when ETypeAll n then (first matching case of pickText n (dataNames ds 0) : when Absent then [] when Present t then [t] ++ dataChildren ds 0 t end case)
        when EClassOnly n then pickName n (classNames ds 0)
        when EClassAll n then (first matching case of pickText n (classNames ds 0) : when Absent then [] when Present t then [t] ++ classChildren ds 0 t end case)
        when ETypeSome n then (first matching case of pickText n (dataNames ds 0) : when Absent then [] when Present t then [t] ++ (if firstCon ds 0 t = "" then [] else [t ++ "." ++ firstCon ds 0 t] end if) end case)
        when EField n then (first matching case of pickTop n (recordFields ds 0) : when Absent then [] when Present t then [t.id] end case)
        when EMethod n then (first matching case of pickTop n (firstMethods ds 0) : when Absent then [] when Present t then [t.id] end case)
        when EMain then ["main"]
        when ESelf then []
        when EReexport then []
        when EClassOp n then (first matching case of pickTop n (opMethods ds 0) : when Absent then [] when Present t then [t.text, t.id] end case)
        when EOpMethod n then (first matching case of pickTop n (opMethods ds 0) : when Absent then [] when Present t then [t.id] end case)
        when EConOp n then (first matching case of pickTop n (infixDatas ds 0) : when Absent then [] when Present t then [t.text, t.id] end case)
        when EQualSelf n then pickName n (plainValues ds 0)
      end case) ++ exportedIds ds rest
  end case
end function

-- The first constructor of the data type named `want` (`T(K)` exports it).
function firstCon (ds :: List HsDecl) (n :: Integer) (want :: Text) -> Text is
  first matching case of ds :
    when Nil then ""
    when Cons d rest then
      (first matching case of d :
        when DData x then (if typeName n = want then (if consOf x > 0 then conName n 0 else "" end if) else firstCon rest (n + 1) want end if)
        when DValue x then firstCon rest n want
        when DSyn then firstCon rest n want
        when DClass x then firstCon rest n want
        when DInst x then firstCon rest n want
      end case)
  end case
end function

-- The first field of each record type, and the first method of each class
-- with methods, as (export text, symbol id).
function recordFields (ds :: List HsDecl) (n :: Integer) -> List TopName is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (first matching case of d :
        when DData x then (if isRecord x then [TopName record{ text = fieldName n 0 , id = typeName n ++ "." ++ fieldName n 0}] else [] end if) ++ recordFields rest (n + 1)
        when DValue x then recordFields rest n
        when DSyn then recordFields rest n
        when DClass x then recordFields rest n
        when DInst x then recordFields rest n
      end case)
  end case
end function

function firstMethods (ds :: List HsDecl) (n :: Integer) -> List TopName is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (first matching case of d :
        when DClass x then (if methodsOf x > 0 then [TopName record{ text = methodName n 0 , id = className n ++ "." ++ methodName n 0}] else [] end if) ++ firstMethods rest (n + 1)
        when DValue x then firstMethods rest n
        when DSyn then firstMethods rest n
        when DData x then firstMethods rest n
        when DInst x then firstMethods rest n
      end case)
  end case
end function

-- The export-list text, as written (one item per pick, names resolved).
-- Each class with an operator method, as (class name, method id).
function opMethods (ds :: List HsDecl) (n :: Integer) -> List TopName is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (first matching case of d :
        when DClass x then (if x.opMethod then [TopName record{ text = className n , id = className n ++ "." ++ opName n}] else [] end if) ++ opMethods rest (n + 1)
        when DValue x then opMethods rest n
        when DSyn then opMethods rest n
        when DData x then opMethods rest n
        when DInst x then opMethods rest n
      end case)
  end case
end function

-- Each data type with infix constructors, as (type name, the symbolic
-- constructor's id): `T ((:*+:))` exports it by name (review 5).
function infixDatas (ds :: List HsDecl) (n :: Integer) -> List TopName is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (first matching case of d :
        when DData x then (if infixOn x then [TopName record{ text = typeName n , id = typeName n ++ "." ++ infixConName n}] else [] end if) ++ infixDatas rest (n + 1)
        when DValue x then infixDatas rest n
        when DSyn then infixDatas rest n
        when DClass x then infixDatas rest n
        when DInst x then infixDatas rest n
      end case)
  end case
end function

function exportItems (ds :: List HsDecl) (ps :: List ExportPick) (self :: Text) -> List Text is
  first matching case of ps :
    when Nil then []
    when Cons p rest then
      (first matching case of p :
        when EValue n then (first matching case of pickText n (valueAndOpNames ds 0 0) : when Absent then [] when Present t then [(if prelude.startsWith t "<" then "(" ++ t ++ ")" else t end if)] end case)
        when ETypeOnly n then pickName n (dataNames ds 0)
        when ETypeAll n then (first matching case of pickText n (dataNames ds 0) : when Absent then [] when Present t then [t ++ "(..)"] end case)
        when EClassOnly n then pickName n (classNames ds 0)
        when EClassAll n then (first matching case of pickText n (classNames ds 0) : when Absent then [] when Present t then [t ++ "(..)"] end case)
        when ETypeSome n then (first matching case of pickText n (dataNames ds 0) : when Absent then [] when Present t then [t ++ "(" ++ firstCon ds 0 t ++ ")"] end case)
        when EField n then (first matching case of pickTop n (recordFields ds 0) : when Absent then [] when Present t then [t.text] end case)
        when EMethod n then (first matching case of pickTop n (firstMethods ds 0) : when Absent then [] when Present t then [t.text] end case)
        when EMain then ["main"]
        when ESelf then ["module " ++ self]
        when EReexport then ["module Data.List"]
        when EClassOp n then (first matching case of pickTop n (opMethods ds 0) : when Absent then [] when Present t then [t.text ++ " ((" ++ prelude.drop (prelude.length t.text + 1) t.id ++ "))"] end case)
        when EOpMethod n then (first matching case of pickTop n (opMethods ds 0) : when Absent then [] when Present t then ["(" ++ prelude.drop (prelude.length t.text + 1) t.id ++ ")"] end case)
        when EConOp n then (first matching case of pickTop n (infixDatas ds 0) : when Absent then [] when Present t then [t.text ++ " ((" ++ prelude.drop (prelude.length t.text + 1) t.id ++ "))"] end case)
        when EQualSelf n then (first matching case of pickText n (plainValues ds 0) : when Absent then [] when Present t then [self ++ "." ++ t] end case)
      end case) ++ exportItems ds rest self
  end case
end function

-- The rule, as one function: `exported` is Absent when there is no export
-- list (or no header).
function visibleIn (exported :: Maybe (List Text)) (kind :: SymbolKind) (id :: Text) -> Visibility is
  if kind = KindInstance then Exported else
    (first matching case of exported :
      when Absent then Exported
      when Present ids then (if ids contains id then Exported else Unexported end if)
    end case)
  end if
end function

-- ---------------------------------------------------------------------------
-- Haddock. `-- |` before a declaration, `-- ^` after a constructor or a
-- field; the text is the comment's, markers and one following space
-- removed, lines joined by "\n".

function docLines (d :: Maybe DocStyle) -> List Text is
  first matching case of d :
    when Absent then []
    when Present DocOne then ["-- | Doc."]
    when Present DocTwo then ["-- | Doc.", "-- More."]
    when Present DocNoSpace then ["-- |Doc."]
    when Present DocBlock then ["{- | Doc.", "     More. -}"]
    when Present DocBlockTight then ["{-| Doc. -}"]
    when Present DocGap then ["-- | Doc.", ""]
    when Present DocGapComment then ["-- | Doc.", "", "-- A plain comment."]
    -- A `-- |` line after a plain `--` line still starts a doc: the grammar
    -- reads the two lines as one plain comment (review 6, S1 and L7). The
    -- blank line first keeps the plain line from continuing a doc that ends
    -- the declaration above.
    when Present DocAfterComment then ["", "-- A plain comment.", "-- | Doc."]
  end case
end function

function docRaw (d :: Maybe DocStyle) -> DocText is
  first matching case of d :
    when Absent then DocText record{ raw = "" , format = NoDoc}
    when Present DocOne then DocText record{ raw = "Doc." , format = Haddock}
    when Present DocTwo then DocText record{ raw = "Doc.\nMore." , format = Haddock}
    when Present DocNoSpace then DocText record{ raw = "Doc." , format = Haddock}
    when Present DocBlock then DocText record{ raw = "Doc.\n     More." , format = Haddock}
    when Present DocBlockTight then DocText record{ raw = "Doc." , format = Haddock}
    when Present DocGap then DocText record{ raw = "Doc." , format = Haddock}
    when Present DocGapComment then DocText record{ raw = "Doc." , format = Haddock}
    when Present DocAfterComment then DocText record{ raw = "Doc." , format = Haddock}
  end case
end function

function afterDoc (on :: Bool) -> DocText is
  if on then DocText record{ raw = "After." , format = Haddock} else DocText record{ raw = "" , format = NoDoc} end if
end function

function afterText (on :: Bool) -> Text is if on then " -- ^ After." else "" end if end function

-- The block spelling of every after-doc line (`{- ^ After. -}`).
function blockAfters (ls :: List Text) -> List Text is
  first matching case of ls :
    when Nil then []
    when Cons l rest then
      [(if prelude.endsWith l " -- ^ After." then prelude.take (prelude.length l - 12) l ++ " {- ^ After. -}"
        else (if l = "      -- ^ After." then "      {- ^ After. -}" else l end if) end if)] ++ blockAfters rest
  end case
end function

-- ---------------------------------------------------------------------------
-- The import table and the Prelude table.

function importLine (i :: ImportModel) -> List Text is
  first matching case of i :
    when ImpExplicit then ["import Data.Char (toUpper)"]
    when ImpQualifiedAs then ["import qualified Data.Map as M"]
    when ImpQualified then ["import qualified Data.Set"]
    when ImpOpen then ["import Data.List"]
    when ImpHidePrelude then ["import Prelude hiding (length)"]
    when ImpPreludeOnly then ["import Prelude (map)"]
    when ImpHidingTight then ["import Data.List hiding(insert)"]
    when ImpQualifiedPost then ["import Data.Map qualified as Q (insert)"]
    when ImpHidingLines then ["import Prelude hiding", "  ( length", "  )"]
    when ImpPreludeEmpty then ["import Prelude ()"]
    when ImpPreludeQualified then ["import qualified Prelude as P"]
    when ImpSharedAlias then ["import qualified Data.Text as T", "import qualified Data.Text.IO as T"]
    when ImpQualifiedHiding then ["import qualified Data.Map as H hiding (insert)"]
  end case
end function

function importLines (imps :: List ImportModel) -> List Text is
  first matching case of imps : when Nil then [] when Cons i rest then importLine i ++ importLines rest end case
end function

-- The Prelude names the model calls (the extractor's table is larger and
-- must contain these; law PRELUDE-1).
-- Prelude functions the model calls (corpus check C4: the Haskell 2010
-- Prelude and the class methods GHC's Prelude exports). `length` and `map`
-- stay first: the import rules name them.
function preludeNames (u :: Unit) -> List Text is
  ["length", "map", "show", "print", "foldr", "fmap", "pure", "traverse", "mapM_", "sequenceA", "foldMap", "mempty",
   "mconcat", "concatMap", "either", "maybe", "fst", "snd", "zip", "lookup", "filter", "words", "unwords", "replicate",
   "putStrLn", "readFile", "error", "fromIntegral", "otherwise", "succ", "until", "subtract", "realToFrac", "userError"]
end function

-- ---------------------------------------------------------------------------
-- Call resolution.

type Ctx is a record{
  moduleId :: Text
  tops :: List TopName
  imports :: List ImportModel
  noPrelude :: Bool
  ops :: List Text
  fields :: List TopName}
end type

function paramName (v :: ValueModel) (firstValue :: Maybe Text) (j :: Integer) -> Text is
  if j = 0 && v.shadow then (first matching case of firstValue : when Absent then "x" when Present t then t end case)
  else nthText j ["x", "y", "z"] end if
end function

function paramNames (v :: ValueModel) (firstValue :: Maybe Text) (j :: Integer) (n :: Integer) -> List Text is
  if j >= n then [] else [paramName v firstValue j] ++ paramNames v firstValue (j + 1) n end if
end function

function calleeText (x :: Ctx) (locals :: List Text) (cl :: Callee) -> Text is
  first matching case of cl :
    when HTop n then (first matching case of pickTop n x.tops : when Absent then "zzNone 0" when Present t then t.text ++ " 0" end case)
    when HLocal n then (first matching case of pickText n locals : when Absent then "zzNone 0" when Present t then t ++ " 0" end case)
    when HTopOp n then (first matching case of pickText n x.ops : when Absent then "zzNone 0" when Present t then "(" ++ t ++ ") 0" end case)
    when HField n then (first matching case of pickTop n x.fields : when Absent then "zzNone 0" when Present t then t.text ++ " 0" end case)
    when HSelfQual n then (first matching case of pickTop n x.tops : when Absent then "zzNone 0" when Present t then x.moduleId ++ "." ++ t.text ++ " 0" end case)
    when HExplicit then "toUpper 0"
    when HQualAs then "M.insert 0"
    when HQualFull then "Data.Set.member 0"
    when HOpenName then "sortOn 0"
    when HPrelude n then (first matching case of pickText n (preludeNames unitValue) : when Absent then "length 0" when Present t then t ++ " 0" end case)
    when HUnknown then "zzNone 0"
    when HUnknownAlias then "Q.zz 0"
    when HLambdaApply then "(\\_ -> 0) 0"
    when HCurried then "foldr id 0"
    when HShared then "T.pack 0"
    when HInsert then "insert 0"
    when HPostQualified then "Q.insert 0"
    when HQualHidingKept then "H.member 0"
    when HQualHidingHidden then "H.insert 0"
  end case
end function

function pickTop (n :: Int8) (ts :: List TopName) -> Maybe TopName is
  if prelude.length ts = 0 then Absent else prelude.at (fold n (prelude.length ts)) ts end if
end function

-- Haskell 2010: the Prelude is imported implicitly unless the module
-- imports it explicitly; then a name is visible if some unqualified Prelude
-- import brings it in; NoImplicitPrelude and RebindableSyntax turn off the
-- implicit import only.
function preludeHidden (x :: Ctx) (name :: Text) -> Bool is
  if preludeImported x.imports then !(preludeBrings x.imports name) else x.noPrelude end if
end function

function importsPrelude (i :: ImportModel) -> Bool is
  i = ImpHidePrelude || i = ImpPreludeOnly || i = ImpHidingLines || i = ImpPreludeEmpty || i = ImpPreludeQualified
end function

function preludeImported (imps :: List ImportModel) -> Bool is prelude.any importsPrelude imps end function

function bringsPrelude (name :: Text) (i :: ImportModel) -> Bool is
  (i = ImpHidePrelude && name != "length") || (i = ImpHidingLines && name != "length") || (i = ImpPreludeOnly && name = "map")
end function

function preludeBrings (imps :: List ImportModel) (name :: Text) -> Bool is prelude.any (bringsPrelude name) imps end function

-- The honesty ladder (spec, "Call edges"): a local name applied is dynamic;
-- a top-level name of this module is internal; an explicit or qualified
-- import is external, expanded; a Prelude name not hidden is builtin;
-- everything else is unresolved as written, and an open import never
-- resolves a name.
function calleeEdge (x :: Ctx) (locals :: List Text) (cl :: Callee) -> CallEdge is
  first matching case of cl :
    when HTop n then
      (first matching case of pickTop n x.tops :
        when Absent then edge Unresolved "zzNone" Absent
        when Present t then (if locals contains t.text then edge Dynamic t.text Absent else edge Internal t.text (Present (x.moduleId ++ "#" ++ t.id)) end if)
      end case)
    when HLocal n then (first matching case of pickText n locals : when Absent then edge Unresolved "zzNone" Absent when Present t then edge Dynamic t Absent end case)
    when HTopOp n then (first matching case of pickText n x.ops : when Absent then edge Unresolved "zzNone" Absent when Present t then edge Internal t (Present (x.moduleId ++ "#" ++ t)) end case)
    when HField n then
      (first matching case of pickTop n x.fields :
        when Absent then edge Unresolved "zzNone" Absent
        when Present t then (if locals contains t.text then edge Dynamic t.text Absent else edge Internal t.text (Present (x.moduleId ++ "#" ++ t.id)) end if)
      end case)
    when HSelfQual n then (first matching case of pickTop n x.tops : when Absent then edge Unresolved "zzNone" Absent when Present t then edge Internal t.text (Present (x.moduleId ++ "#" ++ t.id)) end case)
    when HExplicit then (if hasImport ImpExplicit x.imports then edge External "Data.Char.toUpper" Absent else edge Unresolved "toUpper" Absent end if)
    when HQualAs then (if hasImport ImpQualifiedAs x.imports then edge External "Data.Map.insert" Absent else edge Unresolved "M.insert" Absent end if)
    when HQualFull then (if hasImport ImpQualified x.imports then edge External "Data.Set.member" Absent else edge Unresolved "Data.Set.member" Absent end if)
    when HOpenName then edge Unresolved "sortOn" Absent
    when HPrelude n then
      (let name = (first matching case of pickText n (preludeNames unitValue) : when Absent then "length" when Present t then t end case) in
        (if preludeHidden x name then edge Unresolved name Absent else edge Builtin name Absent end if) end let)
    when HUnknown then edge Unresolved "zzNone" Absent
    when HUnknownAlias then edge Unresolved "Q.zz" Absent
    when HLambdaApply then edge Unresolved "(\\_ -> 0)" Absent
    when HCurried then (if preludeHidden x "foldr" then edge Unresolved "foldr" Absent else edge Builtin "foldr" Absent end if)
    when HShared then edge Unresolved "T.pack" Absent
    when HInsert then edge Unresolved "insert" Absent
    when HPostQualified then (if hasImport ImpQualifiedPost x.imports then edge External "Data.Map.insert" Absent else edge Unresolved "Q.insert" Absent end if)
    when HQualHidingKept then (if hasImport ImpQualifiedHiding x.imports then edge External "Data.Map.member" Absent else edge Unresolved "H.member" Absent end if)
    when HQualHidingHidden then edge Unresolved "H.insert" Absent
  end case
end function

function callTexts (x :: Ctx) (locals :: List Text) (cs :: List Callee) -> List Text is
  first matching case of cs : when Nil then [] when Cons cl rest then [calleeText x locals cl] ++ callTexts x locals rest end case
end function

function callEdges (x :: Ctx) (locals :: List Text) (cs :: List Callee) -> List CallEdge is
  first matching case of cs : when Nil then [] when Cons cl rest then [calleeEdge x locals cl] ++ callEdges x locals rest end case
end function

-- ---------------------------------------------------------------------------
-- Declarations as blocks of lines with their symbols.

type Block is a record{
  lines :: List Text
  decls :: List Decl}
end type

function declOf (id :: Text) (name :: Text) (kind :: SymbolKind) (loc :: Location) (owner :: Text) (doc :: DocText) -> Decl is
  Decl record{ id = id , name = name , kind = kind , visibility = Exported , idiom = ExportList ,
    location = loc , owner = owner , doc = doc ,
    entry = EntryPoint record{ isEntrypoint = false , invocation = Absent} ,
    detail = Detail record{ complexity = Complexity record{ time = Absent , space = Absent , method = Deferred} ,
      signature = Absent , typeKind = "" , underlying = "" , typeText = "" , inAll = Absent , decorators = [] ,
      concerns = [] , binary = noBinary unitValue} ,
    calls = [] , condition = ""}
end function

function intParams (n :: Integer) -> List Param is
  if n <= 0 then [] else [Param record{ name = "" , typeText = "Int" , annotations = [] , nameSynthetic = false}] ++ intParams (n - 1) end if
end function

function sigOf (args :: Integer) -> Signature is
  Signature record{ params = intParams args , returns = intParams 1 , typeParams = [] , receiver = Absent , variadic = false ,
                    modifiers = [] , descriptor = "" , throws = []}
end function

function arrows (n :: Integer) -> Text is if n <= 0 then "Int" else "Int -> " ++ arrows (n - 1) end if end function

-- A value is a function when it takes arguments or its signature is a
-- function type, or it is an operator; otherwise a constant.
function isFunctionSig (s :: SigKind) -> Bool is s = SigFunc || s = SigConstrained || s = SigForall end function
function isFunction (v :: ValueModel) -> Bool is v.operator || paramsOf v > 0 || isFunctionSig v.sig end function

function sigPrefix (s :: SigKind) -> Text is
  first matching case of s : when SigConstrained then "Eq a => " when SigForall then "forall a. " when SigFunc then "" when SigValue then "" when SigNone then "" end case
end function

-- The scope expression for a shadowing form (an element of the body list),
-- or "" when the form binds for the whole equation or none.
function scopeExpr (f :: ScopeForm) (n :: Text) -> Text is
  first matching case of f :
    when InLet then "let " ++ n ++ " = 1 in " ++ n ++ " 0"
    when InLambda then "(\\" ++ n ++ " -> " ++ n ++ " 0) 1"
    when InCase then "case 1 of { " ++ n ++ " -> " ++ n ++ " 0 }"
    when InDo then "do { " ++ n ++ " <- [] ; " ++ n ++ " 0 }"
    when InDoLet then "do { let { " ++ n ++ " = 1 } ; " ++ n ++ " 0 }"
    when InPatGuard then "case () of { _ | " ++ n ++ " <- 1 -> " ++ n ++ " 0 }"
    when InGenerator then "[" ++ n ++ " 0 | (" ++ n ++ ", _) <- []]"
    when InPatLet then "let { (" ++ n ++ ", _) = (1, 2) } in " ++ n ++ " 0"
    when InWherePat then ""
    when InFieldPat then "case 1 of { K{" ++ n ++ " = _} -> " ++ n ++ " 0 }"
    when InFieldPun then "case 1 of { K{" ++ n ++ "} -> " ++ n ++ " 0 }"
    when InGuardLet then "case () of { _ | let { " ++ n ++ " = 1 } -> " ++ n ++ " 0 }"
    when InQualLet then "[" ++ n ++ " 0 | let { " ++ n ++ " = 1 }]"
    when InAltWhere then "case 1 of { _ -> " ++ n ++ " 0 where { " ++ n ++ " = 1 } }"
    when InRec then "do { rec { " ++ n ++ " <- [] } ; " ++ n ++ " 0 }"
    when InWhere then ""
    when InPattern then ""
    when NoScope then ""
  end case
end function

-- `x`: a field label in a record pattern binds nothing (InFieldPat: the
-- module's name stays internal); a punned field binds its name (review 3).
function scopeEdges (x :: Ctx) (locals :: List Text) (f :: ScopeForm) (n :: Text) -> List CallEdge is
  first matching case of f :
    when InLambda then [edge Unresolved ("(\\" ++ n ++ " -> " ++ n ++ " 0)") Absent, edge Dynamic n Absent]
    when InLet then [edge Dynamic n Absent]
    when InCase then [edge Dynamic n Absent]
    when InDo then [edge Dynamic n Absent]
    when InDoLet then [edge Dynamic n Absent]
    when InPatGuard then [edge Dynamic n Absent]
    when InGenerator then [edge Dynamic n Absent]
    when InPatLet then [edge Dynamic n Absent]
    when InWherePat then []
    when InFieldPat then [calleeEdge x locals (HTop 0)]
    when InFieldPun then [edge Dynamic n Absent]
    when InGuardLet then [edge Dynamic n Absent]
    when InQualLet then [edge Dynamic n Absent]
    when InAltWhere then [edge Dynamic n Absent]
    when InRec then [edge Dynamic n Absent]
    when InWhere then []
    when InPattern then []
    when NoScope then []
  end case
end function

function shadowName (firstValue :: Maybe Text) -> Text is
  first matching case of firstValue : when Absent then "zz" when Present t then t end case
end function

-- The parts of a value binding, computed by small helpers (a long `let`
-- chain ending in a record literal made `check` hang: LawSpec issue 17).
type VParts is a record{
  locals :: List Text
  params :: List Text
  fun :: Bool
  args :: Integer
  sn :: Text}
end type

function vparts (v :: ValueModel) (firstValue :: Maybe Text) -> VParts is
  let sn = shadowName firstValue in
  let named = paramNames v firstValue 0 (paramsOf v) in
  let pattern = v.scope = InPattern && paramsOf v > 0 in
    VParts record{ locals = (if pattern then [sn] ++ prelude.drop 1 named else named end if) ++ (if v.scope = InWhere || v.scope = InWherePat then [sn] else [] end if) ,
                   params = (if pattern then ["(Just " ++ sn ++ ")"] ++ prelude.drop 1 named else named end if) ,
                   fun = isFunction v ,
                   args = (if isFunction v then (if paramsOf v > 0 then paramsOf v else 1 end if) else 0 end if) ,
                   sn = sn}
  end let end let end let
end function

function sigLines (v :: ValueModel) (name :: Text) (vp :: VParts) -> List Text is
  if v.sig = SigNone then [] else [name ++ " :: " ++ (if vp.fun then sigPrefix v.sig ++ arrows vp.args else "Int" end if)] end if
end function

function siteText (s :: CallSite) (list :: Text) -> Text is
  first matching case of s :
    when SiteList then list
    when SiteDo then "do { " ++ list ++ " ++ [] }"
    when SiteGuard then "case () of { _ | " ++ list ++ " == [] -> [] }"
    when SiteCase then "case " ++ list ++ " ++ [] of { _ -> [] }"
    when SiteFilter then "[ () | " ++ list ++ " == [] ]"
    when SiteSig then "(" ++ list ++ " :: [Int])"
  end case
end function

-- The operator a call site itself writes (`++`, `==`) is a call, resolved
-- like any Prelude name (owner, 2026-11-12: operators are calls).
function siteEdges (x :: Ctx) (s :: CallSite) -> List CallEdge is
  first matching case of s :
    when SiteList then []
    when SiteDo then [preludeEdge x "++"]
    when SiteGuard then [preludeEdge x "=="]
    when SiteCase then [preludeEdge x "++"]
    when SiteFilter then [preludeEdge x "=="]
    when SiteSig then []
  end case
end function

function preludeEdge (x :: Ctx) (name :: Text) -> CallEdge is
  if preludeHidden x name then edge Unresolved name Absent else edge Builtin name Absent end if
end function

function rhsOf (x :: Ctx) (v :: ValueModel) (vp :: VParts) -> Text is
  siteText v.site ("[" ++ prelude.join ", " (callTexts x vp.locals v.calls ++ (if scopeExpr v.scope vp.sn = "" then [] else [scopeExpr v.scope vp.sn] end if)) ++ "]")
    ++ (if v.scope = InWhere then " where " ++ vp.sn ++ " = 1" else (if v.scope = InWherePat then " where (" ++ vp.sn ++ ", _) = (1, 2)" else "" end if) end if)
end function

function bareOf (v :: ValueModel) (name :: Text) -> Text is
  if v.operator then prelude.drop 1 (prelude.take (prelude.length name - 1) name) else "`" ++ name ++ "`" end if
end function

function equationOf (x :: Ctx) (v :: ValueModel) (name :: Text) (vp :: VParts) -> Text is
  if vp.fun && paramsOf v = 0 then name ++ " = \\_ -> " ++ rhsOf x v vp
  else (if v.infixDef && paramsOf v = 2 then nthText 0 vp.params ++ " " ++ bareOf v name ++ " " ++ nthText 1 vp.params ++ " = " ++ rhsOf x v vp
        else name ++ prelude.join "" (prefixed vp.params) ++ " = " ++ rhsOf x v vp end if) end if
end function

function extraEquation (v :: ValueModel) (name :: Text) (vp :: VParts) (named :: List Text) -> List Text is
  if v.clauses && paramsOf v > 0
  then [(if v.infixDef && paramsOf v = 2 then "0 " ++ bareOf v name ++ " " ++ nthText 1 named else name ++ " 0" ++ prelude.join "" (prefixed (prelude.drop 1 named)) end if) ++ " = []"]
  else [] end if
end function

-- A `-- ^` after the signature documents the value (review 5, S5): only
-- without a `-- |` doc, with a signature written first.
function effAfter (v :: ValueModel) -> Bool is v.docAfter && (v.doc matches Absent) && v.sig != SigNone && !v.sigAfter end function

function valueLines (x :: Ctx) (v :: ValueModel) (name :: Text) (firstValue :: Maybe Text) (vp :: VParts) -> List Text is
  docLines v.doc ++ (if v.sigAfter then [] else sigLines v name vp ++ (if effAfter v then ["-- ^ After."] else [] end if) end if)
    ++ extraEquation v name vp (paramNames v firstValue 0 (paramsOf v)) ++ [equationOf x v name vp]
    ++ (if v.sigAfter then sigLines v name vp else [] end if)
end function

function valueDeclOf (x :: Ctx) (file :: Text) (v :: ValueModel) (id :: Text) (vp :: VParts) (start :: Integer) (count :: Integer) -> Decl is
  let d = declOf id id (if vp.fun then KindFunction else KindConst end if) (at file (start + prelude.length (docLines v.doc)) 1 (start + count - 1)) "" (if effAfter v then DocText record{ raw = "After." , format = Haddock} else docRaw v.doc end if) in
    d with detail = (d.detail with signature = (if vp.fun && v.sig != SigNone then Present (sigOf vp.args) else Absent end if) ,
                                   typeText = (if !vp.fun && v.sig != SigNone then "Int" else "" end if)) ,
           calls = merged (callEdges x vp.locals v.calls ++ scopeEdges x vp.locals v.scope vp.sn ++ siteEdges x v.site)
  end let
end function

function valueBlock (x :: Ctx) (file :: Text) (v :: ValueModel) (name :: Text) (id :: Text) (firstValue :: Maybe Text) (start :: Integer) -> Block is
  let vp = vparts v firstValue in
  let lines = valueLines x v name firstValue vp in
    Block record{ lines = lines , decls = [valueDeclOf x file v id vp start (prelude.length lines)]}
  end let end let
end function

function prefixed (ts :: List Text) -> List Text is
  first matching case of ts : when Nil then [] when Cons t rest then [" " ++ t] ++ prefixed rest end case
end function

function positional (n :: Integer) -> Text is if n <= 0 then "" else " Int" ++ positional (n - 1) end if end function

function conLines (k :: Integer) (j :: Integer) (n :: Integer) (fields :: Integer) (after :: Bool) -> List Text is
  if j >= n then [] else
    [(if j = 0 then "  = " else "  | " end if) ++ conName k j ++ positional fields ++ afterText (after && j = 0)] ++ conLines k (j + 1) n fields after
  end if
end function

function conDecls (file :: Text) (k :: Integer) (j :: Integer) (n :: Integer) (start :: Integer) (after :: Bool) -> List Decl is
  if j >= n then [] else
    [declOf (typeName k ++ "." ++ conName k j) (conName k j) KindConstructor (at file (start + j) 5 (start + j)) (typeName k) (afterDoc (after && j = 0))]
      ++ conDecls file k (j + 1) n start after
  end if
end function

function fieldLines (k :: Integer) (j :: Integer) (n :: Integer) (after :: Bool) (pair :: Bool) (below :: Bool) -> List Text is
  if j >= n then [] else
    (if j = 0 && pair && n >= 2
     then ["    { " ++ fieldName k 0 ++ ", " ++ fieldName k 1 ++ " :: Int" ++ afterText (after && !below)] ++ (if below then ["      -- ^ After."] else [] end if) ++ fieldLines k 2 n after pair below
     else [(if j = 0 then "    { " else "    , " end if) ++ fieldName k j ++ " :: Int" ++ afterText (after && !below && j = 0)]
            ++ (if below && j = 0 then ["      -- ^ After."] else [] end if) ++ fieldLines k (j + 1) n after pair below end if)
  end if
end function

-- Field j's line: paired fields share the first line; a below-line doc
-- after the first field shifts the later ones down by one.
function fieldLine (j :: Integer) (pair :: Bool) (below :: Bool) (n :: Integer) -> Integer is
  let row = (if pair && n >= 2 then (if j <= 1 then 0 else j - 1 end if) else j end if) in
    row + (if below && row > 0 then 1 else 0 end if)
  end let
end function

function fieldDecls (file :: Text) (k :: Integer) (j :: Integer) (n :: Integer) (start :: Integer) (after :: Bool) (pair :: Bool) (below :: Bool) -> List Decl is
  if j >= n then [] else
    [fxType (declOf (typeName k ++ "." ++ fieldName k j) (fieldName k j) KindField
       (at file (start + fieldLine j pair below n) 7 (start + fieldLine j pair below n)) (typeName k)
       (afterDoc ((after || below) && (if pair && n >= 2 then j <= 1 else j = 0 end if)))) "Int"]
      ++ fieldDecls file k (j + 1) n start after pair below
  end if
end function

-- A formatter-style doc over two lines (review 5, S3): its second line is
-- a plain `--` comment to the grammar.
function fmtTwo (x :: DataModel) -> Bool is fmtDoc x && (first matching case of x.doc : when Absent then false when Present d then d = DocTwo end case) end function
function twoOf (x :: DataModel) -> Integer is if fmtTwo x then 1 else 0 end if end function
function fmtDocText (x :: DataModel) -> DocText is if fmtTwo x then DocText record{ raw = "Before.\nMore." , format = Haddock} else beforeDoc unitValue end if end function

function dataBlock (file :: Text) (x :: DataModel) (k :: Integer) (start :: Integer) -> Block is
  let docs = docLines x.doc in
  let head = (if x.isNewtype then "newtype " else "data " end if) ++ (if x.infixHead then "a `" ++ typeName k ++ "` b" else typeName k end if) in
  let top = start + prelude.length docs in
  let body = (if isVoid x then [] else (if isRecord x
               then ["  = " ++ conName k 0]
                      ++ (if fmtDoc x then ["    { -- | Before."] ++ (if fmtTwo x then ["      -- More."] else [] end if) ++ ["      " ++ fieldName k 0 ++ " :: Int"] ++ fieldLines k 1 (fieldsOf x) false false false
                          else fieldLines k 0 (fieldsOf x) x.after x.pairFields x.afterBelow end if) ++ ["    }"]
                      ++ (if sharedCon x then [sharedLead k ++ fieldName k (fieldsOf x) ++ " :: Int }"] else [] end if)
               else (if fmtDoc x then ["  = -- | Before."] ++ (if fmtTwo x then ["    -- More."] else [] end if) ++ ["    " ++ conName k 0 ++ positional (fieldsOf x)] ++ conLines k 1 (consOf x) (fieldsOf x) false
                     else conLines k 0 (consOf x) (fieldsOf x) false
                            ++ (if infixOn x then ["  | Int " ++ infixConName k ++ " Int", "  | Int `" ++ tickConName k ++ "` Int"] else [] end if) end if) end if) end if) in
  let lines = docs ++ [head] ++ (if x.blockAfter then blockAfters body else body end if) in
  let last = start + prelude.length lines - 1 in
  let t = declOf (typeName k) (typeName k) KindType (at file top 1 last) "" (docRaw x.doc) in
  let kids = (if isVoid x then [] else (if isRecord x
               then [declOf (typeName k ++ "." ++ conName k 0) (conName k 0) KindConstructor (at file (top + 1) 5 (if sharedCon x then last - 1 else last end if)) (typeName k) (DocText record{ raw = "" , format = NoDoc})]
                      ++ (if sharedCon x then [declOf (typeName k ++ "." ++ conName k 1) (conName k 1) KindConstructor (at file last 5 last) (typeName k) (DocText record{ raw = "" , format = NoDoc}),
                                               fxType (declOf (typeName k ++ "." ++ fieldName k (fieldsOf x)) (fieldName k (fieldsOf x)) KindField (at file last (prelude.length (sharedLead k) + 1) last) (typeName k) (DocText record{ raw = "" , format = NoDoc})) "Int"] else [] end if)
                      ++ (if fmtDoc x then withFirstDoc (fieldDecls file k 0 (fieldsOf x) (top + 3 + twoOf x) false false false) (fmtDocText x)
                          else fieldDecls file k 0 (fieldsOf x) (top + 2) x.after x.pairFields x.afterBelow end if)
               else (if fmtDoc x then withFirstDoc (conDecls file k 0 (consOf x) (top + 2 + twoOf x) false) (fmtDocText x)
                     else conDecls file k 0 (consOf x) (top + 1) false
                            ++ (if infixOn x then [declOf (typeName k ++ "." ++ infixConName k) (infixConName k) KindConstructor (at file (top + 1 + consOf x) 5 (top + 1 + consOf x)) (typeName k) (DocText record{ raw = "" , format = NoDoc}),
                                                   declOf (typeName k ++ "." ++ tickConName k) (tickConName k) KindConstructor (at file (top + 2 + consOf x) 5 (top + 2 + consOf x)) (typeName k) (DocText record{ raw = "" , format = NoDoc})] else [] end if) end if) end if) end if) in
  Block record{ lines = lines , decls = [t with detail = (t.detail with typeKind = (if x.isNewtype then "newtype" else "data" end if))] ++ kids}
  end let end let end let end let end let end let end let end let
end function

function synBlock (file :: Text) (k :: Integer) (start :: Integer) -> Block is
  let t = declOf (synName k) (synName k) KindType (at file start 1 start) "" (DocText record{ raw = "" , format = NoDoc}) in
  Block record{ lines = ["type " ++ synName k ++ " = Int"] , decls = [t with detail = (t.detail with typeKind = "synonym" , underlying = "Int")]}
  end let
end function

-- A class's methods; with `valueMethod`, the first has a value type,
-- written `[a]`: the pinned grammar mis-parses a later class after `:: a`
-- or `:: Int` in some layouts (F87, law HSE-0b), not after `:: [a]`.
function methodLines (k :: Integer) (j :: Integer) (n :: Integer) (valueMethod :: Bool) (pair :: Bool) -> List Text is
  if j >= n then [] else
    (if j = 0 && pair && n >= 2
     then ["  " ++ methodName k 0 ++ ", " ++ methodName k 1 ++ " :: a -> Int"] ++ methodLines k 2 n valueMethod pair
     else ["  " ++ methodName k j ++ " :: " ++ (if valueMethod && j = 0 then "[a]" else "a -> Int" end if)] ++ methodLines k (j + 1) n valueMethod pair end if)
  end if
end function

function methodRow (j :: Integer) (pair :: Bool) (n :: Integer) -> Integer is
  if pair && n >= 2 then (if j <= 1 then 0 else j - 1 end if) else j end if
end function

function opMethodDecl (file :: Text) (k :: Integer) (line :: Integer) -> Decl is
  let d = declOf (className k ++ "." ++ opName k) (opName k) KindMethod (at file line 3 line) (className k) (DocText record{ raw = "" , format = NoDoc}) in
    d with detail = (d.detail with signature = Present (Signature record{ params = [Param record{ name = "" , typeText = "a" , annotations = [] , nameSynthetic = false}] ,
                                returns = intParams 1 , typeParams = [] , receiver = Absent , variadic = false , modifiers = [] , descriptor = "" , throws = []}))
  end let
end function

function methodDecls (file :: Text) (k :: Integer) (j :: Integer) (n :: Integer) (start :: Integer) (valueMethod :: Bool) (pair :: Bool) (doc :: Bool) -> List Decl is
  if j >= n then [] else
    [let d = declOf (className k ++ "." ++ methodName k j) (methodName k j) KindMethod
               (at file (start + methodRow j pair n) 3 (start + methodRow j pair n)) (className k)
               (if doc && methodRow j pair n = 0 then DocText record{ raw = "Method." , format = Haddock} else DocText record{ raw = "" , format = NoDoc} end if) in
       d with detail = (d.detail with signature = Present (if valueMethod && !(pair && n >= 2) && j = 0
         then Signature record{ params = [] , returns = [Param record{ name = "" , typeText = "[a]" , annotations = [] , nameSynthetic = false}] ,
                                typeParams = [] , receiver = Absent , variadic = false , modifiers = [] , descriptor = "" , throws = []}
         else Signature record{ params = [Param record{ name = "" , typeText = "a" , annotations = [] , nameSynthetic = false}] ,
                                returns = intParams 1 , typeParams = [] , receiver = Absent , variadic = false , modifiers = [] , descriptor = "" , throws = []} end if)) end let]
      ++ methodDecls file k (j + 1) n start valueMethod pair doc
  end if
end function

function superText (s :: Int8) -> Text is
  let f = fold s 7 in (if f = 1 then "Eq a => " else (if f = 2 then "(Eq a, Show a) => " else (if f = 3 then "Foo (Bar a) a => " else (if f = 4 then "(Eq a) => " else (if f = 5 then "Foo => " else (if f = 6 then "(a ~ Int) => " else "" end if) end if) end if) end if) end if) end if) end let
end function

function superNames (s :: Int8) -> List Text is
  let f = fold s 7 in (if f = 1 then ["Eq"] else (if f = 2 then ["Eq", "Show"] else (if f = 3 then ["Foo"] else (if f = 4 then ["Eq"] else (if f = 5 then ["Foo"] else [] end if) end if) end if) end if) end if) end let
end function

function classBlock (file :: Text) (x :: ClassModel) (k :: Integer) (start :: Integer) -> Block is
  let docs = docLines x.doc in
  let top = start + prelude.length docs in
  let n = methodsOf x in
  let mdoc = x.methodDoc && n > 0 in
  let head = "class " ++ superText x.super ++ className k ++ " a" ++ (if n > 0 || x.opMethod then " where" else "" end if) in
  let lines = docs ++ [head] ++ (if mdoc then ["  -- | Method."] else [] end if) ++ methodLines k 0 n x.valueMethod x.pairMethods
                ++ (if x.opMethod then ["  (" ++ opName k ++ ") :: a -> Int"] else [] end if) in
  let t = declOf (className k) (className k) KindClass (at file top 1 (start + prelude.length lines - 1)) "" (docRaw x.doc) in
  Block record{ lines = lines ,
                decls = [t with detail = (t.detail with typeKind = "typeclass" , binary = (noBinary unitValue with extends = superNames x.super))]
                          ++ methodDecls file k 0 n (top + 1 + (if mdoc then 1 else 0 end if)) x.valueMethod x.pairMethods mdoc
                          ++ (if x.opMethod then [opMethodDecl file k (start + prelude.length lines - 1)] else [] end if)}
  end let end let end let end let end let end let end let
end function

function instBlock (file :: Text) (ds :: List HsDecl) (x :: InstModel) (start :: Integer) -> Block is
  let cls = (if x.own then (first matching case of classNames ds 0 : when Nil then "Show" when Cons c0 rest then c0 end case) else "Show" end if) in
  let base = (first matching case of pickText x.target (dataNames ds 0) : when Absent then "Int" when Present t then t end case) in
  let ty = (if x.wrapped then "(Maybe " ++ base ++ ")" else base end if) in
  let gap = (if x.spaced then "  " else " " end if) in
  let written = (if x.wrapped then "(Maybe" ++ gap ++ base ++ ")" else base end if) in
  let head = "instance" ++ gap ++ cls ++ gap ++ written ++ (if x.method then " where" else "" end if) in
  let lines = (if x.doc then ["-- | Inst."] else [] end if) ++ [head] ++ (if x.method then ["  " ++ (if x.own then "mthX" else "show" end if) ++ " _ = 0"] else [] end if) in
  let id = "instance " ++ cls ++ " " ++ ty in
  Block record{ lines = lines , decls = [declOf id id KindInstance (at file (if x.doc then start + 1 else start end if) 1 (start + prelude.length lines - 1)) "" (if x.doc then DocText record{ raw = "Inst." , format = Haddock} else DocText record{ raw = "" , format = NoDoc} end if)]}
  end let end let end let end let end let end let end let end let
end function

-- Ordinals while walking a module's declarations.
type Ords is a record{
  value :: Integer
  op :: Integer
  data :: Integer
  syn :: Integer
  cls :: Integer}
end type

function declBlocks (x :: Ctx) (file :: Text) (ds :: List HsDecl) (all :: List HsDecl) (o :: Ords) (start :: Integer) -> Block is
  first matching case of ds :
    when Nil then Block record{ lines = [] , decls = []}
    when Cons d rest then
      (let firstValue = prelude.at 0 (plainValues all 0) in
        (let b = (first matching case of d :
                   when DValue v then valueBlock x file v (valueName v o.value o.op) (if v.operator then opBare o.op else "v" ++ textOf o.value end if) firstValue start
                   when DData dm then dataBlock file dm o.data start
                   when DSyn then synBlock file o.syn start
                   when DClass cm then classBlock file cm o.cls start
                   when DInst im then instBlock file all im start
                 end case) in
          (let o2 = (first matching case of d :
                      when DValue v then (if v.operator then o with op = o.op + 1 else o with value = o.value + 1 end if)
                      when DData dm then o with data = o.data + 1
                      when DSyn then o with syn = o.syn + 1
                      when DClass cm then o with cls = o.cls + 1
                      when DInst im then o
                    end case) in
            (let more = declBlocks x file rest all o2 (start + prelude.length b.lines + 1) in
              Block record{ lines = b.lines ++ [""] ++ more.lines , decls = b.decls ++ more.decls}
            end let) end let) end let) end let)
  end case
end function

-- ---------------------------------------------------------------------------
-- A module: its file text and its package.

type Rendered is a record{
  source :: Text
  crlf :: Text
  pkg :: Package}
end type

function withVisibility (exported :: Maybe (List Text)) (ds :: List Decl) -> List Decl is
  first matching case of ds :
    when Nil then []
    when Cons d rest then [d with visibility = visibleIn exported d.kind d.id] ++ withVisibility exported rest
  end case
end function

function markEntry (inv :: Invocation) (ds :: List Decl) -> List Decl is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      [(if d.id = "main" then d with entry = EntryPoint record{ isEntrypoint = true , invocation = Present inv} else d end if)] ++ markEntry inv rest
  end case
end function

function exportListOf (i :: Integer) (m :: HsModule) -> Maybe (List ExportPick) is
  if hasHeader i m.kind then m.exports else Absent end if
end function

-- A module using `rec` (InRec) needs RecursiveDo (review 5, B3).
function bindsRec (d :: HsDecl) -> Bool is
  first matching case of d : when DValue v then v.scope = InRec when DData x then false when DSyn then false when DClass x then false when DInst x then false end case
end function

function usesRec (ds :: List HsDecl) -> Bool is prelude.any bindsRec ds end function

function headLinesOf (i :: Integer) (m :: HsModule) -> List Text is
  (if usesRec m.decls then ["{-# LANGUAGE RecursiveDo #-}"] else [] end if)
    ++ (if m.noPrelude then ["{-# LANGUAGE NoImplicitPrelude #-}"] else [] end if)
    ++ (if m.rebindable then ["{-# LANGUAGE RebindableSyntax #-}"] else [] end if)
    ++ (if hasHeader i m.kind && m.doc then (if m.blockDoc then ["{- |", "Module doc.", "-}"] else ["-- | Module doc."] end if) ++ (if m.docGap then [""] else [] end if) else [] end if)
    ++ (if hasHeader i m.kind then [moduleLine i m] else [] end if)
    ++ importLines m.imports ++ [""]
end function

function moduleLine (i :: Integer) (m :: HsModule) -> Text is
  "module " ++ moduleId i m.kind
    ++ (first matching case of exportListOf i m : when Absent then "" when Present ps then " (" ++ prelude.join ", " (exportItems m.decls ps (moduleId i m.kind)) ++ ")" end case)
    ++ " where"
end function

-- A headerless module means `module Main (main) where` (Haskell report).
function exportedOf (i :: Integer) (m :: HsModule) -> Maybe (List Text) is
  if !(hasHeader i m.kind) then Present ["main"] else
    (first matching case of exportListOf i m : when Absent then Absent when Present ps then (if ps contains ESelf then Absent else Present (exportedIds m.decls ps) end if) end case)
  end if
end function

function bodyOf (i :: Integer) (m :: HsModule) -> Block is
  declBlocks (Ctx record{ moduleId = moduleId i m.kind , tops = topNames m.decls , imports = m.imports , noPrelude = m.noPrelude || m.rebindable , ops = opValues m.decls 0 , fields = recordFields m.decls 0})
             (moduleFile i m.kind) m.decls m.decls (Ords record{ value = 0 , op = 0 , data = 0 , syn = 0 , cls = 0})
             (prelude.length (headLinesOf i m) + 1)
end function

function mainBlock (file :: Text) (on :: Bool) (start :: Integer) -> Block is
  if on then
    (let d = declOf "main" "main" KindConst (at file start 1 (start + 1)) "" (DocText record{ raw = "" , format = NoDoc}) in
       Block record{ lines = ["main :: IO ()", "main = mempty"] , decls = [d with detail = (d.detail with typeText = "IO ()")]} end let)
  else Block record{ lines = [] , decls = []} end if
end function

function isEntry (i :: Integer) (m :: HsModule) -> Bool is isMainModule i m.kind && m.mainDef end function

function invocationOf (i :: Integer) (m :: HsModule) -> Invocation is
  Invocation record{ kind = "binary" , how = "runghc " ++ moduleFile i m.kind}
end function

function renderModule (i :: Integer) (m :: HsModule) -> Rendered is
  let body = bodyOf i m in
  let mb = mainBlock (moduleFile i m.kind) m.mainDef (prelude.length (headLinesOf i m) + prelude.length body.lines + 1) in
  let decls = withVisibility (exportedOf i m) (body.decls ++ mb.decls) in
    Rendered record{
      source = joinLines (headLinesOf i m ++ body.lines ++ mb.lines) ++ "\n" ,
      crlf = prelude.join "\r\n" (headLinesOf i m ++ body.lines ++ mb.lines) ++ "\r\n" ,
      pkg = Package record{ id = moduleId i m.kind , language = "haskell" , path = moduleFile i m.kind , name = moduleName i m.kind ,
                            doc = (if hasHeader i m.kind && m.doc then "Module doc." else "" end if) , level = "module" , members = [] ,
                            isEntrypoint = isEntry i m , invocation = (if isEntry i m then Present (invocationOf i m) else Absent end if) ,
                            symbols = (if isEntry i m then markEntry (invocationOf i m) decls else decls end if)}}
  end let end let end let
end function



function renderAll (ms :: List HsModule) (i :: Integer) -> List Rendered is
  first matching case of ms : when Nil then [] when Cons m rest then [renderModule i m] ++ renderAll rest (i + 1) end case
end function

function sourcesOf (rs :: List Rendered) (ms :: List HsModule) (i :: Integer) -> List SourceFile is
  first matching case of rs :
    when Nil then []
    when Cons r rest then
      (first matching case of ms :
        when Nil then []
        when Cons m mrest then [SourceFile record{ path = moduleFile i m.kind , content = r.source}] ++ sourcesOf rest mrest (i + 1)
      end case)
  end case
end function

function packagesOf (rs :: List Rendered) -> List Package is
  first matching case of rs : when Nil then [] when Cons r rest then [r.pkg] ++ packagesOf rest end case
end function

-- Files the extractor must not report: a dot-directory, a literate file and
-- a boot file (out of v1 scope: skipped, never mislabeled).
function noiseFiles (on :: Bool) -> List SourceFile is
  if on then [SourceFile record{ path = ".hidden/Ghost.hs" , content = "module Ghost where\nghost = 0\n"} ,
              SourceFile record{ path = "dist-newstyle/src/Dep.hs" , content = "module Dep where\ndep = 0\n"} ,
              SourceFile record{ path = "dist/Old.hs" , content = "module Old where\nold = 0\n"} ,
              SourceFile record{ path = "Ghost.lhs" , content = "> module Ghost where\n> ghost = 0\n"} ,
              SourceFile record{ path = "Ghost.hs-boot" , content = "module Ghost where\nghost :: Int\n"}]
  else [] end if
end function

-- Out-of-scope forms (spec.md: "must not crash and must not mislabel. It
-- skips what it does not model"): a GADT keeps its type and loses its
-- constructors; type families, pattern synonyms, splices, CPP lines,
-- standalone deriving and foreign imports are skipped; a binding inside a
-- CPP block is an ordinary binding.
-- ---------------------------------------------------------------------------
-- Fixture modules (scope-design.md, sections J, M and Q; next-cycle-2/design.md; next-cycle-4/design.md; next-cycle-5/design.md): literal sources with
-- their literal expected packages. GENERATED by next-cycle-5/tools/gen-fixtures.py (the next calibration/tools/gen-fixtures.py)
-- from hand-written tables; edit the tables, not this text.

function fx (file :: Text) (id :: Text) (name :: Text) (kind :: SymbolKind) (line :: Integer) (col :: Integer) (endLine :: Integer) (owner :: Text) (vis :: Visibility) -> Decl is
  (declOf id name kind (at file line col endLine) owner (DocText record{ raw = "" , format = NoDoc})) with visibility = vis
end function

function fxKind (d :: Decl) (typeKind :: Text) (underlying :: Text) -> Decl is
  d with detail = (d.detail with typeKind = typeKind , underlying = underlying)
end function

function fxType (d :: Decl) (t :: Text) -> Decl is d with detail = (d.detail with typeText = t) end function

function fxImpl (d :: Decl) (classes :: List Text) -> Decl is
  d with detail = (d.detail with binary = (d.detail.binary with implements = classes))
end function

function fxDoc (d :: Decl) (raw :: Text) -> Decl is d with doc = DocText record{ raw = raw , format = Haddock} end function

function fxParams (ts :: List Text) -> List Param is
  first matching case of ts :
    when Nil then []
    when Cons t rest then [Param record{ name = "" , typeText = t , annotations = [] , nameSynthetic = false}] ++ fxParams rest
  end case
end function

function fxSig (d :: Decl) (params :: List Text) (result :: Text) -> Decl is
  d with detail = (d.detail with signature = Present (Signature record{ params = fxParams params , returns = fxParams [result] , typeParams = [] ,
                                                                       receiver = Absent , variadic = false , modifiers = [] , descriptor = "" , throws = []}))
end function

function fxCalls (d :: Decl) (es :: List CallEdge) -> Decl is d with calls = merged es end function

function fxWhen (d :: Decl) (condition :: Text) -> Decl is d with condition = condition end function

function fixtureExoticSource (u :: Unit) -> Text is
  "{-# LANGUAGE CPP #-}\nmodule Exotic (pattern P, G (..), F, exv, type (+++), Box, D (D1), rx, cinsert) where\n\ndata G a where\n  GK :: Int -> G Int\n  GA, GB :: G Bool\n  GR :: { gf :: a, gg :: Int } -> G a\n  deriving (Show, Eq)\n\ntype family F a\n\ntype family F2 a where\n  F2 Int = Bool\n\ntype instance F Int = Bool\n\ndata family D a\n\ndata instance D Int = D1 Int | D2 { dfld :: Int }\n\nnewtype instance D Bool = D3 Bool\n\nclass Coll c where\n  type Elem c\n  data Box c\n  cinsert :: Elem c -> c -> c\n  cinsert _ c = cid c\n\ninstance Coll [a] where\n  type Elem [a] = a\n  data Box [a] = BoxL [a]\n  cinsert x xs = cid (x : xs)\n\n-- | A pattern.\npattern P :: Int\npattern P = 0\n\npattern Q x <- Just x where\n  Q x = cid (Just x)\n\npattern R {rx, ry} = (rx, ry)\n\nderiving instance Show (D Int)\n\nforeign import ccall \"sin\" c_sin :: Double -> Double\nforeign import ccall \"v\" c_v :: Int\nforeign export ccall exv :: Int -> Int\n\ntype a +++ b = Either a b\n\ndata T = T1 | T2 Int\n  deriving stock (Show)\n  deriving anyclass (Coll)\n\nnewtype N = N Int deriving newtype (Num)\n\ndata Y = !Int :? Int | forall a. Show a => a :^ a\n\n(pa, pb) = cid (1, 2)\n\n(fh x) y = cid x\n\ninfixr 5 +++\ntype role G nominal\ntype KS :: Type\ntype KS = Int\n\nmakeIt ''T\n\n$(return [])\n\n-- |\n-- Bare first line.\ncid x = x\nexv x = x\n\n#if EXOTIC_CPP\ncppv = 1\n#else\ncppelse = 2\n#endif\n"
end function

function fixtureExoticPackage (u :: Unit) -> Package is
  Package record{ id = "Exotic" , language = "haskell" , path = "Exotic.hs" , name = "Exotic" , doc = "" , level = "module" , members = [] , isEntrypoint = false , invocation = Absent ,
    symbols = [
      fxImpl (fxKind (fx "Exotic.hs" "G" "G" KindType 4 1 8 "" Exported) "data" "") ["Show", "Eq"] ,
      fx "Exotic.hs" "G.GK" "GK" KindConstructor 5 3 5 "G" Exported ,
      fx "Exotic.hs" "G.GA" "GA" KindConstructor 6 3 6 "G" Exported ,
      fx "Exotic.hs" "G.GB" "GB" KindConstructor 6 3 6 "G" Exported ,
      fx "Exotic.hs" "G.GR" "GR" KindConstructor 7 3 7 "G" Exported ,
      fxType (fx "Exotic.hs" "G.gf" "gf" KindField 7 11 7 "G" Exported) "a" ,
      fxType (fx "Exotic.hs" "G.gg" "gg" KindField 7 20 7 "G" Exported) "Int" ,
      fxKind (fx "Exotic.hs" "F" "F" KindType 10 1 10 "" Exported) "type-family" "" ,
      fxKind (fx "Exotic.hs" "F2" "F2" KindType 12 1 13 "" Unexported) "closed-type-family" "" ,
      fxKind (fx "Exotic.hs" "type instance F Int" "type instance F Int" KindInstance 15 1 15 "" Exported) "" "Bool" ,
      fxKind (fx "Exotic.hs" "D" "D" KindType 17 1 17 "" Exported) "data-family" "" ,
      fx "Exotic.hs" "data instance D Int" "data instance D Int" KindInstance 19 1 19 "" Exported ,
      fx "Exotic.hs" "D.D1" "D1" KindConstructor 19 23 19 "D" Exported ,
      fx "Exotic.hs" "D.D2" "D2" KindConstructor 19 32 19 "D" Unexported ,
      fxType (fx "Exotic.hs" "D.dfld" "dfld" KindField 19 37 19 "D" Unexported) "Int" ,
      fx "Exotic.hs" "newtype instance D Bool" "newtype instance D Bool" KindInstance 21 1 21 "" Exported ,
      fx "Exotic.hs" "D.D3" "D3" KindConstructor 21 27 21 "D" Unexported ,
      fxKind (fx "Exotic.hs" "Coll" "Coll" KindClass 23 1 27 "" Unexported) "typeclass" "" ,
      fxKind (fx "Exotic.hs" "Coll.Elem" "Elem" KindType 24 3 24 "Coll" Unexported) "type-family" "" ,
      fxKind (fx "Exotic.hs" "Coll.Box" "Box" KindType 25 3 25 "Coll" Exported) "data-family" "" ,
      fxCalls (fxSig (fx "Exotic.hs" "Coll.cinsert" "cinsert" KindMethod 26 3 27 "Coll" Exported) ["Elem c", "c"] "c") [edge Internal "cid" (Present "Exotic#cid")] ,
      fxCalls (fx "Exotic.hs" "instance Coll [a]" "instance Coll [a]" KindInstance 29 1 32 "" Exported) [edge Internal "cid" (Present "Exotic#cid"), edge Builtin ":" Absent] ,
      fxKind (fx "Exotic.hs" "type instance Elem [a]" "type instance Elem [a]" KindInstance 30 3 30 "instance Coll [a]" Exported) "" "a" ,
      fx "Exotic.hs" "data instance Box [a]" "data instance Box [a]" KindInstance 31 3 31 "instance Coll [a]" Exported ,
      fx "Exotic.hs" "Coll.Box.BoxL" "BoxL" KindConstructor 31 18 31 "Coll.Box" Unexported ,
      fxDoc (fx "Exotic.hs" "P" "P" KindConstructor 35 1 36 "" Exported) "A pattern." ,
      fxCalls (fx "Exotic.hs" "Q" "Q" KindConstructor 38 1 39 "" Unexported) [edge Internal "cid" (Present "Exotic#cid"), edge Builtin "Just" Absent] ,
      fx "Exotic.hs" "R" "R" KindConstructor 41 1 41 "" Unexported ,
      fx "Exotic.hs" "R.rx" "rx" KindField 41 12 41 "R" Exported ,
