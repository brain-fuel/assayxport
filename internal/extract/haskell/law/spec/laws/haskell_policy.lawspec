function fixtureSixExpSource (u :: Unit) -> Text is
  "{-# LANGUAGE TypeOperators, ExplicitNamespaces, TypeData #-}\nmodule SixExp ((:+:) (..), (:*:) (P), type (++) (Q), (:*) (..), type (:%) (..), Universe (..), Kn (KA), td1, td2) where\nimport Other (Star (..))\n\ndata a :+: b = L a | R b\ndata a :*: b = P a | P2 b\ndata a ++ b = Q | Q2\ndata a :* b = a :* b | Nil\ndata (a :% b) = Q5 a b\ntype data Universe = Star | Arrow Universe Universe\ntype data Kn = KA | KB\ntype data Gk where\n  GA, GB :: Gk\ntd1 = Star 1\ntd2 = KA 1\n"
end function

