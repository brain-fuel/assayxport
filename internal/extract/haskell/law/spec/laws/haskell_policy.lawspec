function fixtureSixSource (u :: Unit) -> Text is
  "{-# LANGUAGE RecordWildCards, OverloadedRecordDot, PatternSynonyms, TemplateHaskell, TypeFamilies, TypeOperators, ParallelListComp #-}\nmodule Six where\nimport Data.Function ((&))\nimport Other (Imp (..), name)\n\ndata Rc = Rc { fa :: Int, fb :: Int }\ndata Op2 = Int :+ Int\ndata Tk = Outer Int Tk | Inner | Int :| Tk | Rk { rk :: Int }\nclass C a where\n  meth :: a -> Int\ndata family Df a\ndata instance Df Int = Df1 Int deriving (Show, Eq)\nnewtype instance Df Bool = Df2 Bool deriving newtype (Num)\ndata (a :% b) = Q a b\ndata (a `Bt` b) = Q6\ntype (a :%% b) = Either a b\nclass (a :=> b) where\n  mm :: a -> b\nsize x = x\nv0 x = x\nw0 x = x\n\nb1a (<>) a b = a <> b\nb1b (&) x = x & 1\nb1c = \\(+) a -> a + 1\nb1d (*) | True = 1 * 2\nb1e (Just (==)) a = a == 1\nb1f x = x <> 1 where (f, (<>)) = (1, 2)\nb1g x = let (Just (<>)) = Nothing in x <> 1\nb1h = 1 <+> 2\nb1i ((:+) a b) = a :+ b\nb1j xs = [a <+> b | ((<+>), a, b) <- xs]\n((<+>), q0) = v0 (1, 2)\n\np1 r = r.fa\np2 r = r.size\np3 r = r.meth\np4 r = r.name\np5 = (.size)\np6 r = r.fa.fb\np7 r = r.length\np8 size = size.size\n\nw1 Imp{..} a b = a <> b\nw2 Imp{..} a = (<> a)\nw3 Imp{..} a = (<>) a a\nw4 Imp{..} a = a : (a :+ a)\nw5 $(pat) a = a + 1\n\npattern Bang n = Outer n Inner\npattern Two a b = a :| (Outer b Inner)\npattern One a <- Outer a _\npattern Rp a = Rk { rk = a }\npattern Jp a = Just (Left a)\npattern Lp a = [Outer a Inner, Inner]\n\ng1 x | Just v0 <- v0 x = v0 1\ng2 = [v0 1 | v0 <- v0 2]\ng3 x | w0 x, Just w0 <- x = w0 1\ng4 x | Just w0 <- x, v0 (w0 1) = 2\ng5 xs = [1 | y <- w0 xs, w0 <- y]\ng6 xs = [1 | w0 <- xs, y <- w0 1]\ng7 xs ys = [1 | v0 <- xs | y <- v0 ys]\ng8 x = case x of { y | Just v0 <- v0 y -> v0 1 }\n\nn2a = Prelude.map 1\nn2b x = x Prelude.+ 1\nn2c = Prelude.zzq 1\nn2d = Prelude.Just 1\nn3a = (,) 1 2\nn3b = (,,) 1 2 3\n"
end function

