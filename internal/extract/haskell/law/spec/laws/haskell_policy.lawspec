function fixtureGramSource (u :: Unit) -> Text is
  "{-# LANGUAGE RequiredTypeArguments #-}\nmodule Gram where\n\nimport qualified GA as Q (data ..)\nimport qualified GB as R (type ..)\nimport qualified GC as S hiding (data ..)\nimport qualified GD as U (type .., data ..)\nimport GE (type ..)\nimport GF (data ..)\n\ndata T2 = MkT\n\nv0 x = x\nw0 x = x\n\na → b = a\n\nr1 = v0 (Int -> Bool)\nr2 = v0 (Show a => a) (w0 1)\nr3 = v0 (forall a. a -> a)\nr4 = v0 (forall a -> a)\nr5 = v0 (a %1 -> b)\nr6 = (->) 1 2\nr7 ((->) a b) = v0 a\nr8 = v0 (type Int)\nr9 = 1 → 2\nr10 = v0 (Maybe w0 -> T2)\nr11 = v0 (w0 1 -> Int)\nr12 = v0 (forall a. Maybe (w0 a))\nr13 = v0 ((->) (w0 1) Int)\nr14 = v0 (T2 1 %1 -> w0 2)\nr15 = w0 (Eq (v0 1) => T2 1)\nr16 = (→ 1)\nr17 = (→) 1 2\nn1 = Q.qf 1\nn2 = R.rf 1\nn3 = S.sf 1\nn4 = U.uf 1\nn5 = Q.QK 1\nn6 = zz 1\n"
end function

