function fixtureNextSource (u :: Unit) -> Text is
  "{-# LANGUAGE Arrows, OrPatterns, ViewPatterns, LambdaCase, MultilineStrings, NPlusKPatterns, LinearTypes, DataKinds, TypeApplications, OverloadedLabels, RecordWildCards, TemplateHaskell #-}\nmodule Next where\nimport Control.Arrow (returnA, (<+>), (>>>))\n\ndata Rf = Rf { (+++) :: Int, rb :: Int }\ndata Lin = Lin { lx %1 :: Int, ly %'Many :: Int }\ndata T = A | B | C\ntype Pr a b = Proxy '( 'a, 'b )\nv0 x = x\nw0 x = x\n\nar1 = proc x -> v0 -< w0 x\nar2 = proc x -> v0 -<< w0 x\nar3 = proc v0 -> v0 -< v0\nar4 = proc v0 -> v0 -<< w0 v0\nar5 = proc w0 -> v0 (w0 1) -< w0\nar6 = proc x -> do\n  w0 <- v0 -< x\n  let z = v0 w0\n  rec q <- v0 -< z q\n  w0 -<< q\n  w0 -< z\nar7 = proc x -> case x of\n  Left v0 -> v0 -<< x\n  Right w0 -> w0 -< x\nar8 = proc x -> if v0 x then w0 -< x else returnA -< x\nar9 = proc x -> let w0 = x in w0 -<< v0 w0\nar10 = proc x -> (| v0 (w0 -< x) (returnA -< x) |)\nar11 = proc v0 -> (| v0 (w0 -<< v0) |)\nar12 = proc x -> v0 >>> w0 -< x\nar13 = proc x -> (v0 -< x) <+> (w0 -< x)\nar14 = proc v0 -> (| v0 |)\nor1 (A; B) = v0 1\nor2 x = case x of { (Left _; Right (w0 -> True)) -> v0 1; _ -> 2 }\nor3 = \\case { (1; 2) -> v0 1; _ -> w0 2 }\nor4 w0 ((== w0) -> True; v0 -> 1) = w0 2\nms1 = v0 \"\"\"\n  w0 1 \"quoted\" it's\n  -- | not a doc\n  \"\"\"\nms2 = w0 \"\"\"a\"\"\"\nnk1 (v0 + 1) = v0 (w0 2)\nnk2 = \\(w0 + 2) -> w0 1\nrf1 = 1 +++ 2\nrf2 = Rf { (+++) = v0 1, rb = 2 }\nrf3 r = r { (+++) = w0 1 }\nrf4 Rf { (+++) = p } = p 1\nrf5 Rf{..} = 1 +++ rb\nrf6 r = (+++) r\nli1 u = let %1 w0 = u in w0 1\nli2 u = w0 1 where %1 w0 = u\nli3 u = let %1 (v0, w0) = u in v0 w0\nli4 u = let %Many x = u in v0 x\npr1 = v0 @'[] 1\npr2 = (w0 1 :: Proxy '[ 'True ])\nch1 = v0 ['\\r','\\n'] (w0 1)\nch2 = v0 ['\\'','\"'] (w0 '\\\\')\nlb1 = v0 #Foo #\"a b\" #3\nlb2 = do\n  #x `w0` v0 1\n  v0 2\nfx1 x =\n  let infixl 4 =:\n      a =: b = v0 a\n   in 1 =: x\nqd1 = [d|\n  qf a = v0 a\n\n  qg = w0 1 |]\n$(v0 [d| data Qt = Qt |])\n"
end function

