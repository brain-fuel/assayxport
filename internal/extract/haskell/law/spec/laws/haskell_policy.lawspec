  "{-# LANGUAGE CPP #-}\nmodule Cpp\n  ( f\n  , g\n#if EXPORT_K\n  , k\n#endif\n  ) where\n\n#if MIN_VERSION_base(4,8,0)\nimport Data.Foo (foo)\n#else\nimport Data.Bar (foo)\n#endif\n#ifdef WITH_Q\nimport qualified Q.New as Q\n#elif defined(OLD_Q) && !LEGACY\nimport qualified Q.Old as Q\n#endif\n\nv0 x = x\n\nf x = foo x\n\ng = Q.run 1\n\nk = v0 1\n\nh = v0\n#if ARG\n  1\n#endif\n\n#ifndef NO_T\ndata T = T1\n#  if WIDE\n  | T2\n#  endif\n#else\ntype T = Int\n#endif\n\n#if __GLASGOW_HASKELL__ >= 908 \\\n  && defined(FAST)\np :: Int\n#else\np :: Integer\n#endif\np = 1\n\nq = v0 2\n#define LOCAL 1\n"
end function

