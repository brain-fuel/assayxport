  [SourceFile record{ path = "Next.hs" , content = fixtureNextSource unitValue} ,
   SourceFile record{ path = "NextBrace.hs" , content = fixtureNextBraceSource unitValue} ,
   SourceFile record{ path = "NextExp.hs" , content = fixtureNextExpSource unitValue} ,
   SourceFile record{ path = "NextImp.hs" , content = fixtureNextImpSource unitValue} ,
   SourceFile record{ path = "SixImp.hs" , content = fixtureSixImpSource unitValue} ,
   SourceFile record{ path = "NextArr.hs" , content = fixtureNextArrSource unitValue}]
end function

function fixtureGapGrammarExtPackages (u :: Unit) -> List Package is
  [fixtureNextPackage unitValue, fixtureNextBracePackage unitValue, fixtureNextExpPackage unitValue, fixtureNextImpPackage unitValue, fixtureSixImpPackage unitValue, fixtureNextArrPackage unitValue]
end function

