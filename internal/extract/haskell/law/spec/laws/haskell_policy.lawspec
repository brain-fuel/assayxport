function fixturePackages (u :: Unit) -> List Package is
  [fixtureExoticPackage unitValue, fixturePrelAPackage unitValue, fixturePrelBPackage unitValue, fixturePrelCPackage unitValue, fixtureNextOpPackage unitValue, fixtureSixExpPackage unitValue, fixtureSixDocPackage unitValue, fixtureDoc2Package unitValue, fixtureCompPackage unitValue, fixtureWildAPackage unitValue, fixtureWildBPackage unitValue, fixtureWildCPackage unitValue, fixtureWildDPackage unitValue, fixtureDoc3Package unitValue, fixtureNextOp2Package unitValue, fixtureBindPackage unitValue]
end function


function render (t :: HsTree) -> List SourceFile is
  sourcesOf (renderAll t.modules 0) t.modules 0 ++ noiseFiles t.noise
    ++ (if t.exotic then fixtureSources unitValue else [] end if)
end function

-- The same tree written with Windows line endings (a CRLF checkout): ax
-- reports it as the LF tree (review 4, S3; the native layer's CRLF step,
-- which only a binary-level law can see: mutation survivor, 2026-11-11).
function renderCrlf (t :: HsTree) -> List SourceFile is
  crlfSources (renderAll t.modules 0) t.modules 0 ++ noiseFiles t.noise
    ++ (if t.exotic then fixtureSources unitValue else [] end if)
end function

function crlfSources (rs :: List Rendered) (ms :: List HsModule) (i :: Integer) -> List SourceFile is
  first matching case of rs :
    when Nil then []
    when Cons r rest then
      (first matching case of ms :
        when Nil then []
        when Cons m mrest then [SourceFile record{ path = moduleFile i m.kind , content = r.crlf}] ++ crlfSources rest mrest (i + 1)
      end case)
  end case
end function

function expected (t :: HsTree) -> List Package is
  packagesOf (renderAll t.modules 0) ++ (if t.exotic then fixturePackages unitValue else [] end if)
end function

-- ---------------------------------------------------------------------------
-- Designed generation: a tree holding every construct, rotated by r, plus
-- an extra module and extra declarations from the default generator.

function fnv (op :: Bool) (params :: Int8) (sig :: SigKind) (doc :: Maybe DocStyle) (shadow :: Bool) (calls :: List Callee) -> HsDecl is
  DValue (ValueModel record{ operator = op , params = params , sig = sig , doc = doc , shadow = shadow , clauses = false , sigAfter = false , infixDef = false , scope = NoScope , site = SiteList , docAfter = false , calls = calls})
end function

-- A value defined infix (`x <+> y = …`, or `` x `f` y = … ``).
function fnInfix (op :: Bool) (calls :: List Callee) -> HsDecl is
  DValue (ValueModel record{ operator = op , params = 2 , sig = SigFunc , doc = Absent , shadow = false , clauses = true , sigAfter = false , infixDef = true , scope = NoScope , site = SiteList , docAfter = false , calls = calls})
end function

-- A value whose body binds the module's first value name in `form`, and
-- also calls that name (internal outside the scope, dynamic inside it).
function fnScope (form :: ScopeForm) (site :: CallSite) -> HsDecl is
  DValue (ValueModel record{ operator = false , params = 1 , sig = SigNone , doc = Absent , shadow = false , clauses = false , sigAfter = false , infixDef = false , scope = form , site = site , docAfter = false , calls = [HTop 0]})
end function

-- A function of two equations whose signature follows them.
function fnClauses (calls :: List Callee) -> HsDecl is
  DValue (ValueModel record{ operator = false , params = 2 , sig = SigFunc , doc = Present DocOne , shadow = false , clauses = true , sigAfter = true , infixDef = false , scope = NoScope , site = SiteList , docAfter = false , calls = calls})
end function

function everyCallee (u :: Unit) -> List Callee is
  [HTop 0, HTop 1, HTop 2, HTopOp 0, HField 0, HSelfQual 0, HLocal 0, HExplicit, HQualAs, HQualFull, HOpenName, HPrelude 0, HPrelude 1, HUnknown, HUnknownAlias, HLambdaApply,
   HCurried, HShared, HInsert, HPostQualified, HQualHidingKept, HQualHidingHidden]
end function

function everyDecl (u :: Unit) -> List HsDecl is
  [fnv false 2 SigFunc (Present DocOne) false (everyCallee unitValue) ,
   fnv false 1 SigNone Absent true [HLocal 0, HTop 0] ,
   fnv false 0 SigFunc (Present DocTwo) false [HPrelude 2] ,
   fnv false 0 SigValue (Present DocNoSpace) false [HPrelude 3] ,
   fnv false 0 SigNone Absent false [] ,
   fnv true 2 SigFunc Absent false [HExplicit] ,
   fnClauses [HLocal 1, HTop 0] ,
   fnv false 2 SigConstrained Absent false [HTop 0] ,
   fnv false 0 SigForall Absent false [] ,
   fnInfix true [HLocal 0] ,
   fnInfix false [HLocal 1] ,
   fnScope InWhere SiteDo , fnScope InLet SiteGuard , fnScope InLambda SiteCase , fnScope InCase SiteFilter , fnScope InDo SiteList , fnScope InPattern SiteList ,
   DData (DataModel record{ isNewtype = false , asRecord = false , cons = 1 , fields = 2 , doc = Present DocOne , after = false , void = false , pairFields = false , afterBelow = false , sharedCon = false , fmtDoc = false , blockAfter = false , infixCons = false , infixHead = false}) ,
   DData (DataModel record{ isNewtype = false , asRecord = true , cons = 0 , fields = 1 , doc = Absent , after = true , void = false , pairFields = false , afterBelow = false , sharedCon = false , fmtDoc = false , blockAfter = false , infixCons = false , infixHead = false}) ,
   DData (DataModel record{ isNewtype = true , asRecord = false , cons = 0 , fields = 0 , doc = Absent , after = false , void = false , pairFields = false , afterBelow = false , sharedCon = false , fmtDoc = false , blockAfter = false , infixCons = false , infixHead = false}) ,
   DData (DataModel record{ isNewtype = false , asRecord = false , cons = 0 , fields = 0 , doc = Absent , after = false , void = true , pairFields = false , afterBelow = false , sharedCon = false , fmtDoc = false , blockAfter = false , infixCons = false , infixHead = false}) ,
   DData (DataModel record{ isNewtype = false , asRecord = true , cons = 0 , fields = 2 , doc = Absent , after = true , void = false , pairFields = true , afterBelow = false , sharedCon = false , fmtDoc = false , blockAfter = false , infixCons = false , infixHead = false}) ,
   DData (DataModel record{ isNewtype = false , asRecord = true , cons = 0 , fields = 2 , doc = Absent , after = false , void = false , pairFields = false , afterBelow = true , sharedCon = false , fmtDoc = false , blockAfter = false , infixCons = false , infixHead = false}) ,
   DSyn ,
   DClass (ClassModel record{ super = 1 , methods = 2 , valueMethod = true , pairMethods = false , methodDoc = false , opMethod = false , doc = Present DocOne}) ,
   DClass (ClassModel record{ super = 0 , methods = 0 , valueMethod = false , pairMethods = false , methodDoc = false , opMethod = false , doc = Absent}) ,
   DClass (ClassModel record{ super = 2 , methods = 2 , valueMethod = false , pairMethods = true , methodDoc = true , opMethod = false , doc = Absent}) ,
   DClass (ClassModel record{ super = 3 , methods = 1 , valueMethod = false , pairMethods = false , methodDoc = false , opMethod = false , doc = Absent}) ,
   DInst (InstModel record{ own = true , target = 0 , spaced = true , wrapped = true , method = true , doc = false}) ,
   DInst (InstModel record{ own = false , target = 9 , spaced = false , wrapped = false , method = false , doc = false})]
end function

function rotate (n :: Integer) (xs :: List HsDecl) -> List HsDecl is
  if n <= 0 then xs else (first matching case of xs : when Nil then [] when Cons y rest then rotate (n - 1) (rest ++ [y]) end case) end if
end function

function hm (kind :: ModKind) (doc :: Bool) (exports :: Maybe (List ExportPick)) (noPrelude :: Bool) (imports :: List ImportModel) (decls :: List HsDecl) (mainDef :: Bool) -> HsModule is
  HsModule record{ kind = kind , doc = doc , blockDoc = false , docGap = false , exports = exports , noPrelude = noPrelude , rebindable = false , imports = imports , decls = decls , mainDef = mainDef}
end function

function everything (r :: Int8) (extra :: HsModule) (more :: List HsDecl) -> HsTree is
  HsTree record{
    modules = [hm MainHeader true (Present [EValue 0, ETypeAll 0, ETypeOnly 1, EClassAll 0, EClassOnly 1, ETypeSome 2, EField 0, EMethod 0, EMain]) false
                  [ImpExplicit, ImpQualifiedAs, ImpQualified, ImpOpen, ImpHidePrelude, ImpHidingTight, ImpQualifiedPost, ImpSharedAlias, ImpQualifiedHiding]
                  (rotate (fold r 30) (everyDecl unitValue) ++ more) true ,
               hm Dotted false Absent true [] [fnv false 1 SigFunc Absent false [HPrelude 0, HTop 0], fnScope InDoLet SiteList, fnScope InPatGuard SiteList, fnScope InGenerator SiteList, fnScope InPatLet SiteList, fnScope InWherePat SiteList, fnScope InFieldPat SiteList, fnScope InFieldPun SiteList,
                                               DData (DataModel record{ isNewtype = false , asRecord = true , cons = 0 , fields = 2 , doc = Absent , after = false , void = false , pairFields = false , afterBelow = false , sharedCon = true , fmtDoc = false , blockAfter = false , infixCons = false , infixHead = false}),
                                               DData (DataModel record{ isNewtype = false , asRecord = false , cons = 1 , fields = 1 , doc = Absent , after = false , void = false , pairFields = false , afterBelow = false , sharedCon = false , fmtDoc = true , blockAfter = false , infixCons = false , infixHead = false}),
                                               DData (DataModel record{ isNewtype = false , asRecord = true , cons = 0 , fields = 2 , doc = Absent , after = false , void = false , pairFields = false , afterBelow = false , sharedCon = false , fmtDoc = true , blockAfter = false , infixCons = false , infixHead = false}),
                                               DData (DataModel record{ isNewtype = false , asRecord = false , cons = 1 , fields = 1 , doc = Absent , after = true , void = false , pairFields = false , afterBelow = false , sharedCon = false , fmtDoc = false , blockAfter = true , infixCons = false , infixHead = false}),
                                               DData (DataModel record{ isNewtype = false , asRecord = true , cons = 0 , fields = 2 , doc = Absent , after = true , void = false , pairFields = false , afterBelow = false , sharedCon = false , fmtDoc = false , blockAfter = true , infixCons = false , infixHead = false}),
                                               DClass (ClassModel record{ super = 4 , methods = 1 , valueMethod = false , pairMethods = false , methodDoc = false , opMethod = false , doc = Absent}),
                                               DClass (ClassModel record{ super = 5 , methods = 1 , valueMethod = false , pairMethods = false , methodDoc = false , opMethod = false , doc = Absent}),
                                               DClass (ClassModel record{ super = 6 , methods = 1 , valueMethod = false , pairMethods = false , methodDoc = false , opMethod = false , doc = Absent})] true ,
               HsModule record{ kind = Named , doc = true , blockDoc = true , docGap = false , exports = Absent , noPrelude = false , rebindable = false , imports = [] ,
                                decls = [fnv false 0 SigNone (Present DocBlock) false [], fnv false 0 SigNone (Present DocBlockTight) false []] , mainDef = false} ,
               HsModule record{ kind = Named , doc = false , blockDoc = false , docGap = false , exports = Present [ESelf, EReexport] , noPrelude = false , rebindable = false , imports = [ImpOpen] ,
                                decls = [fnv false 0 SigNone Absent false [],
                                         DData (DataModel record{ isNewtype = false , asRecord = false , cons = 0 , fields = 1 , doc = Absent , after = false , void = false , pairFields = false , afterBelow = false , sharedCon = false , fmtDoc = false , blockAfter = false , infixCons = true , infixHead = false}),
                                         DClass (ClassModel record{ super = 0 , methods = 1 , valueMethod = false , pairMethods = false , methodDoc = false , opMethod = true , doc = Absent})] , mainDef = false} ,
               HsModule record{ kind = Named , doc = false , blockDoc = false , docGap = false , exports = Present [EClassOp 0, EOpMethod 1, EConOp 0] , noPrelude = false , rebindable = false , imports = [] ,
                                decls = [DData (DataModel record{ isNewtype = false , asRecord = false , cons = 1 , fields = 0 , doc = Absent , after = false , void = false , pairFields = false , afterBelow = false , sharedCon = false , fmtDoc = false , blockAfter = false , infixCons = true , infixHead = false}),
                                         DClass (ClassModel record{ super = 0 , methods = 1 , valueMethod = false , pairMethods = false , methodDoc = false , opMethod = true , doc = Absent}),
                                         DClass (ClassModel record{ super = 0 , methods = 0 , valueMethod = false , pairMethods = false , methodDoc = false , opMethod = true , doc = Absent})] , mainDef = false} ,
               hm Named false (Present []) false [ImpPreludeOnly] [fnv false 0 SigNone Absent false [HPrelude 1, HPrelude 0]] false ,
               hm Named false Absent false [ImpHidingLines] [fnv false 0 SigNone Absent false [HPrelude 0, HPrelude 1, HCurried]] false ,
               hm Named false Absent false [ImpPreludeEmpty] [fnv false 0 SigNone Absent false [HPrelude 1, HCurried]] false ,
               hm Named false Absent false [ImpPreludeQualified, ImpHidePrelude] [fnv false 0 SigNone Absent false [HPrelude 0, HPrelude 1]] false ,
               (hm Named false Absent false [] [fnv false 0 SigNone Absent false [HPrelude 1]] false) with rebindable = true ,
               hm Named false (Present [EQualSelf 0]) false [] [fnv false 0 SigNone Absent false [HPrelude 7], fnv false 0 SigNone Absent false [HPrelude 12]] false ,
               (hm Named true Absent false [] [fnv false 0 SigNone (Present DocGap) false [HField 0, HSelfQual 0], fnScope InGuardLet SiteList, fnScope InQualLet SiteList, fnScope InAltWhere SiteList, fnScope InRec SiteSig,
                                                fnv false 1 SigFunc (Present DocGapComment) false [],
                                                DValue (ValueModel record{ operator = false , params = 1 , sig = SigFunc , doc = Absent , shadow = false , clauses = false , sigAfter = false , infixDef = false , scope = NoScope , site = SiteList , docAfter = true , calls = []}),
                                                DData (DataModel record{ isNewtype = false , asRecord = true , cons = 0 , fields = 2 , doc = Present DocTwo , after = false , void = false , pairFields = false , afterBelow = false , sharedCon = false , fmtDoc = true , blockAfter = false , infixCons = false , infixHead = true}),
                                                DData (DataModel record{ isNewtype = false , asRecord = false , cons = 2 , fields = 1 , doc = Present DocTwo , after = false , void = false , pairFields = false , afterBelow = false , sharedCon = false , fmtDoc = true , blockAfter = false , infixCons = false , infixHead = false}),
                                                DInst (InstModel record{ own = false , target = 0 , spaced = false , wrapped = false , method = false , doc = true}),
                                                fnv false 0 SigValue (Present DocAfterComment) false [],
                                                DData (DataModel record{ isNewtype = false , asRecord = false , cons = 1 , fields = 1 , doc = Present DocAfterComment , after = false , void = false , pairFields = false , afterBelow = false , sharedCon = false , fmtDoc = false , blockAfter = false , infixCons = false , infixHead = false})] false) with docGap = true ,
               extra] ,
    noise = true ,
    exotic = true}
end function

-- ---------------------------------------------------------------------------
-- Labels (an independent collector over the model, for `cover`).

function calleeLabel (cl :: Callee) -> Text is
  first matching case of cl :
    when HTop n then "call: top" when HTopOp n then "call: operator, prefix" when HLocal n then "call: local" when HExplicit then "call: explicit import"
    when HQualAs then "call: qualified alias" when HQualFull then "call: qualified" when HOpenName then "call: open import"
    when HPrelude n then "call: prelude" when HUnknown then "call: unknown" when HUnknownAlias then "call: unknown alias" when HLambdaApply then "call: lambda applied"
    when HCurried then "call: curried" when HShared then "call: shared alias" when HInsert then "call: hidden or qualified-only name" when HPostQualified then "call: post-qualified"
    when HQualHidingKept then "call: qualified hiding, kept" when HQualHidingHidden then "call: qualified hiding, hidden" when HField n then "call: field selector" when HSelfQual n then "call: own qualified"
  end case
end function

function calleeLabels (cs :: List Callee) -> List Text is
  first matching case of cs : when Nil then [] when Cons cl rest then [calleeLabel cl] ++ calleeLabels rest end case
end function

function docLabel (d :: Maybe DocStyle) -> List Text is
  first matching case of d : when Absent then [] when Present DocOne then ["doc: one line"] when Present DocTwo then ["doc: two lines"] when Present DocNoSpace then ["doc: no space"] when Present DocBlock then ["doc: block"] when Present DocBlockTight then ["doc: block, tight"] when Present DocGap then ["doc: blank line between"] when Present DocGapComment then ["doc: comment between"] when Present DocAfterComment then ["doc: after a plain comment"] end case
end function

function declLabels (d :: HsDecl) -> List Text is
  first matching case of d :
    when DValue v then
      [(if v.operator then "value: operator" else (if isFunction v then "value: function" else "value: constant" end if) end if)]
        ++ (if v.sig = SigFunc then ["sig: function"] else (if v.sig = SigValue then ["sig: value"] else (if v.sig = SigConstrained then ["sig: constrained"] else (if v.sig = SigForall then ["sig: forall"] else [] end if) end if) end if) end if)
        ++ (if v.infixDef && paramsOf v = 2 then [(if v.operator then "value: infix operator" else "value: infix backticks" end if)] else [] end if)
        ++ (first matching case of v.scope :
              when NoScope then [] when InWhere then ["scope: where"] when InLet then ["scope: let"] when InLambda then ["scope: lambda"]
              when InCase then ["scope: case"] when InDo then ["scope: do"] when InDoLet then ["scope: do let"] when InPatGuard then ["scope: pattern guard"] when InGenerator then ["scope: generator"] when InPatLet then ["scope: let pattern"] when InWherePat then ["scope: where pattern"] when InFieldPat then ["scope: field pattern"] when InFieldPun then ["scope: field pun"] when InGuardLet then ["scope: guard let"] when InQualLet then ["scope: qualifier let"] when InAltWhere then ["scope: alternative where"] when InRec then ["scope: rec"] when InPattern then (if paramsOf v > 0 then ["scope: pattern"] else [] end if) end case)
        ++ (first matching case of v.site : when SiteList then [] when SiteDo then ["site: do"] when SiteGuard then ["site: guard"] when SiteCase then ["site: case"] when SiteFilter then ["site: filter"] when SiteSig then ["site: signature"] end case) ++ (if effAfter v then ["doc: after signature"] else [] end if)
        ++ (if !v.operator && fold v.params 3 = 0 && isFunctionSig v.sig then ["value: point-free"] else [] end if)
        ++ (if v.shadow then ["value: shadowing param"] else [] end if)
        ++ (if v.clauses && paramsOf v > 0 then ["value: several equations"] else [] end if)
        ++ (if v.sigAfter && v.sig != SigNone then ["sig: after"] else [] end if)
        ++ docLabel v.doc ++ calleeLabels v.calls
    when DData x then
      [(if x.isNewtype then "data: newtype" else (if isVoid x then "data: empty" else (if isRecord x then "data: record" else "data: positional" end if) end if) end if)]
        ++ (if isRecord x && x.after && !x.afterBelow then ["doc: after"] else [] end if)
        ++ (if isRecord x && x.afterBelow then ["doc: after, line below"] else [] end if)
        ++ (if isRecord x && x.pairFields && fieldsOf x >= 2 then ["data: paired fields"] else [] end if) ++ (if sharedCon x then ["data: shared field"] else [] end if) ++ (if infixOn x then ["data: infix constructors"] else [] end if) ++ (if fmtDoc x then [(if isRecord x then "doc: before field" else "doc: before constructor" end if)] else [] end if) ++ (if fmtTwo x then ["doc: before, two lines"] else [] end if) ++ (if x.infixHead then ["data: infix head"] else [] end if) ++ (if x.blockAfter && x.after then ["doc: after block"] else [] end if) ++ docLabel x.doc
    when DSyn then ["type: synonym"]
    when DClass x then ["class"]
      ++ (let f = fold x.super 7 in (if f = 1 then ["class: superclass"] else (if f = 2 then ["class: superclass tuple"] else (if f = 3 then ["class: nested superclass"] else (if f = 4 then ["class: parenthesized superclass"] else (if f = 5 then ["class: nullary superclass"] else (if f = 6 then ["class: equality constraint"] else [] end if) end if) end if) end if) end if) end if) end let)
      ++ (if x.pairMethods && methodsOf x >= 2 then ["class: paired methods"] else [] end if)
      ++ (if x.opMethod then ["class: operator method"] else [] end if)
      ++ (if x.methodDoc && methodsOf x > 0 then ["class: method doc"] else [] end if) ++ (if methodsOf x > 0 then ["class: methods"] else [] end if) ++ (if methodsOf x > 0 && x.valueMethod then ["class: value method"] else [] end if) ++ docLabel x.doc
    when DInst x then ["instance"] ++ (if x.spaced then ["instance: spaced"] else [] end if) ++ (if x.own then ["instance: own class"] else [] end if) ++ (if x.wrapped then ["instance: wrapped type"] else [] end if) ++ (if x.doc then ["instance: doc"] else [] end if)
  end case
end function

function declsLabels (ds :: List HsDecl) -> List Text is
  first matching case of ds : when Nil then [] when Cons d rest then declLabels d ++ declsLabels rest end case
end function

function importLabel (i :: ImportModel) -> Text is
  first matching case of i :
    when ImpExplicit then "import: explicit" when ImpQualifiedAs then "import: qualified alias" when ImpQualified then "import: qualified"
    when ImpOpen then "import: open" when ImpHidePrelude then "import: hiding prelude" when ImpPreludeOnly then "import: prelude list"
    when ImpHidingTight then "import: hiding, tight" when ImpQualifiedPost then "import: qualified post" when ImpHidingLines then "import: hiding, lines"
    when ImpPreludeEmpty then "import: prelude empty" when ImpPreludeQualified then "import: prelude qualified" when ImpSharedAlias then "import: shared alias"
    when ImpQualifiedHiding then "import: qualified hiding"
  end case
end function

function importsLabels (imps :: List ImportModel) -> List Text is
  first matching case of imps : when Nil then [] when Cons i rest then [importLabel i] ++ importsLabels rest end case
end function

function exportLabel (p :: ExportPick) -> Text is
  first matching case of p :
    when EValue n then "export: value" when ETypeAll n then "export: type with children" when ETypeOnly n then "export: type only"
    when EClassAll n then "export: class with methods" when EClassOnly n then "export: class only" when ETypeSome n then "export: type with some children" when EField n then "export: field" when EMethod n then "export: method" when EMain then "export: main" when ESelf then "export: self module" when EReexport then "export: module re-export" when EClassOp n then "export: class operator member" when EOpMethod n then "export: operator method" when EConOp n then "export: infix constructor" when EQualSelf n then "export: qualified own name"
  end case
end function

function exportsLabels (ps :: List ExportPick) -> List Text is
  first matching case of ps : when Nil then [] when Cons p rest then [exportLabel p] ++ exportsLabels rest end case
end function

function moduleLabels (i :: Integer) (m :: HsModule) -> List Text is
  [(first matching case of effKind i m.kind : when Named then "module: named" when Dotted then "module: dotted" when MainHeader then "module: Main" when Headerless then "module: headerless" end case)]
    ++ (if hasHeader i m.kind && m.doc then ["module: doc"] else [] end if)
    ++ (if m.noPrelude then ["module: no implicit prelude"] else [] end if)
    ++ (if m.rebindable then ["module: rebindable syntax"] else [] end if)
    ++ (if hasHeader i m.kind && m.doc && m.blockDoc then ["module: block doc"] else [] end if)
    ++ (if hasHeader i m.kind && m.doc && m.docGap then ["module: doc, blank line before the header"] else [] end if)
    ++ (if m.mainDef then (if isMainModule i m.kind then ["module: entrypoint"] else ["module: main elsewhere"] end if) else [] end if)
    ++ (first matching case of (if hasHeader i m.kind then m.exports else Absent end if) :
          when Absent then [] when Present ps then (if prelude.length ps = 0 then ["export: empty list"] else exportsLabels ps end if) end case)
    ++ importsLabels m.imports ++ declsLabels m.decls
end function

function modulesLabels (ms :: List HsModule) (i :: Integer) -> List Text is
  first matching case of ms : when Nil then [] when Cons m rest then moduleLabels i m ++ modulesLabels rest (i + 1) end case
end function

function treeLabels (t :: HsTree) -> List Text is modulesLabels t.modules 0 ++ (if t.noise then ["tree: noise"] else [] end if) ++ (if t.exotic then ["tree: out-of-scope forms"] else [] end if) end function

function requiredConstructs (u :: Unit) -> List Text is
  ["call: top", "call: local", "call: explicit import", "call: qualified alias", "call: qualified", "call: open import",
   "call: prelude", "call: unknown", "call: unknown alias", "call: lambda applied",
   "call: curried", "call: shared alias", "call: hidden or qualified-only name", "call: post-qualified", "call: qualified hiding, kept", "call: qualified hiding, hidden",
   "sig: constrained", "sig: forall", "value: infix operator", "value: infix backticks",
   "scope: where", "scope: let", "scope: lambda", "scope: case", "scope: do", "scope: do let", "scope: pattern", "site: do", "site: guard", "site: case", "site: filter", "scope: pattern guard", "scope: generator", "scope: let pattern", "scope: where pattern", "scope: field pattern", "scope: field pun", "data: shared field", "doc: before field", "doc: before constructor", "doc: block", "doc: block, tight", "module: block doc", "doc: after block",
   "doc: after, line below", "data: paired fields", "class: superclass tuple", "class: nested superclass", "class: parenthesized superclass", "class: nullary superclass", "class: equality constraint", "class: paired methods", "class: method doc",
   "import: hiding, tight", "import: qualified post", "import: hiding, lines", "import: prelude empty", "import: prelude qualified", "import: shared alias", "import: qualified hiding",
   "export: field", "export: method", "export: self module", "export: module re-export", "export: class operator member", "export: operator method", "export: infix constructor", "export: qualified own name", "scope: guard let", "scope: qualifier let", "scope: alternative where", "scope: rec", "site: signature", "call: field selector", "call: own qualified", "doc: blank line between", "doc: comment between", "doc: after a plain comment", "doc: after signature", "doc: before, two lines", "data: infix head", "instance: doc", "module: doc, blank line before the header", "call: operator, prefix", "class: operator method", "data: infix constructors", "module: rebindable syntax", "tree: out-of-scope forms",
   "value: function", "value: constant", "value: operator", "value: point-free", "value: shadowing param", "value: several equations", "sig: function", "sig: value", "sig: after",
   "doc: one line", "doc: two lines", "doc: no space", "doc: after",
   "data: positional", "data: record", "data: newtype", "data: empty", "type: synonym",
   "class", "class: superclass", "class: methods", "class: value method", "instance", "instance: spaced", "instance: own class", "instance: wrapped type",
   "import: explicit", "import: qualified alias", "import: qualified", "import: open", "import: hiding prelude", "import: prelude list",
   "export: value", "export: type with children", "export: type only", "export: class with methods", "export: class only", "export: type with some children", "export: main", "export: empty list",
   "module: Main", "module: dotted", "module: named", "module: doc", "module: no implicit prelude", "module: entrypoint", "module: main elsewhere",
   "tree: noise"]
end function

function hasEveryConstruct (t :: HsTree) -> Bool is treeLabels t contains all of requiredConstructs unitValue end function

function sizeLabel (t :: HsTree) -> Text is
  let n = prelude.length t.modules in
    if n = 0 then "no module" else if n = 1 then "one module" else if n <= 3 then "two or three modules" else "four or more modules" end if end if end if
  end let
end function

-- ---------------------------------------------------------------------------
-- The policy's own laws: one rule each.

-- HS-VIS's check is independent of `visibleIn`'s body (review 6, L8): it
-- never asks whether a list contains an id. It builds a list that holds the
-- id (the id put between two copies of an arbitrary list) and a list that
-- cannot (every occurrence removed), and states the answer for each. Every
-- list is one or the other, so the three claims fix the rule.
function listOf (exported :: Maybe (List Text)) -> List Text is
  first matching case of exported : when Absent then [] when Present ids then ids end case
end function

function without (id :: Text) (ids :: List Text) -> List Text is
  first matching case of ids : when Nil then [] when Cons i rest then (if i = id then [] else [i] end if) ++ without id rest end case
end function

law "|no export list exports everything; a list exports what it names; instances always| is
  id: "HS-VIS"
  definition :
    for all (exported :: Maybe (List Text)) (kind :: SymbolKind) (id :: Text) =>
      visibleIn Absent kind id = Exported
        && visibleIn (Present (listOf exported ++ [id] ++ listOf exported)) kind id = Exported
        && visibleIn (Present (without id (listOf exported))) kind id = (if kind = KindInstance then Exported else Unexported end if)
    end for all
  end definition
  expect visibleIn exported kind id = vis
  in table (exported, kind, id, vis) :
    row Absent, KindFunction, "v0", Exported
    row (Present ["v0"]), KindFunction, "v0", Exported
    row (Present ["v0"]), KindFunction, "v1", Unexported
    row (Present []), KindConst, "main", Unexported
    row (Present ["T0", "T0.K0_0"]), KindConstructor, "T0.K0_0", Exported
    row (Present ["T0"]), KindConstructor, "T0.K0_0", Unexported
    row (Present []), KindInstance, "instance Show T0", Exported
  end table
  references:
    "|spec|: "spec.md, mapping table: export list row"
  end references
end law

function declIds (ds :: List Decl) -> List Text is
  first matching case of ds : when Nil then [] when Cons d rest then [d.id] ++ declIds rest end case
end function

function symbolIds (ds :: List HsDecl) -> List Text is
  declIds (renderModule 0 (hm Named false Absent false [] ds false)).pkg.symbols
end function

law "|T(..) and C(..) export their children; T and C alone do not| is
  id: "HS-EXP"
  definition :
    for all (picks :: List ExportPick) => exportedIds (everyDecl unitValue) picks is subset of (symbolIds (everyDecl unitValue) ++ ["main"]) end for all
  end definition
  expect exportedIds (everyDecl unitValue) picks = ids
  in table (picks, ids) :
    row [ETypeAll 0], ["T0", "T0.K0_0", "T0.K0_1"]
    row [ETypeAll 1], ["T1", "T1.K1_0", "T1.fld1_0"]
    row [ETypeOnly 1], ["T1"]
    row [EClassAll 0], ["C0", "C0.mth0_0", "C0.mth0_1"]
    row [EClassOnly 0], ["C0"]
    row [EMain], ["main"]
  end table
  references:
    "|spec|: "spec.md, mapping table: `T(..)` and `C(..)` export constructors, fields and methods"
  end references
end law

law "|a value with arguments or a function type is a function, otherwise a constant| is
  id: "HS-KIND"
  definition :
    for all (p :: Int8) (s :: SigKind) =>
      isFunction (ValueModel record{ operator = false , params = p , sig = s , doc = Absent , shadow = false , clauses = false , sigAfter = false , infixDef = false , scope = NoScope , site = SiteList , docAfter = false , calls = []}) = (fold p 3 > 0 || isFunctionSig s) end for all
  end definition
  expect isFunction (ValueModel record{ operator = false , params = p , sig = s , doc = Absent , shadow = false , clauses = false , sigAfter = false , infixDef = false , scope = NoScope , site = SiteList , docAfter = false , calls = []}) = fun
  in table (p, s, fun) :
    row 1, SigNone, true
    row 0, SigFunc, true
    row 0, SigValue, false
    row 0, SigNone, false
    row 2, SigValue, true
  end table
  references:
    "|spec|: "spec.md, mapping table: function and const rows"
  end references
end law

type Res is a record{
  kind :: CallKind
  target :: Text
  ref :: Maybe Text}
end type

-- Only an internal edge carries a ref, and an open import never resolves.
function honest (e :: CallEdge) (cl :: Callee) -> Bool is
  (e.kind = Internal) = (e.ref matches Present _) && (cl != HOpenName || e.kind = Unresolved)
end function

function resOf (e :: CallEdge) -> Res is Res record{ kind = e.kind , target = e.target , ref = e.ref} end function

law "|calls resolve by the honesty ladder; an open import never resolves a name| is
  id: "HS-CALL"
  definition :
    for all (imports :: List ImportModel) (np :: Bool) (locals :: List Text) (cl :: Callee) =>
      honest (calleeEdge (Ctx record{ moduleId = "M0" , tops = [TopName record{ text = "v0" , id = "v0"}, TopName record{ text = "K0_0" , id = "T0.K0_0"}] , imports = imports , noPrelude = np , ops = ["<+>"] , fields = [TopName record{ text = "f0" , id = "T0.f0"}]}) locals cl) cl
    end for all
  end definition
  expect resOf (calleeEdge (Ctx record{ moduleId = "M0" , tops = [TopName record{ text = "v0" , id = "v0"}, TopName record{ text = "K0_0" , id = "T0.K0_0"}] , imports = imports , noPrelude = np , ops = ["<+>"] , fields = [TopName record{ text = "f0" , id = "T0.f0"}]}) locals cl) = e
  in table (imports, np, locals, cl, e) :
    row [], false, [], HTop 0, Res record{ kind = Internal , target = "v0" , ref = Present "M0#v0"}
    row [], false, [], HTop 1, Res record{ kind = Internal , target = "K0_0" , ref = Present "M0#T0.K0_0"}
    row [], false, ["v0"], HTop 0, Res record{ kind = Dynamic , target = "v0" , ref = Absent}
    row [], false, ["x"], HLocal 0, Res record{ kind = Dynamic , target = "x" , ref = Absent}
    row [], false, [], HTopOp 0, Res record{ kind = Internal , target = "<+>" , ref = Present "M0#<+>"}
    row [], false, [], HField 0, Res record{ kind = Internal , target = "f0" , ref = Present "M0#T0.f0"}
    row [], false, ["f0"], HField 0, Res record{ kind = Dynamic , target = "f0" , ref = Absent}
    row [], false, [], HSelfQual 0, Res record{ kind = Internal , target = "v0" , ref = Present "M0#v0"}
    row [ImpExplicit], false, [], HExplicit, Res record{ kind = External , target = "Data.Char.toUpper" , ref = Absent}
    row [], false, [], HExplicit, Res record{ kind = Unresolved , target = "toUpper" , ref = Absent}
    row [ImpQualifiedAs], false, [], HQualAs, Res record{ kind = External , target = "Data.Map.insert" , ref = Absent}
    row [ImpQualified], false, [], HQualFull, Res record{ kind = External , target = "Data.Set.member" , ref = Absent}
    row [ImpOpen], false, [], HOpenName, Res record{ kind = Unresolved , target = "sortOn" , ref = Absent}
    row [], false, [], HPrelude 0, Res record{ kind = Builtin , target = "length" , ref = Absent}
    row [ImpHidePrelude], false, [], HPrelude 0, Res record{ kind = Unresolved , target = "length" , ref = Absent}
    row [ImpHidePrelude], false, [], HPrelude 1, Res record{ kind = Builtin , target = "map" , ref = Absent}
    row [], true, [], HPrelude 1, Res record{ kind = Unresolved , target = "map" , ref = Absent}
    row [], false, [], HUnknownAlias, Res record{ kind = Unresolved , target = "Q.zz" , ref = Absent}
    -- an alias two imports share has two possible sources (review 6, L3)
    row [ImpSharedAlias], false, [], HShared, Res record{ kind = Unresolved , target = "T.pack" , ref = Absent}
    row [], false, [], HShared, Res record{ kind = Unresolved , target = "T.pack" , ref = Absent}
  end table
  references:
    "|spec|: "spec.md, Call edges"
  end references
end law

law "|Main, or no header, with a top-level main is the entrypoint| is
  id: "HS-MAIN"
  definition :
    for all (i :: Int8) (k :: ModKind) =>
      (renderModule (fold i 3) (hm k false Absent false [] [] true)).pkg.isEntrypoint = (fold i 3 = 0 && (k = MainHeader || k = Headerless)) end for all
  end definition
  expect (renderModule (fold i 3) (hm k false Absent false [] [] true)).pkg.isEntrypoint = entry
  in table (i, k, entry) :
    row 0, MainHeader, true
    row 0, Headerless, true
    row 0, Named, false
    row 1, MainHeader, false
  end table
  references:
    "|spec|: "spec.md, mapping table: `module Main` with top-level `main`"
  end references
end law

law "|only the first module can be Main, so module ids are distinct| is
  id: "HS-ID"
  definition :
    for all (k :: ModKind) (i :: Int8) => (i <= 0) || moduleId (fold i 9 + 1) k != "Main" end for all
  end definition
  references:
    "|Q4|: "discovery-python.md Q4, repeated ids (open question); the model never makes one"
  end references
end law

law "|an instance id is its head with whitespace normalized| is
  id: "HS-INST"
  definition :
    for all (sp :: Bool) => (instBlock "M0.hs" [] (InstModel record{ own = false , target = 0 , spaced = sp , wrapped = true , method = false , doc = false}) 1).decls
                              has same items as (instBlock "M0.hs" [] (InstModel record{ own = false , target = 0 , spaced = false , wrapped = true , method = false , doc = false}) 1).decls end for all
  end definition
  references:
    "|spec|: "spec.md, mapping table: instance row"
  end references
end law

law "|the reference names every package and symbol once| is
  id: "HS-REF-1"
  definition : for all (t :: HsTree) => distinct (expected t) end for all end definition
  references:
    ref function expected
  end references
end law

law "|the designed tree holds every construct| is
  id: "HS-REF-2"
  definition :
    for all (r :: Int8 where r >= 0 && r <= 29) => hasEveryConstruct (everything r (hm Named false Absent false [] [] false) []) end for all
  end definition
  expect hasEveryConstruct (everything r (hm Named false Absent false [] [] false) []) = true
  in table (r) :
    row 0
    row 1
    row 2
    row 3
    row 4
    row 5
    row 6
    row 7
    row 8
    row 9
    row 10
    row 11
    row 12
    row 13
    row 14
    row 15
    row 16
    row 17
    row 18
    row 19
    row 20
    row 21
    row 22
    row 23
    row 24
    row 25
    row 26
    row 27
    row 28
    row 29
  end table
  references:
    ref function everything
    ref function hasEveryConstruct
  end references
end law

end unit
