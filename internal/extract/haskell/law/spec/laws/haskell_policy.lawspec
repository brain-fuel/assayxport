function fixtureSources (u :: Unit) -> List SourceFile is
  [SourceFile record{ path = "Exotic.hs" , content = fixtureExoticSource unitValue} ,
   SourceFile record{ path = "PrelA.hs" , content = fixturePrelASource unitValue} ,
   SourceFile record{ path = "PrelB.hs" , content = fixturePrelBSource unitValue} ,
   SourceFile record{ path = "PrelC.hs" , content = fixturePrelCSource unitValue} ,
   SourceFile record{ path = "NextOp.hs" , content = fixtureNextOpSource unitValue} ,
   SourceFile record{ path = "SixExp.hs" , content = fixtureSixExpSource unitValue} ,
   SourceFile record{ path = "SixDoc.hs" , content = fixtureSixDocSource unitValue} ,
   SourceFile record{ path = "Doc2.hs" , content = fixtureDoc2Source unitValue} ,
   SourceFile record{ path = "Comp.hs" , content = fixtureCompSource unitValue} ,
   SourceFile record{ path = "WildA.hs" , content = fixtureWildASource unitValue} ,
   SourceFile record{ path = "WildB.hs" , content = fixtureWildBSource unitValue} ,
   SourceFile record{ path = "WildC.hs" , content = fixtureWildCSource unitValue} ,
