  "{-# LANGUAGE Trustworthy, ExplicitNamespaces, ExplicitLevelImports, TemplateHaskell, PatternSynonyms #-}\nmodule NextImp where\nimport Prelude hiding (data Just, Either (data Left), data map)\nimport OtherOpen\nimport safe Data.Char (toUpper)\nimport safe qualified Data.Map as S\nimport {-# SOURCE #-} safe qualified Mx as M hiding (zz)\nimport splice Lang.Sp (sf)\nimport quote Lang.Qu (qf)\nimport splice qualified Lang.Sq as Z\nimport Other (data OP, OT (data OK), type OT2, data ov, data (<+>), pattern OQ)\nm1 = toUpper 1\nm2 = S.lookup 1\nm3 = M.yy 1\nm4 = M.zz 1\nm5 = $(sf 1)\nm6 = [| qf 1 |]\nm7 = $(Z.gen 1)\nm8 = OP 1\nm9 = OK 1\nm10 = OT2 1\nm11 = ov 1\nm12 = 1 <+> 2\nm13 = OQ 1\nm14 = Just 1\nm15 = Left 1\nm16 = Right 1\nm17 = map 1\nm18 = OT 1\n"
