function fixtureCallsSource (u :: Unit) -> Text is
  "{-# LANGUAGE RecordWildCards, ViewPatterns, TemplateHaskell, QuasiQuotes, LambdaCase, ParallelListComp, TransformListComp, RecursiveDo, OverloadedRecordDot, MultiWayIf #-}\nmodule Calls where\nimport qualified Data.Map as Q\nimport Data.Char (toUpper)\nimport Other (Imp (..))\n\ndata Rc = Rc { fa :: Int, fb :: Int }\ndata Op = Int :+: Int\ninfixl 6 <+>\na <+> b = a\nv0 x = x\n\no1 = 1 <+> 2\no2 = 1 `v0` 2\no3 = [] ++ []\no4 = 1 : []\no5 = 1 :+: 2\no6 = 1 Q.! 2\no7 = 1 `Q.lookup` 2\no8 = (<+> 1)\no9 = (1 <+>)\no10 = (`v0` 1)\no11 = (Q.! 1)\no12 = 1 `toUpper` 2\no13 = 1 `zz` 2\no14 x = let (<+>) = v0 in 1 <+> x\no15 = v0 $ 1\nc1 = Rc { fa = 1, fb = 2 }\nc2 r = r { fa = 1 }\nc3 r = r.fa\nc4 = (.fb)\nc5 = $(v0 1)\nc6 = [| v0 1 |]\nc7 = [v0|text|]\nc8 (v0 -> y) = y\nc9 (toUpper . v0 -> y) = y\nc10 xs = [x | x <- xs, then v0]\nc11 = Q.Rc { Q.fa = 1 }\ns1 Rc{..} = fa 1\ns2 Imp{..} = v0 fa\ns3 = \\cases x y -> x y\ns4 xs ys = [v0 x | x <- xs | v0 <- ys]\ns5 = mdo { x <- v0 1; v0 <- pure 1; pure x }\ns6 (y :: v0) = v0 y\ns7 $(pat) = v0 1\ns8 x = if | Just v0 <- x -> v0 1 | otherwise -> v0 2\ns9 = v0 '\\n'\ns10 = v0 ['\\r','\\n']\no16 = (:) 1 []\no17 = (Q.!) 1 2\no18 = 1 `Rc` 2\ni1 x = - x\ni2 = [1 ..]\ni3 x = if x then 1 else 2\nk24 = (v0 . v0) 1\nt1 = v0 @Int 1\nt2 = (v0 1 :: Int `Either` Int)\np1 = Just 1\n"
end function

