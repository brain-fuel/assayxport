  "{-# LANGUAGE CPP #-}\nmodule Cpp2\n  ( f\n#ifdef MIN_VERSION_th\n  , lift1\n#endif\n  , t\n  ) where\n\n#if A\nimport X (foo)\n#else\nimport Y (foo)\n#endif\n#ifdef MIN_VERSION_th\nimport TH (run)\n#endif\n\nv0 x = x\n\nf :: Int\nf = foo 1\n#if B\n  + 1\n#else\n  + v0 2\n#endif\n\n#ifdef MIN_VERSION_th\nlift1 x = run x\n#if MIN_VERSION_th(2,16,0)\n  `v0` foo 1\n#endif\n#endif\n\n#ifdef VERSION_text\nt = v0 1\n#else\nt = foo 2\n#endif\n"
end function

