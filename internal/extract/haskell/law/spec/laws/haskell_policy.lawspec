  "-----------------------------------------------------------------------------\n-- |\n-- Module      :  SixDoc\n--\n-- The doc.\n--\n-----------------------------------------------------------------------------\n\nmodule SixDoc where\n\n------------------------------------------------------------------------\n-- | Doc of f.\nf :: Int\nf = 1\n\n-- TODO: something\n-- | Doc of g.\ng :: Int\ng = 2\n\n-- | Doc of h.\n---------------\nh = 3\n\ndata Dr = MkDr\n  { da :: Int -- ^ Doc a,\n             -- continued.\n  , db :: Int -- plain, not a doc\n  -- plain\n  -- | Doc c.\n  , dc :: Int\n  , dd :: Int -- ^ Doc d.\n  } -- not a doc\n\nclass C x where\n  -- | Method m1.\n  m1 :: x -> Int\n  m2 :: x -> Int -- ^ The result of m2.\n  m3 :: x -> Int\n  -- ^ Method m3.\n  m4 :: x -> Int\n    -- ^ The result of m4.\n  m5 :: x -> Int\n\nk1 :: Int -> Int -- ^ The result of k1.\nk1 x = x\n\nk2 :: Int\n-- plain\n-- ^ Doc of k2.\nk2 = 1\n\nk3 :: Int -> Int\n  -- ^ The result of k3.\nk3 x = x\n"
end function

