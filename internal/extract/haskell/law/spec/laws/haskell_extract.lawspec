unit assayxport.haskell.extract
-- ref:DR-0035 ref:DR-0040 (LawSpec writes the extractor's logic: R22 Q3 re-ruled (b))

import lawspec.host
import assayxport.contract as c (Package, SourceFile, Decl, DocText, EntryPoint, Detail, Complexity, Signature, Param, Location, Invocation, CallEdge, SymbolKind, Visibility, VisibilityIdiom, DocFormat, CallKind, ComplexityMethod, wellFormed, normalForm, at, noBinary, edge, merged)
import assayxport.haskell.policy as hs (HsTree, HsModule, HsDecl, ValueModel, DataModel, ClassModel, InstModel, ModKind, DocStyle, ImportModel, Callee, SigKind, ExportPick, ScopeForm, render, expected, everything, hasEveryConstruct, sizeLabel, preludeNames, fixtureSources, fixtureCppSource, fixtureCppCopies, fixtureCppBuildCount, fixtureCppMoreBuilds, fixtureCpp2Source, fixtureCpp2Copies)
import assayxport.haskell.cpp as cpp (Section, Row, Run)
import assayxport.conditions as wn
import assayxport.conditions.policy as wp (Env, Binding, BindingLine, BindingError, Filtered, Outcome, Literal, CExpr)

-- S1.j build step 3, laws first: the Haskell extraction is a checked
-- definition over a tree-sitter syntax tree (spec.md, Architecture). The
-- parse is the only native step (the HaskellParser ability, gotreesitter
-- v0.56.0's Haskell grammar); everything after it is LawSpec, generated
-- as typed Go into ax's production path.

-- ---------------------------------------------------------------------------
-- The syntax tree. Node and field names are the pinned grammar's (FACTS
-- F82, F84). Only named nodes are kept: anonymous tokens carry no meaning
-- the extractor reads.

-- A 1-based position: line, and column in bytes (as ax's ts layer reports).
type Point is a record{
  line :: Integer
  col :: Integer}
end type

-- One node. `field` is its field name in its parent ("" when none); `text`
-- is the node's source text.
type Syntax is a record{
  kind :: Text
  field :: Text
  text :: Text
  from :: Point
  to :: Point
  isError :: Bool
  children :: List Syntax}
end type

ability HaskellParser is
  parse :: Text -> Syntax
  laws
    law "|a parse is rooted at a haskell node| is
      id: "HSP-1"
      definition : for all (source :: Text) => (parse source).kind = "haskell" end for all end definition
      description :
        "Every source parses to a `haskell` root; errors appear below it as
        ERROR nodes (gotreesitter v0.56.0; v0.20.7 rooted headerless modules
        in ERROR, F85)."
      end description
      example "|a headerless module| :
        source = "x = 1\n"
        expect (parse source).kind = "haskell"
      end example
    end law
    law "|positions are 1-based and ordered, children inside their parent| is
      id: "HSP-2"
      definition : for all (source :: Text) => positionsOrdered (parse source) end for all end definition
    end law
    law "|a node's text is the source between its positions| is
      id: "HSP-3"
      definition : for all (source :: Text) => (source contains "\r\n") || (parse source).text = source end for all end definition
      example "|a module| :
        source = "module M where\nx = 1\n"
        expect (parse source).text = "module M where\nx = 1\n"
      end example
    end law
  end laws
end ability

function before (a :: Point) (b :: Point) -> Bool is
  a.line < b.line || (a.line = b.line && a.col <= b.col)
end function

function positionsOrdered (s :: Syntax) -> Bool is
  s.from.line >= 1 && s.from.col >= 1 && before s.from s.to && childrenOrdered s s.children
end function

-- One structurally recursive definition (LawSpec refuses mutually
-- recursive total definitions).
function childrenOrdered (parent :: Syntax) (cs :: List Syntax) -> Bool is
  first matching case of cs :
    when Nil then true
    when Cons ch rest then
      before parent.from ch.from && before ch.to parent.to
        && ch.from.line >= 1 && ch.from.col >= 1 && before ch.from ch.to
        && childrenOrdered ch ch.children && childrenOrdered parent rest
  end case
end function

-- No node of the tree is an error.
function errorFree (s :: Syntax) -> Bool is !s.isError && childrenErrorFree s.children end function

function childrenErrorFree (cs :: List Syntax) -> Bool is
  first matching case of cs : when Nil then true when Cons ch rest then !ch.isError && childrenErrorFree ch.children && childrenErrorFree rest end case
end function

procedure renderedParses (files :: List SourceFile) -> Bool uses HaskellParser is
  first matching case of files :
    when Nil then true
    when Cons f rest then (if prelude.endsWith f.path ".hs" && !(skippedPath f.path) then errorFree (parse f.content) else true end if) && renderedParses rest
  end case
end procedure

law "|every rendered module parses without errors| is
  id: "HSE-0"
  definition : for all (t :: HsTree) => renderedParses (render t) end for all end definition
  description :
    "Grammar honesty (spec.md, Test plan): the policy's rendered Haskell is
    valid for the pinned grammar, so the other laws check real source, and
    a regression in the grammar shows here first."
  end description
end law

-- ---------------------------------------------------------------------------
-- The extraction: a file's path and its parse tree to its package. Written
-- from the laws (HSE-1, HSE-2) and spec.md's mapping table with its
-- amendments. It reads only the tree: no file system, no native code.
-- Lookups go through KeyVal indexes, so each pass is linear or
-- logarithmic (review 1, finding 11).

-- Tree access.
function childField (cs :: List Syntax) (f :: Text) -> Maybe Syntax is
  first matching case of cs : when Nil then Absent when Cons ch rest then (if ch.field = f then Present ch else childField rest f end if) end case
end function

function childKind (cs :: List Syntax) (k :: Text) -> Maybe Syntax is
  first matching case of cs : when Nil then Absent when Cons ch rest then (if ch.kind = k then Present ch else childKind rest k end if) end case
end function

function allField (cs :: List Syntax) (f :: Text) -> List Syntax is
  first matching case of cs : when Nil then [] when Cons ch rest then (if ch.field = f then [ch] else [] end if) ++ allField rest f end case
end function

function allKind (cs :: List Syntax) (k :: Text) -> List Syntax is
  first matching case of cs : when Nil then [] when Cons ch rest then (if ch.kind = k then [ch] else [] end if) ++ allKind rest k end case
end function

-- Every node of kind k below the given nodes, in source order.
function findAll (k :: Text) (cs :: List Syntax) -> List Syntax is
  first matching case of cs :
    when Nil then []
    when Cons ch rest then (if ch.kind = k then [ch] else [] end if) ++ findAll k ch.children ++ findAll k rest
  end case
end function

function textOf (m :: Maybe Syntax) -> Text is
  first matching case of m : when Absent then "" when Present s then s.text end case
end function

function textsOf (cs :: List Syntax) -> List Text is
  first matching case of cs : when Nil then [] when Cons ch rest then [ch.text] ++ textsOf rest end case
end function

function lastText (cs :: List Syntax) (acc :: Text) -> Text is
  first matching case of cs : when Nil then acc when Cons ch rest then lastText rest ch.text end case
end function

-- A module name from its parts (`Data.Map`): a qualified name's module node
-- also spans the dot that follows it (`M.` in `M.insert`).
function moduleText (m :: Maybe Syntax) -> Text is
  first matching case of m :
    when Absent then ""
    when Present s then (if allKind s.children "module_id" = [] then s.text else prelude.join "." (textsOf (allKind s.children "module_id")) end if)
  end case
end function

-- An id the schema accepts: non-empty, no '#'.
function validId (t :: Text) -> Bool is t != "" && !(t contains "#") end function

function lineOf (p :: Point) -> Integer is if p.line < 1 then 1 else p.line end if end function
function colOf (p :: Point) -> Integer is if p.col < 1 then 1 else p.col end if end function

-- The number of leading spaces and tabs in a node's text. The parser starts
-- an infix constructor's node on the blank before it (`= Int :+: Int`), so a
-- constructor's column is its node's column plus these.
function leadBlanks (t :: Text) (i :: Integer) (n :: Integer) -> Integer is
  if i >= n then i
  else (if prelude.take 1 (prelude.drop i t) = " " || prelude.take 1 (prelude.drop i t) = "\t" then leadBlanks t (i + 1) n else i end if) end if
end function

function conLoc (path :: Text) (dc :: Syntax) -> Location is
  let l = lineOf dc.from in
    at path l (colOf dc.from + leadBlanks dc.text 0 (prelude.length dc.text)) (if lineOf dc.to < l then l else lineOf dc.to end if)
  end let
end function

function locOf (path :: Text) (from :: Syntax) (to :: Syntax) -> Location is
  let l = lineOf from.from in
    at path l (colOf from.from) (if lineOf to.to < l then l else lineOf to.to end if)
  end let
end function

-- ---------------------------------------------------------------------------
-- Text: lines and words (LawSpec has no split; take/drop work on Text).

function lineStarts (t :: Text) (i :: Integer) (n :: Integer) (start :: Integer) -> List Text is
  if i >= n then [prelude.take (n - start) (prelude.drop start t)]
  else (if prelude.take 1 (prelude.drop i t) = "\n"
        then [prelude.take (i - start) (prelude.drop start t)] ++ lineStarts t (i + 1) n (i + 1)
        else lineStarts t (i + 1) n start end if) end if
end function

-- The index of the first newline at or after i, or -1.
function newlineFrom (t :: Text) (i :: Integer) (n :: Integer) -> Integer is
  if i >= n then 0 - 1 else (if prelude.take 1 (prelude.drop i t) = "\n" then i else newlineFrom t (i + 1) n end if) end if
end function

-- The index of the last newline before `top` (searching k = 0, 1, ... below it), or -1.
function newlineBack (t :: Text) (k :: Integer) (lim :: Integer) (top :: Integer) -> Integer is
  if k >= lim then 0 - 1 else (if prelude.take 1 (prelude.drop (top - 1 - k) t) = "\n" then top - 1 - k else newlineBack t (k + 1) lim top end if) end if
end function

-- Taking the character at i of a Text costs the length of the Text, so
-- lineStarts over a whole file is quadratic (R53, HSE-16). A long text is
-- split in two at a newline near its middle and each half is split in turn:
-- every character is then read from a text of at most half the length, and
-- the lines are the same.
function splitLines (t :: Text) (fuel :: Integer) -> List Text is
  let n = prelude.length t in
    (if n <= 512 || fuel <= 0 then lineStarts t 0 n 0
     else (let mid = prelude.quot n 2 in
       (if (prelude.drop mid t) contains "\n"
        then (let j = newlineFrom t mid n in splitLines (prelude.take j t) (fuel - 1) ++ splitLines (prelude.drop (j + 1) t) (fuel - 1) end let)
        else (if (prelude.take mid t) contains "\n"
        then (let j = newlineBack t 0 mid mid in splitLines (prelude.take j t) (fuel - 1) ++ splitLines (prelude.drop (j + 1) t) (fuel - 1) end let)
        else [t] end if) end if) end let) end if)
  end let
end function

function linesOf (t :: Text) -> List Text is splitLines t 64 end function

function isSpace (ch :: Text) -> Bool is ch = " " || ch = "\t" || ch = "\n" || ch = "\r" end function

function wordsFrom (t :: Text) (i :: Integer) (n :: Integer) (start :: Integer) -> List Text is
  if i >= n then (if i > start then [prelude.take (i - start) (prelude.drop start t)] else [] end if)
  else (if isSpace (prelude.take 1 (prelude.drop i t))
        then (if i > start then [prelude.take (i - start) (prelude.drop start t)] else [] end if) ++ wordsFrom t (i + 1) n (i + 1)
        else wordsFrom t (i + 1) n start end if) end if
end function

-- Whitespace-separated words (spaces, tabs, newlines).
function words (t :: Text) -> List Text is wordsFrom t 0 (prelude.length t) 0 end function

function normalized (t :: Text) -> Text is prelude.join " " (words t) end function

-- ---------------------------------------------------------------------------
-- Haddock: `-- |` documents what starts on the next line; `-- ^` documents
-- the nearest item before it. Markers and one following space are removed
-- per line.

function stripOne (l :: Text) -> Text is
  let m = (if prelude.startsWith l "-- |" || prelude.startsWith l "-- ^" then prelude.drop 4 l
           else (if prelude.startsWith l "--" then prelude.drop 2 l else l end if) end if) in
    (if prelude.startsWith m " " then prelude.drop 1 m else m end if)
  end let
end function

-- A line after a doc's first: `--` and one blank only (R50: a `-- |` line
-- inside a doc is text, `| second line`).
function stripCont (l :: Text) -> Text is
  let m = (if prelude.startsWith l "--" then prelude.drop 2 l else l end if) in
    (if prelude.startsWith m " " then prelude.drop 1 m else m end if)
  end let
end function

function stripRest (ls :: List Text) -> List Text is
  first matching case of ls : when Nil then [] when Cons l rest then [stripCont l] ++ stripRest rest end case
end function

function stripAll (ls :: List Text) -> List Text is
  first matching case of ls : when Nil then [] when Cons l rest then [stripOne l] ++ stripRest rest end case
end function

function haddockText (h :: Syntax) -> Text is
  if prelude.startsWith h.text "{-" then blockText h.text else prelude.join "\n" (stripAll (linesOf h.text)) end if
end function

-- Line or block Haddock (owner, 2026-11-10: block Haddock is read).
function isBeforeDoc (t :: Text) -> Bool is
  prelude.startsWith t "-- |" || prelude.startsWith t "{- |" || prelude.startsWith t "{-|"
end function
function isAfterDoc (t :: Text) -> Bool is
  prelude.startsWith t "-- ^" || prelude.startsWith t "{- ^" || prelude.startsWith t "{-^"
end function

-- A block's text: without the opening marker and one following space or
-- newline, and without the closing `-}` and the whitespace before it; inner
-- lines as written.
function blockText (t :: Text) -> Text is
  let m = (if prelude.startsWith t "{- |" || prelude.startsWith t "{- ^" then prelude.drop 4 t else prelude.drop 3 t end if) in
  let m2 = (if prelude.startsWith m " " || prelude.startsWith m "\n" then prelude.drop 1 m else m end if) in
  let m3 = (if prelude.endsWith m2 "-}" then prelude.take (prelude.length m2 - 2) m2 else m2 end if) in
    trimEnd m3 (prelude.length m3)
  end let end let end let
end function

function trimEnd (t :: Text) (n :: Integer) -> Text is
  if n <= 0 then "" else (if isSpace (prelude.take 1 (prelude.drop (n - 1) t)) then trimEnd t (n - 1) else prelude.take n t end if) end if
end function

type Docs is a record{
  before :: KeyVal Integer Text
  after :: KeyVal Integer Text}
end type

-- The lines where code starts (any node but a comment, a doc, a pragma or
-- a CPP line).
function codeLines (cs :: List Syntax) (acc :: KeyVal Integer Bool) -> KeyVal Integer Bool is
  first matching case of cs :
    when Nil then acc
    when Cons n rest then
      codeLines rest (codeLines n.children
        (if n.kind = "comment" || n.kind = "haddock" || n.kind = "pragma" || n.kind = "cpp" then acc else prelude.put (lineOf n.from) true acc end if))
  end case
end function

-- The first code line at or after `line`, within `fuel` lines: the lowest key
-- of `code` in that range, found by a walk over the code lines, not over the
-- line range (a tree can put a line anywhere; R49). A `-- |` doc documents the
-- next declaration across blank lines and plain comments, as Haddock reads it
-- (review 5, S2). With none, `line` itself, which holds no code.
function nextCode (code :: KeyVal Integer Bool) (line :: Integer) (fuel :: Integer) -> Integer is
  first matching case of lowestIn (prelude.keys code) line (line + fuel) Absent :
    when Absent then line
    when Present k then k
  end case
end function

-- A line of the source, 1-based; "" past the end.
function lineAt (ls :: List Text) (n :: Integer) -> Text is
  first matching case of ls :
    when Nil then ""
    when Cons l rest then (if n <= 1 then l else lineAt rest (n - 1) end if)
  end case
end function

function blanksOf (l :: Text) -> Integer is leadBlanks l 0 (prelude.length l) end function

function noBlanks (l :: Text) -> Text is prelude.drop (blanksOf l) l end function

function isDocStart (t :: Text) -> Bool is prelude.startsWith t "-- |" || prelude.startsWith t "-- ^" end function

-- A line that ends a doc: a rule of three dashes or more, or the start of
-- another doc (R43).
function isStopper (t :: Text) -> Bool is prelude.startsWith t "---" || prelude.startsWith t "-- $" end function

-- Whether a comment is the first thing on its line (R44): only blanks stand
-- before its column in the source.
function firstOnLine (src :: List Text) (ch :: Syntax) -> Bool is
  blanksOf (lineAt src (lineOf ch.from)) >= colOf ch.from - 1
end function

-- A comment continues a doc that ends on `line` (R44): it starts on the next
-- line, first on that line, with a plain `--` first line. Its column does not
-- matter.
function isCont (src :: List Text) (line :: Integer) (ch :: Syntax) -> Bool is
  (ch.kind = "comment" || ch.kind = "haddock") && lineOf ch.from = line + 1 && prelude.startsWith ch.text "--" && !(isStopper ch.text) && firstOnLine src ch
end function

-- The lines of a continuing comment, up to a rule or the start of a doc.
function contLines (ls :: List Text) -> List Text is
  first matching case of ls :
    when Nil then []
    when Cons l rest then (if isStopper (noBlanks l) then [] else [noBlanks l] ++ contLines rest end if)
  end case
end function

function contText (src :: List Text) (line :: Integer) (cs :: List Syntax) -> Text is
  first matching case of cs :
    when Nil then ""
    when Cons ch rest then
      (if isCont src line ch then
         (let ks = contLines (linesOf ch.text) in
           "\n" ++ prelude.join "\n" ks
             ++ (if prelude.length ks = prelude.length (linesOf ch.text) then contText src (lineOf ch.from + prelude.length ks - 1) rest else "" end if)
         end let)
       else "" end if)
  end case
end function

-- The line where a doc ends once its continuations are added.
function contEnd (src :: List Text) (line :: Integer) (cs :: List Syntax) -> Integer is
  first matching case of cs :
    when Nil then line
    when Cons ch rest then
      (if isCont src line ch then
         (let ks = contLines (linesOf ch.text) in
           (if prelude.length ks = prelude.length (linesOf ch.text) then contEnd src (lineOf ch.from + prelude.length ks - 1) rest else lineOf ch.from + prelude.length ks - 1 end if)
         end let)
       else line end if)
  end case
end function

-- A doc as a node: `idx` is the index of its first line in the run, `col` its
-- column, `ls` its lines (without leading blanks).
function mkDoc (n :: Syntax) (idx :: Integer) (col :: Integer) (ls :: List Text) (extra :: Text) (endLine :: Integer) -> Syntax is
  n with text = prelude.join "\n" ls ++ extra , from = Point record{ line = lineOf n.from + idx , col = col} , to = Point record{ line = endLine , col = 1}
end function

-- The docs of one run of line comments (R42, R43): a doc starts at a `-- |`
-- or `-- ^` line, wherever it stands in the run, and runs to the end of the
-- run or to the line before a rule or the next doc. A doc that runs to the
-- run's end takes the comments that continue it (R44).
function scanRun (src :: List Text) (n :: Syntax) (rest :: List Syntax) (ls :: List Text) (i :: Integer) (cur :: List Text) (start :: Integer) (col :: Integer) (live :: Bool) -> List Syntax is
  first matching case of ls :
    when Nil then
      (if live then
         (let endLine = lineOf n.from + start + prelude.length cur - 1 in
           [mkDoc n start col cur (contText src endLine rest) (contEnd src endLine rest)]
         end let)
       else [] end if)
    when Cons l more then
      (let t = noBlanks l in
       let here = (if i = 0 then colOf n.from else 1 + blanksOf l end if) in
         (if live && isStopper t then
            [mkDoc n start col cur "" (lineOf n.from + start + prelude.length cur - 1)]
              ++ (if isDocStart t then scanRun src n rest more (i + 1) [t] i here true else scanRun src n rest more (i + 1) [] i 1 false end if)
          else (if live then scanRun src n rest more (i + 1) (cur ++ [t]) start col true
                else (if isDocStart t then scanRun src n rest more (i + 1) [t] i here true else scanRun src n rest more (i + 1) cur start col false end if) end if) end if)
      end let end let)
  end case
end function

-- The docs of a tree: each line doc as a node whose text starts at its marker,
-- from its first line to its last (continuations included); block docs as
-- they are. `src`: the source's lines.
-- The line where the last of `ds` ends (R50: a node that starts at or before
-- the line where the previous doc ended was read as part of that doc).
function docsEnd (ds :: List Syntax) (acc :: Integer) -> Integer is
  first matching case of ds : when Nil then acc when Cons d rest then docsEnd rest (lineOf d.to) end case
end function

function docNodes (src :: List Text) (cs :: List Syntax) (skipTo :: Integer) -> List Syntax is
  first matching case of cs :
    when Nil then []
    when Cons n rest then
      (if n.kind = "haddock" || n.kind = "comment" then
         (if prelude.startsWith n.text "--" then
            (if lineOf n.from <= skipTo then docNodes src rest skipTo
             else (let ds = scanRun src n rest (linesOf n.text) 0 [] 0 1 false in ds ++ docNodes src rest (docsEnd ds skipTo) end let) end if)
          else (if n.kind = "haddock" then [n] else [] end if) ++ docNodes src rest skipTo end if)
       else docNodes src n.children skipTo ++ docNodes src rest skipTo end if)
  end case
end function

-- A doc without the blank lines around it (a `-- |` alone on its first line).
function dropLead (t :: Text) (n :: Integer) -> Text is
  if n <= 0 then t else (if prelude.startsWith t "\n" then dropLead (prelude.drop 1 t) (n - 1) else t end if) end if
end function

function trimDoc (t :: Text) -> Text is
  let m = dropLead t (prelude.length t) in trimEnd m (prelude.length m) end let
end function

function docsOf (hs :: List Syntax) (code :: KeyVal Integer Bool) (fuel :: Integer) (d :: Docs) -> Docs is
  first matching case of hs :
    when Nil then d
    when Cons h rest then
      docsOf rest code fuel
        (if isBeforeDoc h.text then d with before = prelude.put (nextCode code (lineOf h.to + 1) fuel) (trimDoc (haddockText h)) d.before
         else (if isAfterDoc h.text then d with after = prelude.put (lineOf h.from) (trimDoc (haddockText h)) d.after else d end if) end if)
  end case
end function

-- The column each `-- ^` doc starts at, by its line (R46, R47).
function afterCols (hs :: List Syntax) (acc :: KeyVal Integer Integer) -> KeyVal Integer Integer is
  first matching case of hs :
    when Nil then acc
    when Cons h rest then afterCols rest (if isAfterDoc h.text then prelude.put (lineOf h.from) (colOf h.from) acc else acc end if)
  end case
end function

function docText (m :: Maybe Text) -> DocText is
  first matching case of m : when Absent then DocText record{ raw = "" , format = NoDoc} when Present t then DocText record{ raw = t , format = Haddock} end case
end function

function docBefore (d :: Docs) (line :: Integer) -> DocText is docText (prelude.lookup line d.before) end function

-- The lowest line in [from, until) that holds a key of `ks`. A walk over the
-- doc lines, not over the line range: positions come from the parse and a
-- range can be arbitrarily wide.
function lowestIn (ks :: List Integer) (from :: Integer) (until :: Integer) (best :: Maybe Integer) -> Maybe Integer is
  first matching case of ks :
    when Nil then best
    when Cons k rest then
      lowestIn rest from until
        (if k >= from && k < until then (first matching case of best : when Absent then Present k when Present b then (if k < b then Present k else best end if) end case) else best end if)
  end case
end function

-- The first `-- ^` starting on a line in [from, until).
function docBetween (d :: Docs) (from :: Integer) (until :: Integer) -> DocText is
  first matching case of lowestIn (prelude.keys d.after) from until Absent :
    when Absent then docText Absent
    when Present k then docText (prelude.lookup k d.after)
  end case
end function

-- The keys of `ks` whose `-- ^` doc starts at column `col`.
function atCol (ks :: List Integer) (col :: Integer) (cols :: KeyVal Integer Integer) -> List Integer is
  first matching case of ks :
    when Nil then []
    when Cons k rest then
      (first matching case of prelude.lookup k cols :
         when Present cc then (if cc = col then [k] else [] end if)
         when Absent then []
       end case) ++ atCol rest col cols
  end case
end function

-- The first `-- ^` starting on a line in [from, until) at column `col`
-- (R46, R47: a method's or a value's after-doc stands at its signature's
-- column).
function docBetweenAt (ix :: Ix) (from :: Integer) (until :: Integer) (col :: Integer) -> DocText is
  first matching case of lowestIn (atCol (prelude.keys ix.docs.after) col ix.afterCols) from until Absent :
    when Absent then docText Absent
    when Present k then docText (prelude.lookup k ix.docs.after)
  end case
end function

-- ---------------------------------------------------------------------------
-- Symbols.

function mkDecl (id :: Text) (name :: Text) (kind :: SymbolKind) (loc :: Location) (owner :: Text) (doc :: DocText) -> Decl is
  Decl record{ id = id , name = name , kind = kind , visibility = Exported , idiom = ExportList ,
    location = loc , owner = owner , doc = doc ,
    entry = EntryPoint record{ isEntrypoint = false , invocation = Absent} ,
    detail = Detail record{ complexity = Complexity record{ time = Absent , space = Absent , method = Deferred} ,
      signature = Absent , typeKind = "" , underlying = "" , typeText = "" , inAll = Absent , decorators = [] ,
      concerns = [] , binary = noBinary unitValue} ,
    calls = [] , condition = ""}
end function

function param (t :: Text) -> Param is Param record{ name = "" , typeText = t , annotations = [] , nameSynthetic = false} end function

-- A type split at its top-level arrows: the parameters, then the result.
function arrowParamsIn (cs :: List Syntax) -> List Param is
  first matching case of cs :
    when Nil then []
    when Cons ch rest then
      (if ch.field = "parameter" then [param ch.text]
       else (if ch.field = "result" && ch.kind = "function" then arrowParamsIn ch.children else [] end if) end if) ++ arrowParamsIn rest
  end case
end function

function arrowResultIn (cs :: List Syntax) (acc :: Text) -> Text is
  first matching case of cs :
    when Nil then acc
    when Cons ch rest then
      (if ch.field = "result" then (if ch.kind = "function" then arrowResultIn ch.children "" else ch.text end if) else arrowResultIn rest acc end if)
  end case
end function

-- The type under any contexts and quantifiers (`Eq a => …`, `forall a. …`).
function coreIn (cs :: List Syntax) -> Maybe Syntax is
  first matching case of cs :
    when Nil then Absent
    when Cons ch rest then
      (if ch.field = "type" then (if ch.kind = "context" || ch.kind = "forall" then coreIn ch.children else Present ch end if) else coreIn rest end if)
  end case
end function

function coreType (t :: Syntax) -> Syntax is
  if t.kind = "context" || t.kind = "forall" then (first matching case of coreIn t.children : when Absent then t when Present c then c end case) else t end if
end function

function sigOfType (t :: Syntax) -> Signature is
  let nd = coreType t in
    Signature record{ params = (if nd.kind = "function" then arrowParamsIn nd.children else [] end if) ,
                      returns = [param (if nd.kind = "function" then arrowResultIn nd.children "" else nd.text end if)] ,
                      typeParams = [] , receiver = Absent , variadic = false , modifiers = [] , descriptor = "" , throws = []}
  end let
end function

-- A bound name: a variable, or an operator in parentheses: `(<+>)` holds an
-- `operator`, `(:+:)` a `constructor_operator` (review 5).
function nameText (n :: Syntax) -> Text is
  if n.kind = "prefix_id" then
    (first matching case of childKind n.children "operator" :
      when Present o then o.text
      when Absent then textOf (childKind n.children "constructor_operator")
    end case)
  else n.text end if
end function

-- The name a binding defines: by its `name` field, or by the operator of an
-- infix definition (`a <+> b = …`, `` x `op` y = … ``).
function directName (s :: Syntax) -> Text is
  first matching case of childField s.children "name" :
    when Present n then nameText n
    when Absent then
      (first matching case of childKind s.children "infix" :
        when Absent then ""
        when Present i then
          (first matching case of childField i.children "operator" :
            when Absent then ""
            when Present o then (if o.kind = "infix_id" then textOf (childKind o.children "variable") else o.text end if)
          end case)
      end case)
  end case
end function

-- A parenthesised head, `(f x) y = e`, names `f` (matrix T3); two levels.
function boundName (s :: Syntax) -> Text is
  let d = directName s in
    (if d != "" then d else
      (first matching case of childField s.children "parens" :
        when Absent then ""
        when Present hp then
          (let d2 = directName hp in
            (if d2 != "" then d2 else
              (first matching case of childField hp.children "parens" : when Absent then "" when Present hq then directName hq end case) end if)
           end let)
      end case) end if)
  end let
end function

-- The names a signature or field declares (`f, g :: …`).
function namesOf (s :: Syntax) -> List Text is
  first matching case of childField s.children "names" :
    when Present l then nameTexts (allField l.children "name")
    when Absent then nameTexts (allField s.children "name")
  end case
end function

function nameTexts (ns :: List Syntax) -> List Text is
  first matching case of ns :
    when Nil then []
    when Cons n rest then [fieldOrName n] ++ nameTexts rest
  end case
end function

function fieldOrName (n :: Syntax) -> Text is
  if n.kind = "field_name" then
    (first matching case of childKind n.children "variable" :
      when Present v then v.text
      when Absent then (first matching case of childKind n.children "prefix_id" : when Present pf then nameText pf when Absent then n.text end case)
    end case)
  else nameText n end if
end function

-- ---------------------------------------------------------------------------
-- Indexes over a module's declarations.

function isValueNode (d :: Syntax) -> Bool is d.kind = "function" || d.kind = "bind" end function

function putNode (k :: Text) (n :: Syntax) (acc :: KeyVal Text (List Syntax)) -> KeyVal Text (List Syntax) is
  prelude.put k (listAt acc k ++ [n]) acc
end function

function putNodes (k :: Text) (ns :: List Syntax) (acc :: KeyVal Text (List Syntax)) -> KeyVal Text (List Syntax) is
  first matching case of ns : when Nil then acc when Cons n rest then putNodes k rest (putNode k n acc) end case
end function

function putUnder (ks :: List Text) (n :: Syntax) (acc :: KeyVal Text (List Syntax)) -> KeyVal Text (List Syntax) is
  first matching case of ks : when Nil then acc when Cons k rest then putUnder rest n (if validId k then putNode k n acc else acc end if) end case
end function

function valueNodes (cs :: List Syntax) -> List Syntax is
  first matching case of cs : when Nil then [] when Cons ch rest then (if isValueNode ch then [ch] else [] end if) ++ valueNodes rest end case
end function

-- The value bindings in a class or instance body (right of its keyword: F87).
function bodyNodes (d :: Syntax) -> List Syntax is
  first matching case of childField d.children "declarations" : when Absent then [] when Present b then rightOf (colOf d.from) (valueNodes b.children) end case
end function

function putDefaults (cls :: Text) (ns :: List Syntax) (acc :: KeyVal Text (List Syntax)) -> KeyVal Text (List Syntax) is
  first matching case of ns :
    when Nil then acc
    when Cons n rest then putDefaults cls rest (if validId (boundName n) then putNode (cls ++ "." ++ boundName n) n acc else acc end if)
  end case
end function

-- The nodes whose calls each symbol carries, by symbol id: a value's
-- equations; a top-level pattern binding, under each variable it binds; a
-- class's default equations, under `C.m`; an instance's method equations,
-- under the instance; a pattern synonym's builders, under the synonym.
function equationsIndex (ds :: List Syntax) (acc :: KeyVal Text (List Syntax)) -> KeyVal Text (List Syntax) is
  first matching case of ds :
    when Nil then acc
    when Cons d rest then
      equationsIndex rest
        (first matching case of d :
          when record{} if isValueNode d && validId (boundName d) then putNode (boundName d) d acc
          when record{} if d.kind = "bind" then putUnder (patternVars (emptyCtx unitValue) (childField d.children "pattern")) d acc
          when record{} if d.kind = "class" && validId (headName d) then putDefaults (headName d) (bodyNodes d) acc
          when record{} if d.kind = "instance" && validId (instanceId d (headName d)) then putNodes (instanceId d (headName d)) (bodyNodes d) acc
          when record{} if d.kind = "pattern_synonym" && validId (synName (synonymOf d)) then putNodes (synName (synonymOf d)) (implicitBuilder d ++ findAll "constructor_synonym" d.children) acc
          otherwise acc
        end case)
  end case
end function

-- `pattern P x = e`: the right-hand side is also the builder (R32, O19). The
-- builder is a node shaped as an explicit one, `constructor_synonym`, whose
-- `pattern` is the synonym's head (its variables are the locals) and whose
-- `expression` is the pattern read as an expression. The token is anonymous: it
-- is `=` when the equation's text, less the pattern at its end, ends with `=`.
function implicitBuilder (d :: Syntax) -> List Syntax is
  first matching case of childKind d.children "equation" :
    when Absent then []
    when Present eq then
      (if childKind eq.children "constructors" matches Present _ then [] else
        (first matching case of childField eq.children "synonym" :
          when Absent then []
          when Present sy then
            (first matching case of childField eq.children "pattern" :
              when Absent then []
              when Present p then
                (if isEqualsHead eq.text p.text then
                   [Syntax record{ kind = "constructor_synonym" , field = "" , text = eq.text , from = eq.from , to = eq.to , isError = false ,
                                   children = [(sy with field = "pattern") , (p with field = "expression" , children = asExprs p.children)]}]
                 else [] end if)
            end case)
        end case) end if)
  end case
end function

-- The same nodes with the grammar's pattern fields renamed `expression`, so
-- that the walk reads a pattern-shaped builder as the expression it is: a
-- nested pattern's field is `pattern` (or `patterns`), which the walk skips.
function asExprs (cs :: List Syntax) -> List Syntax is
  first matching case of cs :
    when Nil then []
    when Cons n rest then
      [n with field = (if n.field = "pattern" || n.field = "patterns" then "expression" else n.field end if) , children = asExprs n.children] ++ asExprs rest
  end case
end function

function isEqualsHead (whole :: Text) (pat :: Text) -> Bool is
  prelude.endsWith whole pat
    && (let lead = prelude.take (prelude.length whole - prelude.length pat) whole in prelude.endsWith (trimEnd lead (prelude.length lead)) "=" end let)
end function

function listAt (kv :: KeyVal Text (List Syntax)) (k :: Text) -> List Syntax is
  first matching case of prelude.lookup k kv : when Absent then [] when Present l then l end case
end function

function signaturesIndex (ds :: List Syntax) (acc :: KeyVal Text Syntax) -> KeyVal Text Syntax is
  first matching case of ds :
    when Nil then acc
    when Cons d rest then
      signaturesIndex rest
        (if d.kind = "signature" then putNames (namesOf d) d acc
         else (if d.kind = "pattern_synonym" && (childKind d.children "signature" matches Present _) then putNames [synName (synonymOf d)] d acc else acc end if) end if)
  end case
end function

function putNames (ns :: List Text) (s :: Syntax) (acc :: KeyVal Text Syntax) -> KeyVal Text Syntax is
  first matching case of ns :
    when Nil then acc
    when Cons n rest then putNames rest s (if prelude.lookup n acc matches Present _ then acc else prelude.put n s acc end if)
  end case
end function

-- ---------------------------------------------------------------------------
-- The import table and the Prelude.

type Import is a record{
  module :: Text
  alias :: Text
  names :: List Text
  alls :: List Text
  hasList :: Bool
  qualified :: Bool
  hiding :: Bool
  dataAll :: Bool}
end type

-- Whether an import list has a `data ..` item (G5): every term name.
function dataWild (items :: List Syntax) -> Bool is
  first matching case of items :
    when Nil then false
    when Cons item rest then (textOf (childField item.children "namespace") = "data" && (childField item.children "wildcard" matches Present _)) || dataWild rest
  end case
end function

-- The words of an import's head, before its list: `qualified` and `hiding`
-- are tokens the named tree does not keep (also `hiding(…)` and
-- ImportQualifiedPost's `import M qualified as X`).
function headWords (ws :: List Text) -> List Text is
  first matching case of ws :
    when Nil then []
    when Cons w rest then (if prelude.startsWith w "(" then [] else (if prelude.startsWith w "hiding(" then ["hiding"] else [w] ++ headWords rest end if) end if)
  end case
end function

function importOf (s :: Syntax) -> Import is
  let hw = headWords (words s.text) in
  let list = childField s.children "names" in
    Import record{ module = moduleText (childField s.children "module") ,
                   alias = moduleText (childField s.children "alias") ,
                   names = (first matching case of list :
                              when Absent then []
                              when Present l then itemNames (allKind l.children "import_name")
                            end case) ,
                   alls = (first matching case of list : when Absent then [] when Present l then allsOf (allKind l.children "import_name") end case) ,
                   hasList = list matches Present _ ,
                   qualified = hw contains "qualified" ,
                   hiding = hw contains "hiding" ,
                   dataAll = (first matching case of list : when Absent then false when Present l then dataWild (allKind l.children "import_name") end case)}
  end let end let
end function

-- The term names an import list's items bring (R36, R22, O15): an item's
-- `variable`; its `operator`, when that is a variable operator and the
-- namespace is not `type`, or a constructor operator under `data` or `pattern`;
-- its `type` under `data` or `pattern` (`import M (data P, pattern Q)` names the
-- constructor P, the pattern synonym Q; a bare or `type` name is a type
-- constructor only); and every name in its child list, whatever the namespace.
function itemNames (items :: List Syntax) -> List Text is
  first matching case of items :
    when Nil then []
    when Cons item rest then
      (let ns = textOf (childField item.children "namespace") in
        (first matching case of childKind item.children "variable" : when Absent then [] when Present v then [v.text] end case)
          ++ (first matching case of childField item.children "operator" :
                when Absent then []
                when Present o then
                  (if childKind o.children "operator" matches Present _ then (if ns != "type" then [nameText o] else [] end if)
                   else (if childKind o.children "constructor_operator" matches Present _ && (ns = "data" || ns = "pattern") then [nameText o] else [] end if) end if)
              end case)
          ++ (if ns = "data" || ns = "pattern" then (first matching case of childField item.children "type" : when Absent then [] when Present tn then [tn.text] end case) else [] end if)
          ++ (first matching case of childField item.children "children" : when Absent then [] when Present kids then memberTexts kids.children end case)
      end let) ++ itemNames rest
  end case
end function

-- The types and classes an import list writes with `(..)`.
function allsOf (items :: List Syntax) -> List Text is
  first matching case of items :
    when Nil then []
    when Cons item rest then
      (first matching case of childField item.children "children" :
        when Absent then []
        when Present kids then (if childKind kids.children "all_names" matches Present _ then [textOf (childField item.children "type")] else [] end if)
      end case) ++ allsOf rest
  end case
end function

function importsOf (cs :: List Syntax) -> List Import is
  first matching case of cs : when Nil then [] when Cons ch rest then [importOf ch] ++ importsOf rest end case
end function

-- The Prelude names that resolve as builtin (Haskell 2010's Prelude
-- functions, a fixed table; the policy's names are a subset, law HSE-3).
-- The Prelude's names (corpus check C4, owner 2026-11-11): the Haskell 2010
-- Prelude, and the class methods and operators GHC's Prelude exports
-- (Functor, Applicative, Monad, Monoid, Foldable, Traversable), and the
-- Prelude's constructors. `||` is written `prelude.drop 1 " ||"`: a LawSpec
-- string starting with `|` reads as a phrase name (issue 22).
function preludeTable (u :: Unit) -> List Text is
  ["abs", "acos", "acosh", "all", "and", "any", "appendFile", "asTypeOf", "asin", "asinh", "atan", "atan2", "atanh",
   "break", "ceiling", "compare", "concat", "concatMap", "const", "cos", "cosh", "curry", "cycle", "decodeFloat", "div",
   "divMod", "drop", "dropWhile", "either", "elem", "encodeFloat", "enumFrom", "enumFromThen", "enumFromThenTo",
   "enumFromTo", "error", "errorWithoutStackTrace", "even", "exp", "exponent", "fail", "filter", "flip", "floatDigits",
   "floatRadix", "floatRange", "floor", "fmap", "foldMap", "foldl", "foldl1", "foldr", "foldr1", "fromEnum",
   "fromInteger", "fromIntegral", "fromRational", "fst", "gcd", "getChar", "getContents", "getLine", "head", "id",
   "init", "interact", "ioError", "isDenormalized", "isIEEE", "isInfinite", "isNaN", "isNegativeZero", "iterate", "last",
   "lcm", "length", "lex", "lines", "log", "logBase", "lookup", "map", "mapM", "mapM_", "mappend", "max", "maxBound",
   "maximum", "maybe", "mconcat", "mempty", "min", "minBound", "minimum", "mod", "negate", "not", "notElem", "null",
   "odd", "or", "otherwise", "pi", "pred", "print", "product", "properFraction", "pure", "putChar", "putStr", "putStrLn",
   "quot", "quotRem", "read", "readFile", "readIO", "readList", "readLn", "readParen", "reads", "readsPrec",
   "realToFrac", "recip", "rem", "repeat", "replicate", "return", "reverse", "round", "scaleFloat", "scanl", "scanl1",
   "scanr", "scanr1", "seq", "sequence", "sequenceA", "sequence_", "show", "showChar", "showList", "showParen",
   "showString", "shows", "showsPrec", "significand", "signum", "sin", "sinh", "snd", "span", "splitAt", "sqrt",
   "subtract", "succ", "sum", "tail", "take", "takeWhile", "tan", "tanh", "toEnum", "toInteger", "toRational",
   "traverse", "truncate", "uncurry", "undefined", "unlines", "until", "unwords", "unzip", "unzip3", "userError",
   "words", "writeFile", "zip", "zip3", "zipWith", "zipWith3", "!!", "$", "$!", "&&", "*", "**", "+", "++", "-", ".",
   "/", "/=", "<", "<=", "==", ">", ">=", ">>", ">>=", "=<<", "^", "^^", "<$>", "<$", "<*>", "*>", "<*", "<>",
   "False", "True", "Nothing", "Just", "Left", "Right", "LT", "EQ", "GT", prelude.drop 1 " ||"]
end function

-- Whether an unqualified import can bring n into scope: definitely (it
-- lists n), possibly (no list, or a hiding list without n), or not.
-- The members of the Prelude's types and classes, as `Owner.member`:
-- `hiding (Functor(..))` hides `fmap`, `(Maybe(..))` brings `Just`.
function preludeOwned (u :: Unit) -> List Text is
  ["Bool.False", "Bool.True", "Maybe.Nothing", "Maybe.Just", "Either.Left", "Either.Right", "Ordering.LT", "Ordering.EQ", "Ordering.GT",
   "Eq.==", "Eq./=", "Ord.compare", "Ord.<", "Ord.<=", "Ord.>", "Ord.>=", "Ord.max", "Ord.min",
   "Enum.succ", "Enum.pred", "Enum.toEnum", "Enum.fromEnum", "Enum.enumFrom", "Enum.enumFromThen", "Enum.enumFromTo", "Enum.enumFromThenTo",
   "Bounded.minBound", "Bounded.maxBound",
   "Num.+", "Num.-", "Num.*", "Num.negate", "Num.abs", "Num.signum", "Num.fromInteger", "Real.toRational",
   "Integral.quot", "Integral.rem", "Integral.div", "Integral.mod", "Integral.quotRem", "Integral.divMod", "Integral.toInteger",
   "Fractional./", "Fractional.recip", "Fractional.fromRational",
   "Floating.pi", "Floating.exp", "Floating.log", "Floating.sqrt", "Floating.**", "Floating.logBase", "Floating.sin", "Floating.cos",
   "Floating.tan", "Floating.asin", "Floating.acos", "Floating.atan", "Floating.sinh", "Floating.cosh", "Floating.tanh", "Floating.asinh",
   "Floating.acosh", "Floating.atanh",
   "RealFrac.properFraction", "RealFrac.truncate", "RealFrac.round", "RealFrac.ceiling", "RealFrac.floor",
   "RealFloat.floatRadix", "RealFloat.floatDigits", "RealFloat.floatRange", "RealFloat.decodeFloat", "RealFloat.encodeFloat",
   "RealFloat.exponent", "RealFloat.significand", "RealFloat.scaleFloat", "RealFloat.isNaN", "RealFloat.isInfinite",
   "RealFloat.isDenormalized", "RealFloat.isNegativeZero", "RealFloat.isIEEE", "RealFloat.atan2",
   "Show.showsPrec", "Show.show", "Show.showList", "Read.readsPrec", "Read.readList",
   "Functor.fmap", "Functor.<$", "Applicative.pure", "Applicative.<*>", "Applicative.*>", "Applicative.<*",
   "Monad.>>=", "Monad.>>", "Monad.return", "MonadFail.fail", "Semigroup.<>", "Monoid.mempty", "Monoid.mappend", "Monoid.mconcat",
   "Foldable.foldMap", "Foldable.foldr", "Foldable.foldl", "Foldable.foldr1", "Foldable.foldl1", "Foldable.elem", "Foldable.maximum",
   "Foldable.minimum", "Foldable.sum", "Foldable.product", "Foldable.null", "Foldable.length",
   "Traversable.traverse", "Traversable.sequenceA", "Traversable.mapM", "Traversable.sequence"]
end function

function ownerHas (n :: Text) (owner :: Text) -> Bool is preludeOwned unitValue contains (owner ++ "." ++ n) end function

-- An import's list names n: written there, or (for the Prelude, whose
-- members are known) a member of a type or class written with `(..)`.
function listed (i :: Import) (n :: Text) -> Bool is
  (i.names contains n) || i.dataAll || (i.module = "Prelude" && prelude.any (ownerHas n) i.alls)
end function

-- Whether an unqualified import can bring n into scope: definitely (it
-- lists n), possibly (no list, or a hiding list without n), or not.
function brings (i :: Import) (n :: Text) -> Bool is
  !i.qualified && (!i.hasList || (i.hiding && !(listed i n)) || (!i.hiding && listed i n))
end function

-- The module an unqualified name comes from: the one non-Prelude import
-- that lists it explicitly; two or more is ambiguous, and an open import
-- never resolves a name (spec: never guessed).
function explicitFrom (imps :: List Import) (n :: Text) -> List Text is
  first matching case of imps :
    when Nil then []
    when Cons i rest then (if !i.qualified && !i.hiding && i.hasList && i.module != "Prelude" && (i.names contains n) then [i.module] else [] end if) ++ explicitFrom rest n
  end case
end function

-- The modules a qualifier q can name (by alias, or by module name when the
-- import has no alias) that can supply n.
function qualifiedFrom (imps :: List Import) (q :: Text) (n :: Text) -> List Text is
  first matching case of imps :
    when Nil then []
    when Cons i rest then
      (if (i.alias = q || (i.alias = "" && i.module = q)) && (!i.hasList || (i.hiding && !(listed i n)) || (!i.hiding && (listed i n || (i.module != "Prelude" && !(prelude.isEmpty i.alls)))))
       then [i.module] else [] end if) ++ qualifiedFrom rest q n
  end case
end function

-- The imports a qualified name is read against: the written ones, and the
-- implicit `import Prelude` when none names the Prelude and it is on (R33).
function importsWithPrelude (x :: Ctx) -> List Import is
  if preludeImported x.imports || x.noPrelude then x.imports
  else x.imports ++ [Import record{ module = "Prelude" , alias = "" , names = [] , alls = [] , hasList = false , qualified = true , hiding = false , dataAll = false}] end if
end function

function preludeImported (imps :: List Import) -> Bool is
  first matching case of imps : when Nil then false when Cons i rest then i.module = "Prelude" || preludeImported rest end case
end function

function preludeBrings (imps :: List Import) (n :: Text) -> Bool is
  first matching case of imps : when Nil then false when Cons i rest then (i.module = "Prelude" && brings i n) || preludeBrings rest n end case
end function

-- Haskell 2010: the Prelude is implicit unless imported explicitly (then a
-- name is visible if an unqualified Prelude import brings it), and
-- NoImplicitPrelude or RebindableSyntax turn the implicit import off.
function preludeVisible (imps :: List Import) (noPrelude :: Bool) (n :: Text) -> Bool is
  if preludeImported imps then preludeBrings imps n else !noPrelude end if
end function

function single (ms :: List Text) -> Maybe Text is
  first matching case of ms :
    when Nil then Absent
    when Cons m rest then (if allSame rest m then Present m else Absent end if)
  end case
end function

function sameText (m :: Text) (x :: Text) -> Bool is x = m end function
function allSame (ms :: List Text) (m :: Text) -> Bool is prelude.all (sameText m) ms end function

-- ---------------------------------------------------------------------------
-- Calls: every application whose function is a name, resolved in scope.

type Ctx is a record{
  moduleId :: Text
  tops :: KeyVal Text Text
  imports :: List Import
  noPrelude :: Bool
  conFields :: KeyVal Text (List Text)
  recordDot :: Bool}
end type

function emptyCtx (u :: Unit) -> Ctx is
  Ctx record{ moduleId = "" , tops = prelude.keyValOf [] , imports = [] , noPrelude = false , conFields = prelude.keyValOf [] , recordDot = false}
end function

-- The record fields of each constructor declared in the module, by
-- constructor name (for `K{..}`; matrix L26), pattern synonyms included.
function putCons (ns :: List Text) (fields :: List Text) (acc :: KeyVal Text (List Text)) -> KeyVal Text (List Text) is
  first matching case of ns : when Nil then acc when Cons n rest then putCons rest fields (prelude.put n fields acc) end case
end function

function conFieldsIn (cs :: List Syntax) (acc :: KeyVal Text (List Text)) -> KeyVal Text (List Text) is
  first matching case of cs :
    when Nil then acc
    when Cons nd rest then
      conFieldsIn rest
        (first matching case of nd :
          when record{} if nd.kind = "data_type" && isTypeData nd then acc
          when record{} if nd.kind = "data_constructor" then
            (let shape = (first matching case of childField nd.children "constructor" : when Absent then nd when Present sh then sh end case) in
              putCons [conNameOf shape] (fieldsNamed (findAll "field" shape.children)) acc end let)
          when record{} if nd.kind = "gadt_constructor" then putCons (namesOf nd) (fieldsNamed (findAll "field" nd.children)) acc
          when record{} if nd.kind = "newtype_constructor" then putCons [textOf (childField nd.children "name")] (fieldsNamed (findAll "field" nd.children)) acc
          when record{} if nd.kind = "pattern_synonym" then putCons [synName (synonymOf nd)] (synFieldNames (synonymOf nd)) acc
          otherwise conFieldsIn nd.children acc
        end case)
  end case
end function

-- A pattern synonym's head: the `synonym` of its equation, or of its signature.
function synonymOf (ps :: Syntax) -> Maybe Syntax is
  first matching case of childKind ps.children "equation" :
    when Present eq then childField eq.children "synonym"
    when Absent then (first matching case of childKind ps.children "signature" : when Absent then Absent when Present sg then childField sg.children "synonym" end case)
  end case
end function

function synName (m :: Maybe Syntax) -> Text is
  first matching case of m :
    when Absent then ""
    when Present sy then
      (first matching case of sy :
        when record{} if sy.kind = "apply" then prelude.join "" (headOf sy.children)
        when record{} if sy.kind = "record" then textOf (childField sy.children "constructor")
        when record{} if sy.kind = "infix" then conNameOf sy
        otherwise sy.text
      end case)
  end case
end function

function fieldPatNames (fps :: List Syntax) -> List Text is
  first matching case of fps :
    when Nil then []
    when Cons fp rest then (first matching case of childField fp.children "field" : when Absent then [] when Present fl then [fieldOrName fl] end case) ++ fieldPatNames rest
  end case
end function

function synFieldNames (m :: Maybe Syntax) -> List Text is
  first matching case of m :
    when Absent then []
    when Present sy then (if sy.kind = "record" then fieldPatNames (allKind sy.children "field_pattern") else [] end if)
  end case
end function

function resolveName (x :: Ctx) (locals :: List Text) (n :: Text) -> CallEdge is
  if locals contains n then edge Dynamic n Absent else
    (first matching case of prelude.lookup n x.tops :
      when Present id then edge Internal n (Present (x.moduleId ++ "#" ++ id))
      when Absent then
        (first matching case of single (explicitFrom x.imports n) :
          when Present m then edge External (m ++ "." ++ n) Absent
          when Absent then
            (if (preludeTable unitValue contains n) && preludeVisible x.imports x.noPrelude n then edge Builtin n Absent
             else edge Unresolved n Absent end if)
        end case)
    end case)
  end if
end function

function resolveQualified (x :: Ctx) (q :: Syntax) -> CallEdge is
  let m = moduleText (childField q.children "module") in
  let n = textOf (childField q.children "id") in
    (if !(validId n) then edge Unresolved q.text Absent else
     (if m = x.moduleId then
        -- M.f in module M is M's own f (Haskell 2010, 5.5.1); an import
        -- aliased M could supply it too, so then it is not guessed (review 5, N1).
        (if prelude.length (qualifiedFrom x.imports m n) > 0 then edge Unresolved q.text Absent
         else (first matching case of prelude.lookup n x.tops :
                 when Present id then edge Internal n (Present (x.moduleId ++ "#" ++ id))
                 when Absent then edge Unresolved q.text Absent
               end case) end if) else
      (first matching case of single (qualifiedFrom (importsWithPrelude x) m n) :
        when Present full then
          (if full = "Prelude" then (if preludeTable unitValue contains n then edge Builtin n Absent else edge External (full ++ "." ++ n) Absent end if)
           else edge External (full ++ "." ++ n) Absent end if)
        when Absent then edge Unresolved q.text Absent
      end case) end if) end if)
  end let end let
end function

-- The edge an application makes: a name is resolved, and so is an operator
-- applied in prefix form, `(<+>) a b`, by its name (review 5); an
-- application of an application is the same call (curried, `f a b`), so it
-- adds nothing; any other callee is unresolved, as written.
-- A wild scope: a record wildcard on a record declared elsewhere, a
-- pattern splice or quasiquote, or the grammar's over-long `char` token may
-- bind names the file does not show. `#wild` can never be a real name.
-- An import that can supply a record field named n (R51): not the Prelude,
-- which exports none; one with no list, a hiding list that does not hide n,
-- or a list that writes n, has a `(..)` child list or a `data ..` item.
function supplies (n :: Text) (i :: Import) -> Bool is
  i.module != "Prelude" && (!i.hasList || (i.hiding && !(listed i n)) || (!i.hiding && (listed i n || !(prelude.isEmpty i.alls))))
end function

-- `#wild`: a splice, a quasi-quote or an over-long char token binds any
-- name. `#wildrec`: a record wildcard on a constructor the module does not
-- declare binds only a name some import can supply.
function wildFor (x :: Ctx) (locals :: List Text) (n :: Text) -> Bool is
  (locals contains "#wild") || ((locals contains "#wildrec") && prelude.any (supplies n) x.imports)
end function

-- A variable in a wild scope, not otherwise bound, is never resolved.
function varEdge (x :: Ctx) (locals :: List Text) (n :: Text) -> CallEdge is
  if !(locals contains n) && wildFor x locals n then edge Unresolved n Absent else resolveName x locals n end if
end function

-- The edge a written callee or operator makes, by the ladder: a variable, a
-- constructor, an operator (`:` is syntax: always builtin), a qualified
-- name, or one of those in parentheses or backticks.
function nameEdges (x :: Ctx) (locals :: List Text) (os :: List Syntax) -> List CallEdge is
  first matching case of os :
    when Nil then []
    when Cons o rest then
      (first matching case of o :
        when record{} if o.kind = "variable" || o.kind = "operator" then (if validId o.text then [varEdge x locals o.text] else [] end if)
        when record{} if o.kind = "constructor_operator" && o.text = ":" then [edge Builtin ":" Absent]
        when record{} if o.kind = "constructor" || o.kind = "constructor_operator" then
          (if validId o.text then [resolveName x locals o.text] else [] end if)
        when record{} if o.kind = "qualified" then [resolveQualified x o]
        when record{} if o.kind = "prefix_id" || o.kind = "infix_id" then nameEdges x locals o.children
        otherwise []
      end case) ++ nameEdges x locals rest
  end case
end function

function isNameNode (nd :: Syntax) -> Bool is
  nd.kind = "variable" || nd.kind = "constructor" || nd.kind = "prefix_id" || nd.kind = "qualified"
end function

-- The edge an application makes: a name is resolved by the ladder; an
-- application of an application is the same call (curried, `f a b`), so it
-- adds nothing; any other callee is unresolved, as written.
-- The innermost function of an application is `(->)`: the application is a
-- type (G2), never a call.
function arrowHead (n :: Syntax) (fuel :: Integer) -> Bool is
  if fuel <= 0 then false
  else
    (if n.kind = "apply" then
       (first matching case of childField n.children "function" :
          when Absent then false
          when Present f then
            (if f.kind = "apply" then arrowHead f (fuel - 1)
             else (f.kind = "prefix_id" && (first matching case of childKind f.children "operator" : when Present o then o.text = "->" when Absent then false end case)) end if)
        end case)
     else false end if)
  end if
end function

function typeFormKind (nd :: Syntax) -> Bool is
  nd.kind = "function" || nd.kind = "linear_function" || nd.kind = "context" || nd.kind = "forall" || nd.kind = "forall_required"
end function

-- A type written where a term is expected (RequiredTypeArguments, G1, G2):
-- a parenthesised arrow, context or forall, or an application of `(->)`.
-- A type holds no call.
function isTypeInTerm (nd :: Syntax) -> Bool is
  (nd.kind = "parens" && (first matching case of childField nd.children "expression" : when Present e then typeFormKind e || arrowHead e 64 when Absent then false end case))
    || (nd.kind = "apply" && arrowHead nd 64)
end function

function applyEdge (x :: Ctx) (locals :: List Text) (a :: Syntax) -> List CallEdge is
  if arrowHead a 64 then [] else
  first matching case of childField a.children "function" :
    when Absent then []
    when Present f then
      (if f.kind = "apply" then []
       else (if f.kind = "prefix_tuple" then (if validId f.text then [edge Builtin f.text Absent] else [] end if)
       else (if isNameNode f then nameEdges x locals [f]
             else (if validId f.text then [edge Unresolved f.text Absent] else [] end if) end if) end if) end if)
  end case end if
end function

-- The first operator of a right section, `(+ 1)`: its child without a field.
function firstOp (cs :: List Syntax) -> List Syntax is
  first matching case of cs :
    when Nil then []
    when Cons ch rest then
      (if ch.field = "" && (ch.kind = "operator" || ch.kind = "constructor_operator" || ch.kind = "infix_id" || ch.kind = "qualified") then [ch] else firstOp rest end if)
  end case
end function

-- `K { f = e }` uses the constructor K, as `K e` does; `r { f = e }` calls nothing.
function conHead (x :: Ctx) (locals :: List Text) (m :: Maybe Syntax) -> List CallEdge is
  first matching case of m :
    when Absent then []
    when Present hd then
      (if hd.kind = "constructor" || (hd.kind = "qualified" && (first matching case of childField hd.children "id" : when Absent then false when Present qi then qi.kind = "constructor" end case))
       then nameEdges x locals [hd] else [] end if)
  end case
end function

-- `r.f`, `(.f)`: one unresolved edge per label (R28, O13). The label does not
-- show which type's field it selects.
function fieldEdges (x :: Ctx) (fs :: List Syntax) -> List CallEdge is
  first matching case of fs :
    when Nil then []
    when Cons fl rest then
      (let n = fieldOrName fl in
        (if !(validId n) then [] else [edge Unresolved n Absent] end if) end let) ++ fieldEdges x rest
  end case
end function

-- Every edge a node itself makes (its children are walked separately).
-- `bare`: the node stands where a function is applied without being written
-- as an application (a view pattern's expression).
function nodeEdges (x :: Ctx) (locals :: List Text) (bare :: Bool) (nd :: Syntax) -> List CallEdge is
  (if nd.kind = "apply" then applyEdge x locals nd else [] end if)
    ++ (if nd.kind = "infix" || nd.kind = "left_section" then nameEdges x locals (allField nd.children "operator") else [] end if)
    ++ (if nd.kind = "right_section" then nameEdges x locals (firstOp nd.children) else [] end if)
    ++ (if nd.kind = "record" then conHead x locals (first matching case of childField nd.children "expression" : when Present hd then Present hd when Absent then childField nd.children "constructor" end case) else [] end if)
    ++ (if nd.kind = "projection" || nd.kind = "projection_selector" then (if x.recordDot then fieldEdges x (allField nd.children "field") else dotEdges x locals (allField nd.children "field") end if) else [] end if)
    ++ (if nd.kind = "quasiquote" then (first matching case of childField nd.children "quoter" : when Absent then [] when Present qt then nameEdges x locals qt.children end case) else [] end if)
    ++ (if (bare || nd.field = "transformation" || nd.field = "classifier") && isNameNode nd then nameEdges x locals [nd] else [] end if)
end function

-- Variables a pattern binds (nested patterns, as-patterns, strictness).
-- Variables a pattern binds (nested patterns, as-patterns, strictness).
function patternVars (x :: Ctx) (m :: Maybe Syntax) -> List Text is
  first matching case of m : when Absent then [] when Present p then (if p.kind = "variable" then [p.text] else varsIn x 0 [p] end if) end case
end function

-- The variables a pattern binds. In a record pattern, a field's label binds
-- nothing when the field has its own pattern (`K{f = v}`); a pun (`K{f}`)
-- binds the label (review 3, S-1). `skip`: labels are skipped here.
function hasDots (fps :: List Syntax) -> Bool is
  first matching case of fps :
    when Nil then false
    when Cons fp rest then (first matching case of childKind fp.children "wildcard" : when Absent then false when Present wc then wc.text = ".." end case) || hasDots rest
  end case
end function

-- What `K{..}` binds: K's fields when the module declares K; otherwise the
-- scope is wild (matrix L26).
function wildFields (x :: Ctx) (nd :: Syntax) -> List Text is
  if !(hasDots (allKind nd.children "field_pattern")) then [] else
    (first matching case of childField nd.children "constructor" :
      when Absent then ["#wildrec"]
      when Present k then
        (if k.kind != "constructor" then ["#wildrec"]
         else (first matching case of prelude.lookup k.text x.conFields : when Absent then ["#wildrec"] when Present fs then fs end case) end if)
    end case)
  end if
end function

-- The variables patterns bind. `mode` 1: record labels are skipped (a field
-- with its own pattern, `K{f = v}`; a pun `K{f}` binds its label; review 3).
-- `mode` 2: the children of a view pattern, whose `expression` binds nothing.
-- Types and type binders bind no term name; a splice or a quasiquote in a
-- pattern binds names the file does not show.
function varsIn (x :: Ctx) (mode :: Integer) (cs :: List Syntax) -> List Text is
  first matching case of cs :
    when Nil then []
    when Cons nd rest then
      (first matching case of nd :
        when record{} if (mode = 1 && nd.kind = "field_name") || (mode = 2 && nd.field = "expression") || nd.field = "type" || nd.kind = "type_binder" then []
        when record{} if nd.kind = "variable" then [nd.text]
        when record{} if nd.kind = "prefix_id" then (if (childKind nd.children "operator" matches Present _) && nameText nd != "->" then [nameText nd] else [] end if)
        when record{} if nd.kind = "splice" || nd.kind = "quasiquote" then ["#wild"]
        when record{} if nd.kind = "field_pattern" then varsIn x (if childField nd.children "pattern" matches Present _ then 1 else 0 end if) nd.children
        when record{} if nd.kind = "record" then wildFields x nd ++ varsIn x 0 nd.children
        when record{} if nd.kind = "view_pattern" then varsIn x 2 nd.children
        otherwise varsIn x 0 nd.children
      end case) ++ varsIn x mode rest
  end case
end function

-- Names a binding group defines (`where`, `let`).
function bindNames (x :: Ctx) (m :: Maybe Syntax) -> List Text is
  first matching case of m : when Absent then [] when Present b then declNames x b.children end case
end function

function declNames (x :: Ctx) (cs :: List Syntax) -> List Text is
  first matching case of cs :
    when Nil then []
    when Cons nd rest then
      (if isValueNode nd && validId (boundName nd) then [boundName nd]
       else (if nd.kind = "bind" then patternVars x (childField nd.children "pattern") else [] end if) end if) ++ declNames x rest
  end case
end function

-- The names bound by the `kind` children (`pattern_guard`, `generator`) of
-- a `guards` or `qualifiers` node, read from their `pattern` (review 2, S3).
function boundBy (x :: Ctx) (kind :: Text) (cs :: List Syntax) -> List Text is
  first matching case of cs :
    when Nil then []
    when Cons nd rest then (if nd.kind = kind then patternVars x (childField nd.children "pattern") else [] end if) ++ boundBy x kind rest
  end case
end function

function fieldsNamed (fs :: List Syntax) -> List Text is
  first matching case of fs : when Nil then [] when Cons f rest then namesOf f ++ fieldsNamed rest end case
end function

-- The locals a binding brings into its own body: its parameters (and an
-- infix definition's operands) and its `where` names.
function operandVars (x :: Ctx) (nd :: Syntax) -> List Text is
  first matching case of childKind nd.children "infix" :
    when Absent then []
    when Present i then patternVars x (childField i.children "left_operand") ++ patternVars x (childField i.children "right_operand")
  end case
end function

function bindingLocals (x :: Ctx) (nd :: Syntax) -> List Text is
  patternVars x (childField nd.children "patterns") ++ operandVars x nd
    ++ (first matching case of childField nd.children "parens" :
          when Absent then []
          when Present hp then patternVars x (childField hp.children "patterns") ++ operandVars x hp
        end case)
    ++ bindNames x (childField nd.children "binds")
end function

-- Positions that are patterns, types or heads, never calls.
-- Positions that are names or types, never calls.
function typeNode (nd :: Syntax) -> Bool is
  nd.field = "name" || nd.field = "names" || nd.field = "type" || nd.field = "multiplicity"
    || nd.kind = "type_application" || nd.kind = "explicit_type" || nd.kind = "kind_application" || nd.kind = "type_binder"
end function

-- Positions that are patterns: only a view pattern's expression calls.
function patNode (nd :: Syntax) -> Bool is nd.field = "patterns" || nd.field = "pattern" || nd.kind = "patterns" end function

-- An infix definition head (`a <+> b = …`): a fieldless `infix` directly
-- under a `function`. The grammar also leaves an infix expression without a
-- field in a `do` statement, a guard, a `case` scrutinee and a filter, where
-- its calls count (review 2, B1), so the parent decides.


-- Names the `let` items of a guard or qualifier list bind (review 5, B1).
function letsIn (x :: Ctx) (cs :: List Syntax) -> List Text is
  first matching case of cs :
    when Nil then []
    when Cons ch rest then (if ch.kind = "let" then bindNames x (childField ch.children "binds") else [] end if) ++ letsIn x rest
  end case
end function

-- Names a `rec` block binds, for itself and what follows (review 5, B3).
function recNames (x :: Ctx) (cs :: List Syntax) -> List Text is
  first matching case of cs :
    when Nil then []
    when Cons ch rest then
      (if ch.kind = "bind" then patternVars x (childField ch.children "pattern") else (if ch.kind = "let" then bindNames x (childField ch.children "binds") else [] end if) end if) ++ recNames x rest
  end case
end function

-- What a comprehension's qualifiers bind over its head: every branch of a
-- parallel comprehension (matrix L19).
function qualsBound (x :: Ctx) (cs :: List Syntax) -> List Text is
  first matching case of cs :
    when Nil then []
    when Cons ch rest then (if ch.field = "qualifiers" then boundBy x "generator" ch.children ++ letsIn x ch.children else [] end if) ++ qualsBound x rest
  end case
end function

function guardsBound (x :: Ctx) (m :: Maybe Syntax) -> List Text is
  first matching case of m : when Absent then [] when Present g then boundBy x "pattern_guard" g.children ++ letsIn x g.children end case
end function

-- The scope a node opens for its children.
-- The scope a node opens for its children.
function scoped (x :: Ctx) (nd :: Syntax) (locals :: List Text) -> List Text is
  first matching case of nd :
    when record{} if nd.kind = "proc" then locals ++ ["#proc"] ++ patternVars x (childField nd.children "pattern")
    when record{} if nd.kind = "lambda" then locals ++ patternVars x (childField nd.children "patterns")
    when record{} if nd.kind = "let_in" then locals ++ bindNames x (childField nd.children "binds")
    when record{} if nd.kind = "alternative" then
      locals ++ patternVars x (childField nd.children "pattern") ++ patternVars x (childField nd.children "patterns") ++ bindNames x (childField nd.children "binds")
    when record{} if nd.kind = "function" || nd.kind = "bind" then locals ++ bindingLocals x nd
    when record{} if nd.kind = "constructor_synonym" then locals ++ patternVars x (childField nd.children "pattern")
    when record{} if nd.kind = "do" && prelude.startsWith nd.text "mdo" then locals ++ recNames x nd.children
    otherwise locals
  end case
end function

-- Arrow notation. The scope outside the last `proc`: the locals before the
-- last `#proc` marker (R2). `cur` is what has been read, `best` the prefix
-- before the last marker met.
function beforeProc (ls :: List Text) (cur :: List Text) (best :: List Text) -> List Text is
  first matching case of ls :
    when Nil then best
    when Cons l rest then (if l = "#proc" then beforeProc rest (cur ++ [l]) cur else beforeProc rest (cur ++ [l]) best end if)
  end case
end function

-- A tail `f -< a` or `f -<< a`, met inside a proc (R2).
function isTail (locals :: List Text) (nd :: Syntax) -> Bool is
  nd.kind = "infix" && (locals contains "#proc")
    && (first matching case of childField nd.children "operator" :
          when Absent then false
          when Present o then o.kind = "operator" && (o.text = "-<" || o.text = "-<<")
        end case)
end function

function isTightTail (nd :: Syntax) -> Bool is
  (first matching case of childField nd.children "operator" : when Absent then false when Present o then o.text = "-<" end case)
end function

-- Where a list of nodes sits: plain; the statements of a `do`; the children
-- of a `function` (whose fieldless `infix` child is an operator definition's
-- head, not a call); inside a pattern; or the children of a view pattern.
-- `WGuard`: the guards of a `match` or the qualifiers of one `qualifiers`
-- field, read in order; `WMatch`: a `match`'s other children; `WQuals`, `WHead`:
-- a comprehension's qualifier fields, and its head.
type Where is one of | WPlain | WDo | WFun | WPat | WView | WLeft | WRight | WSpine | WGuard | WGuards | WMatch | WQuals | WHead end type

function whereOf (nd :: Syntax) -> Where is
  if nd.kind = "do" then WDo else (if nd.kind = "function" then WFun else WPlain end if) end if
end function

-- One structurally recursive walk (LawSpec refuses mutual recursion, so
-- patterns are a mode of it). In a `do` block a statement `p <- e` sees the
-- earlier binds; p is bound for the statements after it; `let` likewise; a
-- `rec` block's binds scope over the block and what follows. In a pattern
-- nothing calls but a view pattern's expression.
function walk (x :: Ctx) (locals :: List Text) (w :: Where) (cs :: List Syntax) -> List CallEdge is
  first matching case of cs :
    when Nil then []
    when Cons nd rest then
      (first matching case of nd :
        when record{} if typeNode nd || isTypeInTerm nd || (w = WFun && nd.kind = "infix" && nd.field = "") then walk x locals w rest
        when record{} if patNode nd || ((w = WPat || w = WView) && !(w = WView && nd.field = "expression")) then
          walk x locals (if nd.kind = "view_pattern" then WView else WPat end if) nd.children ++ walk x locals w rest
        when record{} if w = WDo && nd.kind = "bind" then
          walk x locals WPlain nd.children ++ walk x (locals ++ patternVars x (childField nd.children "pattern")) WDo rest
        when record{} if w = WDo && nd.kind = "let" then
          walk x (locals ++ bindNames x (childField nd.children "binds")) WPlain nd.children ++ walk x (locals ++ bindNames x (childField nd.children "binds")) WDo rest
        when record{} if w = WDo && nd.kind = "rec" then
          walk x (locals ++ recNames x nd.children) WDo nd.children ++ walk x (locals ++ recNames x nd.children) WDo rest
        when record{} if w = WMatch && nd.kind = "guards" then walk x locals w rest
        when record{} if w = WGuards && nd.kind != "guards" then walk x locals w rest
        when record{} if w = WGuards then walk x locals WGuard nd.children ++ walk x locals w rest
        when record{} if w = WQuals && nd.field != "qualifiers" then walk x locals w rest
        when record{} if w = WHead && nd.field = "qualifiers" then walk x locals w rest
        when record{} if w = WQuals then walk x locals WGuard nd.children ++ walk x locals w rest
        when record{} if w = WGuard && (nd.kind = "pattern_guard" || nd.kind = "generator") then
          walk x locals WPlain nd.children ++ walk x (locals ++ patternVars x (childField nd.children "pattern")) WGuard rest
        when record{} if w = WGuard && nd.kind = "let" then
          walk x (locals ++ bindNames x (childField nd.children "binds")) WPlain nd.children ++ walk x (locals ++ bindNames x (childField nd.children "binds")) WGuard rest
        when record{} if nd.kind = "match" then
          walk x locals WGuards nd.children
            ++ walk x (locals ++ guardsBound x (childField nd.children "guards")) WMatch nd.children ++ walk x locals w rest
        when record{} if nd.kind = "list_comprehension" then
          walk x locals WQuals nd.children ++ walk x (locals ++ qualsBound x nd.children) WHead nd.children ++ walk x locals w rest
        when record{} if w = WLeft && nd.field != "left_operand" then walk x locals w rest
        when record{} if w = WRight && nd.field != "right_operand" then walk x locals w rest
        when record{} if w = WSpine && nd.kind = "apply" then walk x locals WSpine nd.children ++ walk x locals w rest
        when record{} if w = WSpine && (nd.field = "function" || nd.field = "expression") then
          (let outer = (if locals contains "#proc" then beforeProc locals [] [] else locals end if) in
            (if isNameNode nd then nameEdges x outer [nd] else nodeEdges x outer false nd ++ walk x (scoped x nd outer) (whereOf nd) nd.children end if)
           end let) ++ walk x locals w rest
        when record{} if isTail locals nd then
          (let outer = (if isTightTail nd then beforeProc locals [] [] else locals end if) in
            (first matching case of childField nd.children "left_operand" :
               when Absent then []
               when Present l then (if isNameNode l && nd.field != "right_operand" then nameEdges x outer [l] else [] end if)
             end case)
            ++ walk x outer WLeft nd.children ++ walk x locals WRight nd.children
           end let) ++ walk x locals w rest
        when record{} if nd.kind = "arrow_form" then walk x locals WSpine nd.children ++ walk x locals w rest
        otherwise nodeEdges x locals (w = WView) nd ++ walk x (scoped x nd locals) (whereOf nd) nd.children ++ walk x locals w rest
      end case)
  end case
end function

-- ---------------------------------------------------------------------------
-- Declarations.

type Ix is a record{
  path :: Text
  docs :: Docs
  sigs :: KeyVal Text Syntax
  eqs :: KeyVal Text (List Syntax)
  afterCols :: KeyVal Integer Integer}
end type

function lastNode (ns :: List Syntax) (acc :: Syntax) -> Syntax is
  first matching case of ns : when Nil then acc when Cons n rest then lastNode rest n end case
end function

-- With no `-- |` doc, a `-- ^` between a value's signature and its first
-- equation documents it (Haddock; review 5, S5).
function orAfterSig (ix :: Ix) (sig :: Maybe Syntax) (d :: Syntax) (b :: DocText) -> DocText is
  if b.raw != "" then b else
    (first matching case of sig :
      when Absent then b
      when Present s then (if lineOf s.to < lineOf d.from then docBetweenAt ix (lineOf s.to + 1) (lineOf d.from) (colOf s.from) else b end if)
    end case)
  end if
end function

function valueDecl (ix :: Ix) (d :: Syntax) -> List Decl is
  let name = boundName d in
  let sig = prelude.lookup name ix.sigs in
  let start = (first matching case of sig : when Absent then d when Present s then (if lineOf s.from <= lineOf d.from then s else d end if) end case) in
  let sigType = (first matching case of sig : when Absent then Absent when Present s then childField s.children "type" end case) in
  let fun = (d.kind = "function") || (first matching case of sigType : when Absent then false when Present t then (coreType t).kind = "function" end case) in
  let last = lastNode (listAt ix.eqs name) d in
  let upto = (first matching case of sig : when Absent then last when Present s then (if lineOf s.to > lineOf last.to then s else last end if) end case) in
    (if !(validId name) then [] else
      [let base = mkDecl name name (if fun then KindFunction else KindConst end if) (locOf ix.path start upto) "" (orAfterSig ix sig d (docBefore ix.docs (lineOf start.from))) in
         base with detail = (base.detail with
                               signature = (if fun then (first matching case of sigType : when Absent then Absent when Present t then Present (sigOfType t) end case) else Absent end if) ,
                               typeText = (if fun then "" else textOf sigType end if)) end let] end if)
  end let end let end let end let end let end let end let
end function

-- Constructors in source order; each `-- ^` documents the nearest item
-- before it, so a constructor's range ends where its first field (or the
-- next constructor) starts.
-- A constructor's name: the `name` of a prefix or record constructor; for an
-- infix one, its operator (`:*:`) or the constructor in backticks (review 4, S2).
function conNameOf (shape :: Syntax) -> Text is
  if shape.kind = "infix" then
    (first matching case of childField shape.children "operator" :
       when Absent then ""
       when Present o then (if o.kind = "infix_id" then textOf (childKind o.children "constructor") else o.text end if)
     end case)
  else textOf (childField shape.children "name") end if
end function

-- `seen`: the fields already emitted for this type. A field repeated in a
-- later constructor is the same selector, so one symbol (review 2, S4).
-- A constructor or field with no `-- ^` takes the `-- |` that ends on the
-- line above it (the formatter layout, review 2 S1), unless it starts on its
-- owner's line (`data T = K`, `K { f :: Int }`), where that doc is the owner's.
function orBefore (ix :: Ix) (a :: DocText) (line :: Integer) (ownerLine :: Integer) -> DocText is
  if a.raw = "" && line != ownerLine then docBefore ix.docs line else a end if
end function

function conDecls (ix :: Ix) (owner :: Text) (cs :: List Syntax) (stop :: Integer) (seen :: List Text) (declLine :: Integer) -> List Decl is
  first matching case of cs :
    when Nil then []
    when Cons dc rest then
      (let shape = (first matching case of childField dc.children "constructor" : when Absent then dc when Present s then s end case) in
        (let name = conNameOf shape in
          (let fields = findAll "field" shape.children in
            (let next = (first matching case of rest : when Nil then stop when Cons n more then lineOf n.from end case) in
              (if validId name then
                 [mkDecl (owner ++ "." ++ name) name KindConstructor (conLoc ix.path dc) owner
                    (orBefore ix (docBetween ix.docs (lineOf dc.from) (first matching case of fields : when Nil then next when Cons f more then lineOf f.from end case)) (lineOf dc.from) declLine)]
                   ++ fieldDecls ix owner fields next seen (lineOf dc.from)
               else [] end if) end let) end let) end let) end let) ++ conDecls ix owner rest stop (seen ++ fieldsNamed (findAll "field" (first matching case of childField dc.children "constructor" : when Absent then dc when Present s then s end case).children)) declLine
  end case
end function

function fieldDecls (ix :: Ix) (owner :: Text) (fs :: List Syntax) (stop :: Integer) (seen :: List Text) (conLine :: Integer) -> List Decl is
  first matching case of fs :
    when Nil then []
    when Cons f rest then
      (if childField f.children "type" matches Present _
       then fieldNames ix owner f (namesOf f) (orBefore ix (docBetween ix.docs (lineOf f.from) (first matching case of rest : when Nil then stop when Cons n more then lineOf n.from end case)) (lineOf f.from) conLine) seen
       else [] end if) ++ fieldDecls ix owner rest stop seen conLine
  end case
end function

function fieldNames (ix :: Ix) (owner :: Text) (f :: Syntax) (ns :: List Text) (doc :: DocText) (seen :: List Text) -> List Decl is
  first matching case of ns :
    when Nil then []
    when Cons n rest then
      (if validId n && !(seen contains n)
       then [let base = mkDecl (owner ++ "." ++ n) n KindField (locOf ix.path f f) owner doc in
               base with detail = (base.detail with typeText = textOf (childField f.children "type")) end let]
       else [] end if) ++ fieldNames ix owner f rest doc seen
  end case
end function

function namedNodes (n :: Text) (ns :: List Syntax) -> List Syntax is
  first matching case of ns : when Nil then [] when Cons nd rest then (if boundName nd = n then [nd] else [] end if) ++ namedNodes n rest end case
end function

-- A method's doc: the `-- |` above it, else the first `-- ^` below it at its
-- column and before the next member (R46).
function methodDoc (ix :: Ix) (s :: Syntax) (until :: Integer) -> DocText is
  let b = docBefore ix.docs (lineOf s.from) in
    (if b.raw != "" then b else docBetweenAt ix (lineOf s.to + 1) until (colOf s.from) end if)
  end let
end function

-- `defaults`: the class's default equations; a method's location runs
-- through its own.
function methodDecls (ix :: Ix) (owner :: Text) (ss :: List Syntax) (defaults :: List Syntax) (starts :: List Integer) (stop :: Integer) -> List Decl is
  first matching case of ss :
    when Nil then []
    when Cons s rest then
      methodNames ix owner s (namesOf s) defaults
        (first matching case of lowestIn starts (lineOf s.to + 1) stop Absent : when Absent then stop when Present k then k end case)
        ++ methodDecls ix owner rest defaults starts stop
  end case
end function

-- The lines where the members of a class body start (not its comments).
function memberStarts (cs :: List Syntax) -> List Integer is
  first matching case of cs :
    when Nil then []
    when Cons ch rest then (if ch.kind = "haddock" || ch.kind = "comment" then [] else [lineOf ch.from] end if) ++ memberStarts rest
  end case
end function

function methodNames (ix :: Ix) (owner :: Text) (s :: Syntax) (ns :: List Text) (defaults :: List Syntax) (until :: Integer) -> List Decl is
  first matching case of ns :
    when Nil then []
    when Cons n rest then
      (if validId n then
         [let base = mkDecl (owner ++ "." ++ n) n KindMethod (locOf ix.path s (lastNode (namedNodes n defaults) s)) owner (methodDoc ix s until) in
            base with detail = (base.detail with signature = (first matching case of childField s.children "type" : when Absent then Absent when Present t then Present (sigOfType t) end case)) end let]
       else [] end if) ++ methodNames ix owner s rest defaults until
  end case
end function

-- The superclasses a context names: the head of each top-level constraint
-- (`Eq a`, the parts of `(Eq a, Show a)`, `Foo (Bar a) a` names Foo).
function constraintHeads (cs :: List Syntax) -> List Text is
  first matching case of cs :
    when Nil then []
    when Cons nd rest then
      (if nd.kind = "apply" then headOf nd.children
       else (if nd.kind = "parens" || nd.kind = "tuple" || nd.kind = "context" then constraintHeads nd.children
             else (if nd.kind = "name" || nd.kind = "constructor" || nd.kind = "qualified" then [nd.text] else [] end if) end if) end if) ++ constraintHeads rest
  end case
end function

function headOf (cs :: List Syntax) -> List Text is
  first matching case of cs :
    when Nil then []
    when Cons nd rest then
      (if nd.field = "constructor" || nd.field = "function" then (if nd.kind = "apply" then headOf nd.children else [nd.text] end if) else headOf rest end if)
  end case
end function

function contextNames (mc :: Maybe Syntax) -> List Text is
  first matching case of mc : when Absent then [] when Present s then constraintHeads s.children end case
end function

function patBindDecls (ix :: Ix) (d :: Syntax) (ns :: List Text) -> List Decl is
  first matching case of ns :
    when Nil then []
    when Cons n rest then (if validId n then [mkDecl n n KindConst (locOf ix.path d d) "" (docBefore ix.docs (lineOf d.from))] else [] end if) ++ patBindDecls ix d rest
  end case
end function

function declsOf (ix :: Ix) (ds :: List Syntax) (seen :: KeyVal Text Bool) -> List Decl is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (if isValueNode d then
         (let name = boundName d in
           (if name = "" && d.kind = "bind" then
              -- a top-level pattern binding: a const for each variable (matrix T5)
              patBindDecls ix d (patternVars (emptyCtx unitValue) (childField d.children "pattern")) ++ declsOf ix rest seen
            else (if prelude.lookup name seen matches Present _ then declsOf ix rest seen
                  else valueDecl ix d ++ declsOf ix rest (prelude.put name true seen) end if) end if) end let)
       else typeDecls ix d ++ declsOf ix rest seen end if)
  end case
end function

-- One small function per declaration family (a deep nested definition
-- made `check` hang: LawSpec issue 17).
function gadtNames (ix :: Ix) (owner :: Text) (gc :: Syntax) (ns :: List Text) (doc :: DocText) -> List Decl is
  first matching case of ns :
    when Nil then []
    when Cons n rest then (if validId n then [mkDecl (owner ++ "." ++ n) n KindConstructor (locOf ix.path gc gc) owner doc] else [] end if) ++ gadtNames ix owner gc rest doc
  end case
end function

-- GADT constructors: one per name of `K1, K2 :: T` (matrix T10).
function gadtDecls (ix :: Ix) (owner :: Text) (cs :: List Syntax) (stop :: Integer) (seen :: List Text) (declLine :: Integer) -> List Decl is
  first matching case of cs :
    when Nil then []
    when Cons gc rest then
      (let fields = findAll "field" gc.children in
        (let next = (first matching case of rest : when Nil then stop when Cons n more then lineOf n.from end case) in
          gadtNames ix owner gc (namesOf gc)
              (orBefore ix (docBetween ix.docs (lineOf gc.from) (first matching case of fields : when Nil then next when Cons f more then lineOf f.from end case)) (lineOf gc.from) declLine)
            ++ fieldDecls ix owner fields next seen (lineOf gc.from)
         end let) end let) ++ gadtDecls ix owner rest stop (seen ++ fieldsNamed (findAll "field" gc.children)) declLine
  end case
end function

function gadtsOf (d :: Syntax) -> List Syntax is
  first matching case of childField d.children "constructors" : when Absent then [] when Present cs then allKind cs.children "gadt_constructor" end case
end function

-- A data type's constructors and fields, owned by `owner`.
function consDecls (ix :: Ix) (owner :: Text) (d :: Syntax) -> List Decl is
  conDecls ix owner (consOf d) (lineOf d.to + 1) [] (lineOf d.from) ++ gadtDecls ix owner (gadtsOf d) (lineOf d.to + 1) [] (lineOf d.from)
end function

function dataDecls (ix :: Ix) (d :: Syntax) (t :: Text) -> List Decl is
  if isTypeData d then typeDataDecls ix d t else [dataTypeDecl ix d t] ++ consDecls ix t d end if
end function

-- `type data T = K …` (R39, O16): a type of kind `type`, and each constructor a
-- type `T.K` it owns. Nothing of it is a term.
function isTypeData (d :: Syntax) -> Bool is d.kind = "data_type" && prelude.startsWith d.text "type" end function

function asTypeData (ds :: List Decl) -> List Decl is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      (if d.kind = KindConstructor then [d with kind = KindType , detail = (d.detail with typeKind = "type-data-constructor")] else [] end if) ++ asTypeData rest
  end case
end function

function typeDataDecls (ix :: Ix) (d :: Syntax) (t :: Text) -> List Decl is
  let base = mkDecl t t KindType (locOf ix.path d d) "" (docBefore ix.docs (lineOf d.from)) in
    [base with detail = (base.detail with typeKind = "type-data")] ++ asTypeData (consDecls ix t d)
  end let
end function

-- The classes a type's deriving clauses name, as written.
function derivedOf (ds :: List Syntax) -> List Text is
  first matching case of ds :
    when Nil then []
    when Cons dv rest then constraintHeads (allField dv.children "classes") ++ derivedOf rest
  end case
end function

function dataTypeDecl (ix :: Ix) (d :: Syntax) (t :: Text) -> Decl is
  let base = mkDecl t t KindType (locOf ix.path d d) "" (docBefore ix.docs (lineOf d.from)) in
    base with detail = (base.detail with typeKind = (if d.kind = "newtype" then "newtype" else "data" end if) ,
                                         binary = (noBinary unitValue with implements = derivedOf (allField d.children "deriving")))
  end let
end function

-- A data type's constructors (GADT constructors are out of scope: only
-- `data_constructor` nodes are read).
function consOf (d :: Syntax) -> List Syntax is
  if d.kind = "newtype" then allKind (allField d.children "constructor") "newtype_constructor"
  else (first matching case of childField d.children "constructors" : when Absent then [] when Present cs then allKind (allField cs.children "constructor") "data_constructor" end case) end if
end function

function synDecl (ix :: Ix) (d :: Syntax) (t :: Text) -> Decl is
  let base = mkDecl t t KindType (locOf ix.path d d) "" (docBefore ix.docs (lineOf d.from)) in
    base with detail = (base.detail with typeKind = "synonym" , underlying = textOf (childField d.children "type"))
  end let
end function

function classDecl (ix :: Ix) (d :: Syntax) (t :: Text) -> Decl is
  let base = mkDecl t t KindClass (locOf ix.path d d) "" (docBefore ix.docs (lineOf d.from)) in
    base with detail = (base.detail with typeKind = "typeclass" , binary = (noBinary unitValue with extends = contextNames (childField d.children "context")))
  end let
end function

function classMethods (d :: Syntax) -> List Syntax is
  first matching case of childField d.children "declarations" : when Absent then [] when Present b then rightOf (colOf d.from) (allKind b.children "signature") end case
end function

-- Members that start right of the class keyword. Valid layout allows no
-- other; F87 nests later top-level declarations in the class (review 3).
function rightOf (col :: Integer) (ss :: List Syntax) -> List Syntax is
  first matching case of ss :
    when Nil then []
    when Cons s rest then (if colOf s.from > col then [s] else [] end if) ++ rightOf col rest
  end case
end function

-- An instance-like id: the keyword, the name and the type patterns, as
-- written, with single spaces.
function headed (kw :: Text) (t :: Text) (d :: Syntax) -> Text is
  normalized (kw ++ t ++ " " ++ prelude.join " " (textsOf (first matching case of childField d.children "patterns" : when Absent then [] when Present p then p.children end case)))
end function

function instanceId (d :: Syntax) (t :: Text) -> Text is headed "instance " t d end function

function instanceDecls (ix :: Ix) (d :: Syntax) (t :: Text) -> List Decl is
  if validId (instanceId d t) then [mkDecl (instanceId d t) (instanceId d t) KindInstance (locOf ix.path d d) "" (docBefore ix.docs (lineOf d.from))] else [] end if
end function

-- A data or newtype head written infix (``data a `T` b``, `data a :* b`)
-- names the type by its operator (review 5, S6).
-- A declaration's name; a head written infix (``data a `T` b``, `data a :* b`,
-- `type a ++ b = …`) is named by its operator (review 5, S6).
function infixHead (i :: Syntax) -> Text is
  first matching case of childField i.children "operator" :
    when Absent then ""
    when Present o then (if o.kind = "infix_id" then textOf (childKind o.children "name") else o.text end if)
  end case
end function

-- A head in parentheses holds the infix: `data (a :% b) = …` (R38).
function parenHead (d :: Syntax) -> Text is
  first matching case of childKind d.children "parens" :
    when Absent then ""
    when Present p then (first matching case of childKind p.children "infix" : when Absent then "" when Present i then infixHead i end case)
  end case
end function

function headName (d :: Syntax) -> Text is
  first matching case of childField d.children "name" :
    when Present n then n.text
    when Absent then
      (first matching case of childKind d.children "infix" :
         when Absent then parenHead d
         when Present i then infixHead i
       end case)
  end case
end function

-- Type and data families; inside a class, `C.T` owned by the class.
function famDecls (ix :: Ix) (owner :: Text) (d :: Syntax) -> List Decl is
  if !(d.kind = "type_family" || d.kind = "data_family") || !(validId (headName d)) then [] else
    [let base = mkDecl (if owner = "" then headName d else owner ++ "." ++ headName d end if) (headName d) KindType (locOf ix.path d d) owner (docBefore ix.docs (lineOf d.from)) in
       base with detail = (base.detail with typeKind =
         (if d.kind = "data_family" then "data-family"
          else (if childField d.children "closed_family" matches Present _ then "closed-type-family" else "type-family" end if) end if)) end let]
  end if
end function

function famsIn (ix :: Ix) (owner :: Text) (cs :: List Syntax) -> List Decl is
  first matching case of cs : when Nil then [] when Cons ch rest then famDecls ix owner ch ++ famsIn ix owner rest end case
end function

-- `type instance F Int = Bool`: an instance whose `underlying` is its
-- right-hand side (its last child, which has no field).
function tyInstDecls (ix :: Ix) (owner :: Text) (d :: Syntax) -> List Decl is
  if d.kind != "type_instance" || !(validId (headed "type instance " (headName d) d)) || !(validId (headName d)) then [] else
    [let base = mkDecl (headed "type instance " (headName d) d) (headed "type instance " (headName d) d) KindInstance (locOf ix.path d d) owner (docBefore ix.docs (lineOf d.from)) in
       base with detail = (base.detail with underlying = (let r = lastNode d.children d in (if r.field = "" && r.text != d.text then r.text else "" end if) end let)) end let]
  end if
end function

-- `data instance D Int = …` / `newtype instance …`: an instance, and its
-- constructors and fields under the family (`prefix`: the class of an
-- associated family, as `C.`).
function dataInstOf (ix :: Ix) (owner :: Text) (prefix :: Text) (d :: Syntax) (inner :: Syntax) -> List Decl is
  let t = headName inner in
  let id = headed (if inner.kind = "newtype" then "newtype instance " else "data instance " end if) t inner in
    (if !(validId t) || !(validId id) then []
     else [let base = mkDecl id id KindInstance (locOf ix.path d d) owner (docBefore ix.docs (lineOf d.from)) in
             base with detail = (base.detail with binary = (noBinary unitValue with implements = derivedOf (allField inner.children "deriving"))) end let]
            ++ consDecls ix (prefix ++ t) inner end if)
  end let end let
end function

function dataInstDecls (ix :: Ix) (owner :: Text) (prefix :: Text) (d :: Syntax) -> List Decl is
  if d.kind != "data_instance" then [] else
    (first matching case of childKind d.children "data_type" :
      when Present inner then dataInstOf ix owner prefix d inner
      when Absent then (first matching case of childKind d.children "newtype" : when Absent then [] when Present inner then dataInstOf ix owner prefix d inner end case)
    end case)
  end if
end function

-- The associated instances in an instance body, owned by the instance.
function assocInsts (ix :: Ix) (inst :: Text) (cls :: Text) (cs :: List Syntax) -> List Decl is
  first matching case of cs :
    when Nil then []
    when Cons ch rest then tyInstDecls ix inst ch ++ dataInstDecls ix inst (cls ++ ".") ch ++ assocInsts ix inst cls rest
  end case
end function

function bodyAll (d :: Syntax) -> List Syntax is
  first matching case of childField d.children "declarations" : when Absent then [] when Present b then rightOf (colOf d.from) b.children end case
end function

-- Each field is located at its own `field_pattern` (R40).
function synFieldDecls (ix :: Ix) (owner :: Text) (fps :: List Syntax) -> List Decl is
  first matching case of fps :
    when Nil then []
    when Cons fp rest then
      (first matching case of childField fp.children "field" :
         when Absent then []
         when Present fl then
           (let n = fieldOrName fl in
             (if validId n then [mkDecl (owner ++ "." ++ n) n KindField (locOf ix.path fp fp) owner (DocText record{ raw = "" , format = NoDoc})] else [] end if)
           end let)
       end case) ++ synFieldDecls ix owner rest
  end case
end function

function synFieldPats (m :: Maybe Syntax) -> List Syntax is
  first matching case of m :
    when Absent then []
    when Present sy then (if sy.kind = "record" then allKind sy.children "field_pattern" else [] end if)
  end case
end function

-- A pattern synonym: a constructor with no owner, from its signature (if
-- written first) through its equation; its record form's fields (matrix T16).
function patSynDecls (ix :: Ix) (d :: Syntax) -> List Decl is
  if d.kind != "pattern_synonym" || !(childKind d.children "equation" matches Present _) || !(validId (synName (synonymOf d))) then [] else
    (let name = synName (synonymOf d) in
     let start = (first matching case of prelude.lookup name ix.sigs : when Absent then d when Present g then (if lineOf g.from <= lineOf d.from then g else d end if) end case) in
       [mkDecl name name KindConstructor (locOf ix.path start d) "" (docBefore ix.docs (lineOf start.from))] ++ synFieldDecls ix name (synFieldPats (synonymOf d))
     end let end let)
  end if
end function

-- A foreign import declares a Haskell name with a type and no body (matrix T17).
function foreignDecls (ix :: Ix) (d :: Syntax) -> List Decl is
  if d.kind != "foreign_import" then [] else
    (first matching case of childField d.children "signature" :
      when Absent then []
      when Present sg then
        (let n = (first matching case of childField sg.children "name" : when Absent then "" when Present nn then nameText nn end case) in
         let ty = childField sg.children "type" in
         let fun = (first matching case of ty : when Absent then false when Present t then (coreType t).kind = "function" end case) in
           (if !(validId n) then [] else
             [let base = mkDecl n n (if fun then KindFunction else KindConst end if) (locOf ix.path d d) "" (docBefore ix.docs (lineOf d.from)) in
                base with detail = (base.detail with
                                      signature = (if fun then (first matching case of ty : when Absent then Absent when Present t then Present (sigOfType t) end case) else Absent end if) ,
                                      typeText = (if fun then "" else textOf ty end if)) end let] end if)
         end let end let end let)
    end case)
  end if
end function

function classLike (ix :: Ix) (d :: Syntax) (t :: Text) -> List Decl is
  [classDecl ix d t] ++ famsIn ix t (bodyAll d) ++ methodDecls ix t (classMethods d) (bodyNodes d) (memberStarts (bodyAll d)) (lineOf d.to + 1)
end function

function instLike (ix :: Ix) (d :: Syntax) (t :: Text) -> List Decl is
  instanceDecls ix d t ++ (if d.kind = "instance" && validId (instanceId d t) then assocInsts ix (instanceId d t) t (bodyAll d) else [] end if)
end function

function typeDecls (ix :: Ix) (d :: Syntax) -> List Decl is
  let t = headName d in
    (first matching case of d :
      when record{} if (d.kind = "data_type" || d.kind = "newtype") && validId t then dataDecls ix d t
      when record{} if d.kind = "type_synomym" && validId t then [synDecl ix d t]
      when record{} if d.kind = "class" && validId t then classLike ix d t
      when record{} if (d.kind = "instance" || d.kind = "deriving_instance") && validId t then instLike ix d t
      otherwise famDecls ix "" d ++ tyInstDecls ix "" d ++ dataInstDecls ix "" "" d ++ patSynDecls ix d ++ foreignDecls ix d
    end case)
  end let
end function

-- Calls of each value binding: every equation of its name, walked in scope.
-- The grammar's `char` rule can run over several literals (`'\r','\n'`
-- read as one token; matrix S1): a valid literal has no `'` inside, but for `'\''`.
function badChar (ch :: Syntax) -> Bool is
  (prelude.slice 1 (prelude.length ch.text - 1) ch.text contains "'") && ch.text != "'\\''"
end function

-- Calls of each symbol: the nodes the index holds for its id, walked in
-- scope. A value with a bad `char` token starts wild: the token may hide a
-- binding.
function withCalls (x :: Ctx) (ix :: Ix) (decls :: List Decl) -> List Decl is
  first matching case of decls :
    when Nil then []
    when Cons d rest then
      [(let nodes = listAt ix.eqs d.id in
         (if nodes = [] then d
          else d with calls = merged (walk x (if prelude.any badChar (findAll "char" nodes) then ["#wild"] else [] end if) WPlain nodes) end if)
        end let)] ++ withCalls x ix rest
  end case
end function

-- ---------------------------------------------------------------------------
-- Visibility, from the export list.

function ownedIndex (decls :: List Decl) (acc :: KeyVal Text (List Text)) -> KeyVal Text (List Text) is
  first matching case of decls :
    when Nil then acc
    when Cons d rest then
      ownedIndex rest
        (if d.owner = "" then acc
         else prelude.put d.owner ((first matching case of prelude.lookup d.owner acc : when Absent then [] when Present l then l end case) ++ [d.id]) acc end if)
  end case
end function

-- A field, a method or an associated family can be exported by its own
-- name (`module M (fld, m, Elem)`).
function memberIndex (decls :: List Decl) (acc :: KeyVal Text (List Text)) -> KeyVal Text (List Text) is
  first matching case of decls :
    when Nil then acc
    when Cons d rest then
      memberIndex rest
        (if d.kind = KindField || d.kind = KindMethod || (d.kind = KindType && d.owner != "")
         then prelude.put d.name ((first matching case of prelude.lookup d.name acc : when Absent then [] when Present l then l end case) ++ [d.id]) acc
         else acc end if)
  end case
end function

-- Constructor ids by name; `onlyLoose`: only those without an owner (pattern synonyms).
function conIndex (decls :: List Decl) (onlyLoose :: Bool) (acc :: KeyVal Text (List Text)) -> KeyVal Text (List Text) is
  first matching case of decls :
    when Nil then acc
    when Cons d rest then
      conIndex rest onlyLoose
        (if d.kind = KindConstructor && (!onlyLoose || d.owner = "")
         then prelude.put d.name ((first matching case of prelude.lookup d.name acc : when Absent then [] when Present l then l end case) ++ [d.id]) acc
         else acc end if)
  end case
end function

function idsAt (kv :: KeyVal Text (List Text)) (k :: Text) -> List Text is
  first matching case of prelude.lookup k kv : when Absent then [] when Present l then l end case
end function

-- An exported name: `M.f` in M's own export list is M's `f` (Haskell 2010,
-- 5.2; corpus check C2); any other qualifier names another module's.
function exportName (self :: Text) (v :: Syntax) -> Text is
  if v.kind = "qualified" && moduleText (childField v.children "module") = self then textOf (childField v.children "id") else v.text end if
end function

-- A type export: each id the name stands for (itself; an associated
-- family's `C.T`), with the members its child list names.
function exportTypes (owned :: KeyVal Text (List Text)) (loose :: KeyVal Text (List Text)) (kids :: Maybe Syntax) (tids :: List Text) -> List Text is
  first matching case of tids :
    when Nil then []
    when Cons tid rest then
      [tid] ++ (first matching case of kids :
                  when Absent then []
                  when Present ch then
                    (if childKind ch.children "all_names" matches Present _ then idsAt owned tid else [] end if)
                      ++ prefixed tid (memberTexts ch.children) ++ bundled loose ch.children
                end case) ++ exportTypes owned loose kids rest
  end case
end function

-- The ids a namespace wildcard exports (G4, O40): `type ..` every type and
-- class (an associated family and a `type data` constructor included),
-- `data ..` every term, constructor, field, method and pattern synonym.
function wildKinds (ns :: Text) (d :: Decl) -> Bool is
  if ns = "type" then d.kind = KindType || d.kind = KindClass
  else (ns = "data" && (d.kind = KindFunction || d.kind = KindConst || d.kind = KindConstructor || d.kind = KindField || d.kind = KindMethod)) end if
end function

function wildIds (ns :: Text) (ds :: List Decl) -> List Text is
  first matching case of ds : when Nil then [] when Cons d rest then (if wildKinds ns d then [d.id] else [] end if) ++ wildIds ns rest end case
end function

function wildExports (ds :: List Decl) (es :: List Syntax) -> List Text is
  first matching case of es :
    when Nil then []
    when Cons e rest then
      (if childField e.children "wildcard" matches Present _ then wildIds (textOf (childField e.children "namespace")) ds else [] end if) ++ wildExports ds rest
  end case
end function

function exportIds (self :: Text) (owned :: KeyVal Text (List Text)) (members :: KeyVal Text (List Text)) (ctors :: KeyVal Text (List Text)) (loose :: KeyVal Text (List Text)) (es :: List Syntax) -> List Text is
  first matching case of es :
    when Nil then []
    when Cons e rest then
      (let ns = textOf (childField e.children "namespace") in
        (if ns = "default" then []
         else
           (first matching case of childField e.children "variable" :
             when Present v then [exportName self v] ++ idsAt members (exportName self v)
             when Absent then
               (first matching case of childField e.children "operator" :
                 when Present o then
                   (if ns = "data" || ns = "pattern" then [nameText o] ++ idsAt members (nameText o) ++ idsAt ctors (nameText o)
                    else exportTypes owned loose (childField e.children "children") ([nameText o] ++ idsAt members (nameText o)) end if)
                 when Absent then
                   (let t = textOf (childField e.children "type") in
                     (if ns = "data" || ns = "pattern" then idsAt ctors t
                      else exportTypes owned loose (childField e.children "children") ([t] ++ idsAt members t) end if) end let)
               end case)
           end case) end if) end let) ++ exportIds self owned members ctors loose rest
  end case
end function

-- The names in `T(..)`-style child lists: an operator member is written
-- `(<+>)` or `(:+:)`, a `prefix_id` named by its operator (review 4, S1;
-- review 5).
function memberTexts (cs :: List Syntax) -> List Text is
  first matching case of cs :
    when Nil then []
    when Cons nd rest then (if nd.kind = "all_names" then [] else [elemName nd] end if) ++ memberTexts rest
  end case
end function

-- A child-list element's name: `data K` (an associated_data) holds it in `name`.
function elemName (nd :: Syntax) -> Text is
  if nd.kind = "associated_data" then (first matching case of childField nd.children "name" : when Present n then nameText n when Absent then nd.text end case) else nameText nd end if
end function

-- The ownerless constructors (pattern synonyms) a child list bundles with `data P`.
function bundled (loose :: KeyVal Text (List Text)) (cs :: List Syntax) -> List Text is
  first matching case of cs :
    when Nil then []
    when Cons nd rest then (if nd.kind = "associated_data" then idsAt loose (elemName nd) else [] end if) ++ bundled loose rest
  end case
end function

function prefixed (owner :: Text) (ns :: List Text) -> List Text is
  first matching case of ns : when Nil then [] when Cons n rest then [owner ++ "." ++ n] ++ prefixed owner rest end case
end function

function setOf (ids :: List Text) (acc :: KeyVal Text Bool) -> KeyVal Text Bool is
  first matching case of ids : when Nil then acc when Cons i rest then setOf rest (prelude.put i true acc) end case
end function

function withVisibility (exported :: Maybe (KeyVal Text Bool)) (ds :: List Decl) -> List Decl is
  first matching case of ds :
    when Nil then []
    when Cons d rest then
      [d with visibility = (if d.kind = KindInstance then Exported else
                              (first matching case of exported : when Absent then Exported when Present ids then (if prelude.lookup d.id ids matches Present _ then Exported else Unexported end if) end case) end if)]
        ++ withVisibility exported rest
  end case
end function

function markMain (inv :: Invocation) (ds :: List Decl) -> List Decl is
  first matching case of ds :
    when Nil then []
    when Cons d rest then [(if d.id = "main" then d with entry = EntryPoint record{ isEntrypoint = true , invocation = Present inv} else d end if)] ++ markMain inv rest
  end case
end function

function hasMain (ds :: List Decl) -> Bool is
  first matching case of ds : when Nil then false when Cons d rest then d.id = "main" || hasMain rest end case
end function

function topIndex (ds :: List Decl) (acc :: KeyVal Text Text) -> KeyVal Text Text is
  first matching case of ds :
    when Nil then acc
    when Cons d rest then
      topIndex rest
        (if (d.kind = KindFunction || d.kind = KindConst || d.kind = KindConstructor || d.kind = KindMethod || d.kind = KindField) && !(prelude.lookup d.name acc matches Present _)
         then prelude.put d.name d.id acc else acc end if)
  end case
end function

-- ---------------------------------------------------------------------------
-- The module.

-- A syntax error can root the parse in ERROR, the header one level down
-- (review 3, S-2).
function headerOf (root :: Syntax) -> Maybe Syntax is
  first matching case of childKind root.children "header" :
    when Present h then Present h
    when Absent then (first matching case of childKind root.children "ERROR" : when Absent then Absent when Present e then childKind e.children "header" end case)
  end case
end function

function moduleIdOf (root :: Syntax) -> Text is
  first matching case of headerOf root :
    when Absent then "Main"
    when Present h then (let t = moduleText (childField h.children "module") in (if validId t then t else "Main" end if) end let)
  end case
end function

function moduleNameOf (root :: Syntax) -> Text is
  first matching case of headerOf root :
    when Absent then "Main"
    when Present h then
      (first matching case of childField h.children "module" :
        when Absent then "Main"
        when Present m then (let t = lastText m.children m.text in (if t = "" then "Main" else t end if) end let)
      end case)
  end case
end function

-- The export list as ids; a headerless module means `module Main (main)
-- where` (Haskell report; spec amendment 2026-11-07).
-- `module M` in M's own export list exports everything M defines (Haskell
-- 2010, 5.2; review 4, B1). Another module's name re-exports, adding none of
-- M's own.
function selfExport (self :: Text) (m :: Syntax) -> Bool is moduleText (childField m.children "module") = self end function

function exportedOf (root :: Syntax) (decls :: List Decl) -> Maybe (KeyVal Text Bool) is
  first matching case of headerOf root :
    when Absent then Present (setOf ["main"] (prelude.keyValOf []))
    when Present h then
      (first matching case of childField h.children "exports" :
        when Absent then Absent
        when Present e then
          (if prelude.any (selfExport (moduleIdOf root)) (allKind e.children "module_export") then Absent
           else Present (setOf (exportIds (moduleIdOf root) (ownedIndex decls (prelude.keyValOf [])) (memberIndex decls (prelude.keyValOf [])) (conIndex decls false (prelude.keyValOf [])) (conIndex decls true (prelude.keyValOf [])) (allField e.children "export") ++ wildExports decls (allField e.children "export")) (prelude.keyValOf [])) end if)
      end case)
  end case
end function

function moduleDocOf (root :: Syntax) (docs :: Docs) -> Text is
  first matching case of headerOf root : when Absent then "" when Present h then (docBefore docs (lineOf h.from)).raw end case
end function

function noPreludePragma (p :: Syntax) -> Bool is p.text contains "NoImplicitPrelude" || p.text contains "RebindableSyntax" end function

function noPreludeOf (root :: Syntax) -> Bool is prelude.any noPreludePragma (allKind root.children "pragma") end function

function declarationsOf (root :: Syntax) -> List Syntax is
  first matching case of childField root.children "declarations" : when Absent then [] when Present d then d.children end case
end function

function importsIn (root :: Syntax) -> List Import is
  first matching case of childField root.children "imports" : when Absent then [] when Present i then importsOf (allKind i.children "import") end case
end function

function indexOf (path :: Text) (root :: Syntax) -> Ix is
  let nodes = docNodes (linesOf root.text) root.children 0 in
    Ix record{ path = path ,
               docs = docsOf nodes (codeLines root.children (prelude.keyValOf [])) (lineOf root.to) (Docs record{ before = prelude.keyValOf [] , after = prelude.keyValOf []}) ,
               sigs = signaturesIndex (declarationsOf root) (prelude.keyValOf []) ,
               eqs = equationsIndex (declarationsOf root) (prelude.keyValOf []) ,
               afterCols = afterCols nodes (prelude.keyValOf [])}
  end let
end function

function contextOf (root :: Syntax) (base :: List Decl) -> Ctx is
  Ctx record{ moduleId = moduleIdOf root , tops = topIndex base (prelude.keyValOf []) , imports = importsIn root , noPrelude = noPreludeOf root , conFields = conFieldsIn (declarationsOf root) (prelude.keyValOf []) , recordDot = recordDotIn (allKind root.children "pragma") false}
end function

-- Whether the file turns OverloadedRecordDot on, and does not turn it off after (R52).
function recordDotIn (ps :: List Syntax) (on :: Bool) -> Bool is
  first matching case of ps :
    when Nil then on
    when Cons p rest then
      recordDotIn rest (if p.text contains "NoOverloadedRecordDot" then false else (if p.text contains "OverloadedRecordDot" then true else on end if) end if)
  end case
end function

-- Without OverloadedRecordDot, `a.b` and `(.b)` are composition (R52): one
-- edge for `.` per dot, by the operator ladder; the label is an operand.
function dotEdges (x :: Ctx) (locals :: List Text) (fs :: List Syntax) -> List CallEdge is
  first matching case of fs : when Nil then [] when Cons fl rest then [varEdge x locals "."] ++ dotEdges x locals rest end case
end function

function packageOf (path :: Text) (root :: Syntax) (ix :: Ix) (decls :: List Decl) -> Package is
  Package record{ id = moduleIdOf root , language = "haskell" , path = path , name = moduleNameOf root ,
                  doc = moduleDocOf root ix.docs , level = "module" , members = [] ,
                  isEntrypoint = isEntry root decls ,
                  invocation = (if isEntry root decls then Present (Invocation record{ kind = "binary" , how = "runghc " ++ path}) else Absent end if) ,
                  symbols = (if isEntry root decls then markMain (Invocation record{ kind = "binary" , how = "runghc " ++ path}) decls else decls end if)}
end function

-- A line of the source that starts with `module ` (C1). The header the
-- grammar finds is the truth; this only says one was written.
function hasModuleLine (source :: Text) -> Bool is
  prelude.startsWith source "module " || (source contains "\nmodule ") || prelude.startsWith source (byteOrderMark unitValue ++ "module ")
end function

-- No header found, yet the source has a `module` line: the parse lost it
-- (F90, or error recovery wrapping the file). Reading the module as
-- headerless would make it `Main`, exporting only `main`: a confident
-- mislabel. It is not reported (owner, 2026-11-11).
function lostHeader (root :: Syntax) -> Bool is !(headerOf root matches Present _) && hasModuleLine root.text end function

-- The module a file yields: none when its header was lost.
function moduleOf (path :: Text) (root :: Syntax) -> List Package is
  if lostHeader root then [] else [extractModule path root] end if
end function

function isEntry (root :: Syntax) (decls :: List Decl) -> Bool is (moduleIdOf root = "Main") && hasMain decls end function

function extractModule (path :: Text) (root :: Syntax) -> Package is
  let ix = indexOf path root in
  let base = declsOf ix (declarationsOf root) (prelude.keyValOf []) in
    packageOf path root ix (withVisibility (exportedOf root base) (withCalls (contextOf root base) ix base))
  end let end let
end function

-- Files the extractor reads: `.hs`, not under a dot-directory or a build
-- directory (`dist-newstyle/`, `dist/`; spec amendment 2026-11-07).
function skippedPath (p :: Text) -> Bool is
  (prelude.startsWith p "." && (p contains "/")) || (p contains "/.")
    || prelude.startsWith p "dist-newstyle/" || prelude.startsWith p "dist/" || (p contains "/dist-newstyle/") || (p contains "/dist/")
end function

-- CPP: every build is read (next-cycle-4/design.md, section 3, rules C1 to
-- C7). The source is read once into logical lines (a directive with its
-- continuations is one); each line gets the literals of its path; the terms,
-- the builds, the copies and every fact's condition fall out of those rows.

-- A literal: a term (one directive's condition as written; two directives
-- with the same text are one term), negated or not.
type CxTerm is a record{
  negated :: Bool
  text :: Text}
end type

-- A logical line: `nlines` physical lines; `word` is the directive word
-- ("" for a line of code) and `body` the rest of a directive, trimmed.
type CxUnit is a record{
  nlines :: Integer
  text :: Text
  word :: Text
  body :: Text
  pieces :: List CxPiece}
end type

-- Next cycle 8 (rules C10 to C13): a line of code as the preprocessor
-- lexes it, in pieces: an identifier, or a run of anything else (quotes
-- and what they hold included). Comments are not pieces.
type CxPiece is one of
  | PId of type Text
  | PTxt of type Text
end type

-- What a macro is, as the walk has it from the file's own lines.
type CxMacro is one of
  | MObj of type Text
  | MFun
  | MGone
end type

-- Next cycle 7 (rules C8, C9): what a `#define` or `#undef` line does to
-- the name it names. `XInt`: `#define N <an integer literal>`; `XOther`:
-- any other `#define N...` (no body, an argument list, another name, a
-- `u` suffix...): N is defined and ax reads no value of it; `XUnset`:
-- `#undef N`.
type CxSets is one of
  | XNothing
  | XInt of type Integer
  | XOther
  | XUnset
end type

type CxDef is a record{
  name :: Text
  sets :: CxSets
  body :: Text
  fun :: Bool}
end type

-- A row: one logical line. `word` is the directive word ("" for a line
-- of code), `line` its first physical line (from 1), `nlines` how many it
-- takes. For a line of code `text` is the line. For an `#if`, `#ifdef`,
-- `#ifndef`, `#elif`, `#elifdef` or `#elifndef` line `own` is its term
-- (a literal: the term's text, negated for `#ifndef` and `#elifndef`,
-- and the expression read from the text), `names` the identifiers it
-- reads (`defined` apart), `vals` those it reads as a value or calls, and
-- `parsed` whether its text is an expression ax reads. For a `#define`
-- or `#undef` line `name` and `sets` are what it does.
type CxRow is a record{
  nlines :: Integer
  line :: Integer
  word :: Text
  text :: Text
  own :: Literal
  names :: List Text
  vals :: List Text
  parsed :: Bool
  name :: Text
  sets :: CxSets
  body :: Text
  fun :: Bool
  pieces :: List CxPiece
  ids :: List Text
  cand :: Bool
  more :: Bool}
end type

-- The plan of a source: the copies (one per build), and what a fact's
-- condition is read from: the rows. `unread` is a source with more builds
-- than the cap.
type CxPlan is a record{
  copies :: List Text
  rows :: List CxRow
  unread :: Bool
  dn :: KeyVal Text Bool
  gv :: CxGiven
  gn :: KeyVal Text Binding
  hdr :: Integer
  cr :: Integer
  marked :: Bool
  fuel :: Integer}
end type

-- Rule C14: the names given, used only where a source has more builds
-- than the cap. `on` is false when no names were given.
type CxGiven is a record{
  on :: Bool
  env :: Env}
end type

-- Rule C17, C1, C12 (a) (cycle 10): the blanks of the preprocessor are
-- the blank, the tab, the form feed and the vertical tab.
function cxIsBlank (ch :: Text) -> Bool is ch = "\v" || ch = "\f" || ch = "\t" || ch = " " end function

function cxSkipBlanks (t :: Text) (fuel :: Integer) -> Text is
  if fuel <= 0 then t else (if cxIsBlank (prelude.take 1 t) then cxSkipBlanks (prelude.drop 1 t) (fuel - 1) else t end if) end if
end function

function cxTrimEnd (t :: Text) (fuel :: Integer) -> Text is
  if fuel <= 0 || prelude.length t = 0 then t
  else (if cxIsBlank (prelude.drop (prelude.length t - 1) t) then cxTrimEnd (prelude.take (prelude.length t - 1) t) (fuel - 1) else t end if) end if
end function

function cxTrim (t :: Text) -> Text is cxTrimEnd (cxSkipBlanks t (prelude.length t)) (prelude.length t) end function

function cxWordLen (t :: Text) (i :: Integer) (n :: Integer) -> Integer is
  if i >= n then i
  else (if (prelude.take 1 (prelude.drop i t)) matches regex "[A-Za-z0-9_]" then cxWordLen t (i + 1) n else i end if) end if
end function

-- The directive word of a line, "" when it is not a directive (C1): `#` in
-- column one, optional blanks, one of the words, whole.
function cxWordOf (l :: Text) -> Text is
  if prelude.startsWith l "#" then
    (let rest = cxSkipBlanks (prelude.drop 1 l) (prelude.length l) in
     let w = prelude.take (cxWordLen rest 0 (prelude.length rest)) rest in
       (if w matches regex "if|ifdef|ifndef|elif|elifdef|elifndef|else|endif|define|undef|include|error|warning|line|pragma" then w else "" end if)
     end let end let)
  else "" end if
end function

-- What follows the directive word, blanks trimmed.
function cxBodyOf (joined :: Text) -> Text is
  let rest = cxSkipBlanks (prelude.drop 1 joined) (prelude.length joined) in
    cxTrim (prelude.drop (cxWordLen rest 0 (prelude.length rest)) rest)
  end let
end function

type CxJoin is a record{
  nlines :: Integer
  text :: Text}
end type

-- A directive after its joins: `used` logical lines, `nlines` physical.
type CxDir is a record{
  used :: Integer
  nlines :: Integer
  text :: Text}
end type

-- A C comment is open at the end of the text: a `/*` with no `*/` after it.
function cxCommentOpen (t :: Text) (i :: Integer) (n :: Integer) (inside :: Bool) (fuel :: Integer) -> Bool is
  if fuel <= 0 || i >= n then inside
  else (if inside then
    (if prelude.take 2 (prelude.drop i t) = "*/" then cxCommentOpen t (i + 2) n false (fuel - 1) else cxCommentOpen t (i + 1) n true (fuel - 1) end if)
  else (if prelude.take 2 (prelude.drop i t) = "/*" then cxCommentOpen t (i + 2) n true (fuel - 1) else cxCommentOpen t (i + 1) n false (fuel - 1) end if) end if) end if
end function

-- The text ends with a backslash and then blanks only (a line splice).
function cxSpliced (t :: Text) -> Bool is prelude.endsWith (cxTrimEnd t (prelude.length t)) "\\" end function

function cxUnsplice (t :: Text) -> Text is
  let s = cxTrimEnd t (prelude.length t) in prelude.take (prelude.length s - 1) s end let
end function

-- Rule C17, the preprocessor's first step: a line whose last character is
-- a backslash (blanks and tabs after it apart) is joined with the next
-- line, whatever that line is: the backslash and what follows it go, the
-- next line's text stands in their place. The joined line stands for as
-- many physical lines as it took (`nlines`). The last line of the source
-- only loses its backslash.
function cxSpliceMore (acc :: Text) (n :: Integer) (rest :: List Text) (fuel :: Integer) -> CxJoin is
  if fuel <= 0 || !(cxSpliced acc) then CxJoin record{ nlines = n , text = acc}
  else
    (first matching case of rest :
      when Nil then CxJoin record{ nlines = n , text = acc}
      when Cons next more then cxSpliceMore (cxUnsplice acc ++ next) (n + 1) more (fuel - 1)
    end case)
  end if
end function

function cxSplice (ls :: List Text) (fuel :: Integer) -> List CxJoin is
  if fuel <= 0 then []
  else
    (first matching case of ls :
      when Nil then []
      when Cons l rest then
        (let j = cxSpliceMore l 1 rest (prelude.length rest + 1) in
          [j] ++ cxSplice (prelude.drop (j.nlines - 1) rest) (fuel - 1) end let)
    end case)
  end if
end function

-- A directive and its continuations (C1): a line that leaves a C comment
-- open goes on through the line that closes it, each line end inside the
-- comment one blank. A comment never closed runs to the end of the source.
function cxJoinMore (acc :: Text) (n :: Integer) (u :: Integer) (rest :: List CxJoin) (fuel :: Integer) -> CxDir is
  if fuel <= 0 then CxDir record{ used = u , nlines = n , text = acc}
  else
    (first matching case of rest :
      when Nil then CxDir record{ used = u , nlines = n , text = acc}
      when Cons next more then
        (if cxCommentOpen acc 0 (prelude.length acc) false (prelude.length acc + 1) then cxJoinMore (acc ++ " " ++ next.text) (n + next.nlines) (u + 1) more (fuel - 1)
         else CxDir record{ used = u , nlines = n , text = acc} end if)
    end case)
  end if
end function

function cxJoin (l :: CxJoin) (rest :: List CxJoin) -> CxDir is cxJoinMore l.text l.nlines 1 rest (prelude.length rest + 1) end function

function cxChAt (t :: Text) (i :: Integer) -> Text is prelude.take 1 (prelude.drop i t) end function

function cxFlushRun (run :: Text) (rest :: List CxPiece) -> List CxPiece is
  if prelude.length run = 0 then rest else [PTxt run] ++ rest end if
end function

type CxLexed is a record{
  pieces :: List CxPiece
  open :: Bool}
end type

-- Rules C10 and C13: the text from index i, lexed as `cpp -traditional`
-- lexes it. From the left: a line end ends a quote; in a quote a
-- backslash takes the next character with it; outside one, `/*` opens a
-- C comment, which is removed (an unclosed one runs to the end of the
-- text: `open`), `'` and `"` open a quote, and an identifier is the
-- longest run of letters, digits and `_` that starts with a letter or
-- `_` where the scan stands.
function cxLexAt (t :: Text) (i :: Integer) (n :: Integer) (quote :: Text) (run :: Text) (fuel :: Integer) -> CxLexed is
  if i >= n || fuel <= 0 then CxLexed record{ pieces = cxFlushRun run [] , open = false}
  else
    (let ch = cxChAt t i in
      (if ch = "\n" then cxLexAt t (i + 1) n "" run (fuel - 1)
       else (if prelude.length quote > 0 then
         (if ch = "\\" && i + 1 < n && !(cxChAt t (i + 1) = "\n")
          then cxLexAt t (i + 2) n quote (run ++ prelude.take 2 (prelude.drop i t)) (fuel - 1)
          else cxLexAt t (i + 1) n (if ch = quote then "" else quote end if) (run ++ ch) (fuel - 1) end if)
       else (if prelude.take 2 (prelude.drop i t) = "/*" then
         (let e = wn.commentEnd t (i + 2) n in
           (if e < 0 then CxLexed record{ pieces = cxFlushRun run [] , open = true}
            else cxLexAt t e n "" run (fuel - 1) end if) end let)
       else (if ch = "'" || ch = "\"" then cxLexAt t (i + 1) n ch (run ++ ch) (fuel - 1)
       else (if wn.isIdStart ch then
         (let e = wn.idLen t i n in
          let nxt = cxLexAt t e n "" "" (fuel - 1) in
            CxLexed record{ pieces = cxFlushRun run ([PId (prelude.take (e - i) (prelude.drop i t))] ++ nxt.pieces) , open = nxt.open} end let end let)
       else cxLexAt t (i + 1) n "" (run ++ ch) (fuel - 1) end if) end if) end if) end if) end if)
    end let)
  end if
end function

-- A line that continues a comment: it is lexed from the comment's end.
function cxLexResume (t :: Text) -> CxLexed is
  let n = prelude.length t in
  let e = wn.commentEnd t 0 n in
    (if e < 0 then CxLexed record{ pieces = [] , open = true}
     else cxLexAt t e n "" "" (n + 2) end if)
  end let end let
end function

function cxFlat (ps :: List CxPiece) -> Text is
  first matching case of ps :
    when Nil then ""
    when Cons p rest then (first matching case of p : when PId s then s when PTxt s then s end case) ++ cxFlat rest
  end case
end function

function cxIdsOf (ps :: List CxPiece) -> List Text is
  first matching case of ps :
    when Nil then []
    when Cons p rest then (first matching case of p : when PId s then [s] when PTxt s then [] end case) ++ cxIdsOf rest
  end case
end function

type CxExp is a record{
  need :: Text
  out :: Text
  mark :: Integer}
end type

type CxCode is a record{
  pieces :: List CxPiece
  nlines :: Integer
  used :: Integer}
end type

-- Rule C13: a code unit runs through the comment it opens, line after
-- line; what follows the `*/` is lexed on.
function cxCodeMore (acc :: List CxPiece) (n :: Integer) (u :: Integer) (rest :: List CxJoin) (fuel :: Integer) -> CxCode is
  if fuel <= 0 then CxCode record{ pieces = acc , nlines = n , used = u}
  else
    (first matching case of rest :
      when Nil then CxCode record{ pieces = acc , nlines = n , used = u}
      when Cons next more then
        (let lx = cxLexResume next.text in
          (if lx.open then cxCodeMore (acc ++ lx.pieces) (n + next.nlines) (u + 1) more (fuel - 1)
           else CxCode record{ pieces = acc ++ lx.pieces , nlines = n + next.nlines , used = u + 1} end if)
        end let)
    end case)
  end if
end function

function cxCodeUnit (l :: CxJoin) (rest :: List CxJoin) -> CxCode is
  let lx = cxLexAt l.text 0 (prelude.length l.text) "" "" (prelude.length l.text + 2) in
    (if lx.open then cxCodeMore lx.pieces l.nlines 1 rest (prelude.length rest + 1)
     else CxCode record{ pieces = lx.pieces , nlines = l.nlines , used = 1} end if)
  end let
end function

function cxUnits (ls :: List CxJoin) (fuel :: Integer) -> List CxUnit is
  if fuel <= 0 then []
  else
    (first matching case of ls :
      when Nil then []
      when Cons l rest then
        (let w = cxWordOf l.text in
          (if prelude.length w = 0 then
             (let cu = cxCodeUnit l rest in
               [CxUnit record{ nlines = cu.nlines , text = cxFlat cu.pieces , word = "" , body = "" , pieces = cu.pieces}]
                 ++ cxUnits (prelude.drop (cu.used - 1) rest) (fuel - 1) end let)
           else (let j = cxJoin l rest in
             [CxUnit record{ nlines = j.nlines , text = j.text , word = w , body = cxBodyOf j.text , pieces = []}] ++ cxUnits (prelude.drop (j.used - 1) rest) (fuel - 1) end let) end if)
        end let)
    end case)
  end if
end function

-- The first identifier of a text: its characters, "" when none starts it.
function cxIdent (t :: Text) -> Text is
  if (prelude.take 1 t) matches regex "[A-Za-z_]" then prelude.take (cxWordLen t 0 (prelude.length t)) t else "" end if
end function

-- Every comment of the text made one blank (an unclosed one runs to the end).
function cxFindOpen (t :: Text) (i :: Integer) (n :: Integer) -> Integer is
  if i + 1 >= n then 0 - 1 else (if prelude.take 2 (prelude.drop i t) = "/*" then i else cxFindOpen t (i + 1) n end if) end if
end function

function cxStrip (t :: Text) (fuel :: Integer) -> Text is
  if fuel <= 0 then t
  else
    (let n = prelude.length t in
     let i = cxFindOpen t 0 n in
       (if i < 0 then t
        else (let e = wn.commentEnd t (i + 2) n in
          prelude.take i t ++ " " ++ (if e < 0 then "" else cxStrip (prelude.drop e t) (fuel - 1) end if) end let) end if)
    end let end let)
  end if
end function

-- Every comment of the text removed, and nothing stands in its place.
function cxDecomment (t :: Text) (fuel :: Integer) -> Text is
  if fuel <= 0 then t
  else
    (let n = prelude.length t in
     let i = cxFindOpen t 0 n in
       (if i < 0 then t
        else (let e = wn.commentEnd t (i + 2) n in
          prelude.take i t ++ (if e < 0 then "" else cxDecomment (prelude.drop e t) (fuel - 1) end if) end let) end if)
    end let end let)
  end if
end function

-- The value of an integer literal with no `u` suffix (rule C8a): decimal,
-- `0x`, leading-0 octal; `l`, `L`, `ll`, `LL` after it.
function cxLitValue (s :: Text) -> Maybe Integer is
  let n = prelude.length s in
    (if s matches regex "0[xX][0-9a-fA-F]+(ll|LL|l|L)?" then Present (wn.numValue s 16 2 (wn.digitRun s 2 n true) 0)
     else (if s matches regex "[1-9][0-9]*(ll|LL|l|L)?" then Present (wn.numValue s 10 0 (wn.digitRun s 0 n false) 0)
     else (if s matches regex "0[0-7]*(ll|LL|l|L)?" then Present (wn.numValue s 8 0 (wn.digitRun s 0 n false) 0)
     else Absent end if) end if) end if)
  end let
end function

-- What follows the name in a `#define`: an argument list right after the
-- name, or a body that is not one integer literal, is `XOther`.
function cxBodySets (rest :: Text) -> CxSets is
  if prelude.startsWith rest "(" then XOther
  else
    (first matching case of cxLitValue (cxTrim rest) :
      when Present v then (if v > 18446744073709551615 then XOther else XInt v end if)
      when Absent then XOther
    end case)
  end if
end function

-- Rule C8a: the name is the first identifier after the word (comments
-- apart); a `#define` or `#undef` with no name does nothing.
function cxDefinition (word :: Text) (body :: Text) -> CxDef is
  if word = "define" || word = "undef" then
    (let b = cxTrim (cxStrip body (prelude.length body)) in
     let id = cxIdent b in
       (if prelude.length id = 0 then CxDef record{ name = "" , sets = XNothing , body = "" , fun = false}
        else (if word = "undef" then CxDef record{ name = id , sets = XUnset , body = "" , fun = false}
        else (let rest = prelude.drop (prelude.length id) b in
          CxDef record{ name = id , sets = cxBodySets rest ,
                        body = cxTrim (prelude.drop (prelude.length id) (cxTrim (cxDecomment body (prelude.length body)))) ,
                        fun = prelude.startsWith rest "("} end let) end if) end if)
    end let end let)
  else CxDef record{ name = "" , sets = XNothing , body = "" , fun = false} end if
end function
function cxIsIfWord (w :: Text) -> Bool is w = "if" || w = "ifdef" || w = "ifndef" end function
function cxIsElifWord (w :: Text) -> Bool is w = "elif" || w = "elifdef" || w = "elifndef" end function
function cxReadsWord (w :: Text) -> Bool is cxIsIfWord w || cxIsElifWord w end function

-- The term of a directive (C1, C7, C9): for `#ifdef`, `#ifndef`,
-- `#elifdef` and `#elifndef`, `defined(` and the first identifier of the
-- rest, or all of it when none starts it. A text whose parentheses do not
-- pair off cannot stand in a condition: it is the C string that names its
-- line. Its expression is the text as `wn.parseWhen` reads it (the
-- literal 0 where it does not).
function cxIsDefForm (word :: Text) -> Bool is word = "ifdef" || word = "ifndef" || word = "elifdef" || word = "elifndef" end function

function cxTextOf (word :: Text) (body :: Text) -> Text is
  let id = cxIdent body in
    (if cxIsDefForm word then "defined(" ++ (if prelude.length id = 0 then body else id end if) ++ ")" else body end if)
  end let
end function

function cxExprOf (text :: Text) -> Maybe CExpr is if wp.paired text then wn.parseWhen text else Absent end if end function

-- Rule C15. `closes`: the text starts with `(` and the first `)` that
-- brings the depth back to zero is its last character.
function cxCloseIdx (t :: Text) (i :: Integer) (n :: Integer) (d :: Integer) -> Integer is
  if i >= n then 0 - 1
  else
    (let ch = cxChAt t i in
     let d2 = (if ch = "(" then d + 1 else (if ch = ")" then d - 1 else d end if) end if) in
       (if d2 = 0 then i else cxCloseIdx t (i + 1) n d2 end if)
     end let end let)
  end if
end function

function cxClosesAtEnd (t :: Text) -> Bool is
  prelude.startsWith t "(" && cxCloseIdx t 0 (prelude.length t) 0 = prelude.length t - 1
end function

-- The name of a text that is exactly `defined N` or `defined ( N )`
-- (blanks allowed where C allows them), "" for any other text.
function cxDefinedName (s :: Text) -> Text is
  if !(prelude.startsWith s "defined") then ""
  else
    (let r = cxSkipBlanks (prelude.drop 7 s) (prelude.length s) in
     let gap = prelude.length r < prelude.length s - 7 in
       (if prelude.startsWith r "(" then
          (let r2 = cxSkipBlanks (prelude.drop 1 r) (prelude.length r) in
           let id = cxIdent r2 in
             (if prelude.length id > 0 && cxTrim (prelude.drop (prelude.length id) r2) = ")" then id else "" end if)
           end let end let)
        else
          (let id = cxIdent r in
            (if gap && prelude.length id > 0 && prelude.length id = prelude.length r then id else "" end if) end let) end if)
     end let end let)
  end if
end function

-- T is whole: a name, a name with one argument list that ends the text,
-- a `defined` form, a text in one pair of parentheses, or `!` and a
-- whole text.
function cxWhole (t :: Text) (fuel :: Integer) -> Bool is
  if fuel <= 0 then false
  else
    (let s = cxTrim t in
      (if prelude.startsWith s "!" && !(prelude.startsWith s "!=") then cxWhole (prelude.drop 1 s) (fuel - 1)
       else (if prelude.length (cxDefinedName s) > 0 then true
       else
         (let id = cxIdent s in
           (if prelude.length id > 0 then
              (let r = cxTrim (prelude.drop (prelude.length id) s) in prelude.length r = 0 || (prelude.startsWith r "(" && cxClosesAtEnd r) end let)
            else prelude.startsWith s "(" && cxClosesAtEnd s end if)
         end let) end if) end if)
    end let)
  end if
end function

type CxTied is a record{
  text :: Text
  negated :: Bool}
end type

function cxTieLoop (t :: Text) (neg :: Bool) (fuel :: Integer) -> CxTied is
  let n = prelude.length t in
    (if fuel <= 0 then CxTied record{ text = t , negated = neg}
     else (if prelude.startsWith t "(" && cxClosesAtEnd t && prelude.length (cxTrim (prelude.take (n - 2) (prelude.drop 1 t))) > 0
       then cxTieLoop (cxTrim (prelude.take (n - 2) (prelude.drop 1 t))) neg (fuel - 1)
     else (if prelude.startsWith t "!" && !(prelude.startsWith t "!=") && cxWhole (prelude.drop 1 t) (n + 1)
       then cxTieLoop (cxTrim (prelude.drop 1 t)) (!neg) (fuel - 1)
     else CxTied record{ text = (let d = cxDefinedName t in (if prelude.length d > 0 then "defined(" ++ d ++ ")" else t end if) end let) , negated = neg} end if) end if) end if)
  end let
end function

-- A text in a normal spelling: its outer parentheses and `!` taken off
-- (the term of what is left, negated for each `!`), `defined N` written
-- `defined(N)`. A text that holds a C comment is left as it is.
function cxTie (text :: Text) -> CxTied is
  let t = cxTrim text in
    (if (t contains "/*") || !(wp.paired t) then CxTied record{ text = t , negated = false}
     else cxTieLoop t false (prelude.length t + 1) end if)
  end let
end function

function cxExprOrZero (text :: Text) -> CExpr is
  first matching case of cxExprOf text : when Present e then e when Absent then Lit 0 end case
end function

function cxTermOf (word :: Text) (body :: Text) (line :: Integer) -> Literal is
  let text = cxTextOf word body in
    (if cxIsDefForm word then
       Literal record{ negated = (word = "ifndef" || word = "elifndef") ,
                       text = (if wp.paired text then text else wp.unreadableTerm line end if) , expr = cxExprOrZero text}
     else
       (if wp.paired text then
          (let tied = cxTie text in Literal record{ negated = tied.negated , text = tied.text , expr = cxExprOrZero tied.text} end let)
        else Literal record{ negated = false , text = wp.unreadableTerm line , expr = Lit 0} end if) end if)
  end let
end function
-- Every name an expression reads, as a value, under `defined`, or as a
-- macro it calls (GHC's version macro is written in terms of the three
-- version names).
function cxNamesOf (e :: CExpr) -> List Text is
  first matching case of e :
    when Lit n then []
    when ULit n then []
    when Name n then [n]
    when IsDefined n then [n]
    when Un u then cxNamesOf u.arg
    when Bin b then cxNamesOf b.left ++ cxNamesOf b.right
    when Cond k then cxNamesOf k.test ++ cxNamesOf k.yes ++ cxNamesOf k.no
    when MinVersion m then ["MIN_VERSION_" ++ m.pkg] ++ cxNamesOf m.major1 ++ cxNamesOf m.major2 ++ cxNamesOf m.minor
    when MinGhc m then
      ["MIN_VERSION_GLASGOW_HASKELL", "__GLASGOW_HASKELL__", "__GLASGOW_HASKELL_PATCHLEVEL1__", "__GLASGOW_HASKELL_PATCHLEVEL2__"]
        ++ cxNamesOf m.major1 ++ cxNamesOf m.major2 ++ cxNamesOf m.patch1 ++ cxNamesOf m.patch2
  end case
end function

-- The names read as a value or called: not those that stand only under
-- `defined`.
function cxValueNames (e :: CExpr) -> List Text is
  first matching case of e :
    when Lit n then []
    when ULit n then []
    when Name n then [n]
    when IsDefined n then []
    when Un u then cxValueNames u.arg
    when Bin b then cxValueNames b.left ++ cxValueNames b.right
    when Cond k then cxValueNames k.test ++ cxValueNames k.yes ++ cxValueNames k.no
    when MinVersion m then ["MIN_VERSION_" ++ m.pkg] ++ cxValueNames m.major1 ++ cxValueNames m.major2 ++ cxValueNames m.minor
    when MinGhc m then
      ["MIN_VERSION_GLASGOW_HASKELL", "__GLASGOW_HASKELL__", "__GLASGOW_HASKELL_PATCHLEVEL1__", "__GLASGOW_HASKELL_PATCHLEVEL2__"]
        ++ cxValueNames m.major1 ++ cxValueNames m.major2 ++ cxValueNames m.patch1 ++ cxValueNames m.patch2
  end case
end function

-- The identifiers of a text outside comments and character constants,
-- `defined` apart (rule C8b): for a text that is no expression ax reads.
function cxIdents (t :: Text) (fuel :: Integer) -> List Text is
  if fuel <= 0 || prelude.length t = 0 then []
  else
    (let n = prelude.length t in let ch = prelude.take 1 t in
      (if prelude.take 2 t = "/*" then
         (let e = wn.commentEnd t 2 n in (if e < 0 then [] else cxIdents (prelude.drop e t) (fuel - 1) end if) end let)
       else (if wn.isDigitCh ch then cxIdents (prelude.drop (wn.numLen t 0 n) t) (fuel - 1)
       else (if wn.isIdStart ch then
         (let e = wn.idLen t 0 n in
           (if prelude.take e t = "defined" then [] else [prelude.take e t] end if) ++ cxIdents (prelude.drop e t) (fuel - 1)
         end let)
       else (if ch = "'" then
         (let e = wn.quoteEnd t 1 n false in (if e < 0 then [] else cxIdents (prelude.drop e t) (fuel - 1) end if) end let)
       else cxIdents (prelude.drop 1 t) (fuel - 1) end if) end if) end if) end if)
    end let end let)
  end if
end function

function cxNoTerm (u :: Unit) -> Literal is Literal record{ negated = false , text = "" , expr = Lit 0} end function

function cxRowOf (u :: CxUnit) (line :: Integer) -> CxRow is
  if prelude.length u.word = 0 then
    CxRow record{ nlines = u.nlines , line = line , word = "" , text = u.text , own = cxNoTerm unitValue , names = [] , vals = [] , parsed = true ,
                  name = "" , sets = XNothing , body = "" , fun = false , pieces = u.pieces , ids = cxIdsOf u.pieces , cand = false , more = false}
  else
    (let d = cxDefinition u.word u.body in
     let t = cxTermOf u.word u.body line in
     let e = cxExprOf (cxTextOf u.word u.body) in
       (if cxReadsWord u.word then
         (first matching case of e :
           when Present x then
             CxRow record{ nlines = u.nlines , line = line , word = u.word , text = "" , own = t , names = cxNamesOf x , vals = cxValueNames x , parsed = true ,
                           name = "" , sets = XNothing , body = "" , fun = false , pieces = [] , ids = [] , cand = false , more = false}
           when Absent then
             CxRow record{ nlines = u.nlines , line = line , word = u.word , text = "" , own = t , names = cxIdents u.body (prelude.length u.body + 1) ,
                           vals = [] , parsed = false , name = "" , sets = XNothing , body = "" , fun = false , pieces = [] , ids = [] , cand = false , more = false}
         end case)
        else CxRow record{ nlines = u.nlines , line = line , word = u.word , text = "" , own = cxNoTerm unitValue , names = [] , vals = [] , parsed = true ,
                           name = d.name , sets = d.sets , body = d.body , fun = d.fun , pieces = [] , ids = [] , cand = false , more = false} end if)
    end let end let end let)
  end if
end function
-- `total`: the source's lines, a last empty one (after the final line
-- end) not counted; a row has `more` after it when it does not end on the
-- source's last line (rule C12 (a)).
function cxScan (us :: List CxUnit) (line :: Integer) (total :: Integer) -> List CxRow is
  first matching case of us :
    when Nil then []
    when Cons u rest then [(cxRowOf u line) with more = (line + u.nlines - 1 < total)] ++ cxScan rest (line + u.nlines) total
  end case
end function

-- Rule C12 (e): the preprocessor's own names, as GCC 15.2 replaces them
-- under `-undef -traditional`.
function cxOwnNames (u :: Unit) -> List Text is
  ["__has_include_next", "__has_include", "__has_feature", "__has_extension", "__has_embed", "__has_cpp_attribute", "__has_c_attribute", "__has_builtin",
   "__has_attribute", "__STDC_EMBED_NOT_FOUND__", "__STDC_EMBED_FOUND__", "__STDC_EMBED_EMPTY__", "__STDC_UTF_32__", "__STDC_UTF_16__", "__STDC_HOSTED__",
   "__STDC_VERSION__", "__FILE_NAME__", "__BASE_FILE__", "__INCLUDE_LEVEL__", "__COUNTER__", "__TIMESTAMP__", "__TIME__", "__DATE__", "__FILE__", "__LINE__"]
end function

-- Rule C12: every name some directive of the source reads, defines or
-- undefines.
function cxPutAll (ns :: List Text) (acc :: KeyVal Text Bool) -> KeyVal Text Bool is
  first matching case of ns : when Nil then acc when Cons n rest then cxPutAll rest (prelude.put n true acc) end case
end function

-- Rule C18: no own name is a name of the environment: none is asked for.
function cxNotOwn (ns :: List Text) -> List Text is
  first matching case of ns :
    when Nil then []
    when Cons n rest then (if (cxOwnNames unitValue) contains n then [] else [n] end if) ++ cxNotOwn rest
  end case
end function

function cxDirNames (rs :: List CxRow) (acc :: KeyVal Text Bool) -> KeyVal Text Bool is
  first matching case of rs :
    when Nil then acc
    when Cons r rest then cxDirNames rest (cxPutAll (cxNotOwn (r.names ++ (if prelude.length r.name > 0 then [r.name] else [] end if))) acc)
  end case
end function

function cxInDn (dn :: KeyVal Text Bool) (n :: Text) -> Bool is prelude.lookup n dn matches Present _ end function

-- A line of code that names one of those: the only lines whose text a
-- walk can change.
function cxCands (dn :: KeyVal Text Bool) (rs :: List CxRow) -> List CxRow is
  first matching case of rs :
    when Nil then []
    when Cons r rest then [(if prelude.length r.word = 0 && prelude.any (cxInDn dn) r.ids then r with cand = true else r end if)] ++ cxCands dn rest
  end case
end function



-- Rule C16: the names the names given define a value for.
function cxGivenNames (es :: List (Entry Text Binding)) -> List Text is
  first matching case of es :
    when Nil then []
    when Cons en rest then
      (first matching case of en :
        when Entry k v then (first matching case of v : when Defined x then [k] when Undefined then [] end case)
      end case) ++ cxGivenNames rest
  end case
end function

-- The names whose use in a line of code the walk looks at: the
-- directives' names, the preprocessor's own, the names given.
function cxWatch (dn :: KeyVal Text Bool) (gn :: KeyVal Text Binding) -> KeyVal Text Bool is
  cxPutAll (cxOwnNames unitValue ++ cxGivenNames (prelude.entries gn)) dn
end function

-- ---------------------------------------------------------------------------
-- Builds (C2, with C8). The walk of the preprocessor: the stack of open
-- groups and the names the file has defined or undefined so far. A build
-- gives a value (1 or 0) to every term of the environment it reads.

-- An open group: `live`, its current arm is being kept; `done`, an arm of
-- it has been taken, or the group stands in lines that are not kept.
type CxFrame is a record{
  live :: Bool
  done :: Bool}
end type

-- `mark`: the first line, in this build, that names a macro the walk does
-- not expand (rule C12), 0 for none. `dn`: the source's directive names.
type CxPass is a record{
  stack :: List CxFrame
  sets :: KeyVal Text CxSets
  macros :: KeyVal Text CxMacro
  mark :: Integer
  dn :: KeyVal Text Bool
  gn :: KeyVal Text Binding
  hdr :: Integer
  cr :: Integer}
end type

-- `gn`: the names given (rule C16; the names that define a value mark the
-- build that reads them in code).
function cxStart (dn :: KeyVal Text Bool) (gn :: KeyVal Text Binding) -> CxPass is
  CxPass record{ stack = [] , sets = prelude.keyValOf [] , macros = prelude.keyValOf [] , mark = 0 , dn = dn , gn = gn , hdr = 0 , cr = 0}
end function

function cxLiveOf (stack :: List CxFrame) -> Bool is
  first matching case of stack : when Nil then true when Cons f rest then f.live end case
end function

-- The preprocessor evaluates this line's condition.
function cxReachedIn (stack :: List CxFrame) (r :: CxRow) -> Bool is
  if cxIsIfWord r.word then cxLiveOf stack
  else (if cxIsElifWord r.word then
    (first matching case of stack : when Nil then false when Cons f rest then cxLiveOf rest && !f.done end case)
  else false end if) end if
end function

-- The stack after a line; `v` is the value of its condition where it was
-- reached (anything where it was not).
function cxStepped (stack :: List CxFrame) (r :: CxRow) (v :: Bool) -> List CxFrame is
  if cxIsIfWord r.word then [CxFrame record{ live = cxLiveOf stack && v , done = !(cxLiveOf stack) || v}] ++ stack
  else (if cxIsElifWord r.word then
    (first matching case of stack :
      when Nil then []
      when Cons f rest then [CxFrame record{ live = !f.done && v , done = f.done || v}] ++ rest
    end case)
  else (if r.word = "else" then
    (first matching case of stack :
      when Nil then []
      when Cons f rest then [CxFrame record{ live = !f.done , done = true}] ++ rest
    end case)
  else (if r.word = "endif" then prelude.drop 1 stack else stack end if) end if) end if) end if
end function

function cxMacOf (r :: CxRow) -> CxMacro is
  if r.sets matches XUnset then MGone else (if r.fun then MFun else MObj r.body end if) end if
end function

function cxAfter (w :: CxPass) (r :: CxRow) (v :: Bool) -> CxPass is
  let defines = !(r.sets matches XNothing) && cxLiveOf w.stack in
    w with stack = cxStepped w.stack r v ,
           sets = (if defines then prelude.put r.name r.sets w.sets else w.sets end if) ,
           macros = (if defines then prelude.put r.name (cxMacOf r) w.macros else w.macros end if)
  end let
end function
function cxIsSet (sets :: KeyVal Text CxSets) (n :: Text) -> Bool is prelude.lookup n sets matches Present _ end function

-- A name the evaluator gives a meaning of its own.
function cxSpecial (n :: Text) -> Bool is
  prelude.startsWith n "MIN_VERSION_" || prelude.startsWith n "VERSION_" || prelude.startsWith n "__GLASGOW_HASKELL"
end function

-- The name keeps the file from deciding the directive: the file has not
-- set it; or it is a special name; or the file defined it with no integer
-- body and it is read as a value.
function cxBlocks (sets :: KeyVal Text CxSets) (vals :: List Text) (n :: Text) -> Bool is
  first matching case of prelude.lookup n sets :
    when Absent then true
    when Present s then cxSpecial n || ((s matches XOther) && (vals contains n))
  end case
end function

-- The file's definitions of the names, as an environment's.
function cxFileNames (sets :: KeyVal Text CxSets) (ns :: List Text) (acc :: KeyVal Text Binding) -> KeyVal Text Binding is
  first matching case of ns :
    when Nil then acc
    when Cons n rest then
      cxFileNames sets rest
        (first matching case of prelude.lookup n sets :
          when Present (XInt v) then prelude.put n (wp.definedAs v) acc
          when Present XUnset then prelude.put n (wp.notDefined unitValue) acc
          when Present XOther then prelude.put n (wp.definedAs 1) acc
          otherwise acc
        end case)
  end case
end function

-- A line of code, as the walk keeps it: its text, and the build's mark.
type CxLine is a record{
  text :: Text
  mark :: Integer}
end type

type CxReading is one of
  | XNotRead
  | XByFile of type Bool
  | XByTerm of type Literal
  | XLine of type CxLine
  | XAskName of type Text
end type

-- The term of a directive the file reaches and does not decide.
function cxFileTerm (line :: Integer) (l :: Literal) -> Literal is
  Literal record{ negated = l.negated , text = wp.fileDefinedTerm line , expr = Lit 0}
end function

-- An own name that the names given define.
function cxOwnGiven (w :: CxPass) (n :: Text) -> Bool is
  cxIsOwn n && (prelude.lookup n w.gn matches Present _)
end function

-- Rule C18 (cycle 10): an own name the file has not taken over reads as a
-- name the file defined with a body that is no integer.
function cxIsOwn (n :: Text) -> Bool is (cxOwnNames unitValue) contains n end function

function cxOwnFree (sets :: KeyVal Text CxSets) (n :: Text) -> Bool is cxIsOwn n && !(cxIsSet sets n) end function

-- A constructor passed straight to prelude.put does not compile on the Go
-- target (LawSpec 0.32.0); a function's result does.
function cxSetOther (u :: Unit) -> CxSets is XOther end function

function cxOwnSets (sets :: KeyVal Text CxSets) (ns :: List Text) -> KeyVal Text CxSets is
  first matching case of ns :
    when Nil then sets
    when Cons n rest then cxOwnSets (if cxOwnFree sets n then prelude.put n (cxSetOther unitValue) sets else sets end if) rest
  end case
end function

-- The term of a directive the file reaches and does not decide: the words
-- for an own name where one that is still the preprocessor's is read.
function cxOpenTerm (sets :: KeyVal Text CxSets) (r :: CxRow) -> Literal is
  if prelude.any (cxOwnFree sets) r.names
  then Literal record{ negated = r.own.negated , text = wp.ownNameTerm r.line , expr = Lit 0}
  else cxFileTerm r.line r.own end if
end function

-- Rule C8b to C8d, and C18: where the names given hold an own name a
-- directive that reads it is not decided.
function cxDecidedBy (w :: CxPass) (r :: CxRow) -> CxReading is
  let sets = cxOwnSets w.sets r.names in
    (if prelude.any (cxOwnGiven w) r.names then XByTerm (cxOpenTerm w.sets r)
     else (if !(prelude.any (cxIsSet sets) r.names) then XByTerm r.own
     else (if !r.parsed || prelude.any (cxBlocks sets r.vals) r.names then XByTerm (cxOpenTerm w.sets r)
     else
       (first matching case of wn.evalWhen (wp.completed ((wp.emptyEnv unitValue) with names = cxFileNames sets r.names (prelude.keyValOf []))) r.own.text :
         when Known v then XByFile ((v != 0) != r.own.negated)
         when Unknown o then XByTerm (cxOpenTerm w.sets r)
         when Bad then XByTerm (cxOpenTerm w.sets r)
       end case) end if) end if) end if)
  end let
end function

-- What the walk meets at a row.
function cxPrefixOut (s :: Text) (e :: CxExp) -> CxExp is e with out = s ++ e.out end function

-- The next piece that is not blanks is a `(`.
-- Before a call's `(` the preprocessor also lets a carriage return pass.
function cxSkipGap (t :: Text) (fuel :: Integer) -> Text is
  if fuel <= 0 || prelude.length t = 0 then t
  else (if cxIsBlank (prelude.take 1 t) || prelude.startsWith t "\r" then cxSkipGap (prelude.drop 1 t) (fuel - 1) else t end if) end if
end function

function cxNextParen (ps :: List CxPiece) (fuel :: Integer) -> Bool is
  if fuel <= 0 then false
  else
    (first matching case of ps :
      when Nil then false
      when Cons p rest then
        (first matching case of p :
          when PId s then false
          when PTxt s then
            (let r = cxSkipGap s (prelude.length s) in
              (if prelude.length r = 0 then cxNextParen rest (fuel - 1) else prelude.startsWith r "(" end if) end let)
        end case)
    end case)
  end if
end function

function cxLexBody (body :: Text) -> List CxPiece is (cxLexAt body 0 (prelude.length body) "" "" (prelude.length body + 2)).pieces end function

-- Nothing but blanks follows (in the pieces of the line).
function cxBlankRest (ps :: List CxPiece) (fuel :: Integer) -> Bool is
  if fuel <= 0 then true
  else
    (first matching case of ps :
      when Nil then true
      when Cons p rest then
        (first matching case of p :
          when PId s then false
          when PTxt s then prelude.length (cxSkipGap s (prelude.length s)) = 0 && cxBlankRest rest (fuel - 1)
        end case)
    end case)
  end if
end function

-- A macro of the walk with an argument list.
function cxIsFun (w :: CxPass) (n :: Text) -> Bool is
  first matching case of prelude.lookup n w.macros :
    when Present MFun then true
    otherwise false
  end case
end function

-- A name the names given define a value for, that no directive names.
function cxIsGiven (w :: CxPass) (n :: Text) -> Bool is
  first matching case of prelude.lookup n w.gn :
    when Present (Defined v) then true
    otherwise false
  end case
end function

-- Rule C12 (a) and (e): the text of a kept line, with its macros replaced
-- and its comments gone, lexed again: does it hold, outside quotes, one of
-- the preprocessor's own names, or the name of a macro with an argument
-- list that a `(` follows (blanks apart) or that ends the line when more
-- lines follow?
function cxCalls (ps :: List CxPiece) (w :: CxPass) (more :: Bool) (fuel :: Integer) -> Bool is
  if fuel <= 0 then false
  else
    (first matching case of ps :
      when Nil then false
      when Cons p rest then
        (first matching case of p :
          when PTxt s then cxCalls rest w more (fuel - 1)
          when PId n then
            (if (cxOwnNames unitValue) contains n then true
             else (if cxIsFun w n && (cxNextParen rest (prelude.length rest + 1) || (more && cxBlankRest rest (prelude.length rest + 1))) then true
             else cxCalls rest w more (fuel - 1) end if) end if)
        end case)
    end case)
  end if
end function

-- Rule C12 (d): the text ends inside a quote.
function cxQuoteOpen (t :: Text) (i :: Integer) (q :: Text) (fuel :: Integer) -> Bool is
  if i >= prelude.length t || fuel <= 0 then prelude.length q > 0
  else
    (let ch = cxChAt t i in
      (if prelude.length q = 0 then cxQuoteOpen t (i + 1) (if ch = "'" || ch = "\"" then ch else "" end if) (fuel - 1)
       else (if ch = "\\" then cxQuoteOpen t (i + 2) q (fuel - 1)
       else cxQuoteOpen t (i + 1) (if ch = q then "" else q end if) (fuel - 1) end if) end if)
    end let)
  end if
end function

-- Rules C11 and C12: the text of a kept line of code. An identifier the
-- walk has defined as an object-like macro is replaced by its body,
-- lexed and replaced in turn; one it has undefined stays; one with an
-- argument list that a `(` follows, or one met again inside its own
-- expansion, marks the build; an identifier no `#define` of the walk
-- stands behind, that some directive names, reads the term
-- `defined(N)` (`need`, when that term has no value yet).
function cxExpand (ps :: List CxPiece) (w :: CxPass) (asg :: KeyVal Text Integer) (line :: Integer) (active :: List Text) (mark :: Integer) (fuel :: Integer) -> CxExp is
  if fuel <= 0 then CxExp record{ need = "" , out = "" , mark = mark}
  else
    (first matching case of ps :
      when Nil then CxExp record{ need = "" , out = "" , mark = mark}
      when Cons p rest then
        (first matching case of p :
          when PTxt s then cxPrefixOut s (cxExpand rest w asg line active mark (fuel - 1))
          when PId n then
            (first matching case of prelude.lookup n w.macros :
              when Absent then
                (if cxInDn w.dn n then
                   (let t = "defined(" ++ n ++ ")" in
                     (first matching case of prelude.lookup t asg :
                       when Absent then CxExp record{ need = t , out = "" , mark = mark}
                       when Present v then cxPrefixOut n (cxExpand rest w asg line active (if v != 0 && mark = 0 then line else mark end if) (fuel - 1))
                     end case)
                   end let)
                 else cxPrefixOut n (cxExpand rest w asg line active (if cxIsGiven w n && mark = 0 then line else mark end if) (fuel - 1)) end if)
              when Present MGone then cxPrefixOut n (cxExpand rest w asg line active mark (fuel - 1))
              when Present MFun then cxPrefixOut n (cxExpand rest w asg line active mark (fuel - 1))
              when Present (MObj body) then
                (if active contains n || cxQuoteOpen body 0 "" (prelude.length body + 1) then cxPrefixOut n (cxExpand rest w asg line active (if mark = 0 then line else mark end if) (fuel - 1))
                 else
                   (let inner = cxExpand (cxLexBody body) w asg line (active ++ [n]) mark (fuel - 1) in
                     (if prelude.length inner.need > 0 then inner
                      else (let nxt = cxExpand rest w asg line active inner.mark (fuel - 1) in
                        CxExp record{ need = nxt.need , out = inner.out ++ nxt.out , mark = nxt.mark} end let) end if)
                   end let) end if)
            end case)
        end case)
    end case)
  end if
end function

-- A kept line of code: its text under the walk's macros, or the term it
-- needs a value for.
function cxCodeAt (w :: CxPass) (asg :: KeyVal Text Integer) (r :: CxRow) -> CxReading is
  if !(cxLiveOf w.stack) then XNotRead
  else (if !r.cand then XLine (CxLine record{ text = r.text , mark = w.mark})
  else
    (let e = cxExpand r.pieces w asg r.line [] w.mark 200000 in
      (if prelude.length e.need > 0 then XAskName e.need
       else XLine (CxLine record{ text = e.out ,
                                   mark = (if e.mark = 0 && cxCalls (cxLexBody e.out) w r.more (prelude.length e.out + 1) then r.line else e.mark end if)}) end if)
    end let) end if) end if
end function

-- What the walk meets at a row.
function cxReadingAt (w :: CxPass) (asg :: KeyVal Text Integer) (r :: CxRow) -> CxReading is
  if prelude.length r.word = 0 then cxCodeAt w asg r
  else (if !(cxReachedIn w.stack r) then XNotRead else cxDecidedBy w r end if) end if
end function
function cxValued (asg :: KeyVal Text Integer) (t :: Text) -> Bool is
  first matching case of prelude.lookup t asg : when Present v then v = 0 || v = 1 when Absent then false end case
end function
-- The directive holds under the values: a term with no value counts 0.
function cxLitTrue (asg :: KeyVal Text Integer) (l :: Literal) -> Bool is
  first matching case of prelude.lookup l.text asg : when Present v then (v != 0) != l.negated when Absent then l.negated end case
end function

function cxTruthAt (w :: CxPass) (asg :: KeyVal Text Integer) (r :: CxRow) -> Bool is
  first matching case of cxReadingAt w asg r :
    when XNotRead then false
    when XByFile v then v
    when XByTerm l then cxLitTrue asg l
    when XLine ln then false
    when XAskName t then false
  end case
end function

-- Rule C14: of a term the names given may decide: 0, no; 1, true alone;
-- 2, false alone.
function cxNoGiven (u :: Unit) -> CxGiven is CxGiven record{ on = false , env = wp.emptyEnv unitValue} end function

function cxSide (g :: CxGiven) (t :: Text) -> Integer is
  if !g.on then 0
  else
    (first matching case of wn.evalWhen g.env t :
      when Known v then (if v != 0 then 1 else 2 end if)
      when Unknown o then 0
      when Bad then 0
    end case)
  end if
end function
-- The number of builds, counted no further than `budget + 1`.
function cxCount (rs :: List CxRow) (w :: CxPass) (asg :: KeyVal Text Integer) (g :: CxGiven) (budget :: Integer) (f :: Integer) -> Integer is
  if f <= 0 then 1
  else
    (first matching case of rs :
      when Nil then 1
      when Cons r rest then
        (if prelude.length r.word = 0 && !r.cand then cxCount rest w asg g budget (f - 1)
         else
          (first matching case of cxReadingAt w asg r :
            when XNotRead then cxCount rest (cxAfter w r false) asg g budget (f - 1)
            when XByFile v then cxCount rest (cxAfter w r v) asg g budget (f - 1)
            when XLine ln then cxCount rest (w with mark = ln.mark) asg g budget (f - 1)
            when XByTerm l then
              (if cxValued asg l.text then cxCount rest (cxAfter w r (cxLitTrue asg l)) asg g budget (f - 1)
               else
                 (let s = cxSide g l.text in
                  let a = (if s = 2 then 0 else cxCount rest (cxAfter w r (!l.negated)) (prelude.put l.text 1 asg) g budget (f - 1) end if) in
                    (if s = 1 || a > budget then a
                     else a + cxCount rest (cxAfter w r l.negated) (prelude.put l.text 0 asg) g (budget - a) (f - 1) end if)
                 end let end let) end if)
            when XAskName t then
              (let s = cxSide g t in
               let a = (if s = 2 then 0 else cxCount rs w (prelude.put t 1 asg) g budget (f - 1) end if) in
                 (if s = 1 || a > budget then a
                  else a + cxCount rs w (prelude.put t 0 asg) g (budget - a) (f - 1) end if)
              end let end let)
          end case) end if)
    end case)
  end if
end function
type CxBuild is a record{
  asg :: KeyVal Text Integer
  mark :: Integer}
end type

function cxBuilds (rs :: List CxRow) (w :: CxPass) (asg :: KeyVal Text Integer) (g :: CxGiven) (f :: Integer) -> List CxBuild is
  if f <= 0 then [CxBuild record{ asg = asg , mark = w.mark}]
  else
    (first matching case of rs :
      when Nil then [CxBuild record{ asg = asg , mark = w.mark}]
      when Cons r rest then
        (if prelude.length r.word = 0 && !r.cand then cxBuilds rest w asg g (f - 1)
         else
          (first matching case of cxReadingAt w asg r :
            when XNotRead then cxBuilds rest (cxAfter w r false) asg g (f - 1)
            when XByFile v then cxBuilds rest (cxAfter w r v) asg g (f - 1)
            when XLine ln then cxBuilds rest (w with mark = ln.mark) asg g (f - 1)
            when XByTerm l then
              (if cxValued asg l.text then cxBuilds rest (cxAfter w r (cxLitTrue asg l)) asg g (f - 1)
               else
                 (let s = cxSide g l.text in
                   (if s = 2 then [] else cxBuilds rest (cxAfter w r (!l.negated)) (prelude.put l.text 1 asg) g (f - 1) end if)
                     ++ (if s = 1 then [] else cxBuilds rest (cxAfter w r l.negated) (prelude.put l.text 0 asg) g (f - 1) end if)
                 end let) end if)
            when XAskName t then
              (let s = cxSide g t in
                (if s = 2 then [] else cxBuilds rs w (prelude.put t 1 asg) g (f - 1) end if)
                  ++ (if s = 1 then [] else cxBuilds rs w (prelude.put t 0 asg) g (f - 1) end if)
              end let)
          end case) end if)
    end case)
  end if
end function
-- The first build: every term it reads is true.
function cxFirstBuild (rs :: List CxRow) (w :: CxPass) (asg :: KeyVal Text Integer) (f :: Integer) -> CxBuild is
  if f <= 0 then CxBuild record{ asg = asg , mark = w.mark}
  else
    (first matching case of rs :
      when Nil then CxBuild record{ asg = asg , mark = w.mark}
      when Cons r rest then
        (if prelude.length r.word = 0 && !r.cand then cxFirstBuild rest w asg (f - 1)
         else
          (first matching case of cxReadingAt w asg r :
            when XNotRead then cxFirstBuild rest (cxAfter w r false) asg (f - 1)
            when XByFile v then cxFirstBuild rest (cxAfter w r v) asg (f - 1)
            when XLine ln then cxFirstBuild rest (w with mark = ln.mark) asg (f - 1)
            when XByTerm l then
              (if cxValued asg l.text then cxFirstBuild rest (cxAfter w r (cxLitTrue asg l)) asg (f - 1)
               else cxFirstBuild rest (cxAfter w r (!l.negated)) (prelude.put l.text 1 asg) (f - 1) end if)
            when XAskName t then cxFirstBuild rs w (prelude.put t 1 asg) (f - 1)
          end case) end if)
    end case)
  end if
end function
function cxBlanks (n :: Integer) -> List Text is if n <= 0 then [] else [""] ++ cxBlanks (n - 1) end if end function

-- A build's copy: every directive line, and every line the walk does not
-- keep under the build's values, empty; no line moves.
function cxCopyLines (w :: CxPass) (asg :: KeyVal Text Integer) (rows :: List CxRow) -> List Text is
  first matching case of rows :
    when Nil then []
    when Cons r rest then
      (if prelude.length r.word > 0 then cxBlanks r.nlines ++ cxCopyLines (cxAfter w r (cxTruthAt w asg r)) asg rest
       else
        (first matching case of cxCodeAt w asg r :
          when XLine ln then [ln.text] ++ cxBlanks (r.nlines - 1) ++ cxCopyLines (w with mark = ln.mark) asg rest
          otherwise cxBlanks r.nlines ++ cxCopyLines w asg rest
        end case) end if)
  end case
end function
function cxCopyOf (dn :: KeyVal Text Bool) (gn :: KeyVal Text Binding) (asg :: KeyVal Text Integer) (rows :: List CxRow) -> Text is
  prelude.join "\n" (cxCopyLines (cxStart dn gn) asg rows)
end function
function cxCopiesOf (rows :: List CxRow) (dn :: KeyVal Text Bool) (gn :: KeyVal Text Binding) (builds :: List CxBuild) -> List Text is
  first matching case of builds :
    when Nil then []
    when Cons b rest then [cxCopyOf dn gn b.asg rows] ++ cxCopiesOf rows dn gn rest
  end case
end function
-- C1: some line of the source is a directive line, wherever the walk
-- reads it (a line inside a comment is one too).
function cxHasDirective (ls :: List CxJoin) -> Bool is
  first matching case of ls : when Nil then false when Cons l rest then prelude.length (cxWordOf l.text) > 0 || cxHasDirective rest end case
end function

-- Rule C1: a pragma that turns the preprocessor on. `{-# LANGUAGE ... #-}`
-- (the word in any case) that lists CPP, or `{-# OPTIONS_GHC ... #-}` or
-- `{-# OPTIONS ... #-}` that holds `-cpp` or `-XCPP`; it may run over
-- lines; its words are parted by blanks, line ends and commas.
function cxWordsOf (t :: Text) (i :: Integer) (n :: Integer) (cur :: Text) (fuel :: Integer) -> List Text is
  if i >= n || fuel <= 0 then (if prelude.length cur = 0 then [] else [cur] end if)
  else
    (let ch = cxChAt t i in
      (if ch = " " || ch = "\t" || ch = "\n" || ch = "\r" || ch = "," then (if prelude.length cur = 0 then [] else [cur] end if) ++ cxWordsOf t (i + 1) n "" (fuel - 1)
       else cxWordsOf t (i + 1) n (cur ++ ch) (fuel - 1) end if)
    end let)
  end if
end function

function cxFindFrom (t :: Text) (what :: Text) (i :: Integer) (n :: Integer) (fuel :: Integer) -> Integer is
  if fuel <= 0 then 0 - 1
  else (if prelude.startsWith (prelude.drop i t) what then i
        else (if i >= n then 0 - 1 else cxFindFrom t what (i + 1) n (fuel - 1) end if) end if) end if
end function

-- Rule C1 (cycle 10): the file's HEADER turns the preprocessor on, or
-- does not. It is read from the start of the text, as GHC's lexer reads
-- the leading run of comments and file-header pragmas: white space is
-- skipped; `{- -}` is a nested comment; two or more dashes begin a line
-- comment unless a symbol follows them; `{-# WORD ... #-}` is a LANGUAGE
-- or OPTIONS pragma (which says what the preprocessor does), a pragma
-- passed over, a pragma that ends the header (a token of its own to
-- GHC), or, with any other word, a comment; a line `#!` is skipped;
-- anything else ends the header. Where this reading cannot be sure it is
-- GHC's (a character outside ASCII where a token may begin; a LANGUAGE
-- pragma that holds more than names; an OPTIONS pragma with a quote or a
-- bracket; a `#` at a line's start that is no `#!`) it stops there, and
-- if the text from there names CPP the source is read as preprocessed and
-- marked with the line (`wp.headerTerm`).
type CxHs is a record{
  next :: Integer
  on :: Integer
  doubt :: Integer
  halt :: Bool}
end type

-- What the header leaves: `on` (1 the preprocessor is on) and `doubt`, the
-- index where the reading stopped unsure, -1 for none.
type CxHdr is a record{
  on :: Integer
  doubt :: Integer}
end type

-- The reading's answer: the preprocessor is on; the line of the doubt (0
-- for none).
type CxHdrRead is a record{
  on :: Bool
  line :: Integer}
end type

function cxHsGo (next :: Integer) (on :: Integer) -> CxHs is CxHs record{ next = next , on = on , doubt = 0 - 1 , halt = false} end function
function cxHsStop (on :: Integer) -> CxHs is CxHs record{ next = 0 , on = on , doubt = 0 - 1 , halt = true} end function
function cxHsDoubt (at :: Integer) (on :: Integer) -> CxHs is CxHs record{ next = 0 , on = on , doubt = at , halt = true} end function

function cxHsWs (ch :: Text) -> Bool is cxIsBlank ch || ch = "\n" || ch = "\r" end function
function cxHsAscii (ch :: Text) -> Bool is (ch matches regex "[ -~]") || cxHsWs ch end function

function cxHsWsEnd (t :: Text) (i :: Integer) (n :: Integer) (fuel :: Integer) -> Integer is
  if i >= n || fuel <= 0 then i else (if cxHsWs (cxChAt t i) then cxHsWsEnd t (i + 1) n (fuel - 1) else i end if) end if
end function

function cxHsDashEnd (t :: Text) (i :: Integer) (n :: Integer) (fuel :: Integer) -> Integer is
  if i >= n || fuel <= 0 || !(cxChAt t i = "-") then i else cxHsDashEnd t (i + 1) n (fuel - 1) end if
end function

function cxHsLineEnd (t :: Text) (i :: Integer) (n :: Integer) -> Integer is
  let e = cxFindFrom t "\n" i n (n + 1) in (if 0 > e then n else e end if) end let
end function

-- The index after the `-}` that closes the comment opened at i; -1 for none.
function cxHsNest (t :: Text) (i :: Integer) (n :: Integer) (depth :: Integer) (fuel :: Integer) -> Integer is
  if i >= n || fuel <= 0 then 0 - 1
  else
    (let two = prelude.take 2 (prelude.drop i t) in
      (if two = "-}" then (if depth > 1 then cxHsNest t (i + 2) n (depth - 1) (fuel - 1) else i + 2 end if)
       else (if two = "{-" then cxHsNest t (i + 2) n (depth + 1) (fuel - 1) else cxHsNest t (i + 1) n depth (fuel - 1) end if) end if)
    end let)
  end if
end function

-- Rule C1 (f), cycle 11: inside a nested comment GHC lexes a line that
-- begins with `#` apart, and a `{-` or a `-}` on it is not seen by the
-- comment. A comment that holds such a line (after its first) is a doubt.
function cxHsHashBrace (l :: Text) -> Bool is prelude.startsWith l "#" && ((l contains "-}") || (l contains "{-")) end function

function cxHsHashLine (text :: Text) -> Bool is prelude.any cxHsHashBrace (prelude.drop 1 (linesOf text)) end function

function cxHsComment (t :: Text) (i :: Integer) (n :: Integer) (on :: Integer) -> CxHs is
  let e = cxHsNest t i n 0 (n + 1) in
  let upTo = (if e < 0 then n else e end if) in
    (if cxHsHashLine (prelude.take (upTo - i) (prelude.drop i t)) then cxHsDoubt i on
     else (if e < 0 then cxHsStop on else cxHsGo e on end if) end if)
  end let end let
end function

-- The words of a pragma, switching the preprocessor: LANGUAGE names CPP or
-- NoCPP, an OPTIONS pragma `-cpp`, `-XCPP` or `-XNoCPP`; the last wins.
function cxHsSwitch (flags :: Bool) (on :: Integer) (ws :: List Text) -> Integer is
  first matching case of ws :
    when Nil then on
    when Cons w rest then
      (let up = (if flags then (w = "-cpp" || w = "-XCPP") else w = "CPP" end if) in
       let down = (if flags then w = "-XNoCPP" else w = "NoCPP" end if) in
         cxHsSwitch flags (if up then 1 else (if down then 0 else on end if) end if) rest
       end let end let)
  end case
end function

function cxHsKnown (word :: Text) -> Bool is
  prelude.any (cxHsSame word) ["language", "options_ghc", "options", "options_haddock", "include"]
end function

function cxHsSame (a :: Text) (b :: Text) -> Bool is a = b end function

function cxHsToken (word :: Text) -> Bool is
  prelude.any (cxHsSame word)
    ["rules", "inline", "inlinable", "inlineable", "notinline", "noinline", "opaque", "specialize", "specialise", "source", "warning", "deprecated", "scc",
     "unpack", "nounpack", "ann", "minimal", "overlaps", "overlappable", "overlapping", "incoherent", "ctype", "complete"]
end function

-- A `{-#` at i, whose body runs to the `#-}` at b.
function cxHsBody (word :: Text) (t :: Text) (i :: Integer) (w1 :: Integer) (b :: Integer) (n :: Integer) (on :: Integer) -> CxHs is
  let body = prelude.take (b - w1) (prelude.drop w1 t) in
  let ws = cxWordsOf body 0 (prelude.length body) "" (prelude.length body + 1) in
    (if word = "language" then
       (if body matches regex "[A-Za-z0-9_, \\t\\n\\r]*" then cxHsGo (b + 3) (cxHsSwitch false on ws) else cxHsDoubt i on end if)
     else (if word = "options_ghc" || word = "options" then
       (if (body contains "\"") || (body contains "[") || (body contains "\f") || (body contains "\v") then cxHsDoubt i on
        else cxHsGo (b + 3) (cxHsSwitch true on ws) end if)
     else cxHsGo (b + 3) on end if) end if)
  end let end let
end function

function cxHsPragma (t :: Text) (i :: Integer) (n :: Integer) (on :: Integer) -> CxHs is
  let w0 = cxHsWsEnd t (i + 3) n (n + 1) in
  let w1 = cxWordLen t w0 n in
  let word = prelude.caseFold (prelude.take (w1 - w0) (prelude.drop w0 t)) in
    (if w1 < n && !(cxHsAscii (cxChAt t w1)) then cxHsDoubt i on
     else (if word = "line" || word = "column" then cxHsDoubt i on
     else (if cxHsKnown word then
       (let b = cxFindFrom t "#-}" w1 n (n + 1) in
         (if b < 0 then cxHsStop on else cxHsBody word t i w1 b n on end if) end let)
     else (if cxHsToken word then cxHsStop on else cxHsComment t i n on end if) end if) end if) end if)
  end let end let end let
end function

-- Two or more dashes at i.
function cxHsDashes (t :: Text) (i :: Integer) (n :: Integer) (on :: Integer) -> CxHs is
  let d = cxHsDashEnd t i n (n + 1) in
  let after = cxChAt t d in
    (if d >= n || after = "\n" then cxHsGo d on
     else (if cxHsAscii after then
       (if after matches regex "[!#$%&*+./<=>?@\\\\^|~:]" then cxHsStop on else cxHsGo (cxHsLineEnd t d n) on end if)
     else cxHsDoubt d on end if) end if)
  end let end let
end function

function cxHsAtStart (t :: Text) (i :: Integer) -> Bool is i <= 0 || cxChAt t (i - 1) = "\n" end function

function cxHsHash (t :: Text) (i :: Integer) (n :: Integer) (on :: Integer) -> CxHs is
  let blankFirst = (i > 0 && cxChAt t (i - 1) = " " && cxHsAtStart t (i - 1)) in
    (if (cxHsAtStart t i || blankFirst) && cxChAt t (i + 1) = "!" then cxHsGo (cxHsLineEnd t i n) on
     else (if cxHsAtStart t i then cxHsDoubt i on else cxHsStop on end if) end if)
  end let
end function

function cxHsStep (t :: Text) (i :: Integer) (n :: Integer) (on :: Integer) -> CxHs is
  let ch = cxChAt t i in
  let three = prelude.take 3 (prelude.drop i t) in
  let two = prelude.take 2 three in
    (if cxHsWs ch then cxHsGo (i + 1) on
     else (if !(cxHsAscii ch) then cxHsDoubt i on
     else (if three = "{-#" then cxHsPragma t i n on
     else (if two = "{-" then cxHsComment t i n on
     else (if two = "--" then cxHsDashes t i n on
     else (if ch = "#" then cxHsHash t i n on else cxHsStop on end if) end if) end if) end if) end if) end if)
  end let end let end let
end function

function cxHsLoop (t :: Text) (i :: Integer) (n :: Integer) (on :: Integer) (fuel :: Integer) -> CxHdr is
  if i >= n || fuel <= 0 then CxHdr record{ on = on , doubt = 0 - 1}
  else
    (let st = cxHsStep t i n on in
      (if st.halt then CxHdr record{ on = st.on , doubt = st.doubt } else cxHsLoop t st.next n st.on (fuel - 1) end if) end let)
  end if
end function

function cxHdrRead (source :: Text) -> CxHdrRead is
  let h = cxHsLoop source 0 (prelude.length source) 0 (prelude.length source + 1) in
    (if h.doubt >= 0 && ((prelude.drop h.doubt source) contains "CPP" || (prelude.drop h.doubt source) contains "-cpp")
     then CxHdrRead record{ on = true , line = prelude.length (linesOf (prelude.take h.doubt source))}
     else CxHdrRead record{ on = (h.on = 1) , line = 0} end if)
  end let
end function

-- The source's lines, a last empty one not counted.
function cxLineTotal (ls :: List Text) -> Integer is
  first matching case of prelude.at (prelude.length ls - 1) ls :
    when Present l then (if prelude.length l = 0 then prelude.length ls - 1 else prelude.length ls end if)
    when Absent then 0
  end case
end function

function cxAnyMarked (bs :: List CxBuild) -> Bool is
  first matching case of bs : when Nil then false when Cons b rest then b.mark > 0 || cxAnyMarked rest end case
end function

-- The most steps a walk can take: every row, and each name a line of
-- code may need a value for.
function cxFuel (rs :: List CxRow) (dn :: KeyVal Text Bool) -> Integer is
  (prelude.length rs + 1) * (prelude.length (prelude.entries dn) + 2)
end function

function cxSingle (source :: Text) -> CxPlan is
  CxPlan record{ copies = [source] , rows = [] , unread = false , dn = prelude.keyValOf [] , gv = cxNoGiven unitValue , gn = prelude.keyValOf [] , hdr = 0 , cr = 0 , marked = false , fuel = 0}
end function

-- Rule C14: names given at all.
function cxGivenOf (env :: Env) -> CxGiven is
  CxGiven record{ on = env.complete || prelude.length (prelude.entries env.names) > 0 || prelude.length (prelude.entries env.versions) > 0 , env = env}
end function

function cxReadAll (rows :: List CxRow) (dn :: KeyVal Text Bool) (gn :: KeyVal Text Binding) (g :: CxGiven) (hdr :: Integer) (cr :: Integer) (fuel :: Integer) -> CxPlan is
  let bs = cxBuilds rows (cxStart dn gn) (prelude.keyValOf []) g fuel in
    CxPlan record{ copies = cxCopiesOf rows dn gn bs , rows = rows , unread = false , dn = dn , gv = g , gn = gn , hdr = hdr , cr = cr , marked = cxAnyMarked bs || hdr > 0 || cr > 0 , fuel = fuel}
  end let
end function

-- The plan of a source (C1, C2, C14). A source with no directive line is
-- its own single copy; one with more builds than `cap` is walked again
-- under the names given, and if it still has more it is read in its first
-- build alone (every term true), with nothing decided.
-- Rule C19 (cycle 11): a lone carriage return is one that no line feed
-- follows (the first of CR CR LF is one). Read from the physical lines
-- (split at line feeds): a carriage return before a line feed ends its
-- line, so a line holds a lone one where it holds a carriage return that
-- is not its last character, or, for the source's last line, any.
function cxCrBody (l :: Text) (last :: Bool) -> Text is
  if !last && prelude.endsWith l "\r" then prelude.take (prelude.length l - 1) l else l end if
end function

-- The number of the line (from k) that holds the first lone carriage
-- return; 0 for none.
function cxCrLine (ls :: List Text) (k :: Integer) -> Integer is
  first matching case of ls :
    when Nil then 0
    when Cons l rest then (if (cxCrBody l (prelude.length rest = 0)) contains "\r" then k else cxCrLine rest (k + 1) end if)
  end case
end function

-- A `#` stands from that carriage return on (line k is the one that holds it).
function cxHasHash (l :: Text) -> Bool is l contains "#" end function

function cxCrHash (ls :: List Text) (k :: Integer) -> Bool is
  first matching case of prelude.drop (k - 1) ls :
    when Nil then false
    when Cons l rest then
      (prelude.drop (cxFindFrom l "\r" 0 (prelude.length l) (prelude.length l + 1)) l) contains "#" || prelude.any cxHasHash rest
  end case
end function

function cppPlanCapped (cap :: Integer) (env :: Env) (source :: Text) -> CxPlan is
  if !(prelude.startsWith source "#" || (source contains "\n#") || (source contains "CPP") || (source contains "-cpp") || ((source contains "\r") && (source contains "#"))) then cxSingle source
  else
    (let phys = linesOf source in
     let ls = cxSplice phys (prelude.length phys + 1) in
     let hd = cxHdrRead source in
     let direct = cxHasDirective ls in
     let h = (if direct then 1 else (if hd.line > 0 then 2 else (if hd.on then 1 else 0 end if) end if) end if) in
     let crk = (if source contains "\r" then cxCrLine phys 1 else 0 end if) in
     let cr = (crk > 0 && (h != 0 || cxCrHash phys crk)) in
       (if h = 0 && !cr then cxSingle source
        else
          (let hdr = (if direct then 0 else hd.line end if) in
           let crl = (if cr then crk else 0 end if) in
           let scanned = cxScan (cxUnits ls (prelude.length ls + 1)) 1 (cxLineTotal phys) in
           let dn = cxDirNames scanned (prelude.keyValOf []) in
           let gn = env.names in
           let rows = cxCands (cxWatch dn gn) scanned in
           let fuel = cxFuel rows dn in
           let nogv = cxNoGiven unitValue in
           let gvn = cxGivenOf env in
             (if cxCount rows (cxStart dn gn) (prelude.keyValOf []) nogv cap fuel <= cap then cxReadAll rows dn gn nogv hdr crl fuel
              else (if gvn.on && cxCount rows (cxStart dn gn) (prelude.keyValOf []) gvn cap fuel <= cap then cxReadAll rows dn gn gvn hdr crl fuel
              else CxPlan record{ copies = [cxCopyOf dn gn (cxFirstBuild rows (cxStart dn gn) (prelude.keyValOf []) fuel).asg rows] , rows = rows , unread = true ,
                                  dn = dn , gv = nogv , gn = gn , hdr = 0 , cr = 0 , marked = false , fuel = fuel} end if) end if)
          end let end let end let end let end let end let end let end let end let) end if)
    end let end let end let end let end let end let end let) end if
end function
-- The plan of a source (C2). A source with no conditional is its own single
-- copy; one with more builds than the cap is read in its first build alone.
function cppPlan (source :: Text) -> CxPlan is cppPlanCapped (wp.buildCap unitValue) (wp.emptyEnv unitValue) source end function
function cppCopies (source :: Text) -> List Text is (cppPlan source).copies end function

-- ---------------------------------------------------------------------------
-- Next cycle 8, rule C14 (next-cycle-8/design.md, section 8): a source
-- with more builds than the cap is walked again under the names given.
-- `cppPlanCapped cap env source` is the plan of a source when at most
-- `cap` builds are read and `env` holds the names given; with the cap of
-- `wp.buildCap` it is what ax reads. `extractFilesCapped` is
-- `extractFiles` over those plans.
--
-- (The two stubs of the law author are replaced: `cppPlanCapped` above, and
-- `extractFilesCapped` below `extractFiles`.)
-- What ax reads under the names given: the cap is `wp.buildCap`.
function cppCopiesUnder (env :: Env) (source :: Text) -> List Text is (cppPlanCapped (wp.buildCap unitValue) env source).copies end function

procedure extractFilesUnder (env :: Env) (files :: List SourceFile) -> List Package uses HaskellParser is
  extractFilesCapped (wp.buildCap unitValue) env files
end procedure

-- ---------------------------------------------------------------------------
-- A fact's condition from the builds that hold it (C4, C7). Walk the
-- choices: at a build, one cube with no literal if the build is in J, none
-- if not; at a choice on a term T, the cubes under T true and under T
-- false: the same list, T does not matter and is not written; otherwise
-- the first list with T put before each cube, then the second with !(T).
-- (A directive the file decides is no choice.)

type CxWalk is a record{
  cubes :: List (List CxTerm)
  count :: Integer}
end type

function cxPrefixed (l :: CxTerm) (cs :: List (List CxTerm)) -> List (List CxTerm) is
  first matching case of cs : when Nil then [] when Cons c rest then [[l] ++ c] ++ cxPrefixed l rest end case
end function

function cxNoWalk (u :: Unit) -> CxWalk is CxWalk record{ cubes = [] , count = 0} end function

-- The two sides of a choice on the term `t`: `s` says which the names
-- given leave (0 both, 1 true alone, 2 false alone). A side that stands
-- alone keeps its literal in the cube.
function cxJoinWalks (t :: Text) (s :: Integer) (a :: CxWalk) (b :: CxWalk) -> CxWalk is
  if s = 2 then CxWalk record{ cubes = cxPrefixed (CxTerm record{ negated = true , text = t}) b.cubes , count = b.count}
  else (if s = 1 then CxWalk record{ cubes = cxPrefixed (CxTerm record{ negated = false , text = t}) a.cubes , count = a.count}
  else (if a.cubes = b.cubes then CxWalk record{ cubes = a.cubes , count = a.count + b.count}
  else CxWalk record{ cubes = cxPrefixed (CxTerm record{ negated = false , text = t}) a.cubes ++ cxPrefixed (CxTerm record{ negated = true , text = t}) b.cubes ,
                      count = a.count + b.count} end if) end if) end if
end function

function cxWalk (rs :: List CxRow) (w :: CxPass) (asg :: KeyVal Text Integer) (g :: CxGiven) (k :: Integer) (j :: List Integer) (f :: Integer) -> CxWalk is
  if f <= 0 then CxWalk record{ cubes = [] , count = 1}
  else
    (first matching case of rs :
      when Nil then
        CxWalk record{ cubes = (if j contains k
                                then [(if w.hdr > 0 then [CxTerm record{ negated = false , text = wp.headerTerm w.hdr}] else [] end if)
                                        ++ (if w.cr > 0 then [CxTerm record{ negated = false , text = wp.crTerm w.cr}] else [] end if)
                                        ++ (if w.mark > 0 then [CxTerm record{ negated = false , text = wp.unexpandedTerm w.mark}] else [] end if)]
                                else [] end if) , count = 1}
      when Cons r rest then
        (if prelude.length r.word = 0 && !r.cand then cxWalk rest w asg g k j (f - 1)
         else
          (first matching case of cxReadingAt w asg r :
            when XNotRead then cxWalk rest (cxAfter w r false) asg g k j (f - 1)
            when XByFile v then cxWalk rest (cxAfter w r v) asg g k j (f - 1)
            when XLine ln then cxWalk rest (w with mark = ln.mark) asg g k j (f - 1)
            when XByTerm l then
              (if cxValued asg l.text then cxWalk rest (cxAfter w r (cxLitTrue asg l)) asg g k j (f - 1)
               else
                 (let s = cxSide g l.text in
                  let a = (if s = 2 then cxNoWalk unitValue else cxWalk rest (cxAfter w r (!l.negated)) (prelude.put l.text 1 asg) g k j (f - 1) end if) in
                  let b = (if s = 1 then cxNoWalk unitValue else cxWalk rest (cxAfter w r l.negated) (prelude.put l.text 0 asg) g (k + a.count) j (f - 1) end if) in
                    cxJoinWalks l.text s a b
                 end let end let end let) end if)
            when XAskName t then
              (let s = cxSide g t in
               let a = (if s = 2 then cxNoWalk unitValue else cxWalk rs w (prelude.put t 1 asg) g k j (f - 1) end if) in
               let b = (if s = 1 then cxNoWalk unitValue else cxWalk rs w (prelude.put t 0 asg) g (k + a.count) j (f - 1) end if) in
                 cxJoinWalks t s a b
              end let end let end let)
          end case) end if)
    end case)
  end if
end function
function cxLits (ts :: List CxTerm) -> List Literal is
  first matching case of ts :
    when Nil then []
    when Cons t rest then [Literal record{ negated = t.negated , text = t.text , expr = Lit 0}] ++ cxLits rest
  end case
end function

function cxCubeLits (cs :: List (List CxTerm)) -> List (List Literal) is
  first matching case of cs : when Nil then [] when Cons c rest then [cxLits c] ++ cxCubeLits rest end case
end function

-- The condition of a fact held by the builds J: "unread" over the cap, none
-- when every build holds it.
function cxCondText (plan :: CxPlan) (j :: List Integer) -> Text is
  if plan.unread then wp.unreadText unitValue
  else (if prelude.length j >= prelude.length plan.copies && !plan.marked then ""
  else wp.conditionText (cxCubeLits (cxWalk plan.rows ((cxStart plan.dn plan.gn) with hdr = plan.hdr , cr = plan.cr) (prelude.keyValOf []) plan.gv 0 j plan.fuel).cubes) end if) end if
end function
-- ---------------------------------------------------------------------------
-- Joining what the copies gave (C3, C5, C6).

type CxEdge is a record{
  edge :: CallEdge
  copies :: List Integer}
end type

type CxSym is a record{
  form :: Decl
  copies :: List Integer
  calls :: List CxEdge}
end type

type CxBook is a record{
  buckets :: KeyVal Text (List CxSym)
  order :: List Text}
end type

function cxAddEdge (e :: CallEdge) (i :: Integer) (es :: List CxEdge) -> List CxEdge is
  first matching case of es :
    when Nil then [CxEdge record{ edge = e , copies = [i]}]
    when Cons x rest then
      (if x.edge = e then [x with copies = x.copies ++ [i]] ++ rest else [x] ++ cxAddEdge e i rest end if)
  end case
end function

function cxAddEdges (es :: List CallEdge) (i :: Integer) (acc :: List CxEdge) -> List CxEdge is
  first matching case of es : when Nil then acc when Cons e rest then cxAddEdges rest i (cxAddEdge e i acc) end case
end function

function cxAddSym (form :: Decl) (es :: List CallEdge) (i :: Integer) (syms :: List CxSym) -> List CxSym is
  first matching case of syms :
    when Nil then [CxSym record{ form = form , copies = [i] , calls = cxAddEdges es i []}]
    when Cons s rest then
      (if s.form = form then [s with copies = s.copies ++ [i] , calls = cxAddEdges es i s.calls] ++ rest
       else [s] ++ cxAddSym form es i rest end if)
  end case
end function

function cxAddDecl (d :: Decl) (i :: Integer) (book :: CxBook) -> CxBook is
  let form = d with calls = [] in
    (first matching case of prelude.lookup d.id book.buckets :
      when Absent then CxBook record{ buckets = prelude.put d.id (cxAddSym form d.calls i []) book.buckets , order = book.order ++ [d.id]}
      when Present syms then CxBook record{ buckets = prelude.put d.id (cxAddSym form d.calls i syms) book.buckets , order = book.order}
    end case)
  end let
end function

function cxAddDecls (ds :: List Decl) (i :: Integer) (book :: CxBook) -> CxBook is
  first matching case of ds : when Nil then book when Cons d rest then cxAddDecls rest i (cxAddDecl d i book) end case
end function

-- A copy that gave a package, with its number.
type CxCopyPkg is a record{
  index :: Integer
  pkg :: Package}
end type

function cxLive (pks :: List (List Package)) (i :: Integer) (id :: Text) -> List CxCopyPkg is
  first matching case of pks :
    when Nil then []
    when Cons ps rest then
      (first matching case of ps :
        when Cons p more then (if p.id = id then [CxCopyPkg record{ index = i , pkg = p}] else [] end if)
        when Nil then []
      end case) ++ cxLive rest (i + 1) id
  end case
end function

function cxFirstId (pks :: List (List Package)) -> Maybe Package is
  first matching case of pks :
    when Nil then Absent
    when Cons ps rest then (first matching case of ps : when Cons p more then Present p when Nil then cxFirstId rest end case)
  end case
end function

function cxBookOf (live :: List CxCopyPkg) (book :: CxBook) -> CxBook is
  first matching case of live :
    when Nil then book
    when Cons cq rest then cxBookOf rest (cxAddDecls cq.pkg.symbols cq.index book)
  end case
end function

-- A symbol instance: one per form, with the condition of the builds that
-- hold it (C5). Each edge carries the condition of the builds that hold it
-- (C6): its builds are among its form's, so it is written whole.
function cxEdgesCond (plan :: CxPlan) (es :: List CxEdge) -> List CallEdge is
  first matching case of es :
    when Nil then []
    when Cons x rest then [x.edge with condition = cxCondText plan x.copies] ++ cxEdgesCond plan rest
  end case
end function

function cxEmitSyms (plan :: CxPlan) (syms :: List CxSym) -> List Decl is
  first matching case of syms :
    when Nil then []
    when Cons s rest then
      [s.form with condition = cxCondText plan s.copies , calls = wn.summedEdges (cxEdgesCond plan s.calls)] ++ cxEmitSyms plan rest
  end case
end function

function cxEmit (plan :: CxPlan) (book :: CxBook) (ids :: List Text) -> List Decl is
  first matching case of ids :
    when Nil then []
    when Cons id rest then
      (first matching case of prelude.lookup id book.buckets :
        when Absent then []
        when Present syms then cxEmitSyms plan syms
      end case) ++ cxEmit plan book rest
  end case
end function

-- A source over the cap is read in one build, and nothing of it is decided:
-- every symbol and edge has the condition "unread" (C7).
function cxUnreadEdges (es :: List CallEdge) -> List CallEdge is
  first matching case of es : when Nil then [] when Cons e rest then [e with condition = wp.unreadText unitValue] ++ cxUnreadEdges rest end case
end function

function cxUnreadDecls (ds :: List Decl) -> List Decl is
  first matching case of ds :
    when Nil then []
    when Cons d rest then [d with condition = wp.unreadText unitValue , calls = cxUnreadEdges d.calls] ++ cxUnreadDecls rest
  end case
end function

function cxUnreadPkgs (ps :: List Package) -> List Package is
  first matching case of ps : when Nil then [] when Cons p rest then [p with symbols = cxUnreadDecls p.symbols] ++ cxUnreadPkgs rest end case
end function

-- The packages of the copies of one file: the package's own fields are
-- those of the first copy that gives a package; a copy whose package id
-- differs is left out (O31); symbols are joined per form, each with the
-- condition of the copies that hold it.
function packagesOfCopies (plan :: CxPlan) (pks :: List (List Package)) -> List Package is
  if prelude.length plan.copies <= 1 && !plan.marked then
    (first matching case of pks :
      when Nil then []
      when Cons ps rest then (if plan.unread then cxUnreadPkgs ps else ps end if)
    end case)
  else
    (first matching case of cxFirstId pks :
      when Absent then []
      when Present base then
        (let book = cxBookOf (cxLive pks 0 base.id) (CxBook record{ buckets = prelude.keyValOf [] , order = []}) in
          [base with symbols = cxEmit plan book book.order] end let)
    end case)
  end if
end function

function modulesOfRoots (path :: Text) (roots :: List Syntax) -> List (List Package) is
  first matching case of roots :
    when Nil then []
    when Cons r rest then [moduleOf path r] ++ modulesOfRoots path rest
  end case
end function

procedure parseAll (texts :: List Text) -> List Syntax uses HaskellParser is
  first matching case of texts :
    when Nil then []
    when Cons t rest then [parse t] ++ parseAll rest
  end case
end procedure

procedure extractFilesCapped (cap :: Integer) (env :: Env) (files :: List SourceFile) -> List Package uses HaskellParser is
  first matching case of files :
    when Nil then []
    when Cons f rest then
      (if prelude.endsWith f.path ".hs" && !(skippedPath f.path)
       then (let plan = cppPlanCapped cap env f.content in packagesOfCopies plan (modulesOfRoots f.path (parseAll plan.copies)) end let)
       else [] end if) ++ extractFilesCapped cap env rest
  end case
end procedure

procedure extractFiles (files :: List SourceFile) -> List Package uses HaskellParser is
  extractFilesCapped (wp.buildCap unitValue) (wp.emptyEnv unitValue) files
end procedure
-- What ax's `--when` needs of the conditions unit, in this unit's types
-- (the generated code of a unit holds only the definitions it uses): the
-- environment of binding lines, or the usage error text of the first line
-- that cannot be read (`origin` is the file's path, or `--when`); and the
-- warning lines of a filtered manifest.
function whenEnv (origin :: Text) (lines :: List Text) -> Either Text Env is
  first matching case of wn.readBindings lines :
    when Left e then Left (wp.bindingErrorText origin e)
    when Right env then Right env
  end case
end function

function whenWarnings (f :: Filtered) -> List Text is wp.warningsOf f end function

-- Cycle 3 (decisions file): the warning lines with the names the decisions
-- files list, the lines to paste for the names missing and not listed (read
-- off the manifest as extracted), the names a file lists, the header of a
-- starter file.
function whenWarningsWith (f :: Filtered) (listed :: List Text) -> List Text is wp.warningsWith f listed end function
function whenPaste (env :: Env) (listed :: List Text) (ps :: List Package) -> List Text is wn.decisionLines env listed ps end function
function whenListed (lines :: List Text) -> List Text is wn.listedNames lines end function
function whenHeader (u :: Unit) -> List Text is wp.decisionsHeader unitValue end function

-- Cycle 6 (`ax when init`): the warning lines init prints, and its last
-- line where it finds no name to list.
function whenInitWarnings (f :: Filtered) -> List Text is wp.initWarnings f end function
function whenInitNothing (root :: Text) (f :: Filtered) -> Text is wp.initNothingText root f end function

law "|a value-typed class method before a context class parses without errors| is
  id: "HSE-0b"
  definition : errorFree (parse "class C2 a where\n  m2 :: a\n\ntype S4 = Int\n\ntype S5 = Int\n\nclass Eq a => C5 a where\n  m :: a -> Int\n") end definition
  description :
    "Valid Haskell (F87): gotreesitter v0.56.0's grammar parses the second
    class head as an equation, splitting `=>` into `=` and an ERROR node,
    after a class whose method has a value type spelled `a`, `Int` or
    `Maybe a` and two type synonyms. That class's block then runs to the
    end of the file, so the class and every declaration after it are missed
    (verified, review 2). To be reported to the gotreesitter maker; the
    policy spells value-typed methods `[a]`, which the grammar parses."
  end description
  references:
    "|F87|: "docs/survey/FACTS.md F87; ax-maker-report.md (grammar)"
  end references
end law

law "|a qualified record pattern in a cons pattern keeps the header| is
  id: "HSE-0c"
  definition : childKind (parse "module M where\nf cs = case cs of\n  (P.C{ P.n = n }:_) -> Just n\n").children "header" matches Present _ end definition
  description :
    "Valid Haskell (F90, corpus check C1): gotreesitter v0.56.0 parses this
    to a root whose only child is `declarations` from 3:25, with no ERROR
    node; the header and everything before are gone. Seen in pandoc
    (Citeproc), ShellCheck (Parser) and others. To be reported to the
    gotreesitter maker with F87."
  end description
  references:
    "|F90|: "docs/survey/FACTS.md F90; corpus-check.md C1"
  end references
end law

law "|a typed-pattern parameter parses without errors| is
  id: "HSE-0d"
  definition : errorFree (parse "module P where\nprop_a (x :: T) = f x == x\ng y = y\n") end definition
  description :
    "Valid Haskell (F89, ScopedTypeVariables): gotreesitter up to v0.57.0
    read the `=` as an error. Fixed in the patched runtime ax builds against
    (with F87 and F90, laws HSE-0b and HSE-0c, which are ordinary laws now)."
  end description
end law

-- The `badChar` safeguard (scope-design.md, section B, row S1). The combined
-- parser reads `['\r','\n']` as two `char` tokens, so no source reaches the
-- rule any more; a hand-built tree pins it. The tree is the parse of
-- `module M where` / `v0 x = x` / `s = v0 [<token>]`, with the list holding
-- one `char` token of the given text.
function charModule (token :: Text) -> Syntax is
  let p1 = Point record{ line = 1 , col = 1} in
  let p2 = Point record{ line = 2 , col = 1} in
  let p3 = Point record{ line = 3 , col = 1} in
    node "haskell" "" p1 p3
      [node "header" "" p1 p1 [leaf "module" "module" "M" p1 p1] ,
       node "declarations" "declarations" p2 p3
         [node "function" "" p2 p2 [leaf "variable" "name" "v0" p2 p2 ,
                                    node "patterns" "patterns" p2 p2 [leaf "variable" "" "x" p2 p2] ,
                                    node "match" "match" p2 p2 [leaf "variable" "expression" "x" p2 p2]] ,
          node "bind" "" p3 p3 [leaf "variable" "name" "s" p3 p3 ,
                                node "match" "match" p3 p3
                                  [node "apply" "expression" p3 p3
                                     [leaf "variable" "function" "v0" p3 p3 ,
                                      node "list" "argument" p3 p3 [node "literal" "element" p3 p3 [leaf "char" "" token p3 p3]]]]]]]
  end let end let end let
end function

function callsAre (id :: Text) (es :: List CallEdge) (d :: Decl) -> Bool is d.id = id && d.calls = merged es end function

law "|a char token that holds a second quote makes its value's scope wild| is
  id: "HSE-0e"
  definition :
    prelude.any (callsAre "s" [edge Unresolved "v0" Absent]) (extractModule "M.hs" (charModule "'\\r','\\n'")).symbols
    && prelude.any (callsAre "s" [edge Internal "v0" (Present "M#v0")]) (extractModule "M.hs" (charModule "'\\''")).symbols
    && prelude.any (callsAre "s" [edge Internal "v0" (Present "M#v0")]) (extractModule "M.hs" (charModule "'a'")).symbols
  end definition
  description :
    "The grammar's char rule once ran over several literals (matrix S1):
    `['\\r','\\n']` was one `char` token. The combined parser fixes it, so no
    source reaches this rule and the tree is built by hand. An over-long
    token may hide a binding, so the value's variables are not resolved
    (`v0` is unresolved, not internal). The valid literals `'\\''` and `'a'`
    change nothing: `v0` is the module's own."
  end description
  references:
    "|S1|: "grammar-matrix.md S1; scope-design.md sections B and L (R10)"
  end references
end law

-- A module whose header the parse loses (C1): not reported, rather than
-- read as headerless `Main` with every symbol unexported.
law "|a module whose header the parse loses is not reported| is
  id: "HSE-8"
  definition : prelude.isEmpty (extractFiles [SourceFile record{ path = "M.hs" , content = "}}}\nmodule M where\nf = 1\n"}]) end definition
  references:
    "|spec|: "spec.md, amendment 2026-11-11 (owner: a lost header is missed, never mislabelled)"
  end references
end law

law "|a module read as headerless has no module line| is
  id: "HSE-9"
  definition :
    for all (source :: Text) =>
      (headerOf (parse source) matches Present _) || !(hasModuleLine source)
        || prelude.isEmpty (extractFiles [SourceFile record{ path = "M.hs" , content = source}])
    end for all
  end definition
  description :
    "A module the extractor reads as headerless (`Main`, exporting only
    `main`) was written without a header: when the parse finds none but a
    line starts with `module `, the module is not reported (C1)."
  end description
end law

-- Literal expectations for code the extraction shares with the policy
-- (markEntry, validId): HSE-1 compares the extraction with the policy, so a
-- defect in shared code is invisible to it (mutation survivors, 2026-11-12).
function isMainEntry (d :: Decl) -> Bool is d.name = "main" && d.entry.isEntrypoint end function
function isOtherEntry (d :: Decl) -> Bool is d.name != "main" && d.entry.isEntrypoint end function
function nameIs (n :: Text) (d :: Decl) -> Bool is d.name = n end function

law "|a Main module's main is its entrypoint, and only main| is
  id: "HSE-10"
  definition :
    (extractModule "Main.hs" (parse "module Main where\nmain = pure ()\nhelper = 1\n")).isEntrypoint
    && prelude.length (extractModule "Main.hs" (parse "module Main where\nmain = pure ()\nhelper = 1\n")).symbols = 2
    && prelude.any isMainEntry (extractModule "Main.hs" (parse "module Main where\nmain = pure ()\nhelper = 1\n")).symbols
    && !(prelude.any isOtherEntry (extractModule "Main.hs" (parse "module Main where\nmain = pure ()\nhelper = 1\n")).symbols)
  end definition
end law

law "|a MagicHash name is not reported| is
  id: "HSE-11"
  definition :
    prelude.length (extractModule "M.hs" (parse "{-# LANGUAGE MagicHash #-}\nmodule M where\nf# = 1\ng = 2\n")).symbols = 1
    && prelude.any (nameIs "g") (extractModule "M.hs" (parse "{-# LANGUAGE MagicHash #-}\nmodule M where\nf# = 1\ng = 2\n")).symbols
  end definition
  description :
    "ax ids use `#` to separate a module from a symbol in an edge's ref
    (`M#f`), so a name containing `#` (MagicHash: `I#`, `+#`) cannot be an
    id. Such a binding is not reported; this is a declared limit."
  end description
end law

-- A module line that follows a byte-order mark is a module line (review 6,
-- N6). The parser starts the tree after the mark, and the source text keeps
-- it, so `hasModuleLine` must look past it: otherwise a module whose header
-- the parse loses is read as a headerless `Main`. The first conjunct pins
-- that the literal below still holds the mark (U+FEFF, three octets).
function byteOrderMark (u :: Unit) -> Text is "﻿" end function

function headerlessTree (source :: Text) -> Syntax is
  let p1 = Point record{ line = 1 , col = 1} in
  let p2 = Point record{ line = 2 , col = 1} in
    (node "haskell" "" p1 p2 [node "declarations" "declarations" p2 p2 [node "bind" "" p2 p2 [leaf "variable" "name" "f" p2 p2]]]) with text = source
  end let end let
end function

law "|a module line after a byte-order mark is a module line| is
  id: "HSE-12"
  definition :
    prelude.octets (prelude.utf8 (byteOrderMark unitValue)) = [239, 187, 191]
    && hasModuleLine (byteOrderMark unitValue ++ "module M where\nf = 1\n")
    && prelude.isEmpty (moduleOf "M.hs" (headerlessTree (byteOrderMark unitValue ++ "module M where\nf = 1\n")))
    && prelude.isEmpty (moduleOf "M.hs" (headerlessTree "module M where\nf = 1\n"))
    && prelude.length (moduleOf "M.hs" (headerlessTree (byteOrderMark unitValue ++ "f = 1\n"))) = 1
    && prelude.length (moduleOf "M.hs" (headerlessTree "f = 1\n")) = 1
  end definition
  description :
    "A header the parse loses is not reported, whether or not the file
    starts with a byte-order mark; a file with no module line is the
    headerless `Main`, with or without the mark. The tree is built by hand:
    no source is known that loses a first-line header on the combined parser."
  end description
  references:
    "|N6|: "review-haskell-6.md N6; scope-design.md sections O (O25) and P (R48)"
  end references
end law

-- A name qualified by `Prelude` (review 6, N2; decision O22): the implicit
-- Prelude answers as `import Prelude` does, and with the Prelude off the
-- qualifier names nothing.
law "|a name qualified by the Prelude is the Prelude's, unless the Prelude is off| is
  id: "HSE-13"
  definition :
    prelude.any (callsAre "n1" [edge Builtin "map" Absent]) (extractModule "M.hs" (parse "module M where\nn1 = Prelude.map 1\n")).symbols
    && prelude.any (callsAre "n1" [edge Builtin "map" Absent]) (extractModule "M.hs" (parse "module M where\nimport Prelude\nn1 = Prelude.map 1\n")).symbols
    && prelude.any (callsAre "n1" [edge Unresolved "Prelude.map" Absent]) (extractModule "M.hs" (parse "{-# LANGUAGE NoImplicitPrelude #-}\nmodule M where\nn1 = Prelude.map 1\n")).symbols
  end definition
  references:
    "|N2|: "review-haskell-6.md N2; scope-design.md sections O (O22) and P (R33)"
  end references
end law

-- A doc after plain comment lines (review 6, S1 and L7). The grammar reads
-- a run of line comments as one node, typed by its first line, so the
-- classic module header (a rule of dashes, `-- |`, the text, a rule) and a
-- `-- |` under a `-- TODO` line are plain `comment` nodes. Haddock reads
-- both docs; a line of three dashes or more ends a doc (GHC's lexer).
function docIs (id :: Text) (raw :: Text) (d :: Decl) -> Bool is d.id = id && d.doc.raw = raw end function

function classicHeader (u :: Unit) -> Text is
  "-----------\n-- |\n-- Module : M\n--\n-- The doc.\n--\n-----------\n\nmodule M where\n\n-- TODO: later\n-- | Doc of f.\nf = 1\n\n-- | Doc of g.\n-----------\ng = 2\n"
end function

law "|a doc line after plain comment lines documents what follows| is
  id: "HSE-14"
  definition :
    (extractModule "M.hs" (parse (classicHeader unitValue))).doc = "Module : M\n\nThe doc."
    && prelude.any (docIs "f" "Doc of f.") (extractModule "M.hs" (parse (classicHeader unitValue))).symbols
    && prelude.any (docIs "g" "Doc of g.") (extractModule "M.hs" (parse (classicHeader unitValue))).symbols
  end definition
  references:
    "|S1|: "review-haskell-6.md S1, L7; scope-design.md sections O (O17) and P (R42, R43, R45)"
  end references
end law

law "|extraction of the parsed source matches the policy| is
  id: "HSE-1"
  definition :
    for all (t :: HsTree) => normalForm (extractFiles (render t)) = normalForm (expected t) end for all
  end definition
  description :
    "The pure core of the extractor (parse, then extractModule) reports
    exactly the policy's packages for every modelled tree, with no ax
    binary and no file system: the native parse is the only step outside
    LawSpec. The file walk (dot-directories, .lhs, .hs-boot) is the native
    Extractor's and is held by the conformance unit."
  end description
end law

-- A module-shaped tree with arbitrary names and positions, for HSE-2: a
-- header, and declarations of every kind the extraction reads, so its
-- defensive branches (invalid ids, positions before 1:1 or reversed, module
-- nodes without parts) are reached, not only well-shaped parses.
function leaf (kind :: Text) (field :: Text) (text :: Text) (p :: Point) (q :: Point) -> Syntax is
  Syntax record{ kind = kind , field = field , text = text , from = p , to = q , isError = false , children = []}
end function

function node (kind :: Text) (field :: Text) (p :: Point) (q :: Point) (cs :: List Syntax) -> Syntax is
  Syntax record{ kind = kind , field = field , text = "" , from = p , to = q , isError = false , children = cs}
end function

function wildModule (header :: Text) (given :: Text) (bad :: Bool) (p :: Point) (q :: Point) -> Syntax is
  let name = (if bad then "" else given end if) in
  node "haskell" "" p q
    [node "header" "" p q [node "module" "module" p q []] ,
     node "header" "" p q [leaf "module" "module" (if bad then "" else header end if) p q] ,
     leaf "haddock" "" given p q ,
     node "declarations" "declarations" p q
       [node "function" "" p q [leaf "variable" "name" name p q] ,
        node "function" "" p q [node "match" "match" p q [node "apply" "" p q [] ,
                                                          node "apply" "" p q [node "qualified" "function" p q [leaf "module" "module" given p q , leaf "variable" "id" name p q]] ,
                                                          node "apply" "" p q [leaf "lambda" "function" name p q]]] ,
        node "data_type" "" p q [leaf "name" "name" name p q , node "data_constructors" "constructors" p q
          [node "data_constructor" "constructor" p q [node "prefix" "constructor" p q [leaf "constructor" "name" name p q]] ,
           node "data_constructor" "constructor" p q [node "record" "constructor" p q [leaf "constructor" "name" given p q ,
             node "fields" "fields" p q [node "field" "field" p q [node "field_name" "name" p q [] , leaf "name" "type" name p q] ,
                                        node "field" "field" p q [leaf "field_name" "name" given p q]]]]]] ,
        node "class" "" p q [leaf "name" "name" given p q , node "class_declarations" "declarations" p q
          [node "signature" "" p q [leaf "variable" "name" name p q , node "function" "type" p q [leaf "name" "result" name p q]]]] ,
        node "instance" "" p q [leaf "name" "name" name p q , node "type_patterns" "patterns" p q [leaf "name" "" name p q]] ,
        node "bind" "" q p [leaf "variable" "name" name q p] ,
        node "data_type" "" p q [leaf "name" "name" name p q , node "data_constructors" "constructors" p q [node "data_constructor" "constructor" p q [node "record" "constructor" p q [leaf "constructor" "name" name p q]]]] ,
        node "newtype" "" p q [leaf "name" "name" name p q] ,
        node "type_synomym" "" p q [leaf "name" "name" name p q] ,
        node "class" "" p q [leaf "name" "name" name p q , node "class_declarations" "declarations" p q [node "signature" "" p q [leaf "variable" "name" name p q]]] ,
        node "instance" "" p q [leaf "name" "name" name p q]]]
  end let
end function

-- ---------------------------------------------------------------------------
-- Trees drawn from the grammar's own vocabulary, for HSE-2 and HSE-5
-- (review 6, L6). `wildModule` reaches the declaration forms of the first
-- scope and `any :: Syntax` almost never names a grammar node, so neither
-- reaches the code added for "all of Haskell". `grammarTree` builds a tree
-- from the grammar's productions: a node of a kind gets children in that
-- kind's fields, each of a kind the grammar allows there, down to a fixed
-- depth. It is a total function of a seed and two points: no filter, no
-- retry. The seed also decides which fields are left out or repeated, which
-- nodes are errors, the texts (invalid ids, `..`, `-<`, `mdo`, doc
-- markers) and the positions (reversed, before 1:1), so the trees are not
-- valid parses: the law is about any tree.

-- One field of a node kind: the kinds the grammar allows there (a name that
-- starts with `@` is a group of kinds), whether it repeats, and whether the
-- grammar requires it. The field "" holds the children without a field.
type Slot is a record{
  field :: Text
  many :: Bool
  needed :: Bool
  kinds :: List Text}
end type

type Prod is a record{
  kind :: Text
  slots :: List Slot}
end type

function sl (field :: Text) (many :: Bool) (needed :: Bool) (kinds :: List Text) -> Slot is
  Slot record{ field = field , many = many , needed = needed , kinds = kinds}
end function

function pr (kind :: Text) (slots :: List Slot) -> Prod is Prod record{ kind = kind , slots = slots} end function

type Grammar is a record{
  prods :: List Prod
  groups :: List Slot
  texts :: List Slot}
end type

-- The texts a node of a kind may carry; the entry "" serves every other kind.
function grammarTexts (u :: Unit) -> List Slot is
  [sl "" true true ["v0", "x", "", "a#b", "main", "Just", "M", "fa", "map", "T", "w0", "f x"] ,
   sl "variable" true true ["v0", "x", "main", "", "a#b", "fa", "map", "w0", "y"] ,
   sl "constructor" true true ["K", "Just", "T", "", "K#", "Rc"] ,
   sl "name" true true ["T", "C", "Int", "", "T#", "Show"] ,
   sl "operator" true true ["+", "<>", "-<", "-<<", "", "#", "<+>", "=="] ,
   sl "constructor_operator" true true [":", ":+", ":|", "", ":#"] ,
   sl "wildcard" true true ["_", ".."] ,
   sl "module_id" true true ["M", "Prelude", "Main", "", "Q", "M#"] ,
   sl "module" true true ["M", "Data.Map", "Prelude", "", "M#", "Main"] ,
   sl "namespace" true true ["data", "type", "pattern", "default", ""] ,
   sl "char" true true ["'a'", "'\\''", "'\\r','\\n'", ""] ,
   sl "prefix_tuple" true true ["(,)", "(,,)", ""] ,
   sl "comment" true true ["-- x", "-- x\n-- | d", "--", "---\n-- |\n-- d\n---", "-- x\n-- ^ d", ""] ,
   sl "haddock" true true ["-- | d", "-- ^ d", "{- | d -}", "{-^ d -}", "-- |\n-- d\n---", "-- | d\n-- e", ""] ,
   sl "pragma" true true ["{-# LANGUAGE NoImplicitPrelude #-}", "{-# LANGUAGE RebindableSyntax #-}", "{-# INLINE f #-}", ""] ,
   sl "do" true true ["do", "mdo { x }", ""] ,
   sl "import" true true ["import M", "import qualified M as Q", "import M hiding (x)", "import Prelude hiding(map)", "import M qualified as Q (x)", ""] ,
   sl "haskell" true true ["module M where\nx = 1\n", "x = 1\n", "-- c\nmodule M where\n", ""] ,
   sl "data_type" true true ["data T = K", "type data T = K", ""] ,
   sl "equation" true true ["P x = K x", "P x <- K x", "K x", ""]]
end function

function theGrammar (u :: Unit) -> Grammar is
  Grammar record{ prods = grammarProds unitValue , groups = grammarGroups unitValue , texts = grammarTexts unitValue}
end function

-- A seed for the j-th choice at a node: below 1000003, never negative for a
-- seed that is not. The multiplier differs for each j, so that two choices
-- at one node do not move together.
function mix (seed :: Integer) (j :: Integer) -> Integer is
  prelude.rem (seed * (7919 + j * 2018) + j * 104729 + 12347) 1000003
end function

function chosen (n :: Integer) (ts :: List Text) (none :: Text) -> Text is
  if prelude.length ts = 0 then none
  else (first matching case of prelude.at (prelude.rem n (prelude.length ts)) ts : when Absent then none when Present t then t end case) end if
end function

function slotsOf (k :: Text) (ps :: List Prod) -> List Slot is
  first matching case of ps : when Nil then [] when Cons p rest then (if p.kind = k then p.slots else slotsOf k rest end if) end case
end function

function kindsNamed (name :: Text) (ss :: List Slot) -> List Text is
  first matching case of ss : when Nil then [] when Cons s rest then (if s.field = name then s.kinds else kindsNamed name rest end if) end case
end function

function textFor (g :: Grammar) (kind :: Text) (seed :: Integer) -> Text is
  chosen seed (if kindsNamed kind g.texts = [] then kindsNamed "" g.texts else kindsNamed kind g.texts end if) ""
end function

-- The kind a slot gets: one of its kinds; a group gives one of its members.
function kindFor (g :: Grammar) (s :: Slot) (seed :: Integer) -> Text is
  let k = chosen seed s.kinds "variable" in
    (if prelude.startsWith k "@" then chosen (mix seed 1) (kindsNamed k g.groups) "variable" else k end if)
  end let
end function

-- A child to grow: its kind, its field and its own seed.
type Pick is a record{
  kind :: Text
  field :: Text
  seed :: Integer}
end type

-- How many children a slot gets: a repeating slot none to three (two to six
-- near the root, so that a module has several declarations); a single slot
-- one, or none (a required one rarely, an optional one a time in three).
function repeats (s :: Slot) (seed :: Integer) (fuel :: Integer) -> Integer is
  if s.many then (if fuel >= 7 then 2 + prelude.rem seed 5 else prelude.rem seed 4 end if)
  else (if (if s.needed then prelude.rem seed 11 else prelude.rem seed 3 end if) = 0 then 0 else 1 end if) end if
end function

function slotPicks (g :: Grammar) (s :: Slot) (n :: Integer) (seed :: Integer) -> List Pick is
  if n <= 0 then [] else [Pick record{ kind = kindFor g s seed , field = s.field , seed = mix seed 5}] ++ slotPicks g s (n - 1) (mix seed 6) end if
end function

function picksOf (g :: Grammar) (ss :: List Slot) (seed :: Integer) (fuel :: Integer) -> List Pick is
  first matching case of ss :
    when Nil then []
    when Cons s rest then slotPicks g s (repeats s (mix seed 2) fuel) (mix seed 3) ++ picksOf g rest (mix seed 4) fuel
  end case
end function

-- The slots from the n-th on, then the first n: every field gets its turn
-- at the front before the width cuts the list.
function turned (n :: Integer) (ss :: List Slot) -> List Slot is
  if prelude.length ss = 0 then ss else prelude.drop (prelude.rem n (prelude.length ss)) ss ++ prelude.take (prelude.rem n (prelude.length ss)) ss end if
end function

-- A node's children: its production's slots, sometimes after a comment, a
-- doc, a pragma or a CPP line (the grammar allows those anywhere); at most
-- six near the root, five below, four at the leaves' end.
function kidsOf (g :: Grammar) (kind :: Text) (seed :: Integer) (fuel :: Integer) -> List Pick is
  let ss = slotsOf kind g.prods in
    prelude.take (if fuel >= 7 then 6 else (if fuel >= 4 then 5 else 4 end if) end if)
      ((if prelude.rem (mix seed 7) 4 = 0 then [Pick record{ kind = chosen (mix seed 8) ["comment", "haddock", "pragma", "cpp"] "comment" , field = "" , seed = mix seed 9}] else [] end if)
        ++ picksOf g (turned (mix seed 12) ss) seed fuel)
  end let
end function

function pointFor (seed :: Integer) (p :: Point) (q :: Point) -> Point is
  Point record{ line = (if prelude.rem seed 13 = 0 then q.line else p.line end if) + prelude.rem seed 4 , col = p.col + prelude.rem (prelude.quot seed 4) 6}
end function

-- One definition, recursive in `fuel` alone (LawSpec refuses mutual
-- recursion, and every recursive call needed move the same parameter): the
-- node, and up to six children written out.
function grow (g :: Grammar) (pk :: Pick) (fuel :: Integer) (p :: Point) (q :: Point) -> Syntax is
  let ks = (if fuel <= 0 then [] else kidsOf g pk.kind pk.seed fuel end if) in
    Syntax record{ kind = pk.kind , field = pk.field , text = textFor g pk.kind (mix pk.seed 10) ,
                   from = pointFor pk.seed p q , to = pointFor (mix pk.seed 11) q p , isError = prelude.rem pk.seed 43 = 0 ,
                   children = (if fuel <= 0 then [] else
                     (first matching case of prelude.at 0 ks : when Absent then [] when Present k then [grow g k (fuel - 1) p q] end case)
                     ++ (first matching case of prelude.at 1 ks : when Absent then [] when Present k then [grow g k (fuel - 1) p q] end case)
                     ++ (first matching case of prelude.at 2 ks : when Absent then [] when Present k then [grow g k (fuel - 1) p q] end case)
                     ++ (first matching case of prelude.at 3 ks : when Absent then [] when Present k then [grow g k (fuel - 1) p q] end case)
                     ++ (first matching case of prelude.at 4 ks : when Absent then [] when Present k then [grow g k (fuel - 1) p q] end case)
                     ++ (first matching case of prelude.at 5 ks : when Absent then [] when Present k then [grow g k (fuel - 1) p q] end case) end if)}
  end let
end function

-- A tree for a seed: rooted at `haskell`; one time in nine its content sits
-- under an ERROR node, as a syntax error leaves it.
function grammarTree (seed :: Integer) (p :: Point) (q :: Point) -> Syntax is
  let s = prelude.rem (if seed < 0 then 0 - seed else seed end if) 1000003 in
  let t = grow (theGrammar unitValue) (Pick record{ kind = "haskell" , field = "" , seed = s}) 8 p q in
    (if prelude.rem s 9 = 0 then t with children = [t with kind = "ERROR" , isError = true] else t end if)
  end let end let
end function

function kindsIn (cs :: List Syntax) -> List Text is
  first matching case of cs : when Nil then [] when Cons nd rest then [nd.kind] ++ kindsIn nd.children ++ kindsIn rest end case
end function

function fieldsIn (cs :: List Syntax) -> List Text is
  first matching case of cs : when Nil then [] when Cons nd rest then [nd.field] ++ fieldsIn nd.children ++ fieldsIn rest end case
end function

-- The trees of the seeds n, n - 1, … 1, at fixed points.
function grammarForest (n :: Integer) -> List Syntax is
  if n <= 0 then [] else [grammarTree (n * 7919) (Point record{ line = 1 , col = 1}) (Point record{ line = 9 , col = 9})] ++ grammarForest (n - 1) end if
end function

-- A tree that holds one production three times: as a declaration, as a
-- value's parameter pattern and as its right-hand side. The seed picks the
-- production in turn, so the seeds 1 to the number of productions put every
-- node kind that has fields at the root of a deep subtree, each child in its
-- own field. Rare forms (a `transform` qualifier, a `proc`, an export's
-- `associated_data`) are reached as often as common ones.
function focusKind (g :: Grammar) (s :: Integer) -> Text is
  if prelude.length g.prods = 0 then "variable"
  else (first matching case of prelude.at (prelude.rem s (prelude.length g.prods)) g.prods : when Absent then "variable" when Present pd then pd.kind end case) end if
end function

function focusTree (seed :: Integer) (p :: Point) (q :: Point) -> Syntax is
  let s = prelude.rem (if seed < 0 then 0 - seed else seed end if) 1000003 in
  let g = theGrammar unitValue in
  let k = focusKind g s in
    focusModule (textFor g "haskell" (mix s 13)) (textFor g "variable" (mix s 15)) p q
      (grow g (Pick record{ kind = k , field = "" , seed = mix s 14}) 5 p q)
      (grow g (Pick record{ kind = k , field = "" , seed = mix s 16}) 4 p q)
      (grow g (Pick record{ kind = k , field = "expression" , seed = mix s 17}) 5 p q)
  end let end let end let
end function

function focusModule (source :: Text) (name :: Text) (p :: Point) (q :: Point) (asDecl :: Syntax) (asPattern :: Syntax) (asBody :: Syntax) -> Syntax is
  (node "haskell" "" p q
    [node "declarations" "declarations" p q
       [asDecl ,
        node "function" "" p q [leaf "variable" "name" name p q , node "patterns" "patterns" p q [asPattern] , node "match" "match" p q [asBody]]]]) with text = source
end function

-- The focus trees of the seeds n, n - 1, … 1.
function focusForest (n :: Integer) -> List Syntax is
  if n <= 0 then [] else [focusTree n (Point record{ line = 1 , col = 1}) (Point record{ line = 9 , col = 9})] ++ focusForest (n - 1) end if
end function

