{
  :manifest-version 1
  :component {
    :name "assayxport-haskell-laws"
    :version "0.1.0"
  }
  :language-profile "1.0-rc.2"
  :verification {
    :layers [:property :examples]
  }
  :sources ["laws"]
  ;; The shared contract, a LawSpec package (packages as contracts).
  :dependencies {
    "assayxport.contract" "^0.3.0"
  }
  :packages ["contract"]
  ;; The ax build the HaskellExtractor handler runs (AX_BIN).
  :inputs ["../calibration/bin/ax"]
  :targets [
    {
      :language :go
      :root "../calibration/lawtests-hs"
      :native-bindings {
        :go-imports [{:alias "workspace" :path "example.com/lawspec-example/native/workspace"}]
        :handlers [{:ability "assayxport.contract::Workspace" :native ["workspace" "NewWorkspace"]}]
      }
    }
  ]
}
